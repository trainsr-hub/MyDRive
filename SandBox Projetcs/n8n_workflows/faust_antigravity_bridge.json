        "jsCode": "const { execFileSync } = require('child_process');\nconst pythonExe = 'd:\\\\Program Files\\\\Python\\\\python.exe';\nconst script = 'd:\\\\My Drive\\\\SandBox Projetcs\\\\.agents\\\\scripts\\\\dispatch_to_faust.py';\nconst text = ($json && $json.message && $json.message.text) ? $json.message.text : '';\nconst msgId = String(($json && $json.message && $json.message.message_id) ? $json.message.message_id : '0');\nconst chatId = String(($json && $json.message && $json.message.chat && $json.message.chat.id) ? $json.message.chat.id : '');\nconst threadId = String(($json && $json.message && $json.message.message_thread_id) ? $json.message.message_thread_id : '');\ntry {\n  const res = execFileSync(pythonExe, [script, text, msgId, chatId, threadId], { encoding: 'utf8', timeout: 30000 });\n  return [{ json: { success: true, result: res.trim() } }];\n} catch (err) {\n  return [{ json: { success: false, error: err.message } }];\n}"
