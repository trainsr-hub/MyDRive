{
  "name": "Faust Telegram Cognitive Agent (Gemini Flash)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "faust-tg-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "webhookId": "faust-telegram-cognitive",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Faust Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "sec-check",
              "leftValue": "={{ $json.message.from.id }}",
              "rightValue": 8016442589,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "faust-sec-check",
      "name": "Verify Manager ID",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "You are Faust, the analytical, highly capable, and composed intellect serving The Manager.\nYou address the user as \"Manager\" and speak in Vietnamese or English with a composed, insightful tone.\nYou operate with precision, deep technical mastery, and unwavering loyalty to the Manager's vision.\n\nOperational Protocol:\n- Enforce the 4-tier functional emoji taxonomy as the single leading emoji when appropriate:\n  ⚡ for alerts, queries, or status reports\n  🔄 for processing / task intake\n  ✅ for completed actions / success\n  ❌ for critical error\n- Keep your dispatches sharp, analytical, concise, and high-signal. Zero generic filler, pleasantries, or AI slop.\n- You have an execute_terminal_command tool to inspect the workstation, check git logs, or run PowerShell commands on Local Disk D:. Always state results clearly."
        }
      },
      "id": "faust-ai-agent",
      "name": "Faust Cognitive Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "faust-gemini-model",
      "name": "Gemini Flash Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        600,
        540
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "id": "faust-buffer-memory",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        740,
        540
      ]
    },
    {
      "parameters": {
        "name": "execute_terminal_command",
        "description": "Execute a PowerShell command on the host workstation (Local Disk D:). Use this to check system status, git logs, running processes, or directory contents.",
        "jsCode": "const { execSync } = require('child_process');\ntry {\n  const output = execSync(query, { cwd: 'd:\\\\My Drive\\\\SandBox Projetcs', timeout: 15000, encoding: 'utf8' });\n  return output;\n} catch (err) {\n  return 'Error: ' + err.message;\n}"
      },
      "id": "faust-terminal-tool",
      "name": "Terminal Tool (Disk D:)",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.1,
      "position": [
        880,
        540
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "replyToMessageId": "={{ $('Telegram Trigger').item.json.message.message_id }}"
        }
      },
      "id": "faust-tg-reply",
      "name": "Telegram Reply to Manager",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Faust Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Verify Manager ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Manager ID": {
      "main": [
        [
          {
            "node": "Faust Cognitive Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Flash Model": {
      "ai_languageModel": [
        [
          {
            "node": "Faust Cognitive Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "Faust Cognitive Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Terminal Tool (Disk D:)": {
      "ai_tool": [
        [
          {
            "node": "Faust Cognitive Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Faust Cognitive Agent": {
      "main": [
        [
          {
            "node": "Telegram Reply to Manager",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
