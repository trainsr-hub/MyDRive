#define PIN_BTN_BOOT  9   // Onboard BOOT button (GPIO 9)
#define PIN_BTN_SCROLL 0  // Primary Scroll/Page button: GPIO 0 to GND
#define PIN_BTN_SCROLL_ALT 2 // Alternative Scroll/Page button: GPIO 2 to GND

