#include <Arduino.h>
#include "pins.h"
#include "Jq8900Player.h"

Jq8900Player audio(Serial1);

static uint16_t currentTrack = 1;

void play(uint16_t t) {
  currentTrack = t;
  Serial.printf("\n>>> [JQ8900] Playing Track #%u <<<\n", t);
  audio.playTrack(t);
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_BTN_ROLL, INPUT_PULLUP);
  pinMode(PIN_BTN_SCROLL, INPUT_PULLUP);

  delay(1000);
  Serial.println("\n========================================");
  Serial.println("  JQ8900 Varis Gear Audio Diagnostic");
  Serial.println("========================================");
  Serial.printf("Initializing JQ8900 on TX Pin GPIO %d...\n", PIN_JQ_TX);

  audio.begin(PIN_JQ_TX);
  delay(200);

  Serial.println("Setting Volume to 25...");
  audio.setVolume(25);
  delay(300);

  Serial.println("\nCommands:");
  Serial.println(" - Press onboard BOOT button (GPIO 9) to play NEXT track");
  Serial.println(" - Press SCROLL button (GPIO 0) to play PREVIOUS track");
  Serial.println(" - Type track number (1, 2, 3, 4...) in Serial monitor and press Enter");
  Serial.println("----------------------------------------");

  // First, play Track 3
  Serial.println("\n[AUTO-TEST] Now playing Track 3 (expected 0003.wav)...");
  play(3);
  delay(4000);

  // Then, play Track 4
  Serial.println("\n[AUTO-TEST] Now playing Track 4 (expected 0004.wav)...");
  play(4);
}

static bool lastBtnRoll = true;
static bool lastBtnScroll = true;

void loop() {
  // Check Serial input
  if (Serial.available()) {
    String input = Serial.readStringUntil('\n');
    input.trim();
    if (input.length() > 0) {
      if (input == "stop" || input == "s") {
        Serial.println(">>> [JQ8900] STOP <<<");
        audio.stop();
      } else if (input.startsWith("v")) {
        int vol = input.substring(1).toInt();
        if (vol >= 0 && vol <= 30) {
          Serial.printf(">>> [JQ8900] Volume set to %d <<<\n", vol);
          audio.setVolume(vol);
        }
      } else {
        int t = input.toInt();
        if (t > 0) {
          play((uint16_t)t);
        }
      }
    }
  }

  // Check BOOT button (GPIO 9)
  bool btnR = digitalRead(PIN_BTN_ROLL);
  if (lastBtnRoll && !btnR) {
    delay(50); // debounce
    if (!digitalRead(PIN_BTN_ROLL)) {
      play(currentTrack + 1);
    }
  }
  lastBtnRoll = btnR;

  // Check SCROLL button (GPIO 0)
  bool btnS = digitalRead(PIN_BTN_SCROLL);
  if (lastBtnScroll && !btnS) {
    delay(50); // debounce
    if (!digitalRead(PIN_BTN_SCROLL)) {
      if (currentTrack > 1) {
        play(currentTrack - 1);
      } else {
        play(1);
      }
    }
  }
  lastBtnScroll = btnS;

  delay(10);
}
