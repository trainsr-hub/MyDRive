class ProjectEntryHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=BASE_DIR, **kwargs)

    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Origin, Accept")
        self.send_header("Cache-Control", "no-cache, no-store, must-revalidate")
        super().end_headers()

    def do_OPTIONS(self):
        self.send_response(204)
        self.end_headers()

    def _send_json(self, data, status=200):
        body = json.dumps(data, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path == "/" or path == "/entry":
            self.send_response(302)
            self.send_header("Location", "/index.html")
            self.end_headers()
            return

        if path == "/api/tables":
            tables = {}
            for fname in os.listdir(DATA_DIR):
                if fname.endswith(".json"):
                    fpath = os.path.join(DATA_DIR, fname)
                    try:
                        with open(fpath, "r", encoding="utf-8") as f:
                            data = json.load(f)
                            tname = data.get("table_name", fname[:-5])
                            tables[tname] = data
                    except Exception as e:
                        print(f"Error loading {fname}: {e}")
            self._send_json({"success": True, "tables": tables})
            return

        if path.startswith("/api/table/"):
            tname = urllib.parse.unquote(path[len("/api/table/"):])
            fpath = os.path.join(DATA_DIR, f"{tname}.json")
            if os.path.exists(fpath):
                with open(fpath, "r", encoding="utf-8") as f:
                    self._send_json({"success": True, "table": json.load(f)})
            else:
                self._send_json({"success": False, "error": "Table not found"}, status=404)
            return

        if path.startswith("/api/records/"):
            tname = urllib.parse.unquote(path[len("/api/records/"):])
            conn = sqlite3.connect(DB_PATH)
            conn.row_factory = sqlite3.Row
            try:
                cursor = conn.cursor()
                cursor.execute(f"SELECT * FROM {tname};")
                rows = [dict(row) for row in cursor.fetchall()]
                for r in rows:
                    for k, v in r.items():
                        if isinstance(v, str) and (v.startswith("[") and v.endswith("]")):
                            try:
                                r[k] = json.loads(v)
                            except Exception:
                                pass
                self._send_json({"success": True, "records": rows})
            except Exception as e:
                self._send_json({"success": False, "error": str(e)}, status=500)
            finally:
                conn.close()
            return

        if path == "/api/sqlite_info":
            tables_info = {}
            if os.path.exists(DB_PATH):
                conn = sqlite3.connect(DB_PATH)
                try:
                    cursor = conn.cursor()
                    cursor.execute("SELECT name, sql FROM sqlite_master WHERE type='table';")
                    for row in cursor.fetchall():
                        tname, sql = row[0], row[1]
                        cursor.execute(f"SELECT COUNT(*) FROM {tname};")
                        cnt = cursor.fetchone()[0]
                        tables_info[tname] = {"sql": sql, "row_count": cnt}
                except Exception as e:
                    tables_info["_error"] = str(e)
                finally:
                    conn.close()
            self._send_json({"success": True, "db_path": DB_PATH, "tables": tables_info})
            return

        super().do_GET()

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length).decode("utf-8") if length > 0 else "{}"

        try:
            payload = json.loads(body)
        except Exception:
            payload = {}

        if path.startswith("/api/table/"):
            tname = urllib.parse.unquote(path[len("/api/table/"):])
            if not tname:
                self._send_json({"success": False, "error": "Missing table name"}, status=400)
                return

            fpath = os.path.join(DATA_DIR, f"{tname}.json")
            with open(fpath, "w", encoding="utf-8") as f:
                json.dump(payload, f, indent=2)

            # Sync SQLite DDL
            cols = payload.get("columns", [])
            if cols:
                try:
                    sync_table_to_sqlite(tname, cols)
                except Exception as e:
                    print(f"SQLite sync error: {e}")

            self._send_json({"success": True, "message": f"Saved {tname} locally to data/{tname}.json"})
            return

        if path.startswith("/api/records/"):
            tname = urllib.parse.unquote(path[len("/api/records/"):])
            record = payload.get("record") if "record" in payload else payload
            if not record or not isinstance(record, dict):
                self._send_json({"success": False, "error": "Invalid record data"}, status=400)
                return

            conn = sqlite3.connect(DB_PATH)
            try:
                cursor = conn.cursor()
                cursor.execute(f"PRAGMA table_info({tname});")
                valid_cols = [c[1] for c in cursor.fetchall()]

                filtered_record = {}
                for col in valid_cols:
                    if col in record:
                        val = record[col]
                        if isinstance(val, (list, dict)):
                            val = json.dumps(val)
                        filtered_record[col] = val

                if not filtered_record:
                    self._send_json({"success": False, "error": "No valid fields provided"}, status=400)
                    return

                keys = list(filtered_record.keys())
                placeholders = [":" + k for k in keys]
                sql = f"INSERT OR REPLACE INTO {tname} ({', '.join(keys)}) VALUES ({', '.join(placeholders)});"
                cursor.execute(sql, filtered_record)
                conn.commit()
                self._send_json({"success": True, "record": record})
            except Exception as e:
                self._send_json({"success": False, "error": str(e)}, status=500)
            finally:
                conn.close()
            return

        if path == "/api/sync_all":
            try:
                sync_all_to_sqlite()
                self._send_json({"success": True, "message": "All tables synchronized to SQLite database"})
            except Exception as e:
                self._send_json({"success": False, "error": str(e)}, status=500)
            return

        self._send_json({"error": "Endpoint not found"}, status=404)

    def do_DELETE(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path.startswith("/api/records/") or path.startswith("/api/record/"):
            prefix = "/api/records/" if path.startswith("/api/records/") else "/api/record/"
            parts = path[len(prefix):].split("/")
            if len(parts) >= 2:
                tname = urllib.parse.unquote(parts[0])
                rec_id = urllib.parse.unquote(parts[1])
                conn = sqlite3.connect(DB_PATH)
                try:
                    cursor = conn.cursor()
                    cursor.execute(f"DELETE FROM {tname} WHERE id = ?;", (rec_id,))
                    conn.commit()
                    self._send_json({"success": True, "message": f"Deleted record {rec_id}"})
                except Exception as e:
                    self._send_json({"success": False, "error": str(e)}, status=500)
                finally:
                    conn.close()
                return

        if path.startswith("/api/table/"):
            tname = urllib.parse.unquote(path[len("/api/table/"):])
            fpath = os.path.join(DATA_DIR, f"{tname}.json")
            if os.path.exists(fpath):
                os.remove(fpath)
                self._send_json({"success": True, "message": f"Deleted {tname}.json from data/"})
            else:
                self._send_json({"success": False, "error": "Table not found"}, status=404)
            return

        self._send_json({"error": "Endpoint not found"}, status=404)


if __name__ == "__main__":
    sync_all_to_sqlite()
    seed_default_records()
    print(f"[*] Project Entry Server initialized at http://localhost:{PORT}")
    print(f"[*] Storing schemas in: {DATA_DIR}")
    print(f"[*] SQLite Database: {DB_PATH}")
    server = ThreadingHTTPServer(("0.0.0.0", PORT), ProjectEntryHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[*] Server shutdown gracefully.")
