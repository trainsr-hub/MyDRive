"""
Project Entry: Local REST Server & SQLite/JSON Storage Engine.
Serves the Project Entry UI and handles persistent read/write operations
directly to the local `data/` directory (Zero Downloads):
  - JSON schema definitions: `data/<table_name>.json`
  - Real SQLite database: `data/database.sqlite`
"""

from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
import json
import os
import sqlite3
import urllib.parse

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DATA_DIR = os.path.join(BASE_DIR, "data")
DB_PATH = os.path.join(DATA_DIR, "database.sqlite")
PORT = 20139

os.makedirs(DATA_DIR, exist_ok=True)


def get_sqlite_type(field_type: str) -> str:
    """Map the 10 atomic data types to SQLite column definitions."""
    mapping = {
        "hex_id": "TEXT PRIMARY KEY",
        "text_single": "TEXT",
        "text_multi": "TEXT",
        "int_scalar": "INTEGER",
        "float_scalar": "REAL",
        "boolean": "INTEGER DEFAULT 0",
        "enum_single": "TEXT",
        "enum_multi": "TEXT",
        "relation_single": "TEXT",
        "relation_multi": "TEXT",
    }
    return mapping.get(field_type, "TEXT")


def generate_ddl(table_name: str, columns: list) -> str:
    """Generate SQL CREATE TABLE DDL from column specifications using computer slug."""
    cols_sql = []
    for col in columns:
        c_slug = col.get("slug")
        if not c_slug:
            raw = col.get("name") or col.get("label", "unnamed")
            c_slug = "".join(c if c.isalnum() else "_" for c in str(raw).strip().lower()).strip("_")
            c_slug = c_slug or "field"
        c_type = col.get("type", "text_single")
        sql_type = get_sqlite_type(c_type)
        cols_sql.append(f"    {c_slug} {sql_type}")

    col_str = ",\n".join(cols_sql)
    return f"CREATE TABLE IF NOT EXISTS {table_name} (\n{col_str}\n);"


def sync_table_to_sqlite(table_name: str, columns: list):
    """Sync table schema directly into SQLite database."""
    ddl = generate_ddl(table_name, columns)
    conn = sqlite3.connect(DB_PATH)
    try:
        cursor = conn.cursor()
        cursor.execute(ddl)
        conn.commit()
    finally:
        conn.close()


def sync_all_to_sqlite():
    """Ensure all JSON schemas in data/ are reflected in SQLite."""
    conn = sqlite3.connect(DB_PATH)
    try:
        cursor = conn.cursor()
        for fname in os.listdir(DATA_DIR):
            if fname.endswith(".json"):
                fpath = os.path.join(DATA_DIR, fname)
                try:
                    with open(fpath, "r", encoding="utf-8") as f:
                        data = json.load(f)
                        tname = data.get("table_name")
                        cols = data.get("columns", [])
                        if tname and cols:
                            ddl = generate_ddl(tname, cols)
                            cursor.execute(ddl)
                except Exception as e:
                    print(f"Error syncing {fname} to SQLite: {e}")
        conn.commit()
    finally:
        conn.close()


