def upsert_preset(preset: Dict[str, Any], db_path: str = DEFAULT_DB_PATH) -> None:
    init_db(db_path)
    conn = get_connection(db_path)
    with conn:
        conn.execute("BEGIN IMMEDIATE;")

        active_node_ids_json = json.dumps(preset.get("active_node_ids", []), ensure_ascii=False)
        node_weights_json = json.dumps(preset.get("node_weights", {}), ensure_ascii=False)
        active_gacha_pool_ids_json = json.dumps(preset.get("active_gacha_pool_ids", []), ensure_ascii=False)
        created_at = preset.get("created_at", time.strftime("%Y-%m-%d %H:%M:%S"))

        conn.execute("DELETE FROM presets WHERE id = ?;", (preset["id"],))
        conn.execute("""
            INSERT INTO presets (
                id, name, description, target_engine,
                active_node_ids, node_weights, custom_positive, custom_negative,
                active_gacha_pool_ids, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
        """, (
            preset["id"],
            preset["name"].strip(),
            preset.get("description", ""),
            preset.get("target_engine", "ComfyUI"),
            active_node_ids_json,
            node_weights_json,
            preset.get("custom_positive", ""),
            preset.get("custom_negative", ""),
            active_gacha_pool_ids_json,
            created_at
        ))
    conn.execute("PRAGMA wal_checkpoint(PASSIVE);")
    conn.close()


def get_all_presets(db_path: str = DEFAULT_DB_PATH) -> List[Dict[str, Any]]:
    init_db(db_path)
    conn = get_connection(db_path)
    cur = conn.execute("SELECT * FROM presets ORDER BY name ASC;")
    rows = cur.fetchall()
    conn.close()
    return [{
        "id": r["id"],
        "name": r["name"],
        "description": r["description"] or "",
        "target_engine": r["target_engine"] or "ComfyUI",
        "active_node_ids": json.loads(r["active_node_ids"]) if r["active_node_ids"] else [],
        "node_weights": json.loads(r["node_weights"]) if r["node_weights"] else {},
        "custom_positive": r["custom_positive"] or "",
        "custom_negative": r["custom_negative"] or "",
        "active_gacha_pool_ids": json.loads(r["active_gacha_pool_ids"]) if r["active_gacha_pool_ids"] else [],
        "created_at": r["created_at"]
    } for r in rows]


