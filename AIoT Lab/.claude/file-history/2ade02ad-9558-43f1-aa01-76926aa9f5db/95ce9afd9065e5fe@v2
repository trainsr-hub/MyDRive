import { create } from 'zustand';
import { immer } from 'zustand/middleware/immer';
import {
  Category,
  PromptNode,
  GachaPool,
  Preset,
  ResolvedPromptResult,
  TargetEngine,
} from '@/types/schema';
import { categoriesApi, nodesApi, poolsApi, presetsApi, graphApi } from '@/types/api';

interface StudioState {
  // Data
  categories: Category[];
  nodes: PromptNode[];
  pools: GachaPool[];
  presets: Preset[];
  isLoading: boolean;

  // Runtime state
  activePresetId: string | null;
  activeNodeIds: string[];
  nodeWeights: Record<string, number>;
  activeGachaPoolIds: string[];
  targetEngine: TargetEngine;
  customPositive: string;
  customNegative: string;
  seed: number;
  isSeedLocked: boolean;
  selectedCategoryId: string;
  lastResolved: ResolvedPromptResult | null;

  // Actions
  init: () => Promise<void>;
  toggleNode: (nodeId: string) => void;
  setNodeWeight: (nodeId: string, weight: number) => void;
  toggleGachaPool: (poolId: string) => void;
  setTargetEngine: (engine: TargetEngine) => void;
  setCustomPositive: (val: string) => void;
  setCustomNegative: (val: string) => void;
  setSeed: (seed: number) => void;
  toggleSeedLock: () => void;
  setSelectedCategory: (catId: string) => void;
  loadPreset: (presetId: string) => void;
  saveCurrentPreset: (name: string, description?: string) => Promise<void>;
  reroll: () => Promise<void>;
  clearSelections: () => void;
}

export const useStudioStore = create<StudioState>()(
  immer((set, get) => ({
    categories: [],
    nodes: [],
    pools: [],
    presets: [],
    isLoading: false,

    activePresetId: null,
    activeNodeIds: [],
    nodeWeights: {},
    activeGachaPoolIds: [],
    targetEngine: 'ComfyUI',
    customPositive: '',
    customNegative: '',
    seed: Math.floor(Math.random() * 1000000000),
    isSeedLocked: false,
    selectedCategoryId: 'all',
    lastResolved: null,

    init: async () => {
      set({ isLoading: true });
      try {
        const [categories, nodes, pools, presets] = await Promise.all([
          categoriesApi.list(),
          nodesApi.list(),
          poolsApi.list(),
          presetsApi.list(),
        ]);

        set({
          categories,
          nodes,
          pools,
          presets,
          isLoading: false,
        });

        // Load first preset if available
        if (presets.length > 0) {
          get().loadPreset(presets[0].id);
        }
      } catch (e) {
        console.error('[Studio] Init error:', e);
        set({ isLoading: false });
      }
    },

    toggleNode: (nodeId: string) => {
      set((state) => {
        const node = state.nodes.find((n) => n.id === nodeId);
        if (!node) return;

        const category = state.categories.find((c) => c.id === node.category_id);
        const isActive = state.activeNodeIds.includes(nodeId);

        if (isActive) {
          state.activeNodeIds = state.activeNodeIds.filter((id) => id !== nodeId);
        } else {
          if (category?.selection_type === 'single') {
            const otherIds = state.nodes
              .filter((n) => n.category_id === category.id)
              .map((n) => n.id);
            state.activeNodeIds = state.activeNodeIds.filter((id) => !otherIds.includes(id));
          }
          state.activeNodeIds.push(nodeId);
        }
      });
      get().reroll();
    },

    setNodeWeight: (nodeId: string, weight: number) => {
      set((state) => {
        const clamped = Math.max(0.1, Math.min(2.0, Math.round(weight * 100) / 100));
        state.nodeWeights[nodeId] = clamped;
      });
      get().reroll();
    },

    toggleGachaPool: (poolId: string) => {
      set((state) => {
        if (state.activeGachaPoolIds.includes(poolId)) {
          state.activeGachaPoolIds = state.activeGachaPoolIds.filter((id) => id !== poolId);
        } else {
          state.activeGachaPoolIds.push(poolId);
        }
      });
      get().reroll();
    },

    setTargetEngine: (engine: TargetEngine) => {
      set({ targetEngine: engine });
      get().reroll();
    },

    setCustomPositive: (val: string) => {
      set({ customPositive: val });
      get().reroll();
    },

    setCustomNegative: (val: string) => {
      set({ customNegative: val });
      get().reroll();
    },

    setSeed: (seed: number) => {
      set({ seed });
    },

    toggleSeedLock: () => {
      set((state) => {
        state.isSeedLocked = !state.isSeedLocked;
      });
    },

    setSelectedCategory: (catId: string) => {
      set({ selectedCategoryId: catId });
    },

    loadPreset: (presetId: string) => {
      const preset = get().presets.find((p) => p.id === presetId);
      if (!preset) return;

      set({
        activePresetId: preset.id,
        targetEngine: preset.target_engine || 'ComfyUI',
        activeNodeIds: [...preset.active_node_ids],
        nodeWeights: { ...preset.node_weights },
        customPositive: preset.custom_positive || '',
        customNegative: preset.custom_negative || '',
        activeGachaPoolIds: preset.active_gacha_pool_ids || [],
      });

      get().reroll();
    },

    saveCurrentPreset: async (name: string, description?: string) => {
      const {
        targetEngine,
        activeNodeIds,
        nodeWeights,
        customPositive,
        customNegative,
        activeGachaPoolIds,
      } = get();

      const newPreset: Omit<Preset, 'id' | 'created_at'> = {
        name,
        description: description || 'User saved configuration',
        target_engine: targetEngine,
        active_node_ids: activeNodeIds,
        node_weights: nodeWeights,
        custom_positive: customPositive,
        custom_negative: customNegative,
        active_gacha_pool_ids: activeGachaPoolIds,
      };

      try {
        const saved = await presetsApi.create(newPreset);
        set((state) => {
          state.presets.push(saved);
          state.activePresetId = saved.id;
        });
      } catch (e) {
        console.error('[Studio] Save preset error:', e);
      }
    },

    reroll: async () => {
      const { activePresetId, isSeedLocked, seed } = get();

      if (!activePresetId) return;

      const effectiveSeed = isSeedLocked ? seed : Math.floor(Math.random() * 1000000000);

      if (!isSeedLocked) {
        set({ seed: effectiveSeed });
      }

      try {
        const result = await graphApi.resolve(activePresetId, effectiveSeed);
        set({ lastResolved: result });
      } catch (e) {
        console.error('[Studio] Graph resolution error:', e);
      }
    },

    clearSelections: () => {
      set({
        activeNodeIds: [],
        nodeWeights: {},
        customPositive: '',
        customNegative: '',
        activePresetId: null,
      });
      get().reroll();
    },
  }))
);
