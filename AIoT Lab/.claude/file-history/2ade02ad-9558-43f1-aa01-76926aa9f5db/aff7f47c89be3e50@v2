"""
Rebased FastAPI Server - Full REST API for Hazard Trigger System
Port 20140 with CORS enabled for localhost:5173
"""

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from typing import Optional, List
import db
from models import (
    CategoryCreate, Category,
    NodeCreate, Node,
    PoolCreate, Pool,
    PresetCreate, Preset,
    ResolvedPromptResult
)
from graph_resolver import GraphResolver
import time

app = FastAPI(
    title="Rebased API",
    version="1.0.0",
    description="Hazard Trigger Prompt Engineering System"
)

# CORS Configuration
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173", "http://127.0.0.1:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.on_event("startup")
async def startup_event():
    """Initialize database on startup."""
    db.init_db()
    print("[OK] Rebased API server initialized on port 20140")


@app.get("/health")
async def health_check():
    """Health check endpoint."""
    return {
        "status": "ok",
        "service": "rebased-backend",
        "timestamp": int(time.time())
    }


