import React from 'react';
import { PromptNode } from '@/types/schema';
import { useStudioStore } from '@/store/useStudioStore';
import { Plus, Minus } from 'lucide-react';

interface NodeCardProps {
  node: PromptNode;
}

export const NodeCard: React.FC<NodeCardProps> = ({ node }) => {
  const { activeNodeIds, nodeWeights, toggleNode, setNodeWeight } = useStudioStore();

  const isActive = activeNodeIds.includes(node.id);
  const currentWeight = nodeWeights[node.id] ?? node.default_weight ?? 1.0;
  const rarity = node.rarity ?? 'N';

  const rarityColors = {
    SSR: 'from-hazard-crimson to-hazard-amber',
    SR: 'bg-hazard-cyan',
    R: 'bg-hazard-purple',
    N: 'bg-hazard-cardHover',
  };

  return (
    <div
      onClick={() => toggleNode(node.id)}
      className={`relative p-3 rounded-lg border transition cursor-pointer select-none ${
        isActive
          ? 'border-hazard-gold bg-hazard-cardHover shadow-hazard-glow'
          : 'border-hazard-border bg-hazard-card hover:bg-hazard-cardHover'
      }`}
    >
      {/* Header */}
      <div className="flex items-center justify-between gap-2 mb-2">
        <span className={`text-[10px] px-2 py-0.5 rounded font-mono text-white font-bold ${
          rarity === 'SSR' ? 'bg-gradient-to-r ' + rarityColors.SSR :
          rarity === 'SR' ? 'bg-' + rarityColors.SR :
          rarity === 'R' ? 'bg-' + rarityColors.R :
          'bg-' + rarityColors.N
        }`}>
          {rarity}
        </span>
        {isActive && <span className="w-2 h-2 rounded-full bg-hazard-gold animate-ping" />}
      </div>

      {/* Label */}
      <h4 className={`text-xs font-semibold line-clamp-1 ${
        isActive ? 'text-hazard-gold' : 'text-hazard-textBright'
      }`}>
        {node.label}
      </h4>

      {/* Token */}
      <p className="text-[11px] font-mono text-hazard-textMuted line-clamp-2 mt-1">
        {node.token}
      </p>

      {/* Footer */}
      <div className="flex items-center justify-between mt-2 pt-2 border-t border-hazard-border/50">
        <div className="flex gap-1">
          {node.tags?.slice(0, 2).map((tag) => (
            <span key={tag} className="text-[9px] px-1.5 py-0.5 rounded bg-hazard-void text-hazard-textMuted font-mono">
              #{tag}
            </span>
          ))}
        </div>

        {/* Weight */}
        <div className="flex items-center gap-1 bg-hazard-void rounded px-1.5 py-0.5">
          <button
            onClick={(e) => {
              e.stopPropagation();
              setNodeWeight(node.id, currentWeight - 0.05);
            }}
            className="text-hazard-textMuted hover:text-white"
          >
            <Minus className="w-3 h-3" />
          </button>
          <span className={`text-[10px] font-mono font-bold w-8 text-center ${
            currentWeight !== 1.0 ? 'text-hazard-gold' : 'text-hazard-textMuted'
          }`}>
            {currentWeight.toFixed(2)}
          </span>
          <button
            onClick={(e) => {
              e.stopPropagation();
              setNodeWeight(node.id, currentWeight + 0.05);
            }}
            className="text-hazard-textMuted hover:text-white"
          >
            <Plus className="w-3 h-3" />
          </button>
        </div>
      </div>
    </div>
  );
};
