import React, { useState } from 'react';
import { useStudioStore } from '@/store/useStudioStore';
import { Copy, Check, Sparkles, ShieldAlert, Terminal, ChevronDown, ChevronUp } from 'lucide-react';

export const OutputPanel: React.FC = () => {
  const { lastResolved, customPositive, setCustomPositive, customNegative, setCustomNegative } =
    useStudioStore();

  const [copiedType, setCopiedType] = useState<string | null>(null);
  const [isExpanded, setIsExpanded] = useState(true);

  if (!lastResolved) return null;

  const copyToClipboard = (text: string, type: string) => {
    navigator.clipboard.writeText(text);
    setCopiedType(type);
    setTimeout(() => setCopiedType(null), 1800);
  };

  const fullPrompt = `${lastResolved.positive_prompt}\n\nNegative Prompt:\n${lastResolved.negative_prompt}`;

  return (
    <div className="border-t border-hazard-border bg-hazard-card/95 shrink-0">
      {/* Header */}
      <div className="flex items-center justify-between px-4 py-2 bg-hazard-void border-b border-hazard-border/50">
        <div className="flex items-center gap-3">
          <div className="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-hazard-gold">
            <Terminal className="w-3.5 h-3.5" />
            Prompt Output
          </div>
          <div className="flex items-center gap-2 text-[11px] font-mono">
            <span className="px-2 py-0.5 rounded bg-hazard-card border border-hazard-border text-hazard-textBright">
              Tokens: <strong className="text-hazard-gold">{lastResolved.token_count}</strong>
            </span>
            <span className="px-2 py-0.5 rounded bg-hazard-card border border-hazard-border text-hazard-cyan">
              LoRAs: <strong>{lastResolved.loras.length}</strong>
            </span>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button
            onClick={() => copyToClipboard(fullPrompt, 'all')}
            className="flex items-center gap-1 px-3 py-1 bg-hazard-gold/10 border border-hazard-gold/30 hover:bg-hazard-gold/20 text-hazard-gold text-xs font-semibold rounded transition"
          >
            {copiedType === 'all' ? <Check className="w-3 h-3" /> : <Copy className="w-3 h-3" />}
            {copiedType === 'all' ? 'Copied!' : 'Copy All'}
          </button>

          <button
            onClick={() => setIsExpanded(!isExpanded)}
            className="p-1 text-hazard-textMuted hover:text-white"
          >
            {isExpanded ? <ChevronDown className="w-4 h-4" /> : <ChevronUp className="w-4 h-4" />}
          </button>
        </div>
      </div>

      {/* Content */}
      {isExpanded && (
        <div className="p-4 grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[320px] overflow-y-auto">
          {/* Positive */}
          <div className="flex flex-col gap-1.5">
            <div className="flex items-center justify-between">
              <label className="flex items-center gap-1 text-xs font-semibold text-hazard-gold">
                <Sparkles className="w-3.5 h-3.5" />
                Positive
              </label>
              <button
                onClick={() => copyToClipboard(lastResolved.positive_prompt, 'pos')}
                className="flex items-center gap-1 text-[11px] text-hazard-textMuted hover:text-hazard-gold transition"
              >
                {copiedType === 'pos' ? <Check className="w-3 h-3" /> : <Copy className="w-3 h-3" />}
              </button>
            </div>
            <div className="p-2 bg-hazard-void rounded border border-hazard-border text-xs font-mono text-hazard-textBright select-all overflow-y-auto max-h-20 whitespace-pre-wrap">
              {lastResolved.positive_prompt || 'No tokens'}
            </div>
            <input
              type="text"
              placeholder="Add custom positive..."
              value={customPositive}
              onChange={(e) => setCustomPositive(e.target.value)}
              className="w-full bg-hazard-void/60 border border-hazard-border px-2 py-1 text-xs text-hazard-textBright rounded outline-none focus:border-hazard-gold"
            />
          </div>

          {/* Negative */}
          <div className="flex flex-col gap-1.5">
            <div className="flex items-center justify-between">
              <label className="flex items-center gap-1 text-xs font-semibold text-hazard-crimson">
                <ShieldAlert className="w-3.5 h-3.5" />
                Negative
              </label>
              <button
                onClick={() => copyToClipboard(lastResolved.negative_prompt, 'neg')}
                className="flex items-center gap-1 text-[11px] text-hazard-textMuted hover:text-hazard-crimson transition"
              >
                {copiedType === 'neg' ? <Check className="w-3 h-3" /> : <Copy className="w-3 h-3" />}
              </button>
            </div>
            <div className="p-2 bg-hazard-void rounded border border-hazard-border text-xs font-mono text-hazard-textMuted select-all overflow-y-auto max-h-20 whitespace-pre-wrap">
              {lastResolved.negative_prompt || 'No negatives'}
            </div>
            <input
              type="text"
              placeholder="Add custom negative..."
              value={customNegative}
              onChange={(e) => setCustomNegative(e.target.value)}
              className="w-full bg-hazard-void/60 border border-hazard-border px-2 py-1 text-xs text-hazard-textBright rounded outline-none focus:border-hazard-crimson"
            />
          </div>
        </div>
      )}
    </div>
  );
};
