          title="Switch to Hair Visual Codex"
          style={{
            display: 'flex',
            alignItems: 'center',
            gap: '0.35rem',
            padding: '0.35rem 0.75rem',
            borderRadius: 'var(--radius-sm)',
            border: '1px solid rgba(244, 63, 94, 0.4)',
            background: 'rgba(244, 63, 94, 0.15)',
            color: '#fb7185',
            cursor: 'pointer',
            fontSize: '12px',
            fontWeight: 600,
          }}
        >
          <Scissors size={13} />
          {!isMobile && <span>Hair</span>}
        </button>

        <button
          onClick={onSwitchToFacet}
