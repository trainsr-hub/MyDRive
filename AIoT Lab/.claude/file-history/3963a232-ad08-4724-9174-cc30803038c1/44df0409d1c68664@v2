import React from 'react';
import {
  FolderTree,
  Trash2,
  Table,
  Zap,
  Sparkles,
  Scissors,
  Layers,
  Moon,
  Sun,
  Database,
  ExternalLink,
} from 'lucide-react';

interface DriveReconcilerHeaderProps {
