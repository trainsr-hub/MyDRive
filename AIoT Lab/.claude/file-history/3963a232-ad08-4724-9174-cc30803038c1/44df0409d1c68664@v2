              display: 'flex',
              alignItems: 'center',
              gap: '0.35rem',
              padding: '0.35rem 0.75rem',
              borderRadius: 'calc(var(--radius-sm) - 2px)',
              border: 'none',
              background: activeTab === 'trash' ? 'var(--danger)' : 'transparent',
              color: activeTab === 'trash' ? '#fff' : 'var(--text-tertiary)',
              fontWeight: activeTab === 'trash' ? 700 : 500,
              cursor: 'pointer',
              fontSize: '12px',
              transition: 'all 0.15s ease',
            }}
          >
            <Trash2 size={13} />
            <span>Trash & DB Purge</span>
            {trashCount > 0 && (
              <span
                style={{
                  fontSize: '10px',
                  padding: '1px 5px',
                  borderRadius: '10px',
                  background: activeTab === 'trash' ? 'rgba(0,0,0,0.3)' : 'var(--danger)',
                  color: '#fff',
                  fontWeight: 700,
