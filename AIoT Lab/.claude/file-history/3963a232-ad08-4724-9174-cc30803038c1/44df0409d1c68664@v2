  setActiveTab: (tab: 'reconciler' | 'trash') => void;
  trashCount: number;
  onSwitchToPk: () => void;
  onSwitchToHazard: () => void;
  onSwitchToPrompt: () => void;
  onSwitchToHair: () => void;
  onSwitchToFacet: () => void;
  theme: 'dark' | 'light';
  onToggleTheme: () => void;
  isMobile?: boolean;
}

export const DriveReconcilerHeader: React.FC<DriveReconcilerHeaderProps> = ({
