@app.get("/api/drive/trash_candidates")
def get_trash_candidates_endpoint():
    """
    Scans neo_drive.db and local plan to find:
    1. Extraneous folders (PRUNE_EMPTY or FLAG_RED)
    2. Orphan folders (child_of points to non-existent folder)
    3. Duplicate folders (same name under same child_of)
    """
    all_f = db.list_all_raw_folders()
    all_ids = {f["drive_id"] for f in all_f}
    root_id = db.get_config("root_id", "14J8QBCqdSQOPerLBIaR2jLyYhZ4WbJUA")
    template_id = db.get_config("template_id", "1qPYOlZ3-LlnfiBRorXUnNa_0yVZcILvM")

    # 1. Orphans
    orphans = []
    for f in all_f:
        if f["child_of"] and f["child_of"] not in all_ids:
            orphans.append({
                "id": f["drive_id"],
                "name": f["name"],
                "parent_id": f["child_of"],
                "parent_name": "Non-existent parent",
                "description": f.get("description", ""),
                "reason": f"Orphan: parent folder '{f['child_of']}' does not exist in database",
                "child_folders_count": f.get("child_folders_count", 0),
                "type": "ORPHAN",
            })

    # 2. Extraneous from Local Master Plan
    extraneous = []
    try:
        plan = local_master.get_local_master_plan()
        for g in plan.get("groups", []):
            for ep in g.get("entity_plans", []):
                for it in ep.get("items", []):
                    if it.get("action_type") in ("PRUNE_EMPTY", "FLAG_RED") and it.get("target_id"):
                        extraneous.append({
                            "id": it["target_id"],
                            "name": it["folder_name"],
                            "parent_id": it.get("target_parent_id"),
                            "parent_name": ep.get("target_root_name"),
                            "relative_path": it.get("relative_path"),
                            "description": it.get("current_desc", ""),
                            "reason": it.get("reason", "Extraneous folder not present in archetype template"),
                            "action_type": it.get("action_type"),
                            "files_count": it.get("files_count", 0),
                            "subfolders_count": it.get("subfolders_count", 0),
                            "type": "EXTRANEOUS",
                        })
    except Exception as e:
        print("Error getting plan extraneous:", e)

    # 3. Duplicates under same parent
    duplicates = []
    seen = {}
    for f in all_f:
        key = (f["child_of"], f["name"].lower())
        if key in seen:
            duplicates.append({
                "id": f["drive_id"],
                "name": f["name"],
                "parent_id": f["child_of"],
                "parent_name": f.get("parent_name"),
                "reason": f"Duplicate folder name '{f['name']}' under parent '{f.get('parent_name') or f['child_of']}'",
                "original_id": seen[key]["drive_id"],
                "type": "DUPLICATE",
            })
        else:
            seen[key] = f

    # Combine unique trash IDs
    combined_map = {}
    for item in extraneous + orphans + duplicates:
        combined_map[item["id"]] = item

    return {
        "success": True,
        "total_count": len(combined_map),
        "trash_items": list(combined_map.values()),
        "extraneous_count": len(extraneous),
        "orphan_count": len(orphans),
        "duplicate_count": len(duplicates),
        "database_total_folders": len(all_f),
    }


@app.post("/api/drive/purge_trash")
def purge_trash_endpoint(req: PurgeTrashRequest):
    """Purges selected or all trash/orphan folders from SQLite with recursive cascade."""
    target_ids = list(req.folder_ids)

    if req.purge_all:
        candidates = get_trash_candidates_endpoint()
        target_ids = [item["id"] for item in candidates["trash_items"]]

    deleted_total = 0
    for fid in target_ids:
        if req.trash_remote:
            try:
                drive_ops.trash_file(fid)
            except Exception:
                pass
        deleted_total += db.delete_folder_tree(fid)

    return {
        "success": True,
        "deleted_count": deleted_total,
        "purged_folder_ids": target_ids,
        "message": f"Successfully purged {deleted_total} folder records from SQLite.",
    }


@app.post("/api/drive/move_folder")
def move_folder_endpoint(req: MoveFolderRequest):
    """Moves an entity or folder to a new group in local SQLite master."""
    if GLOBAL_MOCK_MODE or (req.folder_id and "mock" in req.folder_id):
        res = mock_store.move_folder(req.folder_id, req.new_parent_id)
        return {"success": True, "folder": res, "mock_mode": True}

    fid = drive_ops.extract_folder_id_from_url(req.folder_id) or req.folder_id
    new_pid = drive_ops.extract_folder_id_from_url(req.new_parent_id) or req.new_parent_id
    ok = db.update_folder_fields(fid, child_of=new_pid)
    return {"success": ok, "folder": {"id": fid, "child_of": new_pid}, "master": "local_sqlite"}


@app.post("/api/drive/sync_push")
def sync_push_endpoint():
    """
    Forces Google Drive to be an exact slave mirror of local SQLite master.
    """
    try:
        res = drive_sync_push.push_local_master_to_drive()
        return res
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to mirror to Google Drive: {str(e)}")





