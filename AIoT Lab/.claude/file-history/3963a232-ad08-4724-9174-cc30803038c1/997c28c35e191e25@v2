@app.post("/api/drive/clone_template")
def clone_template(req: CloneTemplateRequest):
    """
    Creates a new custom-named entity clone under parent_id in local SQLite master.
    """
    t0 = time.time()
    pid = drive_ops.extract_folder_id_from_url(req.parent_id) or req.parent_id
    clean_name = req.clone_name.strip()
    if not clean_name:
        raise HTTPException(status_code=400, detail="Folder name cannot be empty")

    if GLOBAL_MOCK_MODE or "mock" in pid:
        res = mock_store.clone_template(
            target_parent_id=req.parent_id,
            clone_name=clean_name,
        )
        res["duration_ms"] = 1.8
        res["mock_mode"] = True
        return res

    # Local SQLite Sovereign Master Creation
    import time as pytime
    new_ent_id = f"ent_{int(pytime.time() * 1000)}"
    template_id = db.get_config("template_id", "1qPYOlZ3-LlnfiBRorXUnNa_0yVZcILvM")

    # 1. Insert entity root in folders table
    db.save_folder(new_ent_id, clean_name, pid, f"src:{template_id}", src_id=template_id)

    # 2. Recursively duplicate template subfolder tree into local SQLite
    created_count = 1
    def _clone_subfolders(src_p_id: str, dest_p_id: str):
        nonlocal created_count
        subs = db.list_children(src_p_id)
        for s in subs:
            c_new_id = f"fld_{int(pytime.time() * 1000)}_{created_count}"
            db.save_folder(
                drive_id=c_new_id,
                name=s["name"],
                child_of=dest_p_id,
                description=s.get("description", ""),
                src_id=s["drive_id"],
            )
            created_count += 1
            _clone_subfolders(s["drive_id"], c_new_id)

    _clone_subfolders(template_id, new_ent_id)
    duration_ms = round((time.time() - t0) * 1000, 1)

    return {
        "success": True,
        "cloned_root_id": new_ent_id,
        "clone_name": clean_name,
        "total_folders_created": created_count,
        "duration_ms": duration_ms or 1.2,
        "master": "local_sqlite",
    }


