import React, { useState } from 'react';
import {
  Folder,
  Trash2,
  ExternalLink,
  ChevronDown,
  CheckCircle2,
  X,
  Plus,
  RefreshCw,
  FolderPlus,
  FileEdit,
  ArrowRight,
} from 'lucide-react';
import { EntityPlan, ActionItem } from '../../types/drive';

interface EntityFolderCardProps {
  entityPlan: EntityPlan;
  onFixEntity: (entityPlan: EntityPlan) => void;
  isExecuting: boolean;
  isFullWidth?: boolean;
  viewMode?: 'all' | 'conflict' | 'perfected';
  onTrashFolder?: (folderId: string) => Promise<void>;
}

interface TreeNode {
  id: string;
  item: ActionItem;
  path: string;
  name: string;
  children: TreeNode[];
}

function buildEntityTree(items: ActionItem[], viewMode: 'all' | 'conflict' | 'perfected' = 'all'): TreeNode[] {
  let subItems = items.filter((i) => {
    const parts = i.relative_path.split('/').filter(Boolean);
    return parts.length > 2;
  });

  if (viewMode === 'conflict') {
    const conflictPaths = new Set(
      subItems.filter((i) => i.action_type !== 'MATCH').map((i) => i.relative_path)
    );
    subItems = subItems.filter((i) => {
      if (i.action_type !== 'MATCH') return true;
      return Array.from(conflictPaths).some((cp) => cp.startsWith(i.relative_path + '/'));
    });
  } else if (viewMode === 'perfected') {
    subItems = subItems.filter((i) => i.action_type === 'MATCH');
  }

  const nodeMapById = new Map<string, TreeNode>();
  const nodeMapByPath = new Map<string, TreeNode>();
  const rootNodes: TreeNode[] = [];

  const sorted = [...subItems].sort(
    (a, b) => a.relative_path.split('/').length - b.relative_path.split('/').length
  );

  for (let idx = 0; idx < sorted.length; idx++) {
    const item = sorted[idx];
    const parts = item.relative_path.split('/').filter(Boolean);
    const uniqueId = item.target_id || `${item.relative_path}#${item.action_type}#${idx}`;
    const node: TreeNode = {
      id: uniqueId,
      item,
      path: item.relative_path,
      name: item.folder_name,
      children: [],
    };

    if (item.target_id) {
      nodeMapById.set(item.target_id, node);
    }
    nodeMapByPath.set(item.relative_path, node);

    let parentNode: TreeNode | undefined;
    if (item.target_parent_id && nodeMapById.has(item.target_parent_id)) {
      parentNode = nodeMapById.get(item.target_parent_id);
    } else {
      const parentPath = parts.slice(0, -1).join('/');
      parentNode = nodeMapByPath.get(parentPath);
    }

    if (parentNode) {
      parentNode.children.push(node);
    } else {
      rootNodes.push(node);
    }
  }

  return rootNodes;
}

export const EntityFolderCard: React.FC<EntityFolderCardProps> = ({
  entityPlan,
  onFixEntity,
  isExecuting,
  isFullWidth = false,
  viewMode = 'all',
  onTrashFolder,
}) => {
  const [selectedIdsByLevel, setSelectedIdsByLevel] = useState<Record<number, string | null>>({});

  const tree = buildEntityTree(entityPlan.items, viewMode);
  const mismatches = entityPlan.items.filter((i) => i.action_type !== 'MATCH');
  const hasMismatches = mismatches.length > 0;

  const handleFolderClick = (level: number, node: TreeNode) => {
    setSelectedIdsByLevel((prev) => {
      if (prev[level] === node.id) {
        const next = { ...prev };
        delete next[level];
        Object.keys(next).forEach((k) => {
          if (Number(k) >= level) delete next[Number(k)];
        });
        return next;
      }
      const next = { ...prev, [level]: node.id };
      Object.keys(next).forEach((k) => {
        if (Number(k) > level) delete next[Number(k)];
      });
      return next;
    });
  };

  const getStatusBadge = (item: ActionItem) => {
    switch (item.action_type) {
      case 'RENAME':
        return (
          <span style={{ fontSize: '10px', padding: '1px 6px', background: 'rgba(192, 132, 252, 0.15)', color: '#c084fc', borderRadius: '4px' }}>
            <FileEdit size={10} style={{ display: 'inline', marginRight: '2px' }} /> Rename
          </span>
        );
      case 'CREATE':
        return (
          <span style={{ fontSize: '10px', padding: '1px 6px', background: 'var(--success-bg)', color: 'var(--success)', borderRadius: '4px' }}>
            <FolderPlus size={10} style={{ display: 'inline', marginRight: '2px' }} /> Missing
          </span>
        );
      case 'UPDATE_DESC':
        return (
          <span style={{ fontSize: '10px', padding: '1px 6px', background: 'var(--warning-bg)', color: 'var(--warning)', borderRadius: '4px' }}>
            <RefreshCw size={10} style={{ display: 'inline', marginRight: '2px' }} /> Metadata
          </span>
        );
      case 'PRUNE_EMPTY':
        return (
          <span style={{ fontSize: '10px', padding: '1px 6px', background: 'rgba(244, 63, 94, 0.15)', color: 'var(--danger)', borderRadius: '4px', fontWeight: 700 }}>
            <Trash2 size={10} style={{ display: 'inline', marginRight: '2px' }} /> Trash Candidate
          </span>
        );
      case 'MATCH':
      default:
        return (
          <span style={{ fontSize: '10.5px', color: 'var(--success)', display: 'inline-flex', alignItems: 'center', gap: '0.2rem' }}>
            <CheckCircle2 size={11} /> In sync
          </span>
        );
    }
  };

  const renderFolderGrid = (nodes: TreeNode[], level = 0) => {
    const activeId = selectedIdsByLevel[level];
    const activeNode = nodes.find((n) => n.id === activeId);

    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: '0.75rem' }}>
        <div
          style={{
            display: 'grid',
            gridTemplateColumns: isFullWidth ? 'repeat(auto-fill, minmax(260px, 1fr))' : 'repeat(auto-fill, minmax(210px, 1fr))',
            gap: isFullWidth ? '0.85rem' : '0.65rem',
          }}
        >
          {nodes.map((node) => {
            const hasChildren = node.children.length > 0;
            const isSelected = activeId === node.id;
            const isMismatch = node.item.action_type !== 'MATCH';

            return (
              <div
                key={node.id}
                onClick={() => handleFolderClick(level, node)}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  padding: isFullWidth ? '0.85rem 1.1rem' : '0.65rem 0.85rem',
                  borderRadius: 'var(--radius-md)',
                  background: isSelected
                    ? 'var(--bg-canvas)'
                    : isMismatch
                    ? node.item.action_type === 'PRUNE_EMPTY' || node.item.action_type === 'FLAG_RED'
                      ? 'rgba(244, 63, 94, 0.08)'
                      : 'var(--bg-card-hover)'
                    : 'var(--bg-card)',
                  border: isSelected
                    ? '2px solid var(--accent)'
                    : isMismatch
                    ? node.item.action_type === 'PRUNE_EMPTY'
                      ? '1px dashed var(--danger)'
                      : '1px solid rgba(245, 158, 11, 0.4)'
                    : '1px solid var(--border-light)',
                  boxShadow: isSelected ? '0 0 12px var(--accent-glow)' : 'none',
                  cursor: 'pointer',
                  transition: 'all 0.15s ease',
                  userSelect: 'none',
                }}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: '0.65rem', overflow: 'hidden', flex: 1 }}>
                  <Folder
                    size={isFullWidth ? 22 : 18}
                    style={{
                      color:
                        node.item.action_type === 'PRUNE_EMPTY'
                          ? 'var(--danger)'
                          : isMismatch
                          ? 'var(--warning)'
                          : 'var(--accent)',
                      flexShrink: 0,
                    }}
                  />

                  <div style={{ display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>
                    <span
                      style={{
                        fontSize: '12.5px',
                        fontWeight: isMismatch ? 700 : 600,
                        color: isMismatch ? 'var(--text-primary)' : 'var(--text-secondary)',
                        whiteSpace: 'nowrap',
                        overflow: 'hidden',
                        textOverflow: 'ellipsis',
                      }}
                    >
                      {node.item.folder_name}
                    </span>

                    <div style={{ display: 'flex', alignItems: 'center', gap: '0.35rem', marginTop: '2px' }}>
                      {getStatusBadge(node.item)}
                      {hasChildren && (
                        <span style={{ fontSize: '10px', color: 'var(--text-dim)' }}>
                          • {node.children.length} subfolder{node.children.length > 1 ? 's' : ''}
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                <div style={{ display: 'flex', alignItems: 'center', gap: '0.35rem', flexShrink: 0 }} onClick={(e) => e.stopPropagation()}>
                  {node.item.action_type === 'PRUNE_EMPTY' && node.item.target_id && (
                    <button
                      onClick={() => onTrashFolder?.(node.item.target_id!)}
                      style={{
                        padding: '3px 6px',
                        color: '#fff',
                        background: 'var(--danger)',
                        border: 'none',
                        borderRadius: '4px',
                        cursor: 'pointer',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '3px',
                        fontSize: '10px',
                        fontWeight: 700,
                      }}
                      title="Permanently remove trash folder from local SQLite"
                    >
                      <Trash2 size={11} /> Delete
                    </button>
                  )}

                  {node.item.target_id && (
                    <a
                      href={`https://drive.google.com/drive/folders/${node.item.target_id}`}
                      target="_blank"
                      rel="noreferrer"
                      style={{ color: 'var(--text-dim)', padding: '2px' }}
                      title="Open in Google Drive"
                    >
                      <ExternalLink size={12} />
                    </a>
                  )}

                  {hasChildren && (
                    <ChevronDown
                      size={13}
                      style={{
                        color: isSelected ? 'var(--accent)' : 'var(--text-dim)',
                        transform: isSelected ? 'rotate(180deg)' : 'rotate(0deg)',
                        transition: 'transform 0.15s ease',
                      }}
                    />
                  )}
                </div>
              </div>
            );
          })}
        </div>

        {activeNode && activeNode.children.length > 0 && (
          <div
            style={{
              padding: '0.85rem 1rem',
              borderRadius: 'var(--radius-md)',
              background: 'var(--bg-canvas)',
              border: '1px solid var(--border-mid)',
              display: 'flex',
              flexDirection: 'column',
              gap: '0.65rem',
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
              <div style={{ fontSize: '11.5px', fontWeight: 700, color: 'var(--text-secondary)', display: 'flex', alignItems: 'center', gap: '0.4rem' }}>
                <Folder size={14} style={{ color: 'var(--accent)' }} />
                <span>Subfolders inside "{activeNode.name}":</span>
              </div>
              <button
                onClick={() => handleFolderClick(level, activeNode)}
                style={{ background: 'none', border: 'none', color: 'var(--text-dim)', cursor: 'pointer', padding: '2px' }}
              >
                <X size={12} />
              </button>
            </div>
            {renderFolderGrid(activeNode.children, level + 1)}
          </div>
        )}
      </div>
    );
  };

  return (
    <div
      style={{
        padding: '0',
        overflow: 'hidden',
        display: 'flex',
        flexDirection: 'column',
        borderRadius: 'var(--radius-md)',
        border: hasMismatches ? '1px solid rgba(245, 158, 11, 0.4)' : '1px solid var(--border-light)',
        background: 'var(--bg-card)',
      }}
    >
      <div
        style={{
          padding: '0.85rem 1.15rem',
          borderBottom: '1px solid var(--border-light)',
          background: 'var(--bg-card-hover)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          gap: '0.5rem',
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
          <Folder size={18} style={{ color: hasMismatches ? 'var(--warning)' : 'var(--success)' }} />
          <span style={{ fontWeight: 700, fontSize: '15px', color: 'var(--text-primary)' }}>
            {entityPlan.target_root_name}
          </span>
          <a
            href={`https://drive.google.com/drive/folders/${entityPlan.target_root_id}`}
            target="_blank"
            rel="noreferrer"
            style={{ color: 'var(--text-dim)', padding: '2px' }}
            title="Open folder in Google Drive"
          >
            <ExternalLink size={13} />
          </a>
        </div>

        {hasMismatches ? (
          <button
            onClick={() => onFixEntity(entityPlan)}
            disabled={isExecuting}
            style={{
              padding: '0.35rem 0.85rem',
              fontSize: '11.5px',
              fontWeight: 700,
              background: 'var(--warning)',
              color: '#000',
              border: 'none',
              borderRadius: 'var(--radius-sm)',
              cursor: 'pointer',
            }}
          >
            Fix ({mismatches.length})
          </button>
        ) : (
          <div style={{ fontSize: '11.5px', color: 'var(--success)', display: 'flex', alignItems: 'center', gap: '0.25rem', fontWeight: 700 }}>
            <CheckCircle2 size={13} /> In Sync
          </div>
        )}
      </div>

      <div style={{ padding: '0.85rem 1.15rem' }}>
        {tree.length === 0 ? (
          <div style={{ padding: '1rem', textAlign: 'center', color: 'var(--text-dim)', fontSize: '12px' }}>
            No subfolders
          </div>
        ) : (
          renderFolderGrid(tree, 0)
        )}
      </div>
    </div>
  );
};
