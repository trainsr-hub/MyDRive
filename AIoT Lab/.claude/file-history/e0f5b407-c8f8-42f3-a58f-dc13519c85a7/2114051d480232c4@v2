/**
 * Project Entry: Field Editor Sidebar Component
 * Comprehensive Column Configuration, Formula Selector & Inspector
 */
import { state, FIELD_TYPES, escHtml, showToast } from '../state.js';

let onColumnUpdated = null;
let onColumnDeleted = null;

export function initSidebar(columnUpdatedCallback, columnDeletedCallback) {
  onColumnUpdated = columnUpdatedCallback;
  onColumnDeleted = columnDeletedCallback;

  // Bind close and navigate buttons
  const btnClose = document.getElementById('btn-close-sidebar');
  if (btnClose) btnClose.onclick = () => closeSidebar();

  const btnPrev = document.getElementById('btn-prev-col');
  if (btnPrev) btnPrev.onclick = () => navigateSidebar(-1);

  const btnNext = document.getElementById('btn-next-col');
  if (btnNext) btnNext.onclick = () => navigateSidebar(1);

  // Bind sidebar tabs
  document.querySelectorAll('.stab-btn[data-tab]').forEach(btn => {
    btn.onclick = () => switchSidebarTab(btn.getAttribute('data-tab'), btn);
  });

  // Bind delete button
  const btnDelete = document.getElementById('btn-delete-col');
  if (btnDelete) btnDelete.onclick = () => deleteActiveColumn();
}

export function openSidebar(idx) {
  if (idx !== undefined) state.activeColIdx = idx;
  const sidebar = document.getElementById('field-sidebar');
  if (sidebar) sidebar.classList.add('open');
  document.body.classList.add('sidebar-open');
  populateSidebar();
}

export function closeSidebar() {
  const sidebar = document.getElementById('field-sidebar');
  if (sidebar) sidebar.classList.remove('open');
  document.body.classList.remove('sidebar-open');
  document.querySelectorAll('#table-body tr').forEach(r => r.classList.remove('selected'));
  state.activeColIdx = null;
}

export function navigateSidebar(dir) {
  if (state.activeColIdx === null) return;
  const t = state.tables[state.activeTable];
  if (!t) return;
  const next = state.activeColIdx + dir;
  if (next < 0 || next >= t.columns.length) return;
  state.activeColIdx = next;

  document.querySelectorAll('#table-body tr').forEach(r => r.classList.remove('selected'));
  const row = document.querySelector(`#table-body tr[data-idx="${next}"]`);
  if (row) row.classList.add('selected');

  populateSidebar();
}

export function populateSidebar() {
  if (state.activeColIdx === null) return;
  const t = state.tables[state.activeTable];
  if (!t) return;
  const col = t.columns[state.activeColIdx];
  if (!col) return;
  const ft = FIELD_TYPES[col.type] || {};

  // Header labels
  const colNumEl = document.getElementById('sb-col-num');
  const colIconEl = document.getElementById('sb-col-icon');
  const colTitleEl = document.getElementById('sb-col-title');
  if (colNumEl) colNumEl.textContent = `#${state.activeColIdx + 1} of ${t.columns.length}`;
  if (colIconEl) colIconEl.textContent = ft.icon || '';
  if (colTitleEl) colTitleEl.textContent = col.name;

  // Name & Slug
  const nameInput = document.getElementById('sb-name');
  const slugInput = document.getElementById('sb-slug');
  if (nameInput) {
    nameInput.value = col.name;
    nameInput.oninput = (e) => updateName(e.target.value);
  }
  if (slugInput) {
    slugInput.value = col.slug || '';
    slugInput.oninput = (e) => updateSlug(e.target.value);
  }

  // Type select
  const sel = document.getElementById('sb-type');
  if (sel) {
    sel.innerHTML = Object.entries(FIELD_TYPES).map(([slug, info]) =>
      `<option value="${slug}" ${col.type === slug ? 'selected' : ''}>${info.icon} ${info.title}</option>`
    ).join('');
    sel.onchange = (e) => updateType(e.target.value);
  }

  // Render ALWAYS-VISIBLE column configuration card
  renderSidebarMeta(col);

  // Update Code views
  populateSidebarCode();
}

/**
 * ALWAYS VISIBLE CONFIGURATION CARDS
 * Nothing is hidden, even if previously unconfigured
 */
export function renderSidebarMeta(col) {
  const meta = col.metadata || {};
  const container = document.getElementById('sb-meta');
  if (!container) return;

  const t = state.tables[state.activeTable];
  const currentSlug = col.slug || 'col';

  // 1. INTEGER (int_scalar)
  if (col.type === 'int_scalar') {
    const defaultOption = (meta.default_option || '').trim();
    const candidateCols = t ? t.columns.filter(c => c.slug !== col.slug && (c.type === 'int_scalar' || c.type === 'hex_id')) : [];

    let currentPreset = 'custom';
    if (!defaultOption) currentPreset = 'none';
    else if (defaultOption === 'literal:0') currentPreset = 'zero';
    else if (defaultOption.startsWith('literal:')) currentPreset = 'literal';
    else if (defaultOption.toLowerCase() === 'count(*)') currentPreset = 'count';
    else if (defaultOption.toLowerCase().startsWith('max(')) currentPreset = 'max';

    let maxCol = currentSlug;
    let maxStep = 1;
    const maxMatch = defaultOption.match(/max\((\w+)\)(?:\s*\+\s*(\d+))?/i);
    if (maxMatch) {
      maxCol = maxMatch[1] || currentSlug;
      if (maxMatch[2]) maxStep = parseInt(maxMatch[2], 10);
    }

    container.innerHTML = `
      <div class="sidebar-section-card">
        <div class="section-card-header">
          <span>🔢 INTEGER PROPERTIES & FORMULA</span>
          <span style="font-size:10px;color:var(--text-dim);text-transform:none;">default option</span>
        </div>

        <div class="field-group">
          <label class="field-label">Formula Preset Selector</label>
          <select id="sb-formula-preset">
            <option value="none" ${currentPreset === 'none' ? 'selected' : ''}>-- None (Manual Input / Null) --</option>
            <option value="max" ${currentPreset === 'max' ? 'selected' : ''}>⚡ Auto-Increment: max(col) + N</option>
            <option value="count" ${currentPreset === 'count' ? 'selected' : ''}>🔢 Row Count: count(*)</option>
            <option value="zero" ${currentPreset === 'zero' ? 'selected' : ''}>0️⃣ Static Zero (literal:0)</option>
            <option value="literal" ${currentPreset === 'literal' ? 'selected' : ''}>📌 Fixed Value (literal:N)</option>
            <option value="custom" ${currentPreset === 'custom' ? 'selected' : ''}>🛠️ Custom Formula Expression</option>
          </select>
        </div>

        <!-- Formula Builder Widget (ALWAYS VISIBLE) -->
        <div class="field-group" style="background:var(--bg-input);padding:0.75rem;border-radius:var(--radius-sm);border:1px solid var(--border-light);gap:0.4rem;">
          <label class="field-label" style="font-size:10px;color:var(--accent);">Formula Builder</label>
          <div style="display:flex;gap:0.4rem;align-items:center;">
            <span style="font:600 12px var(--font-mono);color:var(--text-tertiary);">max(</span>
            <select id="sb-max-col" style="flex:1;height:32px;font-size:12px;">
              <option value="${escHtml(currentSlug)}" ${maxCol === currentSlug ? 'selected' : ''}>${escHtml(currentSlug)} (this column)</option>
              ${candidateCols.map(c => `<option value="${escHtml(c.slug)}" ${maxCol === c.slug ? 'selected' : ''}>${escHtml(c.slug)} (${escHtml(c.name)})</option>`).join('')}
            </select>
            <span style="font:600 12px var(--font-mono);color:var(--text-tertiary);">) +</span>
            <input type="number" id="sb-max-step" value="${maxStep}" style="width:55px;height:32px;font-size:12px;text-align:center;">
          </div>
        </div>

        <!-- Raw Formula Expression (ALWAYS VISIBLE) -->
        <div class="field-group">
          <label class="field-label">Active Formula Expression <span class="field-hint">(default_option)</span></label>
          <input type="text" id="sb-formula-raw"
            style="font-family:var(--font-mono);font-size:13px;color:var(--accent);font-weight:600;"
            placeholder="e.g. max(${escHtml(currentSlug)}) + 1"
            value="${escHtml(defaultOption)}">
        </div>

        <!-- Quick 1-Click Action Chips (ALWAYS VISIBLE) -->
        <div class="field-group">
          <label class="field-label" style="font-size:10px;">Quick Presets</label>
          <div style="display:flex;gap:0.35rem;flex-wrap:wrap;">
            <button class="add-chip" id="chip-formula-max">max(${escHtml(currentSlug)}) + 1</button>
            <button class="add-chip" id="chip-formula-count">count(*)</button>
            <button class="add-chip" id="chip-formula-zero">literal:0</button>
            <button class="add-chip" id="chip-formula-clear" style="color:var(--danger);">✕ Clear</button>
          </div>
        </div>
      </div>
    `;

    // Attach Formula Event Listeners
    const presetSel = document.getElementById('sb-formula-preset');
    if (presetSel) {
      presetSel.onchange = (e) => handleFormulaPresetChange(e.target.value, currentSlug);
    }

    const colSelect = document.getElementById('sb-max-col');
    const stepInput = document.getElementById('sb-max-step');
    const updateFromBuilder = () => {
      const target = colSelect ? colSelect.value : currentSlug;
      const step = stepInput ? (parseInt(stepInput.value, 10) || 1) : 1;
      applyFormula(`max(${target}) + ${step}`);
    };
    if (colSelect) colSelect.onchange = updateFromBuilder;
    if (stepInput) stepInput.oninput = updateFromBuilder;

    const rawInput = document.getElementById('sb-formula-raw');
    if (rawInput) {
      rawInput.oninput = (e) => {
        applyFormula(e.target.value, false);
      };
    }

    const chipMax = document.getElementById('chip-formula-max');
    if (chipMax) chipMax.onclick = () => applyFormula(`max(${currentSlug}) + 1`);
    const chipCount = document.getElementById('chip-formula-count');
    if (chipCount) chipCount.onclick = () => applyFormula('count(*)');
    const chipZero = document.getElementById('chip-formula-zero');
    if (chipZero) chipZero.onclick = () => applyFormula('literal:0');
    const chipClear = document.getElementById('chip-formula-clear');
    if (chipClear) chipClear.onclick = () => applyFormula('');
    return;
  }

  // 2. FLOAT (float_scalar)
  if (col.type === 'float_scalar') {
    const defaultVal = meta.default_value !== undefined ? meta.default_value : '';
    container.innerHTML = `
      <div class="sidebar-section-card">
        <div class="section-card-header">
          <span>🔢 FLOAT PROPERTIES</span>
          <span style="font-size:10px;color:var(--text-dim);text-transform:none;">scalar decimal</span>
        </div>
        <div class="field-group">
          <label class="field-label">Default Value</label>
          <input type="number" step="any" placeholder="e.g. 0.0" value="${escHtml(defaultVal)}" id="sb-float-default">
        </div>
        <div class="field-group">
          <label class="field-label">Step / Precision Hint</label>
          <input type="text" placeholder="e.g. 0.01 or any" value="${escHtml(meta.step || 'any')}" id="sb-float-step">
        </div>
      </div>
    `;
    const fDef = document.getElementById('sb-float-default');
    if (fDef) fDef.oninput = (e) => updateMeta('default_value', e.target.value ? parseFloat(e.target.value) : null);
    const fStep = document.getElementById('sb-float-step');
    if (fStep) fStep.oninput = (e) => updateMeta('step', e.target.value);
    return;
  }

  // 3. HEX ID (hex_id)
  if (col.type === 'hex_id') {
    const prefix = meta.prefix || (state.activeTable.substring(0, 4).toUpperCase());
    container.innerHTML = `
      <div class="sidebar-section-card">
        <div class="section-card-header">
          <span>🔑 PRIMARY KEY CONFIG</span>
          <span style="font-size:10px;color:var(--c-pk);text-transform:none;">hex_id</span>
        </div>
        <div class="field-group">
          <label class="field-label">ID Prefix <span class="field-hint">(up to 4 chars)</span></label>
          <input type="text" maxlength="4" style="text-transform:uppercase;font-family:var(--font-mono);"
            placeholder="e.g. USER, CONT" value="${escHtml(prefix)}" id="sb-prefix-input">
        </div>
        <div class="field-hint" style="font-family:var(--font-mono);font-size:11.5px;color:var(--c-pk);background:rgba(56,189,248,0.08);padding:0.4rem 0.6rem;border-radius:4px;">
          Preview: ${escHtml(prefix)}_a1b2c3d4
        </div>
      </div>
    `;
    const pInput = document.getElementById('sb-prefix-input');
    if (pInput) pInput.oninput = (e) => updateMeta('prefix', e.target.value.toUpperCase());
    return;
  }

  // 4. ENUM (enum_single & enum_multi)
  if (col.type.startsWith('enum_')) {
    const options = Array.isArray(meta.options) ? meta.options : [];
    const defaultOpt = meta.default_option || '';
    container.innerHTML = `
      <div class="sidebar-section-card">
        <div class="section-card-header">
          <span>🏷️ ENUM CONFIGURATION</span>
          <span style="font-size:10px;color:var(--c-enum);text-transform:none;">${col.type}</span>
        </div>
        <div class="field-group">
          <label class="field-label">Defined Options (${options.length})</label>
          <div class="options-list" id="sb-options-list">
            ${options.map((opt, i) => `
              <span class="option-pill">
                ${escHtml(opt)}
                <button data-opt-idx="${i}" title="Remove">✕</button>
              </span>
            `).join('')}
            ${options.length === 0 ? '<span style="font-size:12px;color:var(--text-dim);font-style:italic;">No options defined yet</span>' : ''}
          </div>
          <div style="display:flex;gap:0.4rem;margin-top:0.4rem;">
            <input type="text" id="sb-new-option-input" placeholder="Type new option...">
            <button class="btn sm" id="btn-add-option">+ Add</button>
          </div>
        </div>
        <div class="field-group">
          <label class="field-label">Default Option</label>
          <select id="sb-enum-default">
            <option value="" ${!defaultOpt ? 'selected' : ''}>-- No Default --</option>
            ${options.map(opt => `<option value="${escHtml(opt)}" ${defaultOpt === opt ? 'selected' : ''}>${escHtml(opt)}</option>`).join('')}
          </select>
        </div>
      </div>
    `;

    container.querySelectorAll('button[data-opt-idx]').forEach(btn => {
      btn.onclick = () => removeOption(parseInt(btn.getAttribute('data-opt-idx'), 10));
    });

    const optInput = document.getElementById('sb-new-option-input');
    const optAddBtn = document.getElementById('btn-add-option');
    const doAdd = () => {
      if (optInput && optInput.value.trim()) {
        addOption(optInput.value.trim());
        optInput.value = '';
      }
    };
    if (optAddBtn) optAddBtn.onclick = doAdd;
    if (optInput) optInput.onkeydown = (e) => { if (e.key === 'Enter') doAdd(); };

    const defSel = document.getElementById('sb-enum-default');
    if (defSel) defSel.onchange = (e) => updateMeta('default_option', e.target.value);
    return;
  }

  // 5. RELATION (relation_single & relation_multi)
  if (col.type.startsWith('relation_')) {
    const target = meta.target || 'self';
    container.innerHTML = `
      <div class="sidebar-section-card">
        <div class="section-card-header">
          <span>🔗 RELATION CONFIGURATION</span>
          <span style="font-size:10px;color:var(--c-rel);text-transform:none;">foreign key</span>
        </div>
        <div class="field-group">
          <label class="field-label">Target Table</label>
          <select id="sb-target-table">
            <option value="self" ${target === 'self' ? 'selected' : ''}>Self (${state.activeTable} tree)</option>
            ${Object.keys(state.tables).map(tname => `
              <option value="${tname}" ${target === tname ? 'selected' : ''}>📁 ${tname}</option>
            `).join('')}
          </select>
        </div>
        <div class="field-hint" style="font-size:11.5px;color:var(--text-dim);">
          References primary keys from <strong>${escHtml(target === 'self' ? state.activeTable : target)}</strong>.
        </div>
      </div>
    `;
    const targetSel = document.getElementById('sb-target-table');
    if (targetSel) targetSel.onchange = (e) => updateMeta('target', e.target.value);
    return;
  }

  // 6. BOOLEAN (boolean)
  if (col.type === 'boolean') {
    const defBool = meta.default_value !== undefined ? meta.default_value : 0;
    container.innerHTML = `
      <div class="sidebar-section-card">
        <div class="section-card-header">
          <span>🔘 BOOLEAN CONFIGURATION</span>
          <span style="font-size:10px;color:var(--c-boolean);text-transform:none;">true / false</span>
        </div>
        <div class="field-group">
          <label class="field-label">Default Value</label>
          <select id="sb-bool-default">
            <option value="0" ${defBool === 0 ? 'selected' : ''}>False (0 / Unchecked)</option>
            <option value="1" ${defBool === 1 ? 'selected' : ''}>True (1 / Checked)</option>
          </select>
        </div>
      </div>
    `;
    const bSel = document.getElementById('sb-bool-default');
    if (bSel) bSel.onchange = (e) => updateMeta('default_value', parseInt(e.target.value, 10));
    return;
  }

  // 7. TEXT (text_single & text_multi)
  const defText = meta.default_value || '';
  const placeholder = meta.placeholder || '';
  container.innerHTML = `
    <div class="sidebar-section-card">
      <div class="section-card-header">
        <span>📝 TEXT CONFIGURATION</span>
        <span style="font-size:10px;color:var(--c-text);text-transform:none;">${col.type}</span>
      </div>
      <div class="field-group">
        <label class="field-label">Default Text <span class="field-hint">(optional)</span></label>
        <input type="text" placeholder="Empty by default" value="${escHtml(defText)}" id="sb-text-default">
      </div>
      <div class="field-group">
        <label class="field-label">Input Placeholder</label>
        <input type="text" placeholder="e.g. Enter description..." value="${escHtml(placeholder)}" id="sb-text-placeholder">
      </div>
    </div>
  `;
  const tDef = document.getElementById('sb-text-default');
  if (tDef) tDef.oninput = (e) => updateMeta('default_value', e.target.value);
  const tPlace = document.getElementById('sb-text-placeholder');
  if (tPlace) tPlace.oninput = (e) => updateMeta('placeholder', e.target.value);
}

function handleFormulaPresetChange(preset, currentSlug) {
  if (preset === 'none') {
    applyFormula('');
  } else if (preset === 'max') {
    const colSelect = document.getElementById('sb-max-col');
    const stepInput = document.getElementById('sb-max-step');
    const target = (colSelect && colSelect.value) ? colSelect.value : currentSlug;
    const step = (stepInput && stepInput.value) ? parseInt(stepInput.value, 10) : 1;
    applyFormula(`max(${target}) + ${step}`);
  } else if (preset === 'count') {
    applyFormula('count(*)');
  } else if (preset === 'zero') {
    applyFormula('literal:0');
  } else if (preset === 'literal') {
    applyFormula('literal:1');
  }
}

function applyFormula(formula, updateRawInput = true) {
  updateMeta('default_option', formula);
  if (updateRawInput) {
    const rawInput = document.getElementById('sb-formula-raw');
    if (rawInput) rawInput.value = formula;
  }

  const presetSel = document.getElementById('sb-formula-preset');
  if (presetSel) {
    const f = (formula || '').trim();
    if (!f) presetSel.value = 'none';
    else if (f === 'literal:0') presetSel.value = 'zero';
    else if (f.startsWith('literal:')) presetSel.value = 'literal';
    else if (f.toLowerCase() === 'count(*)') presetSel.value = 'count';
    else if (f.toLowerCase().startsWith('max(')) presetSel.value = 'max';
    else presetSel.value = 'custom';
  }
}

function updateName(val) {
  if (state.activeColIdx === null) return;
  state.tables[state.activeTable].columns[state.activeColIdx].name = val;
  const colTitleEl = document.getElementById('sb-col-title');
  if (colTitleEl) colTitleEl.textContent = val;
  if (onColumnUpdated) onColumnUpdated(state.activeColIdx);
  populateSidebarCode();
}

function updateSlug(val) {
  if (state.activeColIdx === null) return;
  state.tables[state.activeTable].columns[state.activeColIdx].slug = val;
  if (onColumnUpdated) onColumnUpdated(state.activeColIdx);
  populateSidebarCode();
}

function updateType(val) {
  if (state.activeColIdx === null) return;
  const col = state.tables[state.activeTable].columns[state.activeColIdx];
  col.type = val;
  col.metadata = {};
  if (val.startsWith('enum_'))     col.metadata.options = ['option1'];
  if (val.startsWith('relation_')) col.metadata.target  = 'self';
  if (val === 'hex_id')            col.metadata.prefix  = state.activeTable.substring(0, 4).toUpperCase();
  if (val === 'int_scalar')        col.metadata.default_option = `max(${col.slug || 'idx'}) + 1`;
  populateSidebar();
  if (onColumnUpdated) onColumnUpdated(state.activeColIdx);
  populateSidebarCode();
}

function updateMeta(key, val) {
  if (state.activeColIdx === null) return;
  if (!state.tables[state.activeTable].columns[state.activeColIdx].metadata) {
    state.tables[state.activeTable].columns[state.activeColIdx].metadata = {};
  }
  state.tables[state.activeTable].columns[state.activeColIdx].metadata[key] = val;
  if (onColumnUpdated) onColumnUpdated(state.activeColIdx);
  populateSidebarCode();
}

function addOption(val) {
  if (!val || state.activeColIdx === null) return;
  const col = state.tables[state.activeTable].columns[state.activeColIdx];
  if (!col.metadata) col.metadata = {};
  if (!Array.isArray(col.metadata.options)) col.metadata.options = [];
  if (!col.metadata.options.includes(val)) {
    col.metadata.options.push(val);
  }
  renderSidebarMeta(col);
  if (onColumnUpdated) onColumnUpdated(state.activeColIdx);
  populateSidebarCode();
}

function removeOption(idx) {
  if (state.activeColIdx === null) return;
  const col = state.tables[state.activeTable].columns[state.activeColIdx];
  if (col.metadata && Array.isArray(col.metadata.options)) {
    col.metadata.options.splice(idx, 1);
    renderSidebarMeta(col);
    if (onColumnUpdated) onColumnUpdated(state.activeColIdx);
    populateSidebarCode();
  }
}

function deleteActiveColumn() {
  if (state.activeColIdx === null) return;
  const name = state.tables[state.activeTable].columns[state.activeColIdx].name;
  state.tables[state.activeTable].columns.splice(state.activeColIdx, 1);
  closeSidebar();
  if (onColumnDeleted) onColumnDeleted(name);
  showToast(`Deleted "${name}"`);
}

export function switchSidebarTab(tab, btn) {
  state.activeSidebarTab = tab;
  document.querySelectorAll('.stab-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  document.querySelectorAll('.sidebar-panel').forEach(p => p.classList.remove('active'));
  const panel = document.getElementById(`sp-${tab}`);
  if (panel) panel.classList.add('active');
  if (tab === 'sql' || tab === 'json') populateSidebarCode();
}

export function populateSidebarCode() {
  const t = state.tables[state.activeTable];
  if (!t) return;
  const sqlTitle = document.getElementById('sql-title');
  const jsonTitle = document.getElementById('json-title');
  const sqlCode = document.getElementById('sql-code');
  const jsonCode = document.getElementById('json-code');

  if (sqlTitle) sqlTitle.textContent = `${t.table_name}.sql`;
  if (jsonTitle) jsonTitle.textContent = `${t.table_name}.json`;
  if (sqlCode) sqlCode.textContent = generateSQL(t);
  if (jsonCode) jsonCode.textContent = JSON.stringify(t, null, 2);
}

export function generateSQL(table) {
  if (!table) return '-- No table';
  const lines = [`CREATE TABLE IF NOT EXISTS ${table.table_name} (`];
  const cols = table.columns.map(col => {
    const ft = FIELD_TYPES[col.type] || { sql: 'TEXT' };
    return `    ${(col.slug || col.name).padEnd(22)} ${ft.sql}`;
  });
  lines.push(cols.join(',\n'));
  lines.push(');');
  return lines.join('\n');
}
