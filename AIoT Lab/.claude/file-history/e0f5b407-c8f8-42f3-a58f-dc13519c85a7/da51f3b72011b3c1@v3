<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Project Entry — Schema & Table Template Architect</title>

  <!-- Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">

  <!-- Modular Component Styles -->
  <link rel="stylesheet" href="css/tokens.css">
  <link rel="stylesheet" href="css/layout.css">
  <link rel="stylesheet" href="css/table.css">
  <link rel="stylesheet" href="css/sidebar.css">
  <link rel="stylesheet" href="css/data-grid.css">
</head>

<body>
<div class="app-shell">

  <!-- ======= HEADER ======= -->
  <header class="app-header">
    <div class="app-title">
      <span>Project</span>
      <span class="badge">Entry</span>
    </div>
    <div class="header-divider"></div>

    <!-- View Mode Switcher -->
    <div class="mode-switch">
      <button class="mode-btn active" id="mode-btn-schema">
        <span>📐</span> Schema
      </button>
      <button class="mode-btn" id="mode-btn-data">
        <span>📝</span> Data Entry
      </button>
    </div>

    <div class="header-divider"></div>

    <!-- Table tabs -->
    <nav class="table-tabs" id="table-tabs"></nav>

    <div class="header-actions">
      <div class="status-badge" id="server-status" title="Local SQLite & JSON Storage Engine">
        <span class="status-dot offline" id="status-dot"></span>
        <span id="status-text">Connecting...</span>
      </div>
      <button class="btn primary" id="btn-save-schema">💾 Save</button>
      <button class="btn" id="btn-sync-sqlite">⚡ Sync</button>
      <button class="btn" id="btn-theme-toggle">🌓</button>
    </div>
  </header>

  <!-- ======= TOOLBAR ======= -->
  <div class="toolbar" id="toolbar">
    <div class="toolbar-row">
      <span class="toolbar-label">Filter</span>
      <div id="filter-bar" style="display:flex;gap:0.3rem;flex-wrap:wrap;"></div>
      <div class="toolbar-divider"></div>
      <span id="col-count-label" style="font:500 11px var(--font-mono);color:var(--text-dim);white-space:nowrap;"></span>
      <span style="font:500 11px var(--font-mono);color:var(--text-dim);">·</span>
      <span style="font:500 11px var(--font-body);color:var(--text-tertiary);cursor:pointer;" id="table-name-display"></span>
    </div>
  </div>

  <!-- ======= WORKSPACE (Schema View) ======= -->
  <div class="workspace">

    <!-- Schema Table Area -->
    <div class="table-area" id="table-area">
      <table class="notion-table" id="notion-table">
        <colgroup>
          <col><col><col><col><col><col><col>
        </colgroup>
        <thead>
          <tr>
            <th>#</th>
            <th>Column Name</th>
            <th>Type</th>
            <th class="th-slug">Slug</th>
            <th class="th-config">Config / Default</th>
            <th class="th-sql">SQL Type</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>

    <!-- Field Editor Sidebar Component -->
    <aside class="field-sidebar" id="field-sidebar">
      <div class="sidebar-inner">

        <!-- Sidebar Header -->
        <div class="sidebar-head">
          <div class="sidebar-head-row">
            <div class="sidebar-col-label" id="sidebar-col-label">
              <span class="col-num" id="sb-col-num">#1</span>
              <span id="sb-col-icon"></span>
              <span class="col-title" id="sb-col-title">Column</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.25rem;">
              <div class="sidebar-nav">
                <button class="btn ghost icon-only sm" id="btn-prev-col" title="Previous column">◀</button>
                <button class="btn ghost icon-only sm" id="btn-next-col" title="Next column">▶</button>
              </div>
              <button class="btn ghost icon-only" id="btn-close-sidebar" title="Close (Esc)">✕</button>
            </div>
          </div>
          <div class="sidebar-tabs">
            <button class="stab-btn active" data-tab="edit">Edit</button>
            <button class="stab-btn" data-tab="sql">SQL</button>
            <button class="stab-btn" data-tab="json">JSON</button>
          </div>
        </div>

        <!-- Sidebar Body -->
        <div class="sidebar-body">

          <!-- Edit Panel -->
          <div class="sidebar-panel active" id="sp-edit">

            <div class="field-group">
              <label class="field-label">Column Name</label>
              <input type="text" id="sb-name" placeholder="e.g. User ID">
            </div>

            <div class="field-group">
              <label class="field-label">Slug <span class="field-hint">(database key)</span></label>
              <input type="text" id="sb-slug" placeholder="e.g. user_id" style="font-family: var(--font-mono); font-size: 13px;">
            </div>

            <div class="field-group">
              <label class="field-label">Field Type</label>
              <select id="sb-type"></select>
            </div>

            <div class="section-sep"></div>

            <!-- Dynamic Metadata / Always-Visible Configuration Cards -->
            <div id="sb-meta"></div>

          </div>

          <!-- SQL Panel -->
          <div class="sidebar-panel" id="sp-sql">
            <div class="code-block">
              <div class="code-block-head">
                <span id="sql-title">CREATE TABLE</span>
                <button class="btn sm ghost" onclick="copyCode('sql-code')">📋 Copy</button>
              </div>
              <pre class="code-pre" id="sql-code"></pre>
            </div>
          </div>

          <!-- JSON Panel -->
          <div class="sidebar-panel" id="sp-json">
            <div class="code-block">
              <div class="code-block-head">
                <span id="json-title">JSON Schema</span>
                <button class="btn sm ghost" onclick="copyCode('json-code')">📋 Copy</button>
              </div>
              <pre class="code-pre" id="json-code"></pre>
            </div>
          </div>

        </div>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
          <button class="btn danger" style="width:100%;" id="btn-delete-col">
            🗑 Delete Column
          </button>
        </div>

      </div>
    </aside>

  </div><!-- end .workspace -->

  <!-- ======= DATA ENTRY WORKSPACE ======= -->
  <div class="data-workspace" id="data-workspace" style="display:none;">
    <!-- Data Toolbar -->
    <div class="data-toolbar">
      <div class="data-toolbar-left">
        <span class="data-table-title" id="data-table-title">users</span>
        <span class="record-counter" id="record-counter">0 records</span>
        <div class="data-search-box">
          <span style="color:var(--text-dim);font-size:12px;">🔍</span>
          <input type="text" id="data-search-input" placeholder="Search records...">
        </div>
      </div>
      <div class="data-toolbar-right">
        <button class="btn sm primary" id="btn-add-record">+ Add Record</button>
        <button class="btn sm" id="btn-export-csv">📥 Export CSV</button>
        <button class="btn sm" id="btn-reload-data">🔄 Reload</button>
      </div>
    </div>

    <!-- Data Grid Container -->
    <div class="data-grid-container" id="data-grid-container">
      <table class="data-grid-table" id="data-grid-table">
        <thead id="data-grid-thead"></thead>
        <tbody id="data-grid-tbody"></tbody>
      </table>
    </div>
  </div><!-- end #data-workspace -->

</div><!-- end .app-shell -->

<div class="toast" id="toast"></div>

<!-- Modular Component App Controller -->
<script type="module" src="js/app.js"></script>
</body>
</html>
