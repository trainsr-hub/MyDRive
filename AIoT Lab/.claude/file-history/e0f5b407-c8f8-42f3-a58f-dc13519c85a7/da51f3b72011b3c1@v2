let tables = JSON.parse(JSON.stringify(MOCK_DATA));
let activeTable  = 'quotes';
let activeFilter = 'all';
let activeSidebarTab = 'edit';
let activeColIdx = null;   // currently selected column index

/* ============================================================
   INIT & SERVER SYNC
   ============================================================ */
async function init() {
  await checkServerHealth();
  await loadTables();

  renderTableTabs();
  renderFilterBar();
  renderTable();
  updateColCountLabel();
  ensureRecordsLoaded(activeTable);

  // Keyboard: Escape closes sidebar
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeSidebar();
    if (e.key === 'ArrowLeft'  && activeColIdx !== null) navigateSidebar(-1);
    if (e.key === 'ArrowRight' && activeColIdx !== null) navigateSidebar(1);
  });
}

async function checkServerHealth() {
  const dot = document.getElementById('status-dot');
  const txt = document.getElementById('status-text');
  try {
    const res = await fetch(`${API_BASE}/api/tables`, { method: 'GET' });
    if (res.ok) {
      isServerConnected = true;
      if (dot) dot.className = 'status-dot';
      if (txt) txt.textContent = 'Server Connected (:20139)';
    } else {
      setOffline();
    }
  } catch (e) {
    setOffline();
  }
}

function setOffline() {
  isServerConnected = false;
  const dot = document.getElementById('status-dot');
  const txt = document.getElementById('status-text');
  if (dot) dot.className = 'status-dot offline';
  if (txt) txt.textContent = 'Standalone Mode';
}

async function loadTables() {
  // 1. Try REST server API
  try {
    const res = await fetch(`${API_BASE}/api/tables`);
    if (res.ok) {
      const data = await res.json();
      if (data.success && data.tables && Object.keys(data.tables).length > 0) {
        tables = data.tables;
        if (!tables[activeTable]) {
          activeTable = Object.keys(tables)[0];
        }
        return;
      }
    }
  } catch (e) { }

  // 2. Try localStorage fallback
  try {
    const stored = localStorage.getItem('project_entry_schemas');
    if (stored) {
      const parsed = JSON.parse(stored);
      if (parsed && Object.keys(parsed).length > 0) {
        tables = { ...parsed, ...tables };
      }
    }
  } catch (e) { }
}

/* ============================================================
   TABLE TABS
   ============================================================ */
function renderTableTabs() {
  const container = document.getElementById('table-tabs');
  const names = Object.keys(tables);
  container.innerHTML = names.map(name => `
    <button class="tab-btn ${name === activeTable ? 'active' : ''}" onclick="switchTable('${name}')">
      📁 ${name}
    </button>
  `).join('') + `
    <button class="tab-btn new-table" onclick="createTable()">+ New Table</button>
  `;
}

function switchTable(name) {
  if (!tables[name]) return;
  activeTable = name;
  activeColIdx = null;
  closeSidebar();
  renderTableTabs();

  if (currentViewMode === 'schema') {
    renderFilterBar();
    renderTable();
    updateColCountLabel();
  } else {
    ensureRecordsLoaded(activeTable);
    renderDataWorkspace();
  }
}

function createTable() {
  const name = prompt('Table name (e.g., tasks, inventory):');
  if (!name) return;
  const clean = name.toLowerCase().replace(/[^a-z0-9_]/g, '_');
  if (tables[clean]) { alert('Table already exists'); return; }
  tables[clean] = {
    table_name: clean,
    columns: [{ name: 'ID', slug: 'id', type: 'hex_id', metadata: { prefix: clean.substring(0, 4).toUpperCase() } }]
  };
  switchTable(clean);
  showToast(`Created table "${clean}"`);
}

function promptRenameTable() {
  const current = tables[activeTable].table_name;
  const next = prompt('Rename table:', current);
  if (!next || next === current) return;
  const clean = next.toLowerCase().replace(/[^a-z0-9_]/g, '_');
  tables[activeTable].table_name = clean;
  renderTable();
  document.getElementById('table-name-display').textContent = clean;
  showToast(`Renamed to "${clean}"`);
}

function updateColCountLabel() {
  const t = tables[activeTable];
  if (!t) return;
  document.getElementById('col-count-label').textContent = `${t.columns.length} columns`;
  document.getElementById('table-name-display').textContent = t.table_name;
}

/* ============================================================
   FILTER BAR
   ============================================================ */
function renderFilterBar() {
  const cats = ['all', 'pk', 'text', 'scalar', 'boolean', 'enum', 'rel'];
  const icons = { all: '📊', pk: '🔑', text: '📝', scalar: '🔢', boolean: '🔘', enum: '🏷️', rel: '🔗' };
  document.getElementById('filter-bar').innerHTML = cats.map(cat => `
    <button class="filter-btn ${cat === activeFilter ? 'active' : ''}" onclick="setFilter('${cat}')">
      ${icons[cat]} ${cat === 'all' ? 'All' : cat.charAt(0).toUpperCase() + cat.slice(1)}
    </button>
  `).join('');
}

function setFilter(cat) {
  activeFilter = cat;
  renderFilterBar();
  renderTable();
}

/* ============================================================
   MAIN TABLE RENDER
   ============================================================ */
function getFilteredColumns() {
  const t = tables[activeTable];
  if (!t) return [];
  return activeFilter === 'all'
    ? t.columns.map((c, i) => ({ col: c, realIdx: i }))
    : t.columns.map((c, i) => ({ col: c, realIdx: i })).filter(({ col }) => FIELD_TYPES[col.type]?.category === activeFilter);
}

function renderConfigBadge(col) {
  const meta = col.metadata || {};
  if (col.type === 'int_scalar') {
    if (meta.default_option) {
      return `<span class="config-badge active-formula" title="Default Formula: ${escHtml(meta.default_option)}">⚡ ${escHtml(meta.default_option)}</span>`;
    }
    return `<span class="config-badge muted" title="Click to set default formula">+ set default</span>`;
  }
  if (col.type === 'hex_id') {
    return `<span class="config-badge pk">prefix: ${escHtml(meta.prefix || 'ID')}</span>`;
  }
  if (col.type.startsWith('enum_')) {
    const count = Array.isArray(meta.options) ? meta.options.length : 0;
    return `<span class="config-badge enum">${count} option${count === 1 ? '' : 's'}</span>`;
  }
  if (col.type.startsWith('relation_')) {
    return `<span class="config-badge rel">→ ${escHtml(meta.target || 'self')}</span>`;
  }
  return `<span class="config-badge muted" style="opacity:0.4;">—</span>`;
}

function renderTable() {
  const tbody = document.getElementById('table-body');
  const filtered = getFilteredColumns();
  updateColCountLabel();

  if (filtered.length === 0) {
    tbody.innerHTML = `<tr><td colspan="7" class="table-empty">No columns in this category.</td></tr>`;
    renderAddRow();
    return;
  }

  tbody.innerHTML = filtered.map(({ col, realIdx }) => renderTableRow(col, realIdx)).join('');

  // Re-render the add row at the bottom
  renderAddRow();

  // Attach drag listeners to draggable rows
  attachRowDragListeners();

  // Restore selection highlight
  if (activeColIdx !== null) {
    const row = tbody.querySelector(`tr[data-idx="${activeColIdx}"]`);
    if (row) row.classList.add('selected');
  }
}

function renderTableRow(col, idx) {
  const ft = FIELD_TYPES[col.type] || {};
  const t = tables[activeTable];
  const isFirst = idx === 0;
  const isLast  = idx === t.columns.length - 1;

  return `
    <tr data-idx="${idx}" onclick="selectRow(${idx})" class="draggable ${activeColIdx === idx ? 'selected' : ''}">
      <td class="td-num">
        <span class="row-num" style="color:var(--text-dim);font:500 11px var(--font-mono)">${idx + 1}</span>
        <span class="drag-handle" title="Drag to reorder">⋮⋮</span>
        <span class="row-expand">⤢</span>
      </td>
      <td>
        <div class="td-name">
          <span class="col-icon">${ft.icon || ''}</span>
          <span class="col-name-text">${escHtml(col.name)}</span>
        </div>
      </td>
      <td>
        <span class="type-chip ${ft.category || ''}">${ft.title || col.type}</span>
      </td>
      <td class="td-slug col-slug">${escHtml(col.slug || '')}</td>
      <td class="td-config" onclick="event.stopPropagation(); selectRow(${idx});">
        ${renderConfigBadge(col)}
      </td>
      <td class="td-sql col-sql">${ft.sql || ''}</td>
      <td>
        <div class="td-actions" onclick="event.stopPropagation()">
          <button class="btn ghost icon-only sm" onclick="selectRow(${idx})" title="Configure Column">⚙️</button>
          <button class="btn ghost icon-only sm" onclick="moveColumn(${idx}, -1)" ${isFirst ? 'disabled' : ''} title="Move up" style="${isFirst ? 'opacity:0.3' : ''}">▲</button>
          <button class="btn ghost icon-only sm" onclick="moveColumn(${idx}, 1)"  ${isLast  ? 'disabled' : ''} title="Move down" style="${isLast ? 'opacity:0.3' : ''}">▼</button>
          <button class="btn ghost icon-only sm" onclick="deleteRowDirect(${idx})" title="Delete">✕</button>
        </div>
      </td>
    </tr>
  `;
}

function renderAddRow() {
  const tbody = document.getElementById('table-body');
  const types = [
    ['hex_id','🔑 Hex ID'], ['text_single','📝 Text'], ['text_multi','📋 Multi'],
    ['int_scalar','🔢 Int'], ['float_scalar','🔢 Float'], ['boolean','🔘 Bool'],
    ['enum_single','🏷️ Enum'], ['enum_multi','🏷️ Multi-Enum'],
    ['relation_single','🔗 Relation'], ['relation_multi','🔗 Rel-N'],
  ];
  const existingAddRow = tbody.querySelector('.row-add');
  if (existingAddRow) existingAddRow.remove();

  const tr = document.createElement('tr');
  tr.className = 'row-add';
  tr.innerHTML = `<td colspan="7">
    <div class="add-field-strip">
      <span style="font:600 11px var(--font-mono);color:var(--text-dim);margin-right:0.25rem;">+ ADD</span>
      ${types.map(([slug, label]) => `
        <button class="add-chip" onclick="addField('${slug}')">${label}</button>
      `).join('')}
    </div>
  </td>`;
  tbody.appendChild(tr);
}

/* ============================================================
   ROW SELECTION → SIDEBAR
   ============================================================ */
function selectRow(idx) {
  if (activeColIdx === idx) {
    // Toggle: clicking same row closes sidebar
    closeSidebar();
    return;
  }
  activeColIdx = idx;

  // Update row highlight
  document.querySelectorAll('#table-body tr').forEach(r => r.classList.remove('selected'));
  const row = document.querySelector(`#table-body tr[data-idx="${idx}"]`);
  if (row) row.classList.add('selected');

  openSidebar();
}

function openSidebar() {
  document.getElementById('field-sidebar').classList.add('open');
  document.body.classList.add('sidebar-open');
  populateSidebar();
}

function closeSidebar() {
  document.getElementById('field-sidebar').classList.remove('open');
  document.body.classList.remove('sidebar-open');
  document.querySelectorAll('#table-body tr').forEach(r => r.classList.remove('selected'));
  activeColIdx = null;
}

function navigateSidebar(dir) {
  if (activeColIdx === null) return;
  const t = tables[activeTable];
  const next = activeColIdx + dir;
  if (next < 0 || next >= t.columns.length) return;
  activeColIdx = next;

  document.querySelectorAll('#table-body tr').forEach(r => r.classList.remove('selected'));
  const row = document.querySelector(`#table-body tr[data-idx="${next}"]`);
  if (row) row.classList.add('selected');

  populateSidebar();
}

/* ============================================================
   SIDEBAR POPULATION
   ============================================================ */
function populateSidebar() {
  if (activeColIdx === null) return;
  const t = tables[activeTable];
  const col = t.columns[activeColIdx];
  if (!col) return;
  const ft = FIELD_TYPES[col.type] || {};

  // Header labels
  document.getElementById('sb-col-num').textContent   = `#${activeColIdx + 1} of ${t.columns.length}`;
  document.getElementById('sb-col-icon').textContent  = ft.icon || '';
  document.getElementById('sb-col-title').textContent = col.name;

  // Edit fields
  document.getElementById('sb-name').value = col.name;
  document.getElementById('sb-slug').value = col.slug || '';

  // Type select
  const sel = document.getElementById('sb-type');
  sel.innerHTML = Object.entries(FIELD_TYPES).map(([slug, info]) =>
    `<option value="${slug}" ${col.type === slug ? 'selected' : ''}>${info.icon} ${info.title}</option>`
  ).join('');

  // Meta section
  renderSidebarMeta(col);

  // Code panels
  populateSidebarCode();
}

function renderSidebarMeta(col) {
  const meta = col.metadata || {};
  const container = document.getElementById('sb-meta');

  if (col.type === 'hex_id') {
    container.innerHTML = `
      <div class="field-group">
        <label class="field-label">ID Prefix <span class="field-hint">(max 4 chars)</span></label>
        <input type="text" maxlength="4" value="${escHtml(meta.prefix || '')}"
          oninput="sbUpdateMeta('prefix', this.value)">
      </div>
    `;
    return;
  }

  if (col.type === 'int_scalar') {
    const defaultOption = (meta.default_option || '').trim();
    const t = tables[activeTable];
    const candidateCols = t ? t.columns.filter(c => c.slug !== col.slug && (c.type === 'int_scalar' || c.type === 'hex_id')) : [];
    const currentSlug = col.slug || 'idx';

    // Determine current preset
    let currentPreset = 'custom';
    if (!defaultOption) currentPreset = 'none';
    else if (defaultOption === 'literal:0') currentPreset = 'zero';
    else if (defaultOption.startsWith('literal:')) currentPreset = 'literal';
    else if (defaultOption.toLowerCase() === 'count(*)') currentPreset = 'count';
    else if (defaultOption.toLowerCase().startsWith('max(')) currentPreset = 'max';

    // Extract target column and step if max(...) + N
    let maxCol = currentSlug;
    let maxStep = 1;
    const maxMatch = defaultOption.match(/max\((\w+)\)(?:\s*\+\s*(\d+))?/i);
    if (maxMatch) {
      maxCol = maxMatch[1] || currentSlug;
      if (maxMatch[2]) maxStep = parseInt(maxMatch[2], 10);
    }

    container.innerHTML = `
      <div class="field-group">
        <label class="field-label">Default Option <span class="field-hint">(Formula Selector)</span></label>
        <select id="sb-formula-preset" onchange="handleFormulaPresetChange(this.value)">
          <option value="none" ${currentPreset === 'none' ? 'selected' : ''}>-- No Default (Manual Entry) --</option>
          <option value="max" ${currentPreset === 'max' ? 'selected' : ''}>⚡ Auto-Increment: max(col) + N</option>
          <option value="count" ${currentPreset === 'count' ? 'selected' : ''}>🔢 Row Count: count(*)</option>
          <option value="zero" ${currentPreset === 'zero' ? 'selected' : ''}>0️⃣ Static Zero (literal:0)</option>
          <option value="literal" ${currentPreset === 'literal' ? 'selected' : ''}>📌 Custom Literal (literal:N)</option>
          <option value="custom" ${currentPreset === 'custom' ? 'selected' : ''}>🛠️ Custom Formula Expression</option>
        </select>
      </div>

      <!-- Auto-Increment Builder -->
      <div id="sb-formula-builder-max" class="field-group" style="display:${currentPreset === 'max' ? 'flex' : 'none'};background:var(--bg-input);padding:0.75rem;border-radius:var(--radius-md);border:1px solid var(--border-light);gap:0.4rem;">
        <span style="font:600 11px var(--font-mono);color:var(--accent);">FORMULA BUILDER</span>
        <div style="display:flex;gap:0.4rem;align-items:center;">
          <span style="font:500 12px var(--font-mono);color:var(--text-tertiary);">max(</span>
          <select id="sb-max-col" style="flex:1;height:32px;font-size:12px;" onchange="updateMaxFormulaFromBuilder()">
            <option value="${escHtml(currentSlug)}" ${maxCol === currentSlug ? 'selected' : ''}>${escHtml(currentSlug)} (this column)</option>
            ${candidateCols.map(c => `<option value="${escHtml(c.slug)}" ${maxCol === c.slug ? 'selected' : ''}>${escHtml(c.slug)} (${escHtml(c.name)})</option>`).join('')}
          </select>
          <span style="font:500 12px var(--font-mono);color:var(--text-tertiary);">) +</span>
          <input type="number" id="sb-max-step" value="${maxStep}" style="width:55px;height:32px;font-size:12px;" oninput="updateMaxFormulaFromBuilder()">
        </div>
      </div>

      <!-- Raw Formula Expression -->
      <div class="field-group">
        <label class="field-label">Formula Expression <span class="field-hint">(active config)</span></label>
        <input type="text" id="sb-formula-raw"
          style="font-family:var(--font-mono);font-size:13px;color:var(--accent);font-weight:600;"
          placeholder="e.g. max(id) + 1"
          value="${escHtml(defaultOption)}"
          oninput="sbUpdateMeta('default_option', this.value); refreshTableRow(activeColIdx);">
      </div>

      <!-- Quick Preset Chips -->
      <div class="field-group">
        <label class="field-label" style="font-size:10px;">Quick Presets</label>
        <div style="display:flex;gap:0.35rem;flex-wrap:wrap;">
          <button class="add-chip" onclick="applyFormulaQuick('max(${escHtml(currentSlug)}) + 1')">max(${escHtml(currentSlug)}) + 1</button>
          <button class="add-chip" onclick="applyFormulaQuick('count(*)')">count(*)</button>
          <button class="add-chip" onclick="applyFormulaQuick('literal:0')">literal:0</button>
          <button class="add-chip" onclick="applyFormulaQuick('')" style="color:var(--danger);">✕ Clear</button>
        </div>
      </div>
    `;
    return;
  }

  if (col.type.startsWith('enum_')) {
    const options = Array.isArray(meta.options) ? meta.options : [];
    container.innerHTML = `
      <div class="field-group">
        <label class="field-label">Options</label>
        <div class="options-list" id="sb-options-list">
          ${options.map((opt, i) => `
            <span class="option-pill">
              ${escHtml(opt)}
              <button onclick="sbRemoveOption(${i})" title="Remove">✕</button>
            </span>
          `).join('')}
        </div>
        <input type="text" placeholder="Type option, press Enter"
          onkeydown="if(event.key==='Enter'){sbAddOption(this.value);this.value='';}" style="margin-top:0.4rem;">
      </div>
    `;
    return;
  }

  if (col.type.startsWith('relation_')) {
    const target = meta.target || 'self';
    container.innerHTML = `
      <div class="field-group">
        <label class="field-label">Target Table</label>
        <select onchange="sbUpdateMeta('target', this.value)">
          <option value="self" ${target === 'self' ? 'selected' : ''}>Self (tree)</option>
          ${Object.keys(tables).map(tname => `
            <option value="${tname}" ${target === tname ? 'selected' : ''}>${tname}</option>
          `).join('')}
        </select>
      </div>
    `;
    return;
  }

  container.innerHTML = '';
}

function populateSidebarCode() {
  const t = tables[activeTable];
  document.getElementById('sql-title').textContent  = `${t.table_name}.sql`;
  document.getElementById('json-title').textContent = `${t.table_name}.json`;
  document.getElementById('sql-code').textContent   = generateSQL(t);
  document.getElementById('json-code').textContent  = JSON.stringify(t, null, 2);
}

/* ============================================================
   SIDEBAR TAB SWITCHING
   ============================================================ */
function switchSidebarTab(tab, btn) {
  activeSidebarTab = tab;
  document.querySelectorAll('.stab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.sidebar-panel').forEach(p => p.classList.remove('active'));
  document.getElementById(`sp-${tab}`).classList.add('active');
  if (tab === 'sql' || tab === 'json') populateSidebarCode();
}

/* ============================================================
   SIDEBAR MUTATION HANDLERS
   ============================================================ */
function sbUpdateName(val) {
  if (activeColIdx === null) return;
  tables[activeTable].columns[activeColIdx].name = val;
  document.getElementById('sb-col-title').textContent = val;
  refreshTableRow(activeColIdx);
}

function sbUpdateSlug(val) {
  if (activeColIdx === null) return;
  tables[activeTable].columns[activeColIdx].slug = val;
  refreshTableRow(activeColIdx);
}

function sbUpdateType(val) {
  if (activeColIdx === null) return;
  const col = tables[activeTable].columns[activeColIdx];
  col.type = val;
  col.metadata = {};
  if (val.startsWith('enum_'))     col.metadata.options = ['option1'];
  if (val.startsWith('relation_')) col.metadata.target  = 'self';
  if (val === 'hex_id')            col.metadata.prefix  = activeTable.substring(0, 4).toUpperCase();
  populateSidebar();
  refreshTableRow(activeColIdx);
}

function sbUpdateMeta(key, val) {
  if (activeColIdx === null) return;
  if (!tables[activeTable].columns[activeColIdx].metadata)
    tables[activeTable].columns[activeColIdx].metadata = {};
  tables[activeTable].columns[activeColIdx].metadata[key] = val;
}

function sbAddOption(val) {
  if (!val.trim() || activeColIdx === null) return;
  const meta = tables[activeTable].columns[activeColIdx].metadata;
  if (!Array.isArray(meta.options)) meta.options = [];
  if (!meta.options.includes(val)) { meta.options.push(val); }
  renderSidebarMeta(tables[activeTable].columns[activeColIdx]);
}

function sbRemoveOption(i) {
  if (activeColIdx === null) return;
  tables[activeTable].columns[activeColIdx].metadata.options.splice(i, 1);
  renderSidebarMeta(tables[activeTable].columns[activeColIdx]);
}

function sbDeleteColumn() {
  if (activeColIdx === null) return;
  const name = tables[activeTable].columns[activeColIdx].name;
  tables[activeTable].columns.splice(activeColIdx, 1);
  closeSidebar();
  renderTable();
  updateColCountLabel();
  showToast(`Deleted "${name}"`);
}

/* ============================================================
   TABLE ROW ACTIONS (from action cell, not sidebar)
   ============================================================ */
function deleteRowDirect(idx) {
  const name = tables[activeTable].columns[idx].name;
  tables[activeTable].columns.splice(idx, 1);
  if (activeColIdx === idx) closeSidebar();
  else if (activeColIdx !== null && activeColIdx > idx) activeColIdx--;
  renderTable();
  updateColCountLabel();
  showToast(`Deleted "${name}"`);
}

function moveColumn(idx, dir) {
  const cols = tables[activeTable].columns;
  const target = idx + dir;
  if (target < 0 || target >= cols.length) return;

  const [moved] = cols.splice(idx, 1);
  cols.splice(target, 0, moved);

  if      (activeColIdx === idx)    activeColIdx = target;
  else if (activeColIdx === target) activeColIdx = idx;

  renderTable();
  if (activeColIdx !== null) populateSidebar();
}

function addField(type) {
  const t = tables[activeTable];
  const newCol = { name: FIELD_TYPES[type].title, slug: 'new_field', type, metadata: {} };
  if (type.startsWith('enum_'))     newCol.metadata.options = ['option1', 'option2'];
  if (type.startsWith('relation_')) newCol.metadata.target  = 'self';
  if (type === 'hex_id')            newCol.metadata.prefix  = activeTable.substring(0, 4).toUpperCase();
  t.columns.push(newCol);
  renderTable();
  updateColCountLabel();
  // Open sidebar on new column
  activeColIdx = t.columns.length - 1;
  openSidebar();
  showToast(`Added ${FIELD_TYPES[type].title}`);
}

/* Formula Selector Helper Handlers */
function handleFormulaPresetChange(preset) {
  if (activeColIdx === null) return;
  const col = tables[activeTable].columns[activeColIdx];
  const maxBuilder = document.getElementById('sb-formula-builder-max');
  const slug = col.slug || 'idx';

  if (preset === 'none') {
    if (maxBuilder) maxBuilder.style.display = 'none';
    applyFormulaQuick('');
  } else if (preset === 'max') {
    if (maxBuilder) maxBuilder.style.display = 'flex';
    applyFormulaQuick(`max(${slug}) + 1`);
  } else if (preset === 'count') {
    if (maxBuilder) maxBuilder.style.display = 'none';
    applyFormulaQuick('count(*)');
  } else if (preset === 'zero') {
    if (maxBuilder) maxBuilder.style.display = 'none';
    applyFormulaQuick('literal:0');
  } else if (preset === 'literal') {
    if (maxBuilder) maxBuilder.style.display = 'none';
    applyFormulaQuick('literal:1');
  } else {
    if (maxBuilder) maxBuilder.style.display = 'none';
  }
}

function updateMaxFormulaFromBuilder() {
  const colSelect = document.getElementById('sb-max-col');
  const stepInput = document.getElementById('sb-max-step');
  if (!colSelect || !stepInput) return;
  const targetCol = colSelect.value || 'idx';
  const step = parseInt(stepInput.value, 10) || 1;
  applyFormulaQuick(`max(${targetCol}) + ${step}`);
}

function applyFormulaQuick(formula) {
  if (activeColIdx === null) return;
  sbUpdateMeta('default_option', formula);
  const rawInput = document.getElementById('sb-formula-raw');
  if (rawInput) rawInput.value = formula;
  refreshTableRow(activeColIdx);
}

/* Refresh a single table row in-place without full re-render */
function refreshTableRow(idx) {
  const col = tables[activeTable].columns[idx];
  const row = document.querySelector(`#table-body tr[data-idx="${idx}"]`);
  if (!row) { renderTable(); return; }
  const ft = FIELD_TYPES[col.type] || {};

  row.querySelector('.col-icon').textContent      = ft.icon || '';
  row.querySelector('.col-name-text').textContent = col.name;
  const chip = row.querySelector('.type-chip');
  chip.className = `type-chip ${ft.category || ''}`;
  chip.textContent = ft.title || col.type;
  row.querySelector('.td-slug').textContent = col.slug || '';
  const tdConfig = row.querySelector('.td-config');
  if (tdConfig) tdConfig.innerHTML = renderConfigBadge(col);
  row.querySelector('.td-sql').textContent  = ft.sql || '';
}

/* ============================================================
   NOTION-STYLE ROW DRAG-TO-REORDER (Pointer-based FLIP)
   Each table row represents a column; drag the left edge to reorder
   ============================================================ */
let rowDrag = null;

function attachRowDragListeners() {
  const rows = document.querySelectorAll('#table-body tr.draggable');
  rows.forEach(row => {
    const tdNum = row.querySelector('.td-num');
    if (tdNum) {
      tdNum.addEventListener('pointerdown', handleRowPointerDown);
    }
  });
}

function handleRowPointerDown(e) {
  if (e.button !== 0) return;

  const tdNum = e.currentTarget;
  const row = tdNum.closest('tr.draggable');
  if (!row) return;

  const fromIdx = Number(row.dataset.idx);
  const tbody = document.getElementById('table-body');
  const rect = row.getBoundingClientRect();

  row.setPointerCapture(e.pointerId);

  const placeholder = document.createElement('tr');
  placeholder.className = 'row-placeholder';
  placeholder.innerHTML = '<td colspan="7"></td>';

  const offsetX = e.clientX - rect.left;
  const offsetY = e.clientY - rect.top;

  rowDrag = {
    row, tdNum, fromIdx, tbody, placeholder, offsetX, offsetY, rect,
    isDragging: false, startX: e.clientX, startY: e.clientY
  };

  const onMove = (me) => {
    if (!rowDrag) return;
    const dist = Math.hypot(me.clientX - rowDrag.startX, me.clientY - rowDrag.startY);

    if (!rowDrag.isDragging && dist > 5) {
      rowDrag.isDragging = true;
      row.parentNode.insertBefore(placeholder, row);
      row.classList.add('is-dragging');
      row.style.width = `${rect.width}px`;
      row.style.height = `${rect.height}px`;
    }

    if (rowDrag.isDragging) {
      row.style.left = `${me.clientX - offsetX}px`;
      row.style.top = `${me.clientY - offsetY}px`;
      updateRowPlacementFLIP(me.clientY);
    }
  };

  const onUp = () => {
    window.removeEventListener('pointermove', onMove);
    window.removeEventListener('pointerup', onUp);
    try { row.releasePointerCapture(e.pointerId); } catch (_) {}

    if (!rowDrag.isDragging) { rowDrag = null; return; }

    const targetRect = placeholder.getBoundingClientRect();
    const currentTop = parseFloat(row.style.top);
    const dy = targetRect.top - currentTop;

    row.style.transition = 'transform 0.22s cubic-bezier(0.16,1,0.3,1)';
    row.style.transform = `translateY(${dy}px)`;

    setTimeout(() => {
      const allRows = [...tbody.querySelectorAll('tr.draggable')];
      const toIdx = allRows.indexOf(placeholder);

      row.classList.remove('is-dragging');
      ['position','left','top','width','height','transform','transition']
        .forEach(p => row.style[p] = '');

      if (placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);

      if (toIdx !== -1 && toIdx !== rowDrag.fromIdx) {
        const cols = tables[activeTable].columns;
        const [movedCol] = cols.splice(rowDrag.fromIdx, 1);
        cols.splice(toIdx, 0, movedCol);

        if (activeColIdx !== null) {
          if (activeColIdx === rowDrag.fromIdx) activeColIdx = toIdx;
          else if (rowDrag.fromIdx < toIdx && activeColIdx > rowDrag.fromIdx && activeColIdx <= toIdx) activeColIdx--;
          else if (rowDrag.fromIdx > toIdx && activeColIdx >= toIdx && activeColIdx < rowDrag.fromIdx) activeColIdx++;
        }

        renderTable();
        if (activeColIdx !== null) { openSidebar(); populateSidebar(); }
        showToast(`Reordered: ${movedCol.name}`);
      }
      rowDrag = null;
    }, 220);
  };

  window.addEventListener('pointermove', onMove, { passive: true });
  window.addEventListener('pointerup', onUp);
}

function updateRowPlacementFLIP(pointerY) {
  if (!rowDrag) return;

  const { row, tbody, placeholder } = rowDrag;
  const allRows = [...tbody.querySelectorAll('tr.draggable:not(.is-dragging)')];
  let target = null;

  for (const otherRow of allRows) {
    const box = otherRow.getBoundingClientRect();
    if (pointerY < box.top + box.height / 2) {
      target = otherRow;
      break;
    }
  }

  const curr = placeholder.nextElementSibling === row ? row.nextElementSibling : placeholder.nextElementSibling;
  if (curr === target) return;

  const firstPos = new Map();
  allRows.forEach(r => firstPos.set(r, r.getBoundingClientRect()));

  if (target) tbody.insertBefore(placeholder, target);
  else tbody.appendChild(placeholder);

  allRows.forEach(r => {
    const first = firstPos.get(r);
    const last = r.getBoundingClientRect();
    const dy = first.top - last.top;
    if (dy !== 0) {
      r.style.transition = 'none';
      r.style.transform = `translateY(${dy}px)`;
      r.offsetHeight;
      r.style.transition = 'transform 0.22s cubic-bezier(0.2,0,0,1)';
      r.style.transform = '';
    }
  });
}

/* ============================================================
   CODE GENERATION
   ============================================================ */
function generateSQL(table) {
  if (!table) return '-- No table';
  const lines = [`CREATE TABLE IF NOT EXISTS ${table.table_name} (`];
  const cols = table.columns.map(col => {
    const ft = FIELD_TYPES[col.type];
    return `    ${(col.slug || col.name).padEnd(22)} ${ft.sql}`;
  });
  lines.push(cols.join(',\n'));
  lines.push(');');
  return lines.join('\n');
}

/* ============================================================
   MISC
   ============================================================ */
function copyCode(elId) {
  const text = document.getElementById(elId).textContent;
  navigator.clipboard.writeText(text).then(() => showToast('Copied!'));
}

async function saveTable() {
  const current = tables[activeTable];
  if (!current) return;

  // 1. Redundant save to browser localStorage
  try {
    localStorage.setItem('project_entry_schemas', JSON.stringify(tables));
  } catch (e) { }

  // 2. Persistent save to server data/<table_name>.json + SQLite sync
  try {
    const res = await fetch(`${API_BASE}/api/table/${encodeURIComponent(activeTable)}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(current, null, 2)
    });
    if (res.ok) {
      showToast(`Saved to data/${activeTable}.json & synced SQLite!`);
      checkServerHealth();
      return;
    }
  } catch (e) { }

  showToast(`Saved "${activeTable}" to local storage`);
}

async function syncSqlite() {
  try {
    const res = await fetch(`${API_BASE}/api/sync_all`, { method: 'POST' });
    if (res.ok) {
      showToast('All schemas synchronized to database.sqlite!');
      checkServerHealth();
      return;
    }
  } catch (e) { }

  showToast('SQLite sync: Local standalone mode active');
}

function toggleTheme() {
  const cur = document.documentElement.getAttribute('data-theme') || 'system';
  const next = cur === 'dark' ? 'light' : cur === 'light' ? 'system' : 'dark';
  if (next === 'system') document.documentElement.removeAttribute('data-theme');
  else document.documentElement.setAttribute('data-theme', next);
}

function showToast(msg) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2400);
}

function escHtml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/* ============================================================
   VIEW MODE SWITCHING & DATA ENTRY ENGINE
   ============================================================ */
let currentViewMode = 'schema'; // 'schema' | 'data'
let tableRecords = {};         // { [tableName]: [ { ...col_values } ] }
let dataSearchQuery = '';

function switchViewMode(mode) {
  currentViewMode = mode;
  const btnSchema = document.getElementById('mode-btn-schema');
  const btnData = document.getElementById('mode-btn-data');
  const schemaWorkspace = document.querySelector('.workspace');
  const schemaToolbar = document.getElementById('toolbar');
  const dataWorkspace = document.getElementById('data-workspace');
  const btnSaveSchema = document.getElementById('btn-save-schema');

  if (mode === 'schema') {
    btnSchema.classList.add('active');
    btnData.classList.remove('active');
    schemaWorkspace.style.display = 'flex';
    schemaToolbar.style.display = 'flex';
    dataWorkspace.style.display = 'none';
    if (btnSaveSchema) btnSaveSchema.style.display = 'inline-flex';
    renderTable();
    updateColCountLabel();
  } else {
    btnData.classList.add('active');
    btnSchema.classList.remove('active');
    schemaWorkspace.style.display = 'none';
    schemaToolbar.style.display = 'none';
    dataWorkspace.style.display = 'flex';
    if (btnSaveSchema) btnSaveSchema.style.display = 'none';
    closeSidebar();
    ensureRecordsLoaded(activeTable);
    renderDataWorkspace();
  }
}

async function ensureRecordsLoaded(tableName) {
  if (tableRecords[tableName]) return;

  // Try fetching real SQLite records via server
  try {
    const res = await fetch(`${API_BASE}/api/records/${encodeURIComponent(tableName)}`);
    if (res.ok) {
      const data = await res.json();
      if (data.success && Array.isArray(data.records)) {
        tableRecords[tableName] = data.records;
        if (currentViewMode === 'data') renderDataWorkspace();
        return;
      }
    }
  } catch (e) { }

  // Fallback: localStorage
  try {
    const local = localStorage.getItem(`records_${tableName}`);
    if (local) {
      tableRecords[tableName] = JSON.parse(local);
      if (currentViewMode === 'data') renderDataWorkspace();
      return;
    }
  } catch (e) { }

  // Fallback: Rose Mock Records
  if (typeof MOCK_RECORDS !== 'undefined' && MOCK_RECORDS[tableName]) {
    tableRecords[tableName] = JSON.parse(JSON.stringify(MOCK_RECORDS[tableName]));
    if (currentViewMode === 'data') renderDataWorkspace();
    return;
  }

  // Initialize empty or default
  tableRecords[tableName] = [];
  if (currentViewMode === 'data') renderDataWorkspace();
}

async function refreshDataRecords() {
  delete tableRecords[activeTable];
  await ensureRecordsLoaded(activeTable);
  renderDataWorkspace();
  showToast(`Reloaded ${activeTable} records`);
}

function handleDataSearch(val) {
  dataSearchQuery = (val || '').toLowerCase().trim();
  renderDataWorkspace();
}

function renderDataWorkspace() {
  const current = tables[activeTable];
  if (!current) return;

  document.getElementById('data-table-title').textContent = current.table_name;
  const records = tableRecords[activeTable] || [];

  // Filter records if search query
  const filtered = dataSearchQuery
    ? records.filter(r => Object.values(r).some(v => String(v || '').toLowerCase().includes(dataSearchQuery)))
    : records;

  document.getElementById('record-counter').textContent = `${filtered.length} record${filtered.length === 1 ? '' : 's'}`;

  // 1. Render Table Headers
  const thead = document.getElementById('data-grid-thead');
  let headHtml = `
    <tr>
      <th style="width:44px;text-align:center;">#</th>
  `;

  current.columns.forEach(col => {
    const ft = FIELD_TYPES[col.type] || {};
    headHtml += `
      <th>
        <div class="th-wrap">
          <span>${ft.icon || '📝'}</span>
          <span>${escHtml(col.name)}</span>
          <span class="th-slug">(${escHtml(col.slug || col.name)})</span>
        </div>
      </th>
    `;
  });

  headHtml += `</tr>`;
  thead.innerHTML = headHtml;

  // 2. Render Table Rows
  const tbody = document.getElementById('data-grid-tbody');
  if (filtered.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="${current.columns.length + 1}" style="text-align:center;padding:2.5rem;color:var(--text-dim);">
          No records in this table. Click <strong>+ Add Record</strong> to create the first row.
        </td>
      </tr>
      <tr class="grid-row-add" onclick="addDataRow()">
        <td colspan="${current.columns.length + 1}">+ New Record...</td>
      </tr>
    `;
    return;
  }

  let bodyHtml = '';
  filtered.forEach((rec, rowIdx) => {
    const recId = rec.id || `row_${rowIdx}`;
    bodyHtml += `
      <tr data-record-id="${recId}">
        <td class="data-num-cell">
          <span class="row-idx">${rowIdx + 1}</span>
          <button class="data-del-btn" onclick="deleteDataRecord('${recId}', ${rowIdx})" title="Delete record">✕</button>
        </td>
    `;

    current.columns.forEach(col => {
      const cSlug = col.slug || col.name;
      const val = rec[cSlug];
      bodyHtml += renderDataCell(col, val, recId, rowIdx);
    });

    bodyHtml += `</tr>`;
  });

  bodyHtml += `
    <tr class="grid-row-add" onclick="addDataRow()">
      <td colspan="${current.columns.length + 1}">+ New Record...</td>
    </tr>
  `;

  tbody.innerHTML = bodyHtml;
}

function renderDataCell(col, val, recId, rowIdx) {
  const cSlug = col.slug || col.name;
  const colType = col.type || 'text_single';
  const meta = col.metadata || {};

  // 1. Hex ID (Primary Key)
  if (colType === 'hex_id') {
    const idVal = val || generateHexId(meta.prefix || 'ID');
    return `
      <td>
        <span class="grid-hex-id-badge" onclick="copyId('${escHtml(idVal)}')">
          🔑 ${escHtml(idVal)}
        </span>
      </td>
    `;
  }

  // 2. Boolean (Checkbox)
  if (colType === 'boolean') {
    const checked = (val === 1 || val === true || val === '1') ? 'checked' : '';
    return `
      <td style="text-align:center;">
        <div class="grid-checkbox-wrapper">
          <input type="checkbox" class="grid-checkbox" ${checked}
            onchange="updateDataCell('${recId}', '${cSlug}', this.checked ? 1 : 0)">
        </div>
      </td>
    `;
  }

  // 3. Enum Single (Dropdown)
  if (colType === 'enum_single') {
    const options = Array.isArray(meta.options) ? meta.options : [];
    return `
      <td>
        <select class="grid-cell-select" onchange="updateDataCell('${recId}', '${cSlug}', this.value)">
          <option value="" ${!val ? 'selected' : ''}>-- Select --</option>
          ${options.map(opt => `
            <option value="${escHtml(opt)}" ${val === opt ? 'selected' : ''}>${escHtml(opt)}</option>
          `).join('')}
        </select>
      </td>
    `;
  }

  // 4. Enum Multi (Array)
  if (colType === 'enum_multi') {
    const tags = Array.isArray(val) ? val : (typeof val === 'string' && val.startsWith('[') ? JSON.parse(val || '[]') : (val ? [val] : []));
    return `
      <td>
        <div style="display:flex;align-items:center;">
          ${tags.map(t => `<span class="grid-tag-pill">#${escHtml(t)}</span>`).join('')}
          <input type="text" class="grid-cell-input" style="width:110px;" placeholder="+ tag"
            onkeydown="if(event.key==='Enter'){addTagToRecord('${recId}', '${cSlug}', this.value);this.value='';}">
        </div>
      </td>
    `;
  }

  // 5. Relation Single (Foreign Key)
  if (colType === 'relation_single') {
    const targetTable = meta.target && meta.target !== 'self' ? meta.target : activeTable;
    const targetRecs = tableRecords[targetTable] || [];
    return `
      <td>
        <select class="grid-cell-select" onchange="updateDataCell('${recId}', '${cSlug}', this.value)">
          <option value="" ${!val ? 'selected' : ''}>-- None --</option>
          ${targetRecs.map(tr => {
            const trId = tr.id || '';
            const trLabel = tr.name || tr.title || tr.username || trId;
            return `
              <option value="${escHtml(trId)}" ${val === trId ? 'selected' : ''}>
                ${escHtml(trLabel)} (${trId})
              </option>
            `;
          }).join('')}
        </select>
      </td>
    `;
  }

  // 6. Relation Multi (Foreign Key Array)
  if (colType === 'relation_multi') {
    const rels = Array.isArray(val) ? val : (typeof val === 'string' && val.startsWith('[') ? JSON.parse(val || '[]') : []);
    return `
      <td>
        <div style="display:flex;align-items:center;">
          ${rels.map(r => `<span class="grid-rel-pill">🔗 ${escHtml(r)}</span>`).join('')}
          <input type="text" class="grid-cell-input" style="width:120px;" placeholder="+ Hex ID"
            onkeydown="if(event.key==='Enter'){addRelToRecord('${recId}', '${cSlug}', this.value);this.value='';}">
        </div>
      </td>
    `;
  }

  // 7. Numbers (Int / Float)
  if (colType === 'int_scalar' || colType === 'float_scalar') {
    const step = colType === 'float_scalar' ? 'any' : '1';
    return `
      <td>
        <input type="number" step="${step}" class="grid-cell-input grid-cell-mono" value="${val !== undefined && val !== null ? val : ''}"
          onchange="updateDataCell('${recId}', '${cSlug}', Number(this.value))">
      </td>
    `;
  }

  // 8. Text (Single / Multi)
  return `
    <td>
      <input type="text" class="grid-cell-input" value="${escHtml(val !== undefined && val !== null ? val : '')}"
        placeholder="Empty" onchange="updateDataCell('${recId}', '${cSlug}', this.value)">
    </td>
  `;
}

function generateHexId(prefix) {
  const p = (prefix || 'ROW').substring(0, 4).toUpperCase();
  const hex = Array.from(crypto.getRandomValues(new Uint8Array(4)))
    .map(b => b.toString(16).padStart(2, '0')).join('');
  return `${p}_${hex}`;
}

async function addDataRow() {
  const current = tables[activeTable];
  if (!current) return;

  const newRec = {};
  current.columns.forEach(col => {
    const slug = col.slug || col.name;
    if (col.type === 'hex_id') {
      newRec[slug] = generateHexId(col.metadata?.prefix || activeTable.substring(0, 4));
    } else if (col.type === 'boolean') {
      newRec[slug] = 0;
    } else if (col.type.endsWith('_multi')) {
      newRec[slug] = [];
    } else if (col.type === 'int_scalar') {
      const defaultOption = (col.metadata?.default_option || '').trim();
      const records = tableRecords[activeTable] || [];

      if (!defaultOption) {
        newRec[slug] = 0;
      } else if (defaultOption.startsWith('literal:')) {
        const val = parseFloat(defaultOption.substring(8));
        newRec[slug] = isNaN(val) ? 0 : val;
      } else if (defaultOption.toLowerCase() === 'count(*)') {
        newRec[slug] = records.length;
      } else {
        const maxPlusMatch = defaultOption.match(/max\((\w+)\)\s*\+\s*(\d+)/i);
        if (maxPlusMatch) {
          const targetCol = maxPlusMatch[1];
          const inc = parseInt(maxPlusMatch[2], 10) || 1;
          const maxVal = records.reduce((max, r) => {
            const num = Number(r[targetCol]);
            return (!isNaN(num) && num > max) ? num : max;
          }, 0);
          newRec[slug] = maxVal + inc;
        } else {
          const maxSimpleMatch = defaultOption.match(/max\((\w+)\)/i);
          if (maxSimpleMatch) {
            const targetCol = maxSimpleMatch[1];
            const maxVal = records.reduce((max, r) => {
              const num = Number(r[targetCol]);
              return (!isNaN(num) && num > max) ? num : max;
            }, 0);
            newRec[slug] = maxVal;
          } else {
            newRec[slug] = 0;
          }
        }
      }
    } else if (col.type === 'float_scalar') {
      newRec[slug] = 0.0;
    } else {
      newRec[slug] = '';
    }
  });

  if (!tableRecords[activeTable]) tableRecords[activeTable] = [];
  tableRecords[activeTable].push(newRec);

  renderDataWorkspace();
  await persistRecord(newRec);
  showToast(`Added row in ${activeTable}`);
}

async function updateDataCell(recId, slug, value) {
  const records = tableRecords[activeTable] || [];
  const rec = records.find(r => r.id === recId || String(r.id) === String(recId));
  if (!rec) return;

  rec[slug] = value;
  await persistRecord(rec);
}

function addTagToRecord(recId, slug, tag) {
  if (!tag.trim()) return;
  const records = tableRecords[activeTable] || [];
  const rec = records.find(r => r.id === recId);
  if (!rec) return;

  if (!Array.isArray(rec[slug])) rec[slug] = [];
  if (!rec[slug].includes(tag.trim())) {
    rec[slug].push(tag.trim());
    updateDataCell(recId, slug, rec[slug]);
    renderDataWorkspace();
  }
}

function addRelToRecord(recId, slug, relId) {
  if (!relId.trim()) return;
  const records = tableRecords[activeTable] || [];
  const rec = records.find(r => r.id === recId);
  if (!rec) return;

  if (!Array.isArray(rec[slug])) rec[slug] = [];
  if (!rec[slug].includes(relId.trim())) {
    rec[slug].push(relId.trim());
    updateDataCell(recId, slug, rec[slug]);
    renderDataWorkspace();
  }
}

async function deleteDataRecord(recId, rowIdx) {
  if (!confirm(`Delete record #${rowIdx + 1} (${recId})?`)) return;

  if (tableRecords[activeTable]) {
    tableRecords[activeTable] = tableRecords[activeTable].filter(r => r.id !== recId && String(r.id) !== String(recId));
  }

  // 1. Sync deletion to server SQLite
  try {
    await fetch(`${API_BASE}/api/records/${encodeURIComponent(activeTable)}/${encodeURIComponent(recId)}`, {
      method: 'DELETE'
    });
  } catch (e) { }

  // 2. Update local storage
  try {
    localStorage.setItem(`records_${activeTable}`, JSON.stringify(tableRecords[activeTable]));
  } catch (e) { }

  renderDataWorkspace();
  showToast(`Deleted ${recId}`);
}

async function persistRecord(rec) {
  // 1. Save to server SQLite
  try {
    await fetch(`${API_BASE}/api/records/${encodeURIComponent(activeTable)}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(rec)
    });
  } catch (e) { }

  // 2. Redundancy to localStorage
  try {
    localStorage.setItem(`records_${activeTable}`, JSON.stringify(tableRecords[activeTable]));
  } catch (e) { }
}

function copyId(idStr) {
  navigator.clipboard.writeText(idStr).then(() => showToast(`Copied ${idStr}`));
}

function exportDataCSV() {
  const current = tables[activeTable];
  const records = tableRecords[activeTable] || [];
  if (!current || records.length === 0) {
    showToast('No records to export');
    return;
  }

  const cols = current.columns;
  const headers = cols.map(c => c.slug || c.name);
  const rows = records.map(r => {
    return cols.map(c => {
      const val = r[c.slug || c.name];
      if (val === undefined || val === null) return '""';
      if (typeof val === 'object') return `"${JSON.stringify(val).replace(/"/g, '""')}"`;
      return `"${String(val).replace(/"/g, '""')}"`;
    }).join(',');
  });

  const csvContent = [headers.join(','), ...rows].join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `${activeTable}_export.csv`;
  a.click();
  URL.revokeObjectURL(url);
  showToast(`Exported ${activeTable}_export.csv`);
}

