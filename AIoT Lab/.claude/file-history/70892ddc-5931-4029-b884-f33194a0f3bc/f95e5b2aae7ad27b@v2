// Dynamic Typography Sizing: Constant Height & Font Size, pure X-axis compression for long names
const getDinoNameStyle = (name: string): React.CSSProperties => {
    const len = (name || '').length;
    // Up to 10 characters fit at 100% scale without overflowing card header
    const scaleX = len > 10 ? Math.max(0.48, 10.2 / len) : 1.0;
    return {
        fontSize: '13px',
        lineHeight: '16px',
        transform: `scaleX(${scaleX})`,
        transformOrigin: 'center',
        letterSpacing: scaleX < 0.8 ? '-0.025em' : '0.01em',
    };
};

// Memoized Individual Dinosaur Card matching JWTG Battle Deck UI
