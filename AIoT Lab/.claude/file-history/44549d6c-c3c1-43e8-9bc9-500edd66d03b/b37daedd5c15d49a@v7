"""
Faust Animation Vault — local server
Run:  python server.py
URL:  http://localhost:7700

Serves the directory and handles two API routes:
  GET  /api/tree            → recursive .html tree of Animations/
  POST /api/log             → append a summon result to summon_log.json
  GET  /api/log             → read summon_log.json
"""
import json, os, sys, threading, webbrowser
from http.server import HTTPServer, SimpleHTTPRequestHandler
from pathlib import Path
from datetime import datetime, timezone

ROOT    = Path(__file__).parent
VAULT   = ROOT / "Animations"
LOG     = ROOT / "summon_log.json"
PORT    = 7700


# ── Directory tree ────────────────────────────────────────────────────────────
def build_tree(path: Path, rel_root: Path) -> list:
    nodes = []
    try:
        entries = sorted(path.iterdir(), key=lambda p: (p.is_file(), p.name.lower()))
    except PermissionError:
        return nodes
    for entry in entries:
        rel = str(entry.relative_to(rel_root)).replace("\\", "/")
        if entry.is_dir():
            children = build_tree(entry, rel_root)
            if children:
                nodes.append({"type": "folder", "name": entry.name, "path": rel, "children": children})
        elif entry.suffix.lower() == ".html":
            nodes.append({"type": "file", "name": entry.stem, "file": entry.name, "path": rel})
    return nodes


# ── Log helpers ───────────────────────────────────────────────────────────────
def read_log() -> list:
    if not LOG.exists():
        return []
    try:
        return json.loads(LOG.read_text(encoding="utf-8"))
    except Exception:
        return []

def append_log(entry: dict):
    log = read_log()
    entry["timestamp"] = datetime.now(timezone.utc).isoformat()
    log.append(entry)
    LOG.write_text(json.dumps(log, ensure_ascii=False, indent=2), encoding="utf-8")


# ── Request handler ───────────────────────────────────────────────────────────
class VaultHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(ROOT), **kwargs)

    def do_OPTIONS(self):
        self._cors(); self.end_headers()

    def do_GET(self):
        if self.path == "/api/tree":
            self._json(build_tree(VAULT, VAULT))
        elif self.path == "/api/log":
            self._json(read_log())
        else:
            super().do_GET()

    def do_POST(self):
        if self.path == "/api/log":
            length = int(self.headers.get("Content-Length", 0))
            body   = self.rfile.read(length)
            try:
                entry = json.loads(body)
                append_log(entry)
                self._json({"ok": True})
            except Exception as e:
                self._json({"ok": False, "error": str(e)}, 400)
        else:
            self.send_error(404)

    def _cors(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin",  "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")

    def _json(self, data, status=200):
        body = json.dumps(data, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("Content-Type",   "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control",  "no-cache")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_):
        pass  # silence request log


# ── Boot ──────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    server = HTTPServer(("localhost", PORT), VaultHandler)
    print(f"  Faust Vault  →  http://localhost:{PORT}")
    print(f"  Root:           {ROOT}")
    print(f"  Log:            {LOG}")
    print(f"  Ctrl+C to stop.\n")
    threading.Timer(0.9, lambda: webbrowser.open(f"http://localhost:{PORT}")).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n  Stopped.")
        sys.exit(0)
