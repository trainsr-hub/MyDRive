<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Ember Drift</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #0a0604; }
  canvas { display: block; width: 100%; height: 100%; }
  #label {
    position: fixed; bottom: 18px; left: 20px;
    font-family: 'Courier New', monospace; font-size: 10px;
    letter-spacing: 0.15em; color: rgba(255,160,60,0.2);
    text-transform: uppercase; pointer-events: none; user-select: none;
  }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="label">Ember Drift · Roll 001</div>
<script>
const canvas = document.getElementById('c');
const ctx    = canvas.getContext('2d');
let W, H;

function resize() {
  W = canvas.width  = window.innerWidth;
  H = canvas.height = window.innerHeight;
}

// ── Particle pool ──────────────────────────────────────────
const particles = [];
const MAX_EMBERS = 300;

function randRange(a, b) { return Math.random() * (b - a) + a; }

function spawnEmber(x, y) {
  return {
    type:    'ember',
    x:       x  ?? randRange(0, W),
    y:       y  ?? H + randRange(5, 20),
    vx:      randRange(-0.4, 0.4),
    vy:      randRange(-0.6, -1.4),
    life:    1,
    decay:   randRange(0.002, 0.005),
    size:    randRange(1.2, 3.0),
    hue:     randRange(14, 38),
    sat:     randRange(80, 100),
  };
}

function spawnSpark(ox, oy, angle) {
  const speed = randRange(3, 9);
  return {
    type:  'spark',
    x:     ox,
    y:     oy,
    vx:    Math.cos(angle) * speed,
    vy:    Math.sin(angle) * speed - randRange(1, 3),
    life:  1,
    decay: randRange(0.012, 0.022),
    size:  randRange(1.0, 2.2),
    hue:   randRange(38, 60),   // white-hot yellow
    sat:   100,
    grav:  randRange(0.08, 0.16),
  };
}

// Seed initial embers
for (let i = 0; i < MAX_EMBERS; i++) {
  const p = spawnEmber();
  p.y = randRange(0, H);       // scatter vertically on first load
  p.life = randRange(0.2, 1);
  particles.push(p);
}

// ── Trigger ────────────────────────────────────────────────
function triggerBurst(ox, oy) {
  // Shockwave: push nearby embers radially
  particles.forEach(p => {
    if (p.type !== 'ember') return;
    const dx = p.x - ox, dy = p.y - oy;
    const dist = Math.sqrt(dx * dx + dy * dy);
    if (dist < 220 && dist > 0) {
      const force = (1 - dist / 220) * 6;
      p.vx += (dx / dist) * force;
      p.vy += (dy / dist) * force;
    }
  });

  // Spawn sparks
  for (let i = 0; i < 90; i++) {
    particles.push(spawnSpark(ox, oy, randRange(0, Math.PI * 2)));
  }
}

// ── Main loop ──────────────────────────────────────────────
function tick() {
  // Trail fade — warm near-black
  ctx.fillStyle = 'rgba(10,6,4,0.13)';
  ctx.fillRect(0, 0, W, H);

  // Maintain ember count
  const emberCount = particles.filter(p => p.type === 'ember').length;
  const deficit    = MAX_EMBERS - emberCount;
  for (let i = 0; i < Math.min(deficit, 3); i++) particles.push(spawnEmber());

  // Update + draw
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.life -= p.decay;

    if (p.life <= 0) { particles.splice(i, 1); continue; }

    if (p.type === 'ember') {
      // Gentle horizontal wobble
      p.vx += randRange(-0.04, 0.04);
      p.vx  = Math.max(-1.2, Math.min(1.2, p.vx * 0.98));
      p.vy *= 0.995;
      p.x  += p.vx;
      p.y  += p.vy;
      // Wrap sides
      if (p.x < -10) p.x = W + 10;
      if (p.x > W + 10) p.x = -10;
      // Recycle when it drifts off-screen top or fully fades
      if (p.y < -20) { particles.splice(i, 1); continue; }

      const alpha = p.life * 0.85;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.hue},${p.sat}%,65%,${alpha})`;
      ctx.fill();

      // Soft glow
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size * 3, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.hue},${p.sat}%,50%,${alpha * 0.12})`;
      ctx.fill();

    } else {
      // Spark — has gravity
      p.vy += p.grav;
      p.x  += p.vx;
      p.y  += p.vy;
      p.vx *= 0.98;

      if (p.y > H + 20) { particles.splice(i, 1); continue; }

      const alpha = p.life;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.hue},${p.sat}%,92%,${alpha})`;
      ctx.fill();

      // Bright glow on sparks
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size * 4, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.hue},80%,70%,${alpha * 0.15})`;
      ctx.fill();
    }
  }

  requestAnimationFrame(tick);
}

canvas.addEventListener('click', e => triggerBurst(e.clientX, e.clientY));
window.addEventListener('resize', resize);
resize();
tick();
</script>
</body>
</html>
