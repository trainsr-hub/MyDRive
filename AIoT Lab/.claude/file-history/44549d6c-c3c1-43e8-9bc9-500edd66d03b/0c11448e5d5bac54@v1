<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Animation Gallery</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap">
<style>
/* ─── Tokens — Obsidian-register palette ───────────────────── */
/* Layout: flush sidebar (no chrome), content fills the rest   */
:root {
  --bg:       #1e1e1e;
  --sidebar:  #161616;
  --hover:    rgba(255,255,255,0.055);
  --active:   rgba(255,255,255,0.09);
  --divider:  rgba(255,255,255,0.06);
  --fg:       rgba(220,220,220,0.82);
  --fg-dim:   rgba(180,180,180,0.38);
  --fg-icon:  rgba(180,180,180,0.5);
  --accent:   #7c6fcd;          /* Obsidian purple, muted */
  --panel-w:  220px;
  --font:     'Inter', system-ui, sans-serif;
  color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }

body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font);
  font-size: 13px;
  display: flex;
}

/* ─── Sidebar ──────────────────────────────────────────────── */
#panel {
  width: var(--panel-w);
  min-width: var(--panel-w);
  height: 100%;
  background: var(--sidebar);
  display: flex;
  flex-direction: column;
  transition: transform 0.22s ease;
}

/* Vault name row */
#vault-row {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 14px 12px 10px;
  color: var(--fg-dim);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.03em;
  user-select: none;
  flex-shrink: 0;
}

#vault-row svg { opacity: 0.55; flex-shrink: 0; }

/* Section label */
.section-label {
  padding: 10px 12px 4px;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-dim);
  user-select: none;
  flex-shrink: 0;
}

/* File list */
#anim-list {
  flex: 1;
  overflow-y: auto;
  padding-block: 2px;
  scrollbar-width: none;
}

#anim-list::-webkit-scrollbar { display: none; }

.anim-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border-radius: 4px;
  margin: 1px 6px;
  cursor: pointer;
  transition: background 0.1s;
  user-select: none;
  min-height: 28px;
}

.anim-item:hover  { background: var(--hover); }
.anim-item.active { background: var(--active); }

/* File icon */
.item-icon {
  flex-shrink: 0;
  opacity: 0.45;
  transition: opacity 0.1s;
}
.anim-item.active  .item-icon,
.anim-item:hover   .item-icon { opacity: 0.7; }

.item-name {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--fg-dim);
  font-size: 13px;
  font-weight: 400;
  transition: color 0.1s;
}

.anim-item:hover  .item-name { color: var(--fg); }
.anim-item.active .item-name { color: var(--fg); font-weight: 500; }

/* Bottom action strip — ghosted, no border */
#panel-actions {
  padding: 8px 6px 12px;
  display: flex;
  gap: 2px;
  flex-shrink: 0;
}

.act-btn {
  flex: 1;
  height: 28px;
  background: none;
  border: none;
  border-radius: 4px;
  color: var(--fg-dim);
  font-family: var(--font);
  font-size: 11px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  transition: background 0.1s, color 0.1s;
}
.act-btn:hover { background: var(--hover); color: var(--fg); }
.act-btn svg   { flex-shrink: 0; }

/* ─── Main ─────────────────────────────────────────────────── */
#main {
  flex: 1;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Thin breadcrumb bar at top — fades out */
#topbar {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 36px;
  display: flex;
  align-items: center;
  padding: 0 14px;
  gap: 6px;
  background: linear-gradient(to bottom, rgba(30,30,30,0.85) 60%, transparent);
  z-index: 5;
  pointer-events: none;
}

#crumb-icon { opacity: 0.3; }

#current-label {
  font-size: 12px;
  color: var(--fg-dim);
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Frame */
#frame-wrap { flex: 1; position: relative; }

#anim-frame {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  border: none; display: block;
}

/* Empty state */
#empty-state {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 8px; text-align: center; padding: 24px;
}

#empty-state svg { opacity: 0.18; }

#empty-state p {
  font-size: 13px;
  color: var(--fg-dim);
  max-width: 240px;
  line-height: 1.6;
}

/* KB hint */
#kb-hint {
  position: absolute; bottom: 12px; right: 14px;
  font-size: 10px; color: var(--fg-dim); opacity: 0.35;
  pointer-events: none; line-height: 1.9; text-align: right;
  font-family: var(--font);
}

kbd {
  display: inline-block; padding: 0 4px;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 3px; font-size: 9px;
  background: rgba(255,255,255,0.04);
  font-family: inherit;
}

/* ─── Mobile ───────────────────────────────────────────────── */
@media (max-width: 600px) {
  #panel {
    position: absolute; inset: 0 auto 0 0;
    z-index: 20;
    box-shadow: 6px 0 20px rgba(0,0,0,0.5);
  }
  #panel.hidden { transform: translateX(-100%); }
  #kb-hint { display: none; }
}
</style>
</head>
<body>

<!-- ─── Sidebar ─────────────────────────────────────── -->
<div id="panel">

  <div id="vault-row">
    <!-- folder icon -->
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
      <path d="M1.5 3.5C1.5 2.948 1.948 2.5 2.5 2.5H5.25L6.5 4H11.5C12.052 4 12.5 4.448 12.5 5V10.5C12.5 11.052 12.052 11.5 11.5 11.5H2.5C1.948 11.5 1.5 11.052 1.5 10.5V3.5Z" fill="currentColor" fill-opacity="0.7"/>
    </svg>
    Animations
  </div>

  <div class="section-label">Files</div>

  <div id="anim-list"><!-- populated by JS --></div>

  <div id="panel-actions">
    <button class="act-btn" id="prev-btn" title="Previous  ←">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path d="M7 2.5L3.5 6 7 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Prev
    </button>
    <button class="act-btn" id="next-btn" title="Next  →">
      Next
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path d="M5 2.5L8.5 6 5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="act-btn" id="open-btn" title="Open fullscreen  F" style="flex:0.7">
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
        <path d="M6.5 1.5H9.5V4.5M9.5 1.5L5.5 5.5M2 4V9H7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>

<!-- ─── Main ─────────────────────────────────────────── -->
<div id="main">
  <div id="topbar">
    <svg id="crumb-icon" width="12" height="12" viewBox="0 0 12 12" fill="none">
      <rect x="1.5" y="2" width="9" height="8" rx="1" stroke="currentColor" stroke-width="1.1"/>
      <path d="M4 5.5H8M4 7.5H6.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
    </svg>
    <span id="current-label">—</span>
  </div>

  <div id="frame-wrap">
    <div id="empty-state">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
        <rect x="6" y="8" width="28" height="24" rx="2" stroke="currentColor" stroke-width="1.5"/>
        <path d="M12 16h16M12 21h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <p>Select a file from the panel to preview it here.</p>
    </div>
    <iframe id="anim-frame" hidden title="Animation preview"></iframe>
  </div>
</div>

<div id="kb-hint">
  <kbd>←</kbd> <kbd>→</kbd> navigate &nbsp;·&nbsp; <kbd>F</kbd> fullscreen
</div>

<script>
// ─── Manifest — add entries here as new files are created ──────────────────
const ANIMS = [
  { name: "Particle Field",  file: "anim_001_particle_field.html" },
  { name: "Aurora Waves",    file: "anim_002_aurora_waves.html"   },
  { name: "Geometry Morph",  file: "anim_003_geometry_morph.html" },
];

// ─── State ─────────────────────────────────────────────────────────────────
let current = -1;

// ─── DOM ───────────────────────────────────────────────────────────────────
const list       = document.getElementById('anim-list');
const frame      = document.getElementById('anim-frame');
const emptyState = document.getElementById('empty-state');
const label      = document.getElementById('current-label');
const panel      = document.getElementById('panel');

// Small SVG for the file icon in each row
const FILE_ICON = `<svg class="item-icon" width="13" height="13" viewBox="0 0 13 13" fill="none">
  <path d="M3 1.5H7.5L10 4V11.5H3V1.5Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
  <path d="M7.5 1.5V4H10" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/>
</svg>`;

// ─── Build list ────────────────────────────────────────────────────────────
function buildList() {
  list.innerHTML = '';
  ANIMS.forEach((anim, idx) => {
    const el = document.createElement('div');
    el.className = 'anim-item';
    el.innerHTML = `${FILE_ICON}<span class="item-name">${anim.name}</span>`;
    el.addEventListener('click', () => select(idx));
    list.appendChild(el);
  });
}

// ─── Select ────────────────────────────────────────────────────────────────
function select(idx) {
  if (idx < 0 || idx >= ANIMS.length) return;
  current = idx;
  const anim = ANIMS[idx];

  list.querySelectorAll('.anim-item').forEach((el, i) => {
    el.classList.toggle('active', i === idx);
  });

  const activeEl = list.querySelector('.anim-item.active');
  if (activeEl) activeEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });

  frame.hidden = false;
  emptyState.hidden = true;
  frame.src = anim.file;
  label.textContent = anim.name;

  try { localStorage.setItem('fg-anim-idx', idx); } catch (_) {}
}

// ─── Navigation ────────────────────────────────────────────────────────────
function prev() { select(current <= 0 ? ANIMS.length - 1 : current - 1); }
function next() { select(current >= ANIMS.length - 1 ? 0 : current + 1); }

document.getElementById('prev-btn').addEventListener('click', prev);
document.getElementById('next-btn').addEventListener('click', next);
document.getElementById('open-btn').addEventListener('click', () => {
  if (current >= 0) window.open(ANIMS[current].file, '_blank');
});

// ─── Keyboard ──────────────────────────────────────────────────────────────
document.addEventListener('keydown', e => {
  if (e.target.tagName === 'INPUT') return;
  if (e.key === 'ArrowLeft'  || e.key === 'a' || e.key === 'A') { e.preventDefault(); prev(); }
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') { e.preventDefault(); next(); }
  if (e.key === 'f' || e.key === 'F') { if (current >= 0) window.open(ANIMS[current].file, '_blank'); }
  const n = parseInt(e.key);
  if (!isNaN(n) && n >= 1 && n <= ANIMS.length) select(n - 1);
});

// ─── Init ──────────────────────────────────────────────────────────────────
buildList();
let startIdx = 0;
try {
  const saved = parseInt(localStorage.getItem('fg-anim-idx'));
  if (!isNaN(saved) && saved >= 0 && saved < ANIMS.length) startIdx = saved;
} catch (_) {}
select(startIdx);
</script>
</body>
</html>
