<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Geometry Morph</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #0a0a0f; }
  canvas { display: block; width: 100%; height: 100%; }
  #label {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    font-family: 'Courier New', monospace; font-size: 11px; letter-spacing: 0.2em;
    color: rgba(255,255,255,0.25); text-transform: uppercase; pointer-events: none;
  }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="label">Geometry Morph · 003</div>
<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
let W, H, t = 0;

function resize() {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
}

function polygonPoints(cx, cy, r, n, rot) {
  return Array.from({ length: n }, (_, i) => {
    const angle = (i / n) * Math.PI * 2 + rot;
    return [cx + Math.cos(angle) * r, cy + Math.sin(angle) * r];
  });
}

function lerpPts(a, b, k) {
  const len = Math.max(a.length, b.length);
  return Array.from({ length: len }, (_, i) => {
    const ai = a[i % a.length];
    const bi = b[i % b.length];
    return [ai[0] + (bi[0] - ai[0]) * k, ai[1] + (bi[1] - ai[1]) * k];
  });
}

function drawPoly(pts, strokeColor, glowColor, lineWidth) {
  if (!pts.length) return;

  // Glow pass
  ctx.save();
  ctx.shadowColor = glowColor;
  ctx.shadowBlur = 20;
  ctx.beginPath();
  ctx.moveTo(pts[0][0], pts[0][1]);
  pts.slice(1).forEach(([x, y]) => ctx.lineTo(x, y));
  ctx.closePath();
  ctx.strokeStyle = strokeColor;
  ctx.lineWidth = lineWidth;
  ctx.stroke();
  ctx.restore();
}

const SHAPES = [3, 4, 5, 6, 8, 12];

function getShape(idx) { return SHAPES[idx % SHAPES.length]; }

function tick() {
  t += 0.008;

  ctx.fillStyle = 'rgba(10, 10, 15, 0.18)';
  ctx.fillRect(0, 0, W, H);

  const cx = W / 2, cy = H / 2;
  const baseR = Math.min(W, H) * 0.32;

  const cycle = t * 0.25;
  const morphPhase = (cycle % 1);
  const fromIdx = Math.floor(cycle) % SHAPES.length;
  const toIdx = (fromIdx + 1) % SHAPES.length;

  // Eased morph (smooth step)
  const ease = morphPhase < 0.5
    ? 4 * morphPhase * morphPhase * morphPhase
    : 1 - Math.pow(-2 * morphPhase + 2, 3) / 2;

  // Multiple nested rings
  for (let ring = 0; ring < 5; ring++) {
    const rFactor = 1 - ring * 0.16;
    const r = baseR * rFactor;
    const rot = t * (ring % 2 === 0 ? 0.3 : -0.25) + ring * 0.4;
    const hue = (t * 30 + ring * 40) % 360;

    const fromN = getShape(fromIdx + ring);
    const toN = getShape(toIdx + ring);

    // Build enough points for smooth morph — LCM approach via oversampling
    const samples = fromN * toN;
    const from = Array.from({ length: samples }, (_, i) => {
      const angle = (i / samples) * Math.PI * 2 + rot;
      const fi = Math.round((i / samples) * fromN) % fromN;
      const base = polygonPoints(cx, cy, r, fromN, rot)[fi];
      return base;
    });
    const pts = polygonPoints(cx, cy, r, fromN, rot);
    const ptsTo = polygonPoints(cx, cy, r, toN, rot + Math.PI / toN);
    // Resample both to same count
    const N = Math.max(fromN, toN) * 2;
    function resample(poly, n) {
      return Array.from({ length: n }, (_, i) => {
        const t2 = i / n;
        const idx2 = t2 * poly.length;
        const i0 = Math.floor(idx2) % poly.length;
        const i1 = (i0 + 1) % poly.length;
        const frac = idx2 - Math.floor(idx2);
        return [
          poly[i0][0] + (poly[i1][0] - poly[i0][0]) * frac,
          poly[i0][1] + (poly[i1][1] - poly[i0][1]) * frac
        ];
      });
    }
    const resampled = lerpPts(resample(pts, N), resample(ptsTo, N), ease);

    const alpha = 0.8 - ring * 0.12;
    const strokeColor = `hsla(${hue}, 85%, 65%, ${alpha})`;
    const glowColor = `hsla(${hue}, 100%, 70%, 0.6)`;
    drawPoly(resampled, strokeColor, glowColor, 1.5 - ring * 0.2);
  }

  // Center orb
  const orbR = 6 + Math.sin(t * 2) * 2;
  const orbHue = (t * 60) % 360;
  const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, orbR * 3);
  grad.addColorStop(0, `hsla(${orbHue}, 100%, 90%, 0.9)`);
  grad.addColorStop(0.4, `hsla(${orbHue}, 90%, 65%, 0.4)`);
  grad.addColorStop(1, 'transparent');
  ctx.beginPath();
  ctx.arc(cx, cy, orbR * 3, 0, Math.PI * 2);
  ctx.fillStyle = grad;
  ctx.fill();

  requestAnimationFrame(tick);
}

window.addEventListener('resize', resize);
resize();
tick();
</script>
</body>
</html>
