<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Void Lotus — Roll 003</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%;
  background: #080510;
  font-family: Arial, Helvetica, sans-serif;
  overflow: hidden;
}
.scene {
  position: relative; width: 100%; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  overflow: hidden;
}
.stars {
  position: absolute; inset: 0; opacity: .25; pointer-events: none;
  background-image:
    radial-gradient(circle, rgba(200,120,255,.8) 0 1px, transparent 1.4px),
    radial-gradient(circle, rgba(255,180,255,.4) 0 1px, transparent 1.4px);
  background-size: 110px 110px, 175px 175px;
  background-position: 15px 30px, 80px 70px;
}
.orb-wrap {
  position: relative; width: 340px; height: 340px;
  flex-shrink: 0; transform-style: preserve-3d; perspective: 1000px;
}
.core {
  position: absolute; inset: 28%; border-radius: 50%;
  background: radial-gradient(circle, #0e0416 0 52%, #1e0830 65%, rgba(60,10,90,.7) 78%, transparent 100%);
  box-shadow: 0 0 22px #000, 0 0 60px rgba(160,40,220,.35), 0 0 130px rgba(120,20,180,.18);
}
.ring {
  position: absolute; left: 50%; top: 50%;
  width: var(--d); height: var(--d); border-radius: 50%;
  border: var(--th) solid transparent; transform-origin: center center;
  transform: translate(-50%,-50%) rotateX(var(--tilt)) rotateZ(0deg);
  transform-style: preserve-3d; mix-blend-mode: screen; pointer-events: none; opacity: var(--op);
}
.ring-1 { --d:350px; --th:4px; --tilt:69deg; --op:.92;
  border-top-color: rgba(200,80,255,.95); border-right-color: rgba(140,20,200,.90); border-bottom-color: rgba(80,0,140,.55);
  filter: drop-shadow(0 0 9px rgba(180,60,255,.9)); animation: r1 2000ms linear infinite;
}
.ring-2 { --d:298px; --th:3px; --tilt:63deg; --op:.84;
  border-left-color: rgba(240,160,255,.90); border-top-color: rgba(180,40,240,.88); border-bottom-color: rgba(100,0,160,.52);
  filter: drop-shadow(0 0 13px rgba(200,80,255,.92)); animation: r2 1350ms linear infinite reverse;
}
.ring-3 { --d:248px; --th:5px; --tilt:57deg; --op:.78;
  border-right-color: rgba(255,180,240,.75); border-left-color: rgba(160,20,220,.90);
  filter: blur(1px) drop-shadow(0 0 15px rgba(180,40,240,.88)); animation: r3 840ms linear infinite;
}
.ring-4 { --d:204px; --th:3px; --tilt:51deg; --op:.64;
  border-top-color: rgba(220,120,255,.82); border-bottom-color: rgba(120,0,180,.86);
  filter: drop-shadow(0 0 11px rgba(180,40,240,.80)); animation: r4 640ms linear infinite reverse;
}
@keyframes r1 {
  from { transform: translate(-50%,-50%) rotateX(69deg) rotateZ(0deg); }
  to   { transform: translate(-50%,-50%) rotateX(69deg) rotateZ(360deg); }
}
@keyframes r2 {
  from { transform: translate(-50%,-50%) rotateX(63deg) rotateZ(360deg); }
  to   { transform: translate(-50%,-50%) rotateX(63deg) rotateZ(0deg); }
}
@keyframes r3 {
  from { transform: translate(-50%,-50%) rotateX(57deg) rotateZ(0deg); }
  to   { transform: translate(-50%,-50%) rotateX(57deg) rotateZ(360deg); }
}
@keyframes r4 {
  from { transform: translate(-50%,-50%) rotateX(51deg) rotateZ(360deg); }
  to   { transform: translate(-50%,-50%) rotateX(51deg) rotateZ(0deg); }
}
.glow-ring {
  position: absolute; left: 50%; top: 50%; border-radius: 50%;
  border: 1px solid rgba(180,80,255,.12); transform: translate(-50%,-50%); pointer-events: none;
}
.glow-ring-1 { width: 400px; height: 400px; border-color: rgba(180,80,255,.08); }
.glow-ring-2 { width: 375px; height: 375px; border-color: rgba(180,80,255,.13); }

.particle-field { position: absolute; inset: 0; z-index: 28; pointer-events: none; }
.particle {
  position: absolute; left: 50%; top: 50%;
  width: var(--sz); height: var(--sz); border-radius: 50%; opacity: 0;
  background: radial-gradient(circle at 30% 30%, #fff 0 14%, #e8a0ff 32%, #8000b0 60%, transparent 76%);
  box-shadow: 0 0 5px rgba(255,255,255,.9), 0 0 14px rgba(180,60,255,.8);
  transform: translate(-50%,-50%) rotate(var(--ang)) translateX(var(--rad)) rotate(calc(var(--ang) * -1));
}
.particle.orbit    { animation: pOrbit var(--ot) cubic-bezier(.37,0,.63,1) forwards; }
.particle.compress { animation: pCompress var(--ct) cubic-bezier(.15,.65,.06,1) forwards; }
@keyframes pOrbit {
  0%   { opacity:0; transform:translate(-50%,-50%) rotate(var(--ang)) translateX(var(--rad)) rotate(calc(var(--ang)*-1)) scale(.2); }
  12%  { opacity:var(--op); }
  52%  { opacity:var(--op); transform:translate(-50%,-50%) rotate(calc(var(--ang)+150deg)) translateX(calc(var(--rad)*.96)) rotate(calc((var(--ang)+150deg)*-1)) scale(1); }
  100% { opacity:var(--op); transform:translate(-50%,-50%) rotate(calc(var(--ang)+340deg)) translateX(calc(var(--rad)*.78)) rotate(calc((var(--ang)+340deg)*-1)) scale(.8); }
}
@keyframes pCompress {
  0%   { opacity:1; transform:translate(-50%,-50%) rotate(var(--ang2)) translateX(var(--rad2)) rotate(calc(var(--ang2)*-1)) scale(1); }
  30%  { transform:translate(-50%,-50%) rotate(calc(var(--ang2)+170deg)) translateX(calc(var(--rad2)*.45)) rotate(calc((var(--ang2)+170deg)*-1)) scale(1.08); }
  66%  { transform:translate(-50%,-50%) rotate(calc(var(--ang2)+350deg)) translateX(48px) rotate(calc((var(--ang2)+350deg)*-1)) scale(.82); }
  88%  { opacity:.96; transform:translate(-50%,-50%) rotate(calc(var(--ang2)+430deg)) translateX(17px) rotate(calc((var(--ang2)+430deg)*-1)) scale(.55); }
  100% { opacity:0; transform:translate(-50%,-50%) scale(0); filter:blur(8px); }
}
.distortion {
  position: absolute; width: 900px; height: 900px; border-radius: 50%;
  z-index: 4; pointer-events: none; opacity: 0;
  background: radial-gradient(circle, transparent 0 17%, rgba(140,20,200,.08) 25%, transparent 43%);
  filter: blur(10px);
}
.distortion.active { animation: distort 4.6s ease-in-out forwards; }
@keyframes distort {
  0%  { opacity:0; transform:scale(.8); }
  12% { opacity:.85; transform:scale(1.03); }
  28% { opacity:.55; transform:scale(1.10); }
  46% { opacity:.15; transform:scale(.72); }
  62% { opacity:0;   transform:scale(.40); }
  76% { opacity:.75; transform:scale(.78); }
  100%{ opacity:0;   transform:scale(1.12); }
}
.shockwave {
  position: absolute; left: 50%; top: 50%; width: 60px; height: 60px; z-index: 86;
  border: 2px solid rgba(200,80,255,.95); border-radius: 50%; opacity: 0;
  transform: translate(-50%,-50%) scale(0); pointer-events: none;
}
.shockwave.active { animation: shock 700ms ease-out forwards; }
@keyframes shock {
  from { opacity:.95; transform:translate(-50%,-50%) scale(.2); }
  to   { opacity:0;   transform:translate(-50%,-50%) scale(18); }
}
.supernova {
  position: absolute; left: 50%; top: 50%; width: 26px; height: 8px; z-index: 90;
  opacity: 0; pointer-events: none; transform: translate(-50%,-50%) scaleX(0);
}
.supernova::before {
  content: ""; position: absolute; left: 50%; top: 50%; width: 100%; height: 5px;
  transform: translate(-50%,-50%); border-radius: 999px; background: white;
  box-shadow: 0 0 7px #fff, 0 0 24px #fff, 0 0 60px rgba(220,100,255,.96), 0 0 120px rgba(140,20,200,.92);
}
.supernova::after {
  content: ""; position: absolute; left: 50%; top: 50%; width: 100%; height: 46px;
  transform: translate(-50%,-50%);
  background: linear-gradient(90deg, transparent, rgba(180,40,240,.58), rgba(240,180,255,.96), rgba(180,40,240,.58), transparent);
  filter: blur(10px);
}
.supernova.active { animation: nova 480ms cubic-bezier(.06,.88,.12,1) forwards; }
@keyframes nova {
  0%  { opacity:0;   transform:translate(-50%,-50%) scaleX(0); }
  10% { opacity:1;   transform:translate(-50%,-50%) scaleX(.12); }
  34% { opacity:1;   transform:translate(-50%,-50%) scaleX(5); }
  62% { opacity:.95; transform:translate(-50%,-50%) scaleX(22); }
  100%{ opacity:0;   transform:translate(-50%,-50%) scaleX(52); }
}
.rebirth {
  position: absolute; left: 50%; top: 50%; width: 40px; height: 40px; z-index: 52;
  border: 2px solid rgba(200,80,255,.9); border-radius: 50%; opacity: 0;
  transform: translate(-50%,-50%) scale(0); pointer-events: none;
}
.rebirth.active { animation: rebirth 1s cubic-bezier(.08,.82,.12,1) forwards; }
@keyframes rebirth {
  0%  { opacity:0;   transform:translate(-50%,-50%) scale(.05); filter:blur(5px); }
  24% { opacity:1;   transform:translate(-50%,-50%) scale(.55); filter:blur(0); }
  62% { opacity:.85; transform:translate(-50%,-50%) scale(2.2); }
  100%{ opacity:0;   transform:translate(-50%,-50%) scale(4.8); filter:blur(4px); }
}
.matter-field { position: absolute; inset: 0; z-index: 55; pointer-events: none; }
.matter {
  position: absolute; left: 50%; top: 50%; width: var(--sz); height: var(--sz);
  border-radius: 50%; opacity: 0;
  background: radial-gradient(circle at 30% 30%, #fff 0 12%, #e07aff 32%, #7a00c8 62%, transparent 78%);
  box-shadow: 0 0 5px #fff, 0 0 14px rgba(200,60,255,.92);
  transform: translate(-50%,-50%) rotate(var(--ang)) translateX(3px);
}
.matter.active { animation: matterOut var(--dur) cubic-bezier(.08,.84,.13,1) forwards; }
@keyframes matterOut {
  0%  { opacity:0; transform:translate(-50%,-50%) rotate(var(--ang)) translateX(3px) scale(.1); }
  10% { opacity:1; } 75% { opacity:1; }
  100%{ opacity:0; transform:translate(-50%,-50%) rotate(var(--ang)) translateX(var(--dist)) scale(.42); }
}
.readout {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; pointer-events: none; z-index: 60;
}
.readout-label {
  font-family: monospace; font-size: 10px; color: rgba(200,100,255,.45);
  letter-spacing: .25em; text-transform: uppercase; margin-bottom: 4px;
}
.readout-value {
  font-family: monospace; font-weight: 900; font-size: 1.75rem;
  color: #d880ff; line-height: 1; text-shadow: 0 0 22px rgba(200,80,255,.5);
}
.readout-sub {
  font-family: monospace; font-size: 10px; color: rgba(200,100,255,.3); margin-top: 6px;
}
.controls {
  display: flex; flex-direction: column; align-items: center; gap: 16px;
  width: 100%; margin-top: 8px; position: relative; z-index: 100;
}
.deposit-btn {
  width: 260px; padding: 16px 0; border-radius: 16px;
  background: #2a0840; color: #e8a0ff;
  border: 1.5px solid rgba(180,60,255,.35);
  font-family: monospace; font-weight: 900; font-size: 13px;
  letter-spacing: .2em; text-transform: uppercase; cursor: pointer;
  transition: background .15s, transform .1s, box-shadow .15s;
  box-shadow: 0 0 28px rgba(160,40,220,.28);
}
.deposit-btn:hover:not(:disabled) {
  background: #380c55; box-shadow: 0 0 40px rgba(180,60,255,.45);
}
.deposit-btn:active:not(:disabled) { transform: scale(.97); }
.deposit-btn:disabled { opacity: .35; cursor: not-allowed; }
#label {
  position: fixed; bottom: 14px; left: 16px;
  font-family: monospace; font-size: 10px; letter-spacing: .15em;
  color: rgba(160,60,220,.2); text-transform: uppercase; pointer-events: none;
}
</style>
</head>
<body>
<div class="scene">
  <div class="stars"></div>
  <div class="orb-wrap">
    <div class="glow-ring glow-ring-1"></div>
    <div class="glow-ring glow-ring-2"></div>
    <div class="distortion" id="distortion"></div>
    <div class="ring ring-1"></div>
    <div class="ring ring-2"></div>
    <div class="ring ring-3"></div>
    <div class="ring ring-4"></div>
    <div class="core"></div>
    <div class="particle-field" id="particleField"></div>
    <div class="shockwave"    id="shockwave"></div>
    <div class="supernova"    id="supernova"></div>
    <div class="rebirth"      id="rebirth"></div>
    <div class="matter-field" id="matterField"></div>
    <div class="readout">
      <div class="readout-label">Petals</div>
      <div class="readout-value" id="balanceDisplay">0</div>
      <div class="readout-sub"   id="balanceSub">+0 this bloom</div>
    </div>
  </div>
  <div class="controls">
    <button class="deposit-btn" id="depositBtn" onclick="triggerBloom()">Bloom</button>
  </div>
</div>
<div id="label">Void Lotus · Roll 003</div>

<script>
let totalPetals = 0;
let blooming    = false;

function rollTo(from, to, duration = 1000) {
  const t0 = performance.now();
  function tick(now) {
    const p    = Math.min((now - t0) / duration, 1);
    const ease = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
    const val  = Math.round(from + (to - from) * ease);
    document.getElementById('balanceDisplay').textContent = val;
    if (p < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

function restart(el, cls) {
  el.classList.remove(cls);
  void el.offsetWidth;
  el.classList.add(cls);
}

function spawnParticles(count = 100) {
  const field = document.getElementById('particleField');
  field.innerHTML = '';
  for (let i = 0; i < count; i++) {
    const p      = document.createElement('div');
    const radius = 130 + Math.random() * 340;
    const angle  = Math.random() * 360;
    const size   = 2.0 + Math.random() * 6;
    const op     = .35 + Math.random() * .65;
    const ot     = 900 + Math.random() * 1400;
    const ct     = 700 + Math.random() * 600;
    p.className  = 'particle';
    p.style.setProperty('--rad', `${radius}px`);
    p.style.setProperty('--ang', `${angle}deg`);
    p.style.setProperty('--sz',  `${size}px`);
    p.style.setProperty('--op',  op);
    p.style.setProperty('--ot',  `${ot}ms`);
    p.style.setProperty('--ct',  `${ct}ms`);
    field.appendChild(p);
  }
  requestAnimationFrame(() => {
    [...field.children].forEach((c, i) => {
      setTimeout(() => c.classList.add('orbit'), Math.random() * 600 + i * 2);
    });
  });
}

function compressParticles() {
  const field = document.getElementById('particleField');
  [...field.children].forEach((c, i) => {
    const rad = c.style.getPropertyValue('--rad');
    const ang = parseFloat(c.style.getPropertyValue('--ang'));
    c.style.setProperty('--rad2', rad);
    c.style.setProperty('--ang2', `${ang + Math.random() * 90}deg`);
    setTimeout(() => {
      c.classList.remove('orbit');
      c.classList.add('compress');
    }, Math.random() * 400 + i * .7);
  });
}

function spawnMatter(count = 120) {
  const field = document.getElementById('matterField');
  field.innerHTML = '';
  for (let i = 0; i < count; i++) {
    const p        = document.createElement('div');
    const angle    = Math.random() * 360;
    const distance = 180 + Math.random() * 420;
    const dur      = 800 + Math.random() * 900;
    const size     = 1.5 + Math.random() * 5.5;
    p.className    = 'matter';
    p.style.setProperty('--ang',  `${angle}deg`);
    p.style.setProperty('--dist', `${distance}px`);
    p.style.setProperty('--dur',  `${dur}ms`);
    p.style.setProperty('--sz',   `${size}px`);
    field.appendChild(p);
    setTimeout(() => p.classList.add('active'), 400 + Math.random() * 500);
  }
}

const wait = ms => new Promise(r => setTimeout(r, ms));

async function triggerBloom() {
  if (blooming) return;
  blooming = true;
  document.getElementById('depositBtn').disabled = true;

  restart(document.getElementById('distortion'), 'active');
  await wait(90);
  spawnParticles(150);
  await wait(1050);

  compressParticles();
  await wait(280);

  restart(document.getElementById('shockwave'), 'active');
  restart(document.getElementById('supernova'), 'active');
  await wait(480);

  spawnMatter(120);
  restart(document.getElementById('rebirth'), 'active');

  const gained = (Math.floor(Math.random() * 11) + 1) * 7;
  const prev   = totalPetals;
  totalPetals += gained;
  rollTo(prev, totalPetals);
  document.getElementById('balanceSub').textContent = `+${gained} this bloom`;

  window.parent.postMessage({ type: 'summon', animation: 'Void Lotus', result: `+${gained} Petals` }, '*');

  await wait(1200);
  blooming = false;
  document.getElementById('depositBtn').disabled = false;
}

(async function idleLoop() {
  while (true) {
    spawnParticles(80);
    await wait(1200);
    compressParticles();
    await wait(3200);
  }
})();
</script>
</body>
</html>
