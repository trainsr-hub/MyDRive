<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Aurora Waves</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #030712; }
  canvas { display: block; width: 100%; height: 100%; }
  #label {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    font-family: 'Courier New', monospace; font-size: 11px; letter-spacing: 0.2em;
    color: rgba(255,255,255,0.25); text-transform: uppercase; pointer-events: none;
  }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="label">Aurora Waves · 002</div>
<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
let W, H, t = 0;

function resize() {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
}

function noise(x, y, t) {
  return (
    Math.sin(x * 0.008 + t * 0.7) * 0.4 +
    Math.sin(x * 0.015 - y * 0.006 + t * 0.5) * 0.3 +
    Math.cos(x * 0.005 + y * 0.009 + t * 0.9) * 0.3
  );
}

const LAYERS = [
  { hue: 160, sat: 80, amps: [0.22, 0.18, 0.12], speeds: [0.6, 0.9, 1.3], phases: [0, 1.2, 2.4], yBase: 0.45 },
  { hue: 200, sat: 85, amps: [0.18, 0.14, 0.10], speeds: [0.8, 1.1, 0.7], phases: [1.0, 2.1, 0.5], yBase: 0.52 },
  { hue: 260, sat: 75, amps: [0.15, 0.12, 0.09], speeds: [1.0, 0.6, 1.4], phases: [2.0, 0.3, 1.5], yBase: 0.58 },
  { hue: 300, sat: 70, amps: [0.12, 0.10, 0.08], speeds: [1.2, 0.8, 1.0], phases: [0.5, 1.8, 2.8], yBase: 0.64 },
];

function drawLayer(layer) {
  const { hue, sat, amps, speeds, phases, yBase } = layer;
  const pts = [];

  for (let x = 0; x <= W; x += 4) {
    let y = H * yBase;
    amps.forEach((a, i) => {
      y += Math.sin(x * 0.006 + t * speeds[i] + phases[i]) * H * a;
      y += Math.cos(x * 0.003 - t * speeds[i] * 0.7 + phases[i] * 1.3) * H * a * 0.5;
    });
    pts.push([x, y]);
  }

  const grad = ctx.createLinearGradient(0, H * (yBase - 0.4), 0, H);
  grad.addColorStop(0, `hsla(${hue}, ${sat}%, 65%, 0.55)`);
  grad.addColorStop(0.5, `hsla(${hue + 20}, ${sat}%, 55%, 0.25)`);
  grad.addColorStop(1, `hsla(${hue}, ${sat}%, 40%, 0)`);

  ctx.beginPath();
  ctx.moveTo(0, H);
  pts.forEach(([x, y]) => ctx.lineTo(x, y));
  ctx.lineTo(W, H);
  ctx.closePath();
  ctx.fillStyle = grad;
  ctx.fill();
}

function tick() {
  t += 0.012;

  // Deep background fade
  ctx.fillStyle = 'rgba(3, 7, 18, 0.25)';
  ctx.fillRect(0, 0, W, H);

  // Stars
  if (t % 1 < 0.012) {
    for (let i = 0; i < 3; i++) {
      const sx = Math.random() * W;
      const sy = Math.random() * H * 0.6;
      ctx.beginPath();
      ctx.arc(sx, sy, Math.random() * 1.2, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255,255,255,${Math.random() * 0.6 + 0.2})`;
      ctx.fill();
    }
  }

  ctx.save();
  ctx.globalCompositeOperation = 'screen';
  LAYERS.forEach(drawLayer);
  ctx.restore();

  requestAnimationFrame(tick);
}

window.addEventListener('resize', resize);
resize();
tick();
</script>
</body>
</html>
