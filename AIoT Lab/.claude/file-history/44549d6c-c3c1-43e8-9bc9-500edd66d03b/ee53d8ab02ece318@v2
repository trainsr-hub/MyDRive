<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portal Tear</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #080c10; font-family: Arial, sans-serif;
}

/* ── Two screen halves ── */
.half {
  position: fixed; top: 0; bottom: 0; width: 50%;
  transition: transform 0.55s cubic-bezier(.4,0,.2,1);
  overflow: hidden; z-index: 10;
}
.half-left  { left: 0;   transform: translateX(0); }
.half-right { right: 0;  transform: translateX(0); }
.half.split-left  { transform: translateX(-52%); }
.half.split-right { transform: translateX(52%); }

.half-bg {
  position: absolute; inset: 0;
  background: #080c10;
}
/* Dust motes on each half */
.half-left  .half-bg { background: linear-gradient(90deg, #080c10 70%, #0a1018 100%); }
.half-right .half-bg { background: linear-gradient(90deg, #0a1018 0%, #080c10 30%); }

/* ── Seam / crack ── */
.seam {
  position: fixed; left: 50%; top: 10%; bottom: 10%;
  width: 3px; margin-left: -1.5px;
  background: linear-gradient(to bottom, transparent, #60d8ff 15%, #fff 50%, #60d8ff 85%, transparent);
  z-index: 8;
  box-shadow: 0 0 8px #60d8ff, 0 0 20px rgba(96,216,255,.6), 0 0 40px rgba(96,216,255,.3);
  animation: seamBreath 3s ease-in-out infinite;
}
@keyframes seamBreath {
  0%,100% { opacity: .7; box-shadow: 0 0 8px #60d8ff, 0 0 20px rgba(96,216,255,.6); }
  50%      { opacity: 1;  box-shadow: 0 0 12px #a0f0ff, 0 0 32px rgba(150,230,255,.8); }
}

/* ── Inner glow (revealed when torn open) ── */
.rift-interior {
  position: fixed; left: 50%; top: 0; bottom: 0;
  width: 0; transform: translateX(-50%);
  background: linear-gradient(90deg, transparent, #002030, #00c8ff, #ffffff, #00c8ff, #002030, transparent);
  z-index: 9;
  transition: width 0.55s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.rift-interior.open { width: 200px; }

/* Arc SVG edges */
.arc-svg {
  position: fixed; top: 0; bottom: 0;
  width: 60px; z-index: 11; pointer-events: none;
  opacity: 0; transition: opacity 0.3s;
}
.arc-svg.show { opacity: 1; }
.arc-left  { left:  calc(50% - 100px - 60px); }
.arc-right { right: calc(50% - 100px - 60px); }

/* ── Result text ── */
.result-display {
  position: fixed; left: 50%; top: 50%;
  transform: translate(-50%, -50%) scale(0);
  z-index: 20; text-align: center;
  transition: transform 0.4s cubic-bezier(.2,1.4,.4,1), opacity 0.4s;
  opacity: 0; pointer-events: none;
}
.result-display.show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}
.result-tier {
  font-size: 11px; letter-spacing: .22em; text-transform: uppercase;
  color: var(--rc, #9ca3af); margin-bottom: 6px; opacity: .75;
}
.result-name {
  font-size: 28px; font-weight: 900; letter-spacing: .06em;
  color: var(--rc, #9ca3af);
  text-shadow: 0 0 30px var(--rc, #9ca3af);
}

/* ── Shockwave on close ── */
.shockwave {
  position: fixed; left: 50%; top: 50%;
  width: 40px; height: 40px; margin: -20px;
  border: 2px solid #60d8ff; border-radius: 50%;
  pointer-events: none; opacity: 0; z-index: 30;
}
.shockwave.active { animation: shockExpand .6s ease-out forwards; }
@keyframes shockExpand {
  from { opacity: .9; transform: scale(0.1); }
  to   { opacity: 0;  transform: scale(28); }
}

/* ── Button ── */
.controls {
  position: fixed; bottom: 28px; left: 50%;
  transform: translateX(-50%); z-index: 50;
}
.gate-btn {
  padding: 14px 48px;
  background: #0a1828; border: 1.5px solid rgba(96,216,255,.3);
  border-radius: 12px; color: #60d8ff;
  font-size: 13px; letter-spacing: .18em; text-transform: uppercase;
  cursor: pointer; transition: background .15s, box-shadow .15s, transform .1s;
  box-shadow: 0 0 20px rgba(0,150,200,.2);
}
.gate-btn:hover:not(:disabled) {
  background: #0d2035; box-shadow: 0 0 32px rgba(0,200,255,.3);
}
.gate-btn:active:not(:disabled) { transform: scale(.97); }
.gate-btn:disabled { opacity: .35; cursor: not-allowed; }

/* ── Label ── */
#label {
  position: fixed; bottom: 10px; left: 16px;
  font-family: monospace; font-size: 10px; letter-spacing: .14em;
  color: rgba(40,140,180,.2); text-transform: uppercase; pointer-events: none;
}

/* Dust motes  */
.mote {
  position: fixed;
  width: 2px; height: 2px; border-radius: 50%;
  background: rgba(96,216,255,.35);
  pointer-events: none;
  animation: moteDrift var(--dur) linear infinite;
  opacity: 0;
}
@keyframes moteDrift {
  0%   { transform: translate(0, 0); opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: .6; }
  100% { transform: translate(var(--dx), var(--dy)); opacity: 0; }
}
</style>
</head>
<body>

<div class="half half-left">  <div class="half-bg"></div> </div>
<div class="half half-right"> <div class="half-bg"></div> </div>

<div class="seam" id="seam"></div>

<div class="rift-interior" id="rift"></div>

<!-- Arc SVG overlays on rift edges -->
<svg class="arc-svg arc-left"  id="arcLeft"  viewBox="0 0 60 800" preserveAspectRatio="none">
  <polyline id="arcLPoly" points="" stroke="#60d8ff" stroke-width="1.5" fill="none"
            stroke-dasharray="800" stroke-dashoffset="800" opacity=".85">
    <animate attributeName="stroke-dashoffset" from="800" to="0" dur="0.4s" begin="indefinite" fill="freeze" id="arcLAnim"/>
  </polyline>
</svg>
<svg class="arc-svg arc-right" id="arcRight" viewBox="0 0 60 800" preserveAspectRatio="none">
  <polyline id="arcRPoly" points="" stroke="#60d8ff" stroke-width="1.5" fill="none"
            stroke-dasharray="800" stroke-dashoffset="800" opacity=".85">
    <animate attributeName="stroke-dashoffset" from="800" to="0" dur="0.4s" begin="indefinite" fill="freeze" id="arcRAnim"/>
  </polyline>
</svg>

<div class="result-display" id="resultDisplay">
  <div class="result-tier" id="resultTier">—</div>
  <div class="result-name" id="resultName">—</div>
</div>

<div class="shockwave" id="shockwave"></div>

<div class="controls">
  <button class="gate-btn" id="gateBtn" onclick="openGate()">Open Gate</button>
</div>

<div id="label">Portal Tear · Summon</div>

<script>
const RARITIES = [
  { tier: 'God-tier',  name: 'The Eternal',   color: '#fbbf24', weight: 5  },
  { tier: 'Ancient',   name: 'The Forgotten',  color: '#a855f7', weight: 15 },
  { tier: 'Champion',  name: 'The Sovereign',  color: '#60a5fa', weight: 30 },
  { tier: 'Wanderer',  name: 'The Wanderer',   color: '#9ca3af', weight: 50 },
];

function roll() {
  const total = RARITIES.reduce((a, r) => a + r.weight, 0);
  let rand = Math.random() * total;
  for (const r of RARITIES) { rand -= r.weight; if (rand <= 0) return r; }
  return RARITIES[RARITIES.length - 1];
}

// Spawn motes
for (let i = 0; i < 18; i++) {
  const m = document.createElement('div');
  m.className = 'mote';
  m.style.left   = Math.random() * 100 + 'vw';
  m.style.top    = Math.random() * 100 + 'vh';
  m.style.setProperty('--dur', (6 + Math.random() * 10) + 's');
  m.style.setProperty('--dx',  (Math.random() * 60 - 30) + 'px');
  m.style.setProperty('--dy',  (Math.random() * 60 - 30) + 'px');
  m.style.animationDelay = (Math.random() * 8) + 's';
  document.body.appendChild(m);
}

// Generate jagged arc points
function makeArcPoints(side) {
  const pts = [];
  const steps = 20;
  for (let i = 0; i <= steps; i++) {
    const y = (i / steps) * 800;
    const x = side === 'left' ? 60 - Math.random() * 30 : Math.random() * 30;
    pts.push(`${x},${y}`);
  }
  return pts.join(' ');
}

const wait = ms => new Promise(r => setTimeout(r, ms));
let busy = false;

async function openGate() {
  if (busy) return;
  busy = true;
  document.getElementById('gateBtn').disabled = true;

  const result = roll();

  // Generate arc paths
  document.getElementById('arcLPoly').setAttribute('points', makeArcPoints('left'));
  document.getElementById('arcRPoly').setAttribute('points', makeArcPoints('right'));

  // Split halves
  document.querySelector('.half-left').classList.add('split-left');
  document.querySelector('.half-right').classList.add('split-right');
  document.getElementById('rift').classList.add('open');
  document.getElementById('arcLeft').classList.add('show');
  document.getElementById('arcRight').classList.add('show');
  document.getElementById('arcLAnim').beginElement();
  document.getElementById('arcRAnim').beginElement();

  await wait(600);

  // Show result
  const disp = document.getElementById('resultDisplay');
  disp.style.setProperty('--rc', result.color);
  document.getElementById('resultTier').textContent = result.tier;
  document.getElementById('resultName').textContent = result.name;
  disp.classList.add('show');

  window.parent.postMessage({ type: 'summon', animation: 'Portal Tear', result: result.name }, '*');

  await wait(2500);

  // Slam shut
  disp.classList.remove('show');
  document.querySelector('.half-left').classList.remove('split-left');
  document.querySelector('.half-right').classList.remove('split-right');
  document.getElementById('rift').classList.remove('open');
  document.getElementById('arcLeft').classList.remove('show');
  document.getElementById('arcRight').classList.remove('show');

  // Shockwave
  const sw = document.getElementById('shockwave');
  sw.classList.remove('active');
  void sw.offsetWidth;
  sw.classList.add('active');

  await wait(800);
  busy = false;
  document.getElementById('gateBtn').disabled = false;
}
</script>
</body>
</html>
