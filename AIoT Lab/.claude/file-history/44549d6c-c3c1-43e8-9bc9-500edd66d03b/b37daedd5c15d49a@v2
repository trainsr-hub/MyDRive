"""
Faust Animation Vault — local dev server
Run: python server.py
Opens on http://localhost:7700

Serves the System Design Sandbox directory and exposes
GET /api/tree   → recursive file tree of Animations/
"""
import json
import os
import sys
from http.server import HTTPServer, SimpleHTTPRequestHandler
from pathlib import Path
import webbrowser
import threading

ROOT   = Path(__file__).parent
VAULT  = ROOT / "Animations"
PORT   = 7700


def build_tree(path: Path, rel_root: Path) -> list:
    """Return a sorted list of node dicts — folders first, then files."""
    nodes = []
    try:
        entries = sorted(path.iterdir(), key=lambda p: (p.is_file(), p.name.lower()))
    except PermissionError:
        return nodes

    for entry in entries:
        rel = entry.relative_to(rel_root)
        if entry.is_dir():
            nodes.append({
                "type":     "folder",
                "name":     entry.name,
                "path":     str(rel).replace("\\", "/"),
                "children": build_tree(entry, rel_root),
            })
        elif entry.suffix.lower() == ".html":
            nodes.append({
                "type":  "file",
                "name":  entry.stem,          # display name without .html
                "file":  entry.name,
                "path":  str(rel).replace("\\", "/"),
            })
    return nodes


class VaultHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(ROOT), **kwargs)

    def do_GET(self):
        if self.path == "/api/tree":
            self._serve_tree()
        else:
            super().do_GET()

    def _serve_tree(self):
        tree = build_tree(VAULT, VAULT)
        body = json.dumps(tree, ensure_ascii=False).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        # Suppress noisy request log
        pass


def open_browser():
    webbrowser.open(f"http://localhost:{PORT}/index.html")


if __name__ == "__main__":
    server = HTTPServer(("localhost", PORT), VaultHandler)
    print(f"  Faust Vault  →  http://localhost:{PORT}/index.html")
    print(f"  Serving:        {ROOT}")
    print(f"  Press Ctrl+C to stop.\n")
    threading.Timer(0.8, open_browser).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n  Server stopped.")
        sys.exit(0)
