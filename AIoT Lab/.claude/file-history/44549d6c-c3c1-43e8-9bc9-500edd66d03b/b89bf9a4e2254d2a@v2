<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Particle Field</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #000; }
  canvas { display: block; width: 100%; height: 100%; }
  #label {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    font-family: 'Courier New', monospace; font-size: 11px; letter-spacing: 0.2em;
    color: rgba(255,255,255,0.3); text-transform: uppercase; pointer-events: none;
  }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="label">Particle Field · 001</div>
<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
let W, H, particles = [], mouse = { x: 0, y: 0 };
const N = 180;

function resize() {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
}

function rand(a, b) { return Math.random() * (b - a) + a; }

function createParticle() {
  return {
    x: rand(0, W), y: rand(0, H),
    vx: rand(-0.4, 0.4), vy: rand(-0.4, 0.4),
    r: rand(1, 2.5),
    opacity: rand(0.3, 0.9),
    hue: rand(180, 260)
  };
}

function init() {
  resize();
  particles = Array.from({ length: N }, createParticle);
}

function drawConnections() {
  for (let i = 0; i < particles.length; i++) {
    for (let j = i + 1; j < particles.length; j++) {
      const a = particles[i], b = particles[j];
      const dx = a.x - b.x, dy = a.y - b.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist > 120) continue;
      const alpha = (1 - dist / 120) * 0.15;
      ctx.beginPath();
      ctx.strokeStyle = `hsla(220, 80%, 70%, ${alpha})`;
      ctx.lineWidth = 0.5;
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
    }
  }
}

function drawMouseConnections() {
  particles.forEach(p => {
    const dx = p.x - mouse.x, dy = p.y - mouse.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    if (dist > 160) return;
    const alpha = (1 - dist / 160) * 0.5;
    ctx.beginPath();
    ctx.strokeStyle = `hsla(${p.hue}, 90%, 75%, ${alpha})`;
    ctx.lineWidth = 0.8;
    ctx.moveTo(mouse.x, mouse.y);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
  });
}

function tick() {
  ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
  ctx.fillRect(0, 0, W, H);

  drawConnections();
  drawMouseConnections();

  particles.forEach(p => {
    // Mouse repulsion
    const dx = p.x - mouse.x, dy = p.y - mouse.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    if (dist < 100) {
      p.vx += (dx / dist) * 0.08;
      p.vy += (dy / dist) * 0.08;
    }

    p.vx = Math.max(-1.2, Math.min(1.2, p.vx * 0.995));
    p.vy = Math.max(-1.2, Math.min(1.2, p.vy * 0.995));
    p.x += p.vx;
    p.y += p.vy;

    if (p.x < 0) p.x = W;
    if (p.x > W) p.x = 0;
    if (p.y < 0) p.y = H;
    if (p.y > H) p.y = 0;

    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    ctx.fillStyle = `hsla(${p.hue}, 80%, 70%, ${p.opacity})`;
    ctx.fill();
  });

  requestAnimationFrame(tick);
}

window.addEventListener('resize', init);
window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
init();
tick();
</script>
</body>
</html>
