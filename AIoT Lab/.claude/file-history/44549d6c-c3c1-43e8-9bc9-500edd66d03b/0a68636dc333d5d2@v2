<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Void Tendrils</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #07050f; }
  canvas { display: block; width: 100%; height: 100%; }
  #label {
    position: fixed; bottom: 18px; left: 20px;
    font-family: 'Courier New', monospace; font-size: 10px;
    letter-spacing: 0.15em; color: rgba(140,90,255,0.18);
    text-transform: uppercase; pointer-events: none; user-select: none;
  }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="label">Void Tendrils · Roll 002</div>
<script>
const canvas = document.getElementById('c');
const ctx    = canvas.getContext('2d');
let W, H, t  = 0;

function resize() {
  W = canvas.width  = window.innerWidth;
  H = canvas.height = window.innerHeight;
  initTendrils();
}

// ── Tendril system ─────────────────────────────────────────
const IDLE_COUNT  = 10;
const PT_COUNT    = 55;
let idleTendrils  = [];
let burstTendrils = [];

function makeTendril(cx, cy, baseAngle, hue, length) {
  return {
    cx, cy,
    baseAngle,
    hue,
    length,
    // Impulse state
    impulseX: 0,
    impulseY: 0,
    impulseDamp: 0,
    // Per-point computed each frame
    pts: new Array(PT_COUNT).fill(null).map(() => ({ x: 0, y: 0 })),
    // Unique wave params
    freq1:  0.5 + Math.random() * 1.0,
    freq2:  0.3 + Math.random() * 0.8,
    amp1:   30  + Math.random() * 50,
    amp2:   15  + Math.random() * 30,
    phase1: Math.random() * Math.PI * 2,
    phase2: Math.random() * Math.PI * 2,
    speed:  0.3 + Math.random() * 0.6,
    alpha:  0.5 + Math.random() * 0.4,
    width:  0.6 + Math.random() * 0.9,
  };
}

function initTendrils() {
  idleTendrils = [];
  const cx = W / 2, cy = H / 2;
  for (let i = 0; i < IDLE_COUNT; i++) {
    const angle  = (i / IDLE_COUNT) * Math.PI * 2 + Math.random() * 0.5;
    const radius = 40 + Math.random() * 80;
    const ox     = cx + Math.cos(angle) * radius;
    const oy     = cy + Math.sin(angle) * radius;
    const hue    = 220 + Math.random() * 80; // violet → teal range
    idleTendrils.push(makeTendril(ox, oy, angle, hue, 100 + Math.random() * 160));
  }
}

function updateTendrilPts(td, tLocal) {
  const step   = td.length / (PT_COUNT - 1);
  const ix     = td.impulseX * td.impulseDamp;
  const iy     = td.impulseY * td.impulseDamp;
  for (let i = 0; i < PT_COUNT; i++) {
    const frac = i / (PT_COUNT - 1);
    const d    = i * step;
    const ang  = td.baseAngle
      + Math.sin(tLocal * td.speed * td.freq1 + td.phase1 + frac * 3) * td.amp1 / td.length
      + Math.sin(tLocal * td.speed * td.freq2 + td.phase2 + frac * 5) * td.amp2 / td.length;
    td.pts[i].x = td.cx + Math.cos(ang) * d + ix * frac;
    td.pts[i].y = td.cy + Math.sin(ang) * d + iy * frac;
  }
  if (td.impulseDamp > 0) td.impulseDamp *= 0.93;
}

function drawTendril(pts, hue, alpha, width, glowOnly) {
  if (pts.length < 2) return;
  ctx.save();
  ctx.shadowColor  = `hsl(${hue}, 90%, 65%)`;
  ctx.shadowBlur   = 12;
  ctx.strokeStyle  = glowOnly
    ? `hsla(${hue},100%,90%,${alpha})`
    : `hsla(${hue},75%,60%,${alpha})`;
  ctx.lineWidth    = width;
  ctx.lineCap      = 'round';
  ctx.lineJoin     = 'round';
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
  ctx.stroke();
  ctx.restore();
}

// ── Trigger ────────────────────────────────────────────────
function triggerBurst(ox, oy) {
  // Repulse idle tendrils
  idleTendrils.forEach(td => {
    const dx   = td.cx - ox, dy = td.cy - oy;
    const dist = Math.sqrt(dx * dx + dy * dy) || 1;
    const force = Math.min(300 / dist, 120);
    td.impulseX   = (dx / dist) * force;
    td.impulseY   = (dy / dist) * force;
    td.impulseDamp = 1;
  });

  // Spawn burst tendrils
  for (let i = 0; i < 7; i++) {
    const angle = (i / 7) * Math.PI * 2 + Math.random() * 0.4;
    const hue   = 270 + Math.random() * 60;
    const bt    = makeTendril(ox, oy, angle, hue, 60 + Math.random() * 100);
    bt.life      = 1;
    bt.decay     = 0.008 + Math.random() * 0.006;
    bt.width     = 1.0 + Math.random() * 1.2;
    burstTendrils.push(bt);
  }
}

// ── Main loop ──────────────────────────────────────────────
function tick() {
  t += 0.016;

  ctx.fillStyle = 'rgba(7,5,15,0.18)';
  ctx.fillRect(0, 0, W, H);

  // Idle tendrils
  idleTendrils.forEach(td => {
    updateTendrilPts(td, t);
    drawTendril(td.pts, td.hue, td.alpha * 0.7, td.width, false);
  });

  // Burst tendrils
  for (let i = burstTendrils.length - 1; i >= 0; i--) {
    const bt = burstTendrils[i];
    bt.life -= bt.decay;
    if (bt.life <= 0) { burstTendrils.splice(i, 1); continue; }
    updateTendrilPts(bt, t);
    drawTendril(bt.pts, bt.hue, bt.life * 0.9, bt.width, true);
  }

  requestAnimationFrame(tick);
}

canvas.addEventListener('click', e => triggerBurst(e.clientX, e.clientY));
window.addEventListener('resize', resize);
resize();
tick();
</script>
</body>
</html>
