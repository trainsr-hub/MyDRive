@app.post("/api/drive/trash_folder")
def trash_folder_endpoint(req: TrashFolderRequest):
    """Moves a folder to Google Drive Trash (checks emptiness unless force=True)."""
    if GLOBAL_MOCK_MODE or (req.folder_id and "mock" in req.folder_id):
        ok = mock_store.trash_folder(req.folder_id)
        return {"success": ok, "mock_mode": True}

    fid = drive_ops.extract_folder_id_from_url(req.folder_id)
    if not fid:
        raise HTTPException(status_code=400, detail="Invalid folder ID")

    if not req.force and not drive_ops.is_folder_empty(fid):
        raise HTTPException(status_code=400, detail="Folder is not empty. Cannot safely delete without force.")

    try:
        res = drive_ops.trash_file(fid)
        return {"success": True, "folder": res}
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to trash folder: {str(e)}")



