@app.get("/api/drive/browse")
def browse_folder(folder_id: Optional[str] = None):
    """
    Returns folder metadata, immediate subfolders with origin tags, and files for the Drive Navigator dashboard.
    """
    t0 = time.time()
    fid = folder_id.strip() if folder_id else (MOCK_ROOT_ID if GLOBAL_MOCK_MODE else config.default_root_url)

    # Mock mode branch
    if GLOBAL_MOCK_MODE or (fid and "mock" in fid):
        resolved_id = fid if fid.startswith("mock_") else MOCK_ROOT_ID
        current_f = mock_store.get_folder(resolved_id) or mock_store.get_folder(MOCK_ROOT_ID)
        all_contents = mock_store.list_contents(current_f["id"])
        subfolders = []
        files = []
        for item in all_contents:
            if item.get("mimeType") == "application/vnd.google-apps.folder":
                subfolders.append({
                    "id": item["id"],
                    "name": item["name"],
                    "description": item.get("description", ""),
                    "source_id": item.get("properties", {}).get("src"),
                    "mimeType": "application/vnd.google-apps.folder",
                })
            else:
                files.append(item)

        parents = [current_f["parent_id"]] if current_f.get("parent_id") else []
        return {
            "success": True,
            "duration_ms": 1.5,
            "current_folder": {
                "id": current_f["id"],
                "name": current_f["name"],
                "description": current_f.get("description", ""),
                "source_id": current_f.get("properties", {}).get("src"),
                "parents": parents,
            },
            "subfolders": subfolders,
            "files": files,
            "mock_mode": True,
        }

    resolved_id = drive_ops.extract_folder_id_from_url(fid)
    if not resolved_id:
        raise HTTPException(status_code=400, detail="Invalid folder ID or link")

    try:
        meta = drive_ops.get_file_metadata(resolved_id)
        contents = drive_ops.list_folder_contents(resolved_id)

        subfolders = []
        files = []

        for item in contents:
            mime = item.get("mimeType", "")
            if mime == "application/vnd.google-apps.folder":
                cid = item["id"]
                src_id = logic.extract_source_id(item)
                subfolders.append({
                    "id": cid,
                    "name": item.get("name", "Untitled Folder"),
                    "description": item.get("description", "") or "",
                    "source_id": src_id,
                    "mimeType": mime,
                })
            else:
                files.append({
                    "id": item["id"],
                    "name": item.get("name", "Untitled File"),
                    "mimeType": mime,
                    "thumbnail_url": drive_ops.format_thumbnail_url(item["id"]) if mime.startswith("image/") else None,
                })

        duration_ms = round((time.time() - t0) * 1000, 1)
        return {
            "success": True,
            "duration_ms": duration_ms,
            "current_folder": {
                "id": meta["id"],
                "name": meta.get("name", "Root"),
                "description": meta.get("description", "") or "",
                "source_id": logic.extract_source_id(meta),
                "parents": meta.get("parents", []),
            },
            "subfolders": subfolders,
            "files": files,
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to browse folder: {str(e)}")


@app.post("/api/drive/clone_template")
def clone_template(req: CloneTemplateRequest):
    """
    Creates a new custom-named entity clone under parent_id,
    recursively duplicating the template folder tree and stamping every node
    with immutable 'src:<id>' Google Drive properties and description headers.
    """
    t0 = time.time()

    if GLOBAL_MOCK_MODE or (req.parent_id and "mock" in req.parent_id):
        res = mock_store.clone_template(
            target_parent_id=req.parent_id,
            clone_name=req.clone_name.strip(),
        )
        res["duration_ms"] = 1.8
        res["mock_mode"] = True
        return res

    pid = drive_ops.extract_folder_id_from_url(req.parent_id)
    if not pid:
        raise HTTPException(status_code=400, detail="Invalid parent folder ID or URL")

    t_link = req.template_link.strip() if req.template_link else config.default_template_url
    tid = drive_ops.extract_folder_id_from_url(t_link)
    if not tid:
        raise HTTPException(status_code=400, detail="Invalid template folder ID or URL")

    if not req.clone_name.strip():
        raise HTTPException(status_code=400, detail="Folder name cannot be empty")

    try:
        res = logic.spawn_clone_from_template(
            target_parent_id=pid,
            clone_name=req.clone_name.strip(),
            template_id=tid,
        )
        res["duration_ms"] = round((time.time() - t0) * 1000, 1)
        return res
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to clone template: {str(e)}")


