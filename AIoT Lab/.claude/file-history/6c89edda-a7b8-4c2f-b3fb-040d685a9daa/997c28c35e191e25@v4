@app.post("/api/template/save")
def save_template(req: TemplateSaveRequest):
    """
    Applies additions, deletions, and metadata updates directly to Google Drive template archetype.
    Automatically harvests new tags and updates SQLite schema records.
    """
    t0 = time.time()
    t_link = req.template_link.strip() if req.template_link else config.default_template_url
    template_id = drive_ops.extract_folder_id_from_url(t_link)
    if not template_id:
        raise HTTPException(status_code=400, detail="Invalid or missing Template Folder URL / ID")

    created_count = 0
    updated_count = 0
    deleted_count = 0

    try:
        # 1. Process Deletions (safe trash)
        for d in req.mutations.deletes:
            if d.id and not d.id.startswith("temp_"):
                drive_ops.trash_file(d.id)
                deleted_count += 1

        # 2. Process Updates (name and description)
        for u in req.mutations.updates:
            if u.id and not u.id.startswith("temp_"):
                drive_ops.update_folder_meta(u.id, name=u.name, description=u.description)
                updated_count += 1
                if u.description:
                    kvs, _ = logic.parse_description_to_key_values(u.description)
                    if kvs:
                        db.merge_harvested_tags(kvs, source_folder_id=u.id)

        # 3. Process Additions (support multi-level nested folders)
        id_map: Dict[str, str] = {template_id: template_id}
        pending = list(req.mutations.creates)
        while pending:
            progress = False
            next_pending = []
            for c in pending:
                parent = id_map.get(c.parent_id, c.parent_id)
                if parent in id_map or not parent.startswith("temp_"):
                    res = drive_ops.create_folder(c.name, parent_id=parent, description=c.description)
                    new_id = res["id"]
                    id_map[c.temp_id] = new_id
                    created_count += 1
                    progress = True
                    if c.description:
                        kvs, _ = logic.parse_description_to_key_values(c.description)
                        if kvs:
                            db.merge_harvested_tags(kvs, source_folder_id=new_id)
                else:
                    next_pending.append(c)

            if not progress:
                # Fallback: attach to root template
                for c in next_pending:
                    res = drive_ops.create_folder(c.name, parent_id=template_id, description=c.description)
                    id_map[c.temp_id] = res["id"]
                    created_count += 1
                    if c.description:
                        kvs, _ = logic.parse_description_to_key_values(c.description)
                        if kvs:
                            db.merge_harvested_tags(kvs, source_folder_id=res["id"])
                break
            pending = next_pending

        # 4. Invalidate caches & update local schema record
        db.clear_folder_tree_cache()
        fresh_schema = extract_schema_from_drive_folder(template_id)
        db.save_template_schema(
            name=fresh_schema.get("name", "Archetype"),
            schema_dict=fresh_schema,
            description=f"Archetype schema from {template_id}",
            source_folder_id=template_id,
        )

        # 5. Fetch fresh live tree and updated tags
        fresh_tree = drive_ops.get_hierarchical_tree(template_id)
        vault_tags = db.load_vault_data()
        duration_ms = round((time.time() - t0) * 1000, 1)

        return {
            "success": True,
            "duration_ms": duration_ms,
            "created_count": created_count,
            "updated_count": updated_count,
            "deleted_count": deleted_count,
            "tree": fresh_tree,
            "vault_tags": vault_tags,
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to save template changes: {str(e)}")


