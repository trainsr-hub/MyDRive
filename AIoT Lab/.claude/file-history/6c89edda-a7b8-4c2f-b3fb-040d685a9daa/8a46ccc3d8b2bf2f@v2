import React, { useState, useEffect } from 'react';
import { X, FolderPlus, Folder, Sparkles } from 'lucide-react';
import { EntityGroup } from '../types';

interface NewEntityModalProps {
  isOpen: boolean;
  onClose: () => void;
  availableGroups: EntityGroup[];
  defaultGroupId?: string | null;
  onCreate: (entity: { name: string; folder_slug: string; group_id: string }) => Promise<void>;
  templateName?: string;
}

export const NewEntityModal: React.FC<NewEntityModalProps> = ({
  isOpen,
  onClose,
  availableGroups = [],
  defaultGroupId = null,
  onCreate,
  templateName = 'Entropy 0 Archetype',
}) => {
  const [name, setName] = useState<string>('');
  const [slug, setSlug] = useState<string>('');
  const [groupId, setGroupId] = useState<string>('');
  const [autoSlug, setAutoSlug] = useState<boolean>(true);
  const [isSubmitting, setIsSubmitting] = useState<boolean>(false);

  useEffect(() => {
    if (isOpen) {
      setGroupId(defaultGroupId || (availableGroups[0]?.group_id ?? ''));
      setName('');
      setSlug('');
      setAutoSlug(true);
    }
  }, [isOpen, defaultGroupId, availableGroups]);

  if (!isOpen) return null;

  const handleNameChange = (val: string) => {
    setName(val);
    if (autoSlug) {
      const generated = val
        .trim()
        .replace(/\s+/g, '_')
        .replace(/[^a-zA-Z0-9_-]/g, '');
      setSlug(generated);
    }
  };

  const handleSlugChange = (val: string) => {
    setAutoSlug(false);
    setSlug(val.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9_-]/g, ''));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    const cleanName = name.trim();
    const cleanSlug = slug.trim() || cleanName.replace(/\s+/g, '_');
    if (!cleanName || !cleanSlug) return;

    setIsSubmitting(true);
    try {
      await onCreate({
        name: cleanName,
        folder_slug: cleanSlug,
        group_id: groupId || availableGroups[0]?.group_id || 'mock_grp_t01',
      });
      setName('');
      setSlug('');
      onClose();
    } catch {
      // Error handled by caller toast
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <div
      style={{
        position: 'fixed',
        inset: 0,
        background: 'rgba(0, 0, 0, 0.7)',
        backdropFilter: 'blur(4px)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        zIndex: 1000,
        padding: '1rem',
      }}
    >
      <div
        style={{
          background: 'var(--bg-card)',
          border: '1px solid var(--border-mid)',
          borderRadius: 'var(--radius-lg, 12px)',
          width: '100%',
          maxWidth: '460px',
          boxShadow: '0 20px 40px rgba(0, 0, 0, 0.4)',
          overflow: 'hidden',
        }}
      >
        {/* Header */}
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            padding: '1rem 1.25rem',
            borderBottom: '1px solid var(--border-light)',
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: '0.6rem' }}>
            <FolderPlus size={18} style={{ color: 'var(--accent)' }} />
            <h2 style={{ fontSize: '15px', fontWeight: 700, margin: 0, color: 'var(--text-primary)' }}>
              Create New Entity
            </h2>
          </div>
          <button
            onClick={onClose}
            style={{
              background: 'none',
              border: 'none',
              color: 'var(--text-dim)',
              cursor: 'pointer',
              padding: '0.2rem',
              display: 'flex',
              alignItems: 'center',
            }}
          >
            <X size={18} />
          </button>
        </div>

        {/* Form Body */}
        <form onSubmit={handleSubmit} style={{ padding: '1.25rem', display: 'flex', flexDirection: 'column', gap: '1.1rem' }}>
          {/* Natural Language Name */}
          <div>
            <label style={{ display: 'block', fontSize: '12px', fontWeight: 600, color: 'var(--text-dim)', marginBottom: '0.4rem' }}>
              Entity Natural Language Name
            </label>
            <input
              type="text"
              value={name}
              onChange={(e) => handleNameChange(e.target.value)}
              placeholder="e.g. C25 - Elena Frost"
              required
              autoFocus
              style={{
                width: '100%',
                minHeight: '44px',
                padding: '0.65rem 0.85rem',
                borderRadius: 'var(--radius-sm)',
                background: 'var(--bg-canvas)',
                border: '1px solid var(--border-mid)',
                color: 'var(--text-primary)',
                fontSize: '14px',
                outline: 'none',
              }}
            />
          </div>

          {/* Folder Slug ID (Auto-derived) */}
          <div>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '0.4rem' }}>
              <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text-dim)' }}>
                Google Drive Folder ID / Slug
              </label>
              {autoSlug && (
                <span style={{ fontSize: '10px', color: 'var(--accent)', display: 'inline-flex', alignItems: 'center', gap: '0.2rem' }}>
                  <Sparkles size={10} /> Auto-derived
                </span>
              )}
            </div>
            <input
              type="text"
              value={slug}
              onChange={(e) => handleSlugChange(e.target.value)}
              placeholder="e.g. C25_Elena_Frost"
              required
              style={{
                width: '100%',
                minHeight: '44px',
                padding: '0.65rem 0.85rem',
                borderRadius: 'var(--radius-sm)',
                background: 'var(--bg-canvas)',
                border: '1px solid var(--border-mid)',
                fontFamily: 'var(--font-mono)',
                color: 'var(--text-primary)',
                fontSize: '13px',
                outline: 'none',
              }}
            />
          </div>

          {/* Group Selector */}
          <div>
            <label style={{ display: 'block', fontSize: '12px', fontWeight: 600, color: 'var(--text-dim)', marginBottom: '0.4rem' }}>
              Destination Group (Outliner Taxonomy)
            </label>
            <select
              value={groupId}
              onChange={(e) => setGroupId(e.target.value)}
              style={{
                width: '100%',
                minHeight: '44px',
                padding: '0.65rem 0.85rem',
                borderRadius: 'var(--radius-sm)',
                background: 'var(--bg-canvas)',
                border: '1px solid var(--border-mid)',
                color: 'var(--text-primary)',
                fontSize: '13.5px',
                outline: 'none',
                cursor: 'pointer',
              }}
            >
              {availableGroups.map((g) => (
                <option key={g.group_id} value={g.group_id}>
                  {g.group_name}
                </option>
              ))}
            </select>
          </div>

          {/* Template Archetype (Fixed) */}
          <div>
            <label style={{ display: 'block', fontSize: '12px', fontWeight: 600, color: 'var(--text-dim)', marginBottom: '0.4rem' }}>
              Template Archetype
            </label>
            <div
              style={{
                minHeight: '40px',
                padding: '0.55rem 0.85rem',
                borderRadius: 'var(--radius-sm)',
                background: 'var(--bg-canvas)',
                border: '1px solid var(--border-light)',
                display: 'flex',
                alignItems: 'center',
                gap: '0.4rem',
                fontSize: '13px',
                color: 'var(--accent)',
                fontWeight: 600,
              }}
            >
              <Folder size={14} />
              <span>{templateName}</span>
              <span style={{ fontSize: '10.5px', color: 'var(--text-dim)', marginLeft: 'auto' }}>
                All subfolders auto-stamped
              </span>
            </div>
          </div>

          {/* Action Buttons */}
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'flex-end', gap: '0.75rem', marginTop: '0.5rem' }}>
            <button
              type="button"
              onClick={onClose}
              disabled={isSubmitting}
              className="btn subtle"
              style={{ padding: '0.5rem 1rem', fontSize: '13px' }}
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={isSubmitting || !name.trim()}
              className="btn primary"
              style={{
                padding: '0.55rem 1.25rem',
                fontSize: '13px',
                fontWeight: 600,
                background: 'var(--accent)',
                color: '#000',
                border: 'none',
                boxShadow: '0 0 12px var(--accent-glow)',
              }}
            >
              {isSubmitting ? 'Spawning Folders...' : 'Create Entity'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};
