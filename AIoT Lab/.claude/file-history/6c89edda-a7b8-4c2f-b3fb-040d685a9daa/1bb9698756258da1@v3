import React from 'react';
import { EntityGroup } from '../types';
import { Folder, ChevronDown, Plus, Zap, CheckCircle2, AlertCircle, FolderTree } from 'lucide-react';

interface EntitySidebarProps {
  groups: EntityGroup[];
  selectedEntityId: string | null;
  onSelectEntity: (entityId: string | null) => void;
  onOpenNewCloneModal: () => void;
  totalExceptionsCount: number;
  onSyncAll: () => void;
  isExecuting: boolean;
}

export const EntitySidebar: React.FC<EntitySidebarProps> = ({
  groups,
  selectedEntityId,
  onSelectEntity,
  onOpenNewCloneModal,
  totalExceptionsCount,
  onSyncAll,
  isExecuting,
}) => {
  return (
    <aside
      style={{
        width: '280px',
        flexShrink: 0,
        display: 'flex',
        flexDirection: 'column',
        background: 'var(--bg-card)',
        borderRight: '1px solid var(--border-light)',
        height: 'calc(100vh - 75px)',
        overflowY: 'auto',
      }}
    >
      {/* 1. Global Sync Action Deck */}
      <div style={{ padding: '1rem', borderBottom: '1px solid var(--border-light)', display: 'flex', flexDirection: 'column', gap: '0.6rem' }}>
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
          <span style={{ fontSize: '11.5px', fontWeight: 700, textTransform: 'uppercase', color: 'var(--text-dim)', letterSpacing: '0.04em' }}>
            Entities Workspace
          </span>
          {totalExceptionsCount > 0 ? (
            <span className="badge badge-update" style={{ fontSize: '10.5px', fontWeight: 700 }}>
              {totalExceptionsCount} to fix
            </span>
          ) : (
            <span className="badge badge-match" style={{ fontSize: '10.5px' }}>
              All In Sync
            </span>
          )}
        </div>

        {totalExceptionsCount > 0 && (
          <button
            onClick={onSyncAll}
            disabled={isExecuting}
            className="btn primary"
            style={{
              width: '100%',
              padding: '0.5rem',
              fontSize: '12px',
              fontWeight: 700,
              background: 'var(--accent)',
              color: '#000',
              border: 'none',
              borderRadius: 'var(--radius-sm)',
              cursor: 'pointer',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              gap: '0.4rem',
            }}
          >
            <Zap size={13} /> {isExecuting ? 'Syncing...' : `Sync All (${totalExceptionsCount})`}
          </button>
        )}

        <button
          onClick={onOpenNewCloneModal}
          className="btn secondary"
          style={{
            width: '100%',
            padding: '0.5rem',
            fontSize: '12px',
            fontWeight: 600,
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            gap: '0.4rem',
          }}
        >
          <Plus size={14} /> New Clone from Template
        </button>
      </div>

      {/* 2. Groups & Entities Navigation List */}
      <div style={{ display: 'flex', flexDirection: 'column', padding: '0.5rem 0', flex: 1 }}>
        {/* All Entities Bird's Eye View Button */}
        <button
          onClick={() => onSelectEntity(null)}
          style={{
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            padding: '0.65rem 1rem',
            background: selectedEntityId === null ? 'var(--bg-canvas)' : 'transparent',
            borderLeft: selectedEntityId === null ? '3px solid var(--accent)' : '3px solid transparent',
            borderTop: 'none',
            borderRight: 'none',
            borderBottom: 'none',
            textAlign: 'left',
            cursor: 'pointer',
            color: selectedEntityId === null ? 'var(--text-primary)' : 'var(--text-secondary)',
            marginBottom: '0.5rem',
            fontWeight: selectedEntityId === null ? 700 : 500,
          }}
          className="table-row-hover"
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: '0.6rem' }}>
            <FolderTree size={15} style={{ color: selectedEntityId === null ? 'var(--accent)' : 'var(--text-dim)' }} />
            <span style={{ fontSize: '13px' }}>All Entities (Bird's Eye)</span>
          </div>
          {totalExceptionsCount > 0 ? (
            <span className="badge badge-rename" style={{ fontSize: '10px', padding: '1px 6px' }}>
              {totalExceptionsCount}
            </span>
          ) : (
            <CheckCircle2 size={13} style={{ color: 'var(--success)' }} />
          )}
        </button>

        {groups.map((group) => {
          return (
            <div key={group.group_id} style={{ display: 'flex', flexDirection: 'column', marginBottom: '0.5rem' }}>
              {/* Group Label */}
              <div
                style={{
                  padding: '0.4rem 1rem',
                  fontSize: '11px',
                  fontWeight: 700,
                  color: 'var(--text-dim)',
                  textTransform: 'uppercase',
                  letterSpacing: '0.05em',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '0.4rem',
                }}
              >
                <ChevronDown size={12} />
                <span>{group.group_name}</span>
                <span style={{ marginLeft: 'auto', fontSize: '10px', color: 'var(--text-dim)' }}>
                  ({group.entity_plans.length})
                </span>
              </div>

              {/* Entities inside this group */}
              {group.entity_plans.length === 0 ? (
                <div style={{ padding: '0.25rem 1.25rem', fontSize: '11px', color: 'var(--text-dim)', fontStyle: 'italic' }}>
                  No entities
                </div>
              ) : (
                group.entity_plans.map((ep) => {
                  const isSelected = selectedEntityId === ep.target_root_id;
                  const exceptionCount = ep.items.filter((i) => i.action_type !== 'MATCH').length;

                  return (
                    <button
                      key={ep.target_root_id}
                      onClick={() => onSelectEntity(ep.target_root_id)}
                      style={{
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'space-between',
                        padding: '0.65rem 1rem 0.65rem 1.5rem',
                        background: isSelected ? 'var(--bg-canvas)' : 'transparent',
                        borderLeft: isSelected ? '3px solid var(--accent)' : '3px solid transparent',
                        borderTop: 'none',
                        borderRight: 'none',
                        borderBottom: 'none',
                        textAlign: 'left',
                        cursor: 'pointer',
                        color: isSelected ? 'var(--text-primary)' : 'var(--text-secondary)',
                        transition: 'all 0.15s ease',
                      }}
                      className="table-row-hover"
                    >
                      <div style={{ display: 'flex', alignItems: 'center', gap: '0.6rem', overflow: 'hidden' }}>
                        <Folder
                          size={15}
                          style={{
                            color: isSelected ? 'var(--accent)' : 'var(--text-dim)',
                            flexShrink: 0,
                          }}
                        />
                        <span
                          style={{
                            fontSize: '13px',
                            fontWeight: isSelected ? 700 : 500,
                            whiteSpace: 'nowrap',
                            overflow: 'hidden',
                            textOverflow: 'ellipsis',
                          }}
                        >
                          {ep.target_root_name}
                        </span>
                      </div>

                      {/* Exception status badge */}
                      {exceptionCount > 0 ? (
                        <span
                          className="badge badge-rename"
                          style={{
                            fontSize: '10px',
                            padding: '1px 6px',
                            flexShrink: 0,
                            display: 'inline-flex',
                            alignItems: 'center',
                            gap: '0.2rem',
                          }}
                        >
                          <AlertCircle size={10} /> {exceptionCount}
                        </span>
                      ) : (
                        <CheckCircle2 size={13} style={{ color: 'var(--success)', flexShrink: 0 }} />
                      )}
                    </button>
                  );
                })
              )}
            </div>
          );
        })}
      </div>
    </aside>
  );
};
