def list_template_schemas() -> List[Dict[str, Any]]:
    """Returns a list of all saved template schema metadata."""
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT id, name, description, source_folder_id, updated_at FROM template_schemas ORDER BY name ASC;")
        return [dict(r) for r in cursor.fetchall()]


def delete_template_schema(name: str) -> bool:
    """Deletes a template schema by name."""
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("DELETE FROM template_schemas WHERE name = ?;", (name.strip(),))
