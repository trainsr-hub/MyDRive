    dry_run: bool = False,
    details: Optional[dict] = None,
):
    """Records a reconciliation execution run with full action metrics."""
    import json
    init_db()
    details_json = json.dumps(details or {}, ensure_ascii=False)
    with get_connection() as conn:
        conn.execute(
            """
            INSERT INTO reconciliation_log
            (target_folder_id, target_folder_name, template_name, created_count, 
             updated_desc_count, pruned_empty_count, flagged_red_count, dry_run, details_json)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
            """,
            (
                target_folder_id,
                target_folder_name,
                template_name,
                created_count,
                updated_desc_count,
                pruned_empty_count,
                flagged_red_count,
                1 if dry_run else 0,
                details_json,
            ),
        )
        conn.commit()


def get_recent_reconciliations(limit: int = 15) -> List[Dict[str, Any]]:
    """Retrieves recent reconciliation audit logs from SQLite."""
    import json
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute(
            """
            SELECT id, target_folder_id, target_folder_name, template_name,
                   created_count, updated_desc_count, pruned_empty_count,
                   flagged_red_count, dry_run, details_json, created_at
            FROM reconciliation_log
            ORDER BY id DESC
            LIMIT ?;
            """,
            (limit,),
        )
        rows = cursor.fetchall()
        results = []
        for r in rows:
            details = {}
            if r["details_json"]:
                try:
                    details = json.loads(r["details_json"])
                except Exception:
                    pass
            results.append({
                "id": r["id"],
                "target_folder_id": r["target_folder_id"],
                "target_folder_name": r["target_folder_name"],
                "template_name": r["template_name"],
                "created_count": r["created_count"],
                "updated_desc_count": r["updated_desc_count"],
                "pruned_empty_count": r["pruned_empty_count"],
                "flagged_red_count": r["flagged_red_count"],
                "dry_run": bool(r["dry_run"]),
                "details": details,
                "created_at": str(r["created_at"]),
            })
        return results


