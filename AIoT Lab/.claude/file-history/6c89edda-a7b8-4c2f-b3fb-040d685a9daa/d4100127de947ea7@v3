def save_template_schema(name: str, schema_dict: dict, description: str = "", source_folder_id: Optional[str] = None):
    """Saves or updates a named template schema in SQLite."""
    import json
    init_db()
    schema_json = json.dumps(schema_dict, ensure_ascii=False)
    with get_connection() as conn:
        conn.execute(
            """
            INSERT INTO template_schemas (name, description, schema_json, source_folder_id, updated_at)
            VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(name) DO UPDATE SET
                description = excluded.description,
                schema_json = excluded.schema_json,
                source_folder_id = excluded.source_folder_id,
                updated_at = CURRENT_TIMESTAMP;
            """,
            (name.strip(), description.strip(), schema_json, source_folder_id),
        )
        conn.commit()


def get_template_schema(name: str) -> Optional[dict]:
    """Retrieves a template schema by name as a parsed dictionary."""
    import json
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT schema_json FROM template_schemas WHERE name = ?;", (name.strip(),))
        row = cursor.fetchone()
        if row and row["schema_json"]:
            return json.loads(row["schema_json"])
    return None


def get_template_schema_by_source_id(source_id: str) -> Optional[dict]:
