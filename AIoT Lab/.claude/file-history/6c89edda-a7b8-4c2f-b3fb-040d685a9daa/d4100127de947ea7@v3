def load_vault_data() -> Dict[str, List[str]]:
    """
    Loads all tags as a structured dictionary:
    { "Category": ["Val1", "Val2"], "Theme": ["Dark", "Neon"] }
    Matches the exact legacy vault format.
    """
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT tag_key, tag_value FROM metadata_tags ORDER BY tag_key ASC, tag_value ASC;")
        rows = cursor.fetchall()

    vault_dict: Dict[str, List[str]] = {}
    for row in rows:
        k = row["tag_key"]
        v = row["tag_value"]
        if k not in vault_dict:
            vault_dict[k] = []
        if v not in vault_dict[k]:
            vault_dict[k].append(v)

    return vault_dict


def merge_harvested_tags(harvested: Dict[str, List[str]], source_folder_id: Optional[str] = None) -> int:
    """
    Merges newly discovered Key: [Values] from folder descriptions into SQLite.
    Returns the count of newly inserted tag pairs.
    """
    init_db()
    if not harvested:
        return 0

    inserted_count = 0
    with get_connection() as conn:
        cursor = conn.cursor()
        for key, values in harvested.items():
            clean_key = str(key).strip()
            if not clean_key:
                continue
            for val in values:
                clean_val = str(val).strip()
                if not clean_val:
                    continue
                try:
                    cursor.execute(
                        """
                        INSERT OR IGNORE INTO metadata_tags (tag_key, tag_value, source_folder_id)
                        VALUES (?, ?, ?);
                        """,
                        (clean_key, clean_val, source_folder_id),
                    )
                    if cursor.rowcount > 0:
                        inserted_count += 1
                except sqlite3.Error:
                    pass
        conn.commit()

    return inserted_count


def add_single_tag(tag_key: str, tag_value: str, source_folder_id: Optional[str] = None) -> bool:
    """Adds a single key-value tag pair. Returns True if inserted, False if already exists."""
    init_db()
    clean_k = tag_key.strip()
    clean_v = tag_value.strip()
    if not clean_k or not clean_v:
        return False

    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute(
            """
            INSERT OR IGNORE INTO metadata_tags (tag_key, tag_value, source_folder_id)
            VALUES (?, ?, ?);
            """,
            (clean_k, clean_v, source_folder_id),
        )
        conn.commit()
        return cursor.rowcount > 0


def delete_tag(tag_key: str, tag_value: str) -> bool:
    """Deletes a specific tag value under a key."""
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute(
            "DELETE FROM metadata_tags WHERE tag_key = ? AND tag_value = ?;",
            (tag_key.strip(), tag_value.strip()),
        )
        conn.commit()
        return cursor.rowcount > 0


def delete_key(tag_key: str) -> int:
    """Deletes an entire key and all associated values. Returns count of deleted rows."""
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("DELETE FROM metadata_tags WHERE tag_key = ?;", (tag_key.strip(),))
        deleted = cursor.rowcount
        conn.commit()
        return deleted


def clear_all_vault_data() -> int:
    """Wipes all metadata tags from the database. Returns count of cleared records."""
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("DELETE FROM metadata_tags;")
        deleted = cursor.rowcount
        conn.commit()
        return deleted


def get_all_keys() -> List[str]:
    """Returns a sorted list of all unique tag keys in the vault."""
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT DISTINCT tag_key FROM metadata_tags ORDER BY tag_key ASC;")
        return [row["tag_key"] for row in cursor.fetchall()]


def get_values_for_key(tag_key: str) -> List[str]:
    """Returns a sorted list of values for a specific tag key."""
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute(
            "SELECT tag_value FROM metadata_tags WHERE tag_key = ? ORDER BY tag_value ASC;",
            (tag_key.strip(),),
        )
        return [row["tag_value"] for row in cursor.fetchall()]


