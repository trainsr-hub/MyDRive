def get_vault_stats() -> Dict[str, Any]:
    """Returns summary statistics for the vault database."""
    init_db()
    with get_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT COUNT(DISTINCT tag_key) as total_keys, COUNT(*) as total_tags FROM metadata_tags;")
        row1 = cursor.fetchone()
        cursor.execute("SELECT COUNT(*) as total_clones FROM cloned_trees_log;")
        row2 = cursor.fetchone()
        cursor.execute("SELECT COUNT(*) as total_exports FROM exported_trees_log;")
        row3 = cursor.fetchone()
        cursor.execute("SELECT COUNT(*) as total_schemas FROM template_schemas;")
        row4 = cursor.fetchone()
        cursor.execute("SELECT COUNT(*) as total_reconciliations FROM reconciliation_log;")
        row5 = cursor.fetchone()

        return {
            "total_keys": row1["total_keys"] if row1 else 0,
            "total_tags": row1["total_tags"] if row1 else 0,
            "total_clones": row2["total_clones"] if row2 else 0,
            "total_exports": row3["total_exports"] if row3 else 0,
            "total_schemas": row4["total_schemas"] if row4 else 0,
            "total_reconciliations": row5["total_reconciliations"] if row5 else 0,
            "db_path": str(config.db_path),
        }


