import React, { useState } from 'react';
import { Zap, FolderPlus, Check } from 'lucide-react';

interface QuickSpawnBarProps {
  onSpawned: () => void;
  addToast: (type: 'success' | 'error' | 'info', title: string, message?: string) => void;
}

export const QuickSpawnBar: React.FC<QuickSpawnBarProps> = ({ onSpawned, addToast }) => {
  const [cloneName, setCloneName] = useState('');
  const [targetGroup, setTargetGroup] = useState('mock_grp_t01');
  const [isSpawning, setIsSpawning] = useState(false);

  const handleSpawn = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!cloneName.trim()) return;

    setIsSpawning(true);
    try {
      const res = await fetch('/api/drive/clone_template', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          parent_id: targetGroup,
          clone_name: cloneName.trim(),
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Failed to spawn clone');

      addToast(
        'success',
        'Clone Spawned Successfully',
        `Created '${cloneName}' with ${data.total_folders_created} stamped subfolders`
      );
      setCloneName('');
      onSpawned();
    } catch (err: any) {
      addToast('error', 'Spawning Error', err.message);
    } finally {
      setIsSpawning(false);
    }
  };

  return (
    <div
      className="card"
      style={{
        padding: '0.85rem 1.25rem',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between',
        flexWrap: 'wrap',
        gap: '0.85rem',
        borderColor: 'var(--border-mid)',
      }}
    >
      <div style={{ display: 'flex', alignItems: 'center', gap: '0.65rem' }}>
        <div
          style={{
            width: 30,
            height: 30,
            borderRadius: 'var(--radius-sm)',
            background: 'rgba(168, 85, 247, 0.15)',
            color: '#c084fc',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            border: '1px solid rgba(168, 85, 247, 0.4)',
          }}
        >
          <FolderPlus size={16} />
        </div>
        <div>
          <div style={{ fontSize: '13px', fontWeight: 700, color: 'var(--text-primary)' }}>
            Spawn New Entity from Template
          </div>
          <div style={{ fontSize: '11px', color: 'var(--text-dim)' }}>
            Automatically stamps all subfolders with immutable origin metadata
          </div>
        </div>
      </div>

      <form onSubmit={handleSpawn} style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', flex: 1, minWidth: '320px', justifyContent: 'flex-end' }}>
        <input
          type="text"
          placeholder="New Folder Name (e.g. C25_Elena)..."
          value={cloneName}
          onChange={(e) => setCloneName(e.target.value)}
          className="input-base"
          style={{ maxWidth: '260px', padding: '0.45rem 0.75rem', fontSize: '13px' }}
        />

        <select
          value={targetGroup}
          onChange={(e) => setTargetGroup(e.target.value)}
          className="input-base"
          style={{ width: '150px', padding: '0.45rem 0.65rem', fontSize: '12.5px', cursor: 'pointer' }}
        >
          <option value="mock_grp_t01">Testament 01</option>
          <option value="mock_grp_t02">Testament 02</option>
          <option value="mock_grp_t03">Testament 03</option>
        </select>

        <button
          type="submit"
          disabled={isSpawning || !cloneName.trim()}
          className="btn primary"
          style={{
            padding: '0.45rem 1rem',
            fontSize: '12.5px',
            fontWeight: 700,
            background: '#9333ea',
            borderColor: '#a855f7',
            whiteSpace: 'nowrap',
          }}
        >
          {isSpawning ? 'Spawning...' : '+ Create Clone'}
        </button>
      </form>
    </div>
  );
};
