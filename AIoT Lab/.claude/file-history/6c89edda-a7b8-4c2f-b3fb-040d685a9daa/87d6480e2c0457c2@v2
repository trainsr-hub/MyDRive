import React, { useState, useEffect } from 'react';
import {
  Folder,
  FolderPlus,
  FileEdit,
  Trash2,
  ExternalLink,
  ChevronRight,
  ArrowUpLeft,
  RotateCw,
  Zap,
  File,
  Search,
  Check,
  X,
} from 'lucide-react';
import { BrowseResponse, DriveFolderItem, DriveFileItem } from '../types';

interface DriveNavigatorProps {
  initialFolderId: string;
  templateLink: string;
  addToast: (type: 'success' | 'error' | 'info', title: string, message?: string) => void;
}

interface Crumb {
  id: string;
  name: string;
}

export const DriveNavigator: React.FC<DriveNavigatorProps> = ({
  initialFolderId,
  templateLink,
  addToast,
}) => {
  const [currentFolderId, setCurrentFolderId] = useState<string>(initialFolderId);
  const [breadcrumbs, setBreadcrumbs] = useState<Crumb[]>([]);
  const [browseData, setBrowseData] = useState<BrowseResponse | null>(null);
  const [isLoading, setIsLoading] = useState(false);

  // Jump Input
  const [jumpInput, setJumpInput] = useState('');

  // Modals
  const [isCloneModalOpen, setIsCloneModalOpen] = useState(false);
  const [cloneName, setCloneName] = useState('');
  const [cloneTemplate, setCloneTemplate] = useState(templateLink);
  const [isCloning, setIsCloning] = useState(false);

  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);
  const [newFolderName, setNewFolderName] = useState('');

  const [renameTarget, setRenameTarget] = useState<DriveFolderItem | null>(null);
  const [renameValue, setRenameValue] = useState('');

  const [trashTarget, setTrashTarget] = useState<DriveFolderItem | null>(null);

  // Fetch Folder Contents
  const fetchFolder = async (folderId: string, addToHistory = true) => {
    setIsLoading(true);
    try {
      const res = await fetch(`/api/drive/browse?folder_id=${encodeURIComponent(folderId)}`);
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.detail || 'Failed to browse folder');
      }
      setBrowseData(data);
      setCurrentFolderId(data.current_folder.id);

      if (addToHistory) {
        setBreadcrumbs((prev) => {
          const idx = prev.findIndex((c) => c.id === data.current_folder.id);
          if (idx !== -1) {
            return prev.slice(0, idx + 1);
          }
          return [...prev, { id: data.current_folder.id, name: data.current_folder.name }];
        });
      }
    } catch (err: any) {
      addToast('error', 'Navigation Failed', err.message);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    if (initialFolderId) {
      fetchFolder(initialFolderId);
    }
  }, [initialFolderId]);

  // Jump to pasted ID or URL
  const handleJump = (e: React.FormEvent) => {
    e.preventDefault();
    if (!jumpInput.trim()) return;
    fetchFolder(jumpInput.trim());
    setJumpInput('');
  };

  // Navigate Up
  const handleNavigateUp = () => {
    if (breadcrumbs.length > 1) {
      const parentCrumb = breadcrumbs[breadcrumbs.length - 2];
      fetchFolder(parentCrumb.id);
    }
  };

  // Spawn Clone
  const handleSpawnClone = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!cloneName.trim()) return;
    setIsCloning(true);
    try {
      const res = await fetch('/api/drive/clone_template', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          parent_id: currentFolderId,
          clone_name: cloneName.trim(),
          template_link: cloneTemplate.trim() || templateLink,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Failed to spawn clone');

      addToast(
        'success',
        'Entity Clone Spawned!',
        `Created '${cloneName}' with ${data.total_folders_created} stamped subfolders`
      );
      setIsCloneModalOpen(false);
      setCloneName('');
      fetchFolder(currentFolderId, false);
    } catch (err: any) {
      addToast('error', 'Clone Spawning Error', err.message);
    } finally {
      setIsCloning(false);
    }
  };

  // Create Regular Folder
  const handleCreateFolder = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newFolderName.trim()) return;
    try {
      const res = await fetch('/api/drive/create_folder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          parent_id: currentFolderId,
          name: newFolderName.trim(),
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Failed to create folder');
      addToast('success', 'Folder Created', `Created folder '${newFolderName}'`);
      setIsCreateModalOpen(false);
      setNewFolderName('');
      fetchFolder(currentFolderId, false);
    } catch (err: any) {
      addToast('error', 'Folder Creation Failed', err.message);
    }
  };

  // Rename Folder
  const handleRename = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!renameTarget || !renameValue.trim()) return;
    try {
      const res = await fetch('/api/drive/rename_folder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          folder_id: renameTarget.id,
          name: renameValue.trim(),
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Failed to rename folder');
      addToast('success', 'Folder Renamed', `'${renameTarget.name}' → '${renameValue}'`);
      setRenameTarget(null);
      fetchFolder(currentFolderId, false);
    } catch (err: any) {
      addToast('error', 'Rename Failed', err.message);
    }
  };

  // Trash Folder
  const handleTrash = async () => {
    if (!trashTarget) return;
    try {
      const res = await fetch('/api/drive/trash_folder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          folder_id: trashTarget.id,
          force: false,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Cannot delete folder');
      addToast('success', 'Folder Trashed', `Moved '${trashTarget.name}' to Trash`);
      setTrashTarget(null);
      fetchFolder(currentFolderId, false);
    } catch (err: any) {
      addToast('error', 'Delete Blocked', err.message);
    }
  };

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '1.25rem' }}>
      {/* 1. Navigator Header & Breadcrumbs Deck */}
      <div className="card" style={{ padding: '1rem 1.25rem', display: 'flex', flexDirection: 'column', gap: '0.85rem' }}>
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '0.75rem' }}>
          {/* Breadcrumb Trail */}
          <div style={{ display: 'flex', alignItems: 'center', gap: '0.35rem', flexWrap: 'wrap' }}>
            {breadcrumbs.length > 1 && (
              <button
                onClick={handleNavigateUp}
                className="btn subtle"
                style={{ padding: '0.3rem 0.6rem', fontSize: '12px' }}
                title="Go up to parent folder"
              >
                <ArrowUpLeft size={14} /> Up
              </button>
            )}
            {breadcrumbs.map((crumb, idx) => (
              <React.Fragment key={crumb.id}>
                {idx > 0 && <ChevronRight size={13} style={{ color: 'var(--text-dim)' }} />}
                <button
                  onClick={() => fetchFolder(crumb.id)}
                  style={{
                    background: idx === breadcrumbs.length - 1 ? 'var(--bg-canvas)' : 'transparent',
                    border: 'none',
                    color: idx === breadcrumbs.length - 1 ? 'var(--accent)' : 'var(--text-secondary)',
                    fontWeight: idx === breadcrumbs.length - 1 ? 700 : 500,
                    fontSize: '13px',
                    cursor: 'pointer',
                    padding: '0.2rem 0.5rem',
                    borderRadius: 'var(--radius-sm)',
                  }}
                >
                  {crumb.name}
                </button>
              </React.Fragment>
            ))}
          </div>

          {/* Quick Jump Bar */}
          <form onSubmit={handleJump} style={{ display: 'flex', alignItems: 'center', gap: '0.4rem' }}>
            <input
              type="text"
              placeholder="Jump to Folder URL / ID..."
              value={jumpInput}
              onChange={(e) => setJumpInput(e.target.value)}
              className="input-base"
              style={{ width: '220px', padding: '0.35rem 0.65rem', fontSize: '12px' }}
            />
            <button type="submit" className="btn subtle" style={{ padding: '0.35rem 0.65rem', fontSize: '12px' }}>
              <Search size={13} />
            </button>
          </form>
        </div>

        {/* Current Folder Metadata Strip & Action Toolbar */}
        {browseData && (
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid var(--border-light)', paddingTop: '0.75rem', flexWrap: 'wrap', gap: '0.75rem' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '0.65rem' }}>
              <Folder size={18} style={{ color: 'var(--accent)' }} />
              <span style={{ fontWeight: 700, fontSize: '15px' }}>{browseData.current_folder.name}</span>
              {browseData.current_folder.source_id && (
                <span className="badge badge-match" title="This folder is an entity clone derived from a template archetype">
                  ⚡ Clone (src: {browseData.current_folder.source_id.slice(0, 8)}...)
                </span>
              )}
              <a
                href={`https://drive.google.com/drive/folders/${browseData.current_folder.id}`}
                target="_blank"
                rel="noreferrer"
                style={{ color: 'var(--text-dim)', display: 'inline-flex', alignItems: 'center', marginLeft: '0.3rem' }}
                title="Open in Google Drive"
              >
                <ExternalLink size={14} />
              </a>
            </div>

            {/* Action Buttons */}
            <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
              <button
                onClick={() => setIsCloneModalOpen(true)}
                className="btn primary"
                style={{ padding: '0.4rem 0.85rem', fontSize: '12.5px', background: '#9333ea', borderColor: '#a855f7' }}
              >
                <Zap size={14} /> Spawn Stamped Clone...
              </button>
              <button
                onClick={() => setIsCreateModalOpen(true)}
                className="btn secondary"
                style={{ padding: '0.4rem 0.85rem', fontSize: '12.5px' }}
              >
                <FolderPlus size={14} /> New Folder
              </button>
              <button
                onClick={() => fetchFolder(currentFolderId, false)}
                className="btn subtle"
                style={{ padding: '0.4rem 0.65rem', fontSize: '12.5px' }}
                title="Refresh Folder Contents"
              >
                <RotateCw size={14} className={isLoading ? 'spinner' : ''} />
              </button>
            </div>
          </div>
        )}
      </div>

      {/* 2. Subfolders Listing */}
      <div className="card" style={{ padding: '0', overflow: 'hidden' }}>
        <div style={{ padding: '0.75rem 1.25rem', borderBottom: '1px solid var(--border-light)', background: 'var(--bg-card-hover)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <span style={{ fontSize: '12.5px', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.04em', color: 'var(--text-dim)' }}>
            Folders ({browseData?.subfolders.length || 0})
          </span>
          <span style={{ fontSize: '11.5px', color: 'var(--text-dim)' }}>
            Double-click or click to open
          </span>
        </div>

        {browseData?.subfolders.length === 0 ? (
          <div style={{ padding: '2.5rem', textAlign: 'center', color: 'var(--text-dim)', fontSize: '13.5px' }}>
            No subfolders found in this directory. Click "Spawn Stamped Clone" or "New Folder" above.
          </div>
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column' }}>
            {browseData?.subfolders.map((fld) => (
              <div
                key={fld.id}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  padding: '0.75rem 1.25rem',
                  borderBottom: '1px solid var(--border-table)',
                  transition: 'background 0.15s ease',
                  cursor: 'pointer',
                }}
                className="table-row-hover"
                onClick={() => fetchFolder(fld.id)}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: '0.75rem' }}>
                  <Folder size={18} style={{ color: fld.source_id ? '#c084fc' : 'var(--accent)' }} />
                  <div>
                    <div style={{ fontWeight: 600, fontSize: '13.5px', color: 'var(--text-primary)' }}>
                      {fld.name}
                    </div>
                    {fld.description && (
                      <div style={{ fontSize: '11px', color: 'var(--text-dim)', maxWidth: '500px', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
                        {fld.description}
                      </div>
                    )}
                  </div>
                </div>

                <div style={{ display: 'flex', alignItems: 'center', gap: '0.75rem' }} onClick={(e) => e.stopPropagation()}>
                  {fld.source_id ? (
                    <span className="badge badge-rename" style={{ fontSize: '11px' }}>
                      ⚡ src: {fld.source_id.slice(0, 8)}...
                    </span>
                  ) : (
                    <span className="badge badge-prune" style={{ fontSize: '11px' }}>
                      Manual
                    </span>
                  )}

                  <button
                    onClick={() => { setRenameTarget(fld); setRenameValue(fld.name); }}
                    className="btn subtle"
                    style={{ padding: '0.25rem 0.45rem' }}
                    title="Rename"
                  >
                    <FileEdit size={13} />
                  </button>

                  <button
                    onClick={() => setTrashTarget(fld)}
                    className="btn subtle"
                    style={{ padding: '0.25rem 0.45rem', color: 'var(--danger)' }}
                    title="Trash folder"
                  >
                    <Trash2 size={13} />
                  </button>

                  <a
                    href={`https://drive.google.com/drive/folders/${fld.id}`}
                    target="_blank"
                    rel="noreferrer"
                    style={{ color: 'var(--text-dim)', padding: '0.25rem' }}
                    title="Open in Google Drive"
                  >
                    <ExternalLink size={13} />
                  </a>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* 3. Files Listing (if any) */}
      {browseData && browseData.files.length > 0 && (
        <div className="card" style={{ padding: '0', overflow: 'hidden' }}>
          <div style={{ padding: '0.75rem 1.25rem', borderBottom: '1px solid var(--border-light)', background: 'var(--bg-card-hover)' }}>
            <span style={{ fontSize: '12.5px', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.04em', color: 'var(--text-dim)' }}>
              Files ({browseData.files.length})
            </span>
          </div>
          <div style={{ display: 'flex', flexDirection: 'column' }}>
            {browseData.files.map((file) => (
              <div
                key={file.id}
                style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '0.65rem 1.25rem', borderBottom: '1px solid var(--border-table)' }}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: '0.65rem' }}>
                  <File size={16} style={{ color: 'var(--info)' }} />
                  <span style={{ fontSize: '13px', color: 'var(--text-primary)' }}>{file.name}</span>
                </div>
                <a
                  href={`https://drive.google.com/file/d/${file.id}/view`}
                  target="_blank"
                  rel="noreferrer"
                  style={{ color: 'var(--text-dim)' }}
                >
                  <ExternalLink size={13} />
                </a>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ================= MODAL: SPAWN STAMPED CLONE ================= */}
      {isCloneModalOpen && (
        <div className="modal-backdrop">
          <div className="modal-box" style={{ maxWidth: '480px' }}>
            <h3 style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', margin: '0 0 1rem 0' }}>
              <Zap size={18} style={{ color: '#c084fc' }} />
              Spawn Custom Stamped Clone
            </h3>
            <p style={{ fontSize: '13px', color: 'var(--text-secondary)', marginBottom: '1.25rem' }}>
              Creates a brand new entity folder under <strong>{browseData?.current_folder.name}</strong>,
              recursively reproducing the template tree and stamping each folder with immutable <code>src:</code> pointers.
            </p>
            <form onSubmit={handleSpawnClone} style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
              <div>
                <label style={{ display: 'block', fontSize: '12px', fontWeight: 600, color: 'var(--text-dim)', marginBottom: '0.35rem' }}>
                  New Clone Folder Name (e.g. C25_Elena)
                </label>
                <input
                  type="text"
                  required
                  autoFocus
                  placeholder="Enter specific name..."
                  value={cloneName}
                  onChange={(e) => setCloneName(e.target.value)}
                  className="input-base"
                />
              </div>

              <div>
                <label style={{ display: 'block', fontSize: '12px', fontWeight: 600, color: 'var(--text-dim)', marginBottom: '0.35rem' }}>
                  Template Archetype URL / ID
                </label>
                <input
                  type="text"
                  required
                  value={cloneTemplate}
                  onChange={(e) => setCloneTemplate(e.target.value)}
                  className="input-base"
                />
              </div>

              <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.6rem', marginTop: '0.5rem' }}>
                <button type="button" onClick={() => setIsCloneModalOpen(false)} className="btn subtle" disabled={isCloning}>
                  Cancel
                </button>
                <button type="submit" className="btn primary" style={{ background: '#9333ea', borderColor: '#a855f7' }} disabled={isCloning}>
                  {isCloning ? 'Spawning Folders...' : 'Spawn Stamped Clone'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* ================= MODAL: CREATE REGULAR FOLDER ================= */}
      {isCreateModalOpen && (
        <div className="modal-backdrop">
          <div className="modal-box" style={{ maxWidth: '400px' }}>
            <h3 style={{ margin: '0 0 1rem 0' }}>Create New Folder</h3>
            <form onSubmit={handleCreateFolder} style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
              <input
                type="text"
                required
                autoFocus
                placeholder="Folder name..."
                value={newFolderName}
                onChange={(e) => setNewFolderName(e.target.value)}
                className="input-base"
              />
              <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.6rem' }}>
                <button type="button" onClick={() => setIsCreateModalOpen(false)} className="btn subtle">
                  Cancel
                </button>
                <button type="submit" className="btn primary">
                  Create
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* ================= MODAL: RENAME FOLDER ================= */}
      {renameTarget && (
        <div className="modal-backdrop">
          <div className="modal-box" style={{ maxWidth: '400px' }}>
            <h3 style={{ margin: '0 0 1rem 0' }}>Rename Folder</h3>
            <form onSubmit={handleRename} style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
              <input
                type="text"
                required
                autoFocus
                value={renameValue}
                onChange={(e) => setRenameValue(e.target.value)}
                className="input-base"
              />
              <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.6rem' }}>
                <button type="button" onClick={() => setRenameTarget(null)} className="btn subtle">
                  Cancel
                </button>
                <button type="submit" className="btn primary">
                  Save Name
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* ================= MODAL: TRASH CONFIRMATION ================= */}
      {trashTarget && (
        <div className="modal-backdrop">
          <div className="modal-box" style={{ maxWidth: '420px', borderColor: 'var(--danger-border)' }}>
            <h3 style={{ margin: '0 0 0.75rem 0', color: 'var(--danger)' }}>Move to Trash?</h3>
            <p style={{ fontSize: '13px', color: 'var(--text-secondary)', marginBottom: '1.25rem' }}>
              Are you sure you want to move <strong>'{trashTarget.name}'</strong> to Google Drive Trash?
              Folders with existing files will be safeguarded from accidental deletion.
            </p>
            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.6rem' }}>
              <button type="button" onClick={() => setTrashTarget(null)} className="btn subtle">
                Cancel
              </button>
              <button
                type="button"
                onClick={handleTrash}
                className="btn danger"
                style={{ background: 'var(--danger)', color: 'white' }}
              >
                Confirm Trash
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
