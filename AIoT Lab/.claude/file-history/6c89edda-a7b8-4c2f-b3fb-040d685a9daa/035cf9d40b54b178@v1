export type ActionType = 'CREATE' | 'UPDATE_DESC' | 'PRUNE_EMPTY' | 'FLAG_RED' | 'MATCH';

export interface ActionItem {
  action_type: ActionType;
  relative_path: string;
  folder_name: string;
  target_id?: string | null;
  target_parent_id?: string | null;
  current_desc: string;
  expected_desc: string;
  subfolders_count: number;
  files_count: number;
  reason: string;
}

export interface EntityPlan {
  target_root_id: string;
  target_root_name: string;
  template_name: string;
  summary: Record<string, number>;
  items: ActionItem[];
}

export interface EntityGroup {
  group_name: string;
  group_id: string;
  empty_note?: string;
  entity_plans: EntityPlan[];
}

export interface PlanSummary {
  total_groups: number;
  total_entities: number;
  create_count: number;
  update_desc_count: number;
  prune_empty_count: number;
  flagged_red_count: number;
  compliant_count: number;
  total_evaluated: number;
}

export interface MultiEntityPlan {
  data_root_id: string;
  data_root_name: string;
  template_name: string;
  template_schema: Record<string, any>;
  summary: PlanSummary;
  groups: EntityGroup[];
}

export interface ScanResponse {
  success: boolean;
  duration_ms: number;
  template_id: string;
  root_id: string;
  plan: MultiEntityPlan;
}

export interface ReconcileResults {
  dry_run: boolean;
  created_count: number;
  updated_desc_count: number;
  pruned_empty_count: number;
  flagged_red_count: number;
  duration_ms: number;
  summary: Record<string, number>;
  executed: boolean;
}

export interface AuditLog {
  id: number;
  target_folder_id: string;
  target_folder_name: string;
  template_name: string;
  created_count: number;
  updated_desc_count: number;
  pruned_empty_count: number;
  flagged_red_count: number;
  dry_run: boolean;
  details: Record<string, any>;
  created_at: string;
}

export interface TemplateNode {
  id: string;
  name: string;
  description: string;
  parentId: string | null;
  children: TemplateNode[];
  isNew?: boolean;
  isModified?: boolean;
  isDeleted?: boolean;
}

export interface CreateMutation {
  temp_id: string;
  parent_id: string;
  name: string;
  description: string;
}

export interface UpdateMutation {
  id: string;
  name: string;
  description: string;
}

export interface DeleteMutation {
  id: string;
  name: string;
}

export interface TemplateMutations {
  creates: CreateMutation[];
  updates: UpdateMutation[];
  deletes: DeleteMutation[];
}

export interface TemplateResponse {
  success: boolean;
  template_id: string;
  template_name: string;
  tree: TemplateNode;
  vault_tags: Record<string, string[]>;
  duration_ms: number;
}

export interface TemplateSaveResponse {
  success: boolean;
  duration_ms: number;
  created_count: number;
  updated_count: number;
  deleted_count: number;
  tree: TemplateNode;
  vault_tags: Record<string, string[]>;
}
