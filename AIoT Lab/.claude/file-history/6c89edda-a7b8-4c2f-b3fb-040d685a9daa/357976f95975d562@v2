import React, { useState, useEffect } from 'react';
import {
  Folder,
  File,
  ChevronRight,
  ArrowUpLeft,
  ExternalLink,
  RotateCw,
  Plus,
  Trash2,
  FileEdit,
  CheckCircle2,
  AlertTriangle,
  FolderPlus,
} from 'lucide-react';
import { BrowseResponse, DriveFolderItem, DriveFileItem, ActionItem } from '../types';

interface SubfolderExplorerProps {
  entityRootId: string;
  entityRootName: string;
  allEntityItems: ActionItem[];
  addToast: (type: 'success' | 'error' | 'info', title: string, message?: string) => void;
}

interface Crumb {
  id: string;
  name: string;
}

export const SubfolderExplorer: React.FC<SubfolderExplorerProps> = ({
  entityRootId,
  entityRootName,
  allEntityItems,
  addToast,
}) => {
  const [currentFolderId, setCurrentFolderId] = useState(entityRootId);
  const [breadcrumbs, setBreadcrumbs] = useState<Crumb[]>([{ id: entityRootId, name: entityRootName }]);
  const [browseData, setBrowseData] = useState<BrowseResponse | null>(null);
  const [isLoading, setIsLoading] = useState(false);

  // Modals inside subfolder explorer
  const [isNewFolderOpen, setIsNewFolderOpen] = useState(false);
  const [newFolderName, setNewFolderName] = useState('');

  // Reset navigation when active entity changes
  useEffect(() => {
    setCurrentFolderId(entityRootId);
    setBreadcrumbs([{ id: entityRootId, name: entityRootName }]);
    loadFolder(entityRootId);
  }, [entityRootId, entityRootName]);

  const loadFolder = async (folderId: string) => {
    setIsLoading(true);
    try {
      const res = await fetch(`/api/drive/browse?folder_id=${encodeURIComponent(folderId)}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Failed to load subfolder');
      setBrowseData(data);
    } catch (err: any) {
      addToast('error', 'Navigation Error', err.message);
    } finally {
      setIsLoading(false);
    }
  };

  const navigateTo = (folder: { id: string; name: string }) => {
    setCurrentFolderId(folder.id);
    setBreadcrumbs((prev) => {
      const idx = prev.findIndex((c) => c.id === folder.id);
      if (idx !== -1) return prev.slice(0, idx + 1);
      return [...prev, { id: folder.id, name: folder.name }];
    });
    loadFolder(folder.id);
  };

  const navigateUp = () => {
    if (breadcrumbs.length > 1) {
      const parentCrumb = breadcrumbs[breadcrumbs.length - 2];
      navigateTo(parentCrumb);
    }
  };

  const handleCreateSubfolder = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newFolderName.trim()) return;
    try {
      const res = await fetch('/api/drive/create_folder', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          parent_id: currentFolderId,
          name: newFolderName.trim(),
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.detail || 'Failed to create folder');
      addToast('success', 'Folder Created', `Created '${newFolderName}'`);
      setIsNewFolderOpen(false);
      setNewFolderName('');
      loadFolder(currentFolderId);
    } catch (err: any) {
      addToast('error', 'Create Error', err.message);
    }
  };

  // Find reconciliation status for a subfolder item
  const getSubfolderStatus = (fld: DriveFolderItem) => {
    const item = allEntityItems.find(
      (i) => i.target_id === fld.id || (i.source_id && i.source_id === fld.source_id) || i.folder_name === fld.name
    );
    if (!item) return null;
    return item;
  };

  return (
    <div className="card" style={{ padding: '0', overflow: 'hidden', borderColor: 'var(--border-mid)' }}>
      {/* 1. Explorer Navigation Bar */}
      <div
        style={{
          padding: '0.75rem 1.25rem',
          borderBottom: '1px solid var(--border-light)',
          background: 'var(--bg-canvas)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          flexWrap: 'wrap',
          gap: '0.65rem',
        }}
      >
        {/* Breadcrumb Trail */}
        <div style={{ display: 'flex', alignItems: 'center', gap: '0.35rem', flexWrap: 'wrap' }}>
          {breadcrumbs.length > 1 && (
            <button
              onClick={navigateUp}
              className="btn subtle"
              style={{ padding: '0.25rem 0.55rem', fontSize: '11.5px' }}
              title="Navigate up one level"
            >
              <ArrowUpLeft size={13} /> Up
            </button>
          )}

          {breadcrumbs.map((crumb, idx) => {
            const isLast = idx === breadcrumbs.length - 1;
            return (
              <React.Fragment key={crumb.id}>
                {idx > 0 && <ChevronRight size={12} style={{ color: 'var(--text-dim)' }} />}
                <button
                  onClick={() => navigateTo(crumb)}
                  style={{
                    background: isLast ? 'var(--bg-card-hover)' : 'transparent',
                    border: 'none',
                    color: isLast ? 'var(--accent)' : 'var(--text-secondary)',
                    fontWeight: isLast ? 700 : 500,
                    fontSize: '12.5px',
                    cursor: 'pointer',
                    padding: '0.2rem 0.5rem',
                    borderRadius: 'var(--radius-sm)',
                  }}
                >
                  {crumb.name}
                </button>
              </React.Fragment>
            );
          })}
        </div>

        {/* Action Controls */}
        <div style={{ display: 'flex', alignItems: 'center', gap: '0.4rem' }}>
          <button
            onClick={() => setIsNewFolderOpen(true)}
            className="btn secondary"
            style={{ padding: '0.3rem 0.65rem', fontSize: '11.5px', display: 'flex', alignItems: 'center', gap: '0.35rem' }}
          >
            <FolderPlus size={13} /> New Subfolder
          </button>

          <button
            onClick={() => loadFolder(currentFolderId)}
            className="btn subtle"
            style={{ padding: '0.3rem 0.55rem' }}
            title="Refresh current folder"
          >
            <RotateCw size={13} className={isLoading ? 'spinner' : ''} />
          </button>

          <a
            href={`https://drive.google.com/drive/folders/${currentFolderId}`}
            target="_blank"
            rel="noreferrer"
            className="btn subtle"
            style={{ padding: '0.3rem 0.55rem', color: 'var(--text-dim)' }}
            title="Open current folder in Google Drive"
          >
            <ExternalLink size={13} />
          </a>
        </div>
      </div>

      {/* 2. Directory Contents (Subfolders + Files) */}
      <div style={{ display: 'flex', flexDirection: 'column' }}>
        {isLoading ? (
          <div style={{ padding: '2rem', textAlign: 'center', color: 'var(--text-dim)', fontSize: '13px' }}>
            Loading folder contents...
          </div>
        ) : browseData?.subfolders.length === 0 && browseData?.files.length === 0 ? (
          <div style={{ padding: '2.5rem', textAlign: 'center', color: 'var(--text-dim)', fontSize: '13px' }}>
            This folder is completely empty.
          </div>
        ) : (
          <>
            {/* Subfolders rows */}
            {browseData?.subfolders.map((fld) => {
              const statusItem = getSubfolderStatus(fld);

              return (
                <div
                  key={fld.id}
                  onClick={() => navigateTo(fld)}
                  className="table-row-hover"
                  style={{
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'space-between',
                    padding: '0.75rem 1.25rem',
                    borderBottom: '1px solid var(--border-table)',
                    cursor: 'pointer',
                  }}
                >
                  <div style={{ display: 'flex', alignItems: 'center', gap: '0.75rem' }}>
                    <Folder
                      size={18}
                      style={{
                        color:
                          statusItem?.action_type === 'RENAME'
                            ? '#c084fc'
                            : statusItem?.action_type === 'FLAG_RED'
                            ? 'var(--danger)'
                            : 'var(--accent)',
                      }}
                    />
                    <div>
                      <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                        <span style={{ fontWeight: 600, fontSize: '13.5px', color: 'var(--text-primary)' }}>
                          {fld.name}
                        </span>

                        {/* Status pills inside folder explorer */}
                        {statusItem?.action_type === 'RENAME' ? (
                          <span className="badge badge-rename" style={{ fontSize: '10.5px' }}>
                            Renamed in template &rarr; {statusItem.folder_name}
                          </span>
                        ) : statusItem?.action_type === 'UPDATE_DESC' ? (
                          <span className="badge badge-update" style={{ fontSize: '10.5px' }}>
                            Outdated Metadata
                          </span>
                        ) : statusItem?.action_type === 'PRUNE_EMPTY' ? (
                          <span className="badge badge-prune" style={{ fontSize: '10.5px' }}>
                            Empty / Not in template
                          </span>
                        ) : statusItem?.action_type === 'FLAG_RED' ? (
                          <span className="badge badge-anomaly" style={{ fontSize: '10.5px' }}>
                            Protected ({statusItem.files_count} files)
                          </span>
                        ) : (
                          <span style={{ fontSize: '11px', color: 'var(--success)', display: 'inline-flex', alignItems: 'center', gap: '0.2rem' }}>
                            <CheckCircle2 size={12} /> In sync
                          </span>
                        )}
                      </div>

                      {fld.description && (
                        <div style={{ fontSize: '11px', color: 'var(--text-dim)', maxWidth: '450px', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
                          {fld.description}
                        </div>
                      )}
                    </div>
                  </div>

                  <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                    <span style={{ fontSize: '11px', color: 'var(--text-dim)' }}>
                      Click to enter &rarr;
                    </span>
                  </div>
                </div>
              );
            })}

            {/* Files rows */}
            {browseData?.files.map((file) => (
              <div
                key={file.id}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  padding: '0.65rem 1.25rem',
                  borderBottom: '1px solid var(--border-table)',
                  background: 'var(--bg-canvas)',
                }}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: '0.65rem' }}>
                  <File size={15} style={{ color: 'var(--info)' }} />
                  <span style={{ fontSize: '13px', color: 'var(--text-secondary)' }}>{file.name}</span>
                </div>
                <a
                  href={`https://drive.google.com/file/d/${file.id}/view`}
                  target="_blank"
                  rel="noreferrer"
                  style={{ color: 'var(--text-dim)' }}
                  title="Open file"
                >
                  <ExternalLink size={13} />
                </a>
              </div>
            ))}
          </>
        )}
      </div>

      {/* Modal: New Subfolder */}
      {isNewFolderOpen && (
        <div className="modal-backdrop">
          <div className="modal-box" style={{ maxWidth: '380px' }}>
            <h3 style={{ margin: '0 0 1rem 0', fontSize: '16px' }}>Create Subfolder</h3>
            <form onSubmit={handleCreateSubfolder} style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
              <input
                type="text"
                autoFocus
                required
                placeholder="Subfolder name..."
                value={newFolderName}
                onChange={(e) => setNewFolderName(e.target.value)}
                className="input-base"
              />
              <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '0.5rem' }}>
                <button type="button" onClick={() => setIsNewFolderOpen(false)} className="btn subtle">
                  Cancel
                </button>
                <button type="submit" className="btn primary">
                  Create Subfolder
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};
