/* ========================================================================
   DRIVE ARCHITECT: DESIGN SYSTEM TOKENS (SOVEREIGN FAUST CODEX)
   ======================================================================== */
:root {
  --bg-canvas:      #0a0908;
  --bg-card:        #15110d;
  --bg-card-hover:  #1f1813;
  --bg-card-active: #261f18;
  --bg-input:       #1c1611;
  --bg-input-focus: #28201a;
  --bg-row-hover:   #1a1410;
  --bg-row-active:  #241b14;

  --text-primary:   #fefdfb;
  --text-secondary: #e8ddd0;
  --text-tertiary:  #8f7f6e;
  --text-dim:       #6a5d4f;

  --border-light:   #3a2d23;
  --border-mid:     #4d3d30;
  --border-table:   #2a201a;

  --accent:         #ff9e1b;
  --accent-hover:   #ffb03a;
  --accent-glow:    rgba(255, 158, 27, 0.35);
  --accent-bg:      rgba(255, 158, 27, 0.12);

  --success:        #10b981;
  --success-bg:     rgba(16, 185, 129, 0.12);
  --success-border: rgba(16, 185, 129, 0.4);

  --warning:        #f59e0b;
  --warning-bg:     rgba(245, 158, 11, 0.12);
  --warning-border: rgba(245, 158, 11, 0.4);

  --danger:         #f43f5e;
  --danger-bg:      rgba(244, 63, 94, 0.14);
  --danger-border:  rgba(244, 63, 94, 0.45);
  --danger-glow:    rgba(244, 63, 94, 0.35);

  --info:           #38bdf8;
  --info-bg:        rgba(56, 189, 248, 0.12);
  --info-border:    rgba(56, 189, 248, 0.4);

  --muted:          #64748b;
  --muted-bg:       rgba(100, 116, 139, 0.12);
  --muted-border:   rgba(100, 116, 139, 0.35);

  --font-display:   "IBM Plex Sans", system-ui, -apple-system, sans-serif;
  --font-body:      "IBM Plex Sans", system-ui, -apple-system, sans-serif;
  --font-mono:      "IBM Plex Mono", monospace;

  --radius-sm:      6px;
  --radius-md:      8px;
  --radius-lg:      12px;
  --radius-xl:      16px;
  --radius-full:    9999px;

  --shadow-sm:      0 1px 2px rgba(0, 0, 0, 0.25);
  --shadow-md:      0 4px 16px rgba(0, 0, 0, 0.4);
  --shadow-lg:      0 12px 36px rgba(0, 0, 0, 0.6);

  color-scheme: dark;
}

[data-theme="light"] {
  --bg-canvas:      #faf8f5;
  --bg-card:        #ffffff;
  --bg-card-hover:  #fff5ee;
  --bg-card-active: #faeade;
  --bg-input:       #f5ede5;
  --bg-input-focus: #ffffff;
  --bg-row-hover:   #fdf4ec;
  --bg-row-active:  #fff3e0;

  --text-primary:   #18130e;
  --text-secondary: #382f26;
  --text-tertiary:  #6b5a49;
  --text-dim:       #9e8c79;

  --border-light:   #e8dccf;
  --border-mid:     #d9cabc;
  --border-table:   #ede4da;

  --accent:         #d97706;
  --accent-hover:   #b45309;
  --accent-glow:    rgba(217, 119, 6, 0.25);
  --accent-bg:      rgba(217, 119, 6, 0.10);

  color-scheme: light;
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body, #root {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: var(--bg-canvas);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* App Shell */
.app-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.main-content {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 1.5rem 2rem 3rem 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* Scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--border-mid);
  border-radius: var(--radius-full);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--text-tertiary);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-light);
  background: var(--bg-card);
  color: var(--text-secondary);
  font-weight: 500;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
  user-select: none;
}

.btn:hover:not(:disabled) {
  background: var(--bg-card-hover);
  border-color: var(--border-mid);
  color: var(--text-primary);
  transform: translateY(-1px);
}

.btn:active:not(:disabled) {
  transform: translateY(0);
}

.btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.btn.primary {
  background: var(--accent);
  color: #000;
  border-color: var(--accent);
  font-weight: 600;
  box-shadow: 0 2px 8px var(--accent-glow);
}

.btn.primary:hover:not(:disabled) {
  background: var(--accent-hover);
  box-shadow: 0 4px 16px var(--accent-glow);
}

.btn.danger {
  background: var(--danger-bg);
  border-color: var(--danger-border);
  color: var(--danger);
  font-weight: 600;
}

.btn.danger:hover:not(:disabled) {
  background: var(--danger);
  color: #fff;
  box-shadow: 0 4px 14px var(--danger-glow);
}

.btn.subtle {
  background: transparent;
  border-color: transparent;
  color: var(--text-tertiary);
}

.btn.subtle:hover:not(:disabled) {
  background: var(--bg-card);
  border-color: var(--border-light);
  color: var(--text-primary);
}

/* Badges */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
  font-size: 11px;
  font-family: var(--font-mono);
  font-weight: 600;
  line-height: 1.2;
}

.badge-create {
  background: var(--success-bg);
  color: var(--success);
  border: 1px solid var(--success-border);
}

.badge-update {
  background: var(--warning-bg);
  color: var(--warning);
  border: 1px solid var(--warning-border);
}

.badge-prune {
  background: var(--muted-bg);
  color: var(--muted);
  border: 1px solid var(--muted-border);
}

.badge-anomaly {
  background: var(--danger-bg);
  color: var(--danger);
  border: 1px solid var(--danger-border);
  box-shadow: 0 0 10px var(--danger-glow);
  animation: pulseAnomaly 2.5s infinite;
}

@keyframes pulseAnomaly {
  0% { box-shadow: 0 0 4px rgba(244, 63, 94, 0.2); }
  50% { box-shadow: 0 0 12px rgba(244, 63, 94, 0.5); }
  100% { box-shadow: 0 0 4px rgba(244, 63, 94, 0.2); }
}

.badge-match {
  background: rgba(20, 184, 166, 0.12);
  color: #14b8a6;
  border: 1px solid rgba(20, 184, 166, 0.35);
}

/* Inputs */
.input-base {
  background: var(--bg-input);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-sm);
  padding: 0.6rem 0.85rem;
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 13.5px;
  outline: none;
  width: 100%;
  transition: border-color 0.18s, box-shadow 0.18s;
  cursor: text !important;
  user-select: text !important;
}

.input-base:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-bg);
  background: var(--bg-input-focus);
}

/* Cards */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  padding: 1.25rem 1.5rem;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.18s;
}

.card:hover {
  border-color: var(--border-mid);
}

/* Toast */
.toast-container {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  pointer-events: none;
}

.toast {
  background: var(--bg-card);
  border: 1px solid var(--border-mid);
  box-shadow: var(--shadow-lg);
  color: var(--text-primary);
  padding: 0.85rem 1.35rem;
  border-radius: var(--radius-md);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  animation: toastIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: auto;
}

@keyframes toastIn {
  from { opacity: 0; transform: translateY(16px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* Spinners */
.spinner {
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
