/* Arc Jurassic Golden Standard Gacha Button Styles */

.chrono-gacha-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin-top: 4px;
  user-select: none;
}

/* PRIMARY SUMMON BUTTON (Golden Standard from Image #3) */
.chrono-summon-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: min(440px, 92%);
  min-height: 56px;
  border: 1px solid rgba(168, 85, 247, 0.6);
  border-radius: 14px;
  padding: 12px 32px;
  font-size: 16px;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(180deg, #371e68 0%, #5227a3 50%, #6830cc 100%);
  box-shadow: 0 8px 24px rgba(76, 29, 149, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  transition: transform 0.08s ease-out, box-shadow 0.08s ease-out, border-color 0.08s ease-out;
  white-space: nowrap;
  cursor: pointer;
  user-select: none;
}

.chrono-summon-button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(124, 58, 237, 0.6), 0 0 16px rgba(168, 85, 247, 0.4);
  border-color: #c084fc;
}

.chrono-summon-button:active:not(:disabled) {
  transform: translateY(0) scale(0.98);
}

.chrono-summon-button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* HIGH WAGER MODE */
.chrono-summon-button.is-high-wager {
  background: linear-gradient(180deg, #3b185e 0%, #5b219c 50%, #8b32cc 100%);
  border-color: #d8b4fe;
  box-shadow: 0 8px 26px rgba(139, 50, 204, 0.4), 0 0 16px rgba(216, 180, 254, 0.3);
}

/* SPOOLING ACTIVE MODE */
.chrono-summon-button.is-spooling {
  background: linear-gradient(180deg, #2e1045 0%, #501777 50%, #7c2299 100%);
  border-color: #f0abfc;
  box-shadow: 0 8px 28px rgba(217, 70, 239, 0.45), 0 0 20px rgba(240, 171, 252, 0.5);
}

/* WAGER BAR (Golden Standard from Image #3) */
.chrono-wager-bar {
  width: min(440px, 92%);
  padding: 8px 14px;
  border-radius: 12px;
  background: rgba(14, 10, 24, 0.95);
  border: 1px solid rgba(251, 191, 36, 0.35);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  user-select: none;
}

.chrono-wager-label {
  font-size: 11.5px;
  font-weight: 800;
  color: #ffd86b;
  font-family: monospace;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  white-space: nowrap;
}

.chrono-wager-select-wrapper {
  position: relative;
  flex: 1;
  max-width: 220px;
  display: flex;
  align-items: center;
}

.chrono-wager-select {
  width: 100%;
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  padding: 6px 28px 6px 12px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 800;
  font-family: monospace;
  border: 1px solid rgba(251, 191, 36, 0.35);
  background: rgba(18, 12, 30, 0.95);
  color: #f5f0e8;
  cursor: pointer;
  outline: none;
  transition: all 0.12s ease-out;
}

.chrono-wager-select:hover {
  border-color: #ffd700;
  box-shadow: 0 0 10px rgba(255, 215, 0, 0.25);
}

.chrono-wager-select:focus {
  border-color: #ffd700;
  box-shadow: 0 0 12px rgba(255, 215, 0, 0.4);
}

.chrono-select-chevron {
  position: absolute;
  right: 8px;
  width: 14px;
  height: 14px;
  color: #ffd86b;
  pointer-events: none;
}
