// path: src/apps/heraclitus/components/YellowPoolTab.tsx
// Tier 4 Transport/UI: Yellow Pool Tab embedding the 5 authentic Two-Phase Kinetic Animation Engines
// Direct integration without refactoring or HTML distortion

import React, { useState, useEffect, useRef, useCallback } from 'react'
import { fetchPoolState, depositToPool } from '../services/heraclitusApi'
import type { YellowTimePoolState } from '../types'
import {
  Sparkles,
  Maximize2,
  ExternalLink,
  PlusCircle,
  Database,
} from 'lucide-react'
import { formatDuration } from '../animations/twoPhaseEngine'

export interface ChronoEngineModule {
  id: string
  file: string
  name: string
  desc: string
  icon: string
  themeColor: string
}

export const TWO_PHASE_ENGINES: ChronoEngineModule[] = [
  {
    id: 'spool_shatter',
    file: 'phase_005_spool_and_shatter.html',
    name: 'Chrono Spool & Shatter',
    desc: 'Golden Thermal Blast & Downward Dissolve',
    icon: '⏳',
    themeColor: '#fbbf24',
  },
  {
    id: 'singularity',
    file: 'phase_009_chronos_singularity.html',
    name: 'Chronos Singularity',
    desc: 'Gravitational Collapse & Violet Swarm',
    icon: '⚛',
    themeColor: '#c084fc',
  },
  {
    id: 'prismatic',
    file: 'phase_006_prismatic_crystal.html',
    name: 'Prism Crystal Fracture',
    desc: 'Hexagonal Crystal Stress & Shard Swarm',
    icon: '💎',
    themeColor: '#e879f9',
  },
  {
    id: 'cyber',
    file: 'phase_007_cyber_matrix.html',
    name: 'Cyber Voxel Defrag',
    desc: 'Isometric Voxel Compile & Binary Stream',
    icon: '💾',
    themeColor: '#00f0ff',
  },
  {
    id: 'supernova',
    file: 'phase_010_supernova_spool.html',
    name: 'Supernova Collapse Spool',
    desc: 'Protostar Ingestion & Stellar Flare',
    icon: '☀️',
    themeColor: '#f59e0b',
  },
]

export const YellowPoolTab: React.FC = () => {
  const [activeEngineId, setActiveEngineId] = useState<string>('spool_shatter')
  const [poolState, setPoolState] = useState<YellowTimePoolState | null>(null)
  const [balanceSec, setBalanceSec] = useState<number>(0)
  const [customHours, setCustomHours] = useState<string>('')
  const [isDepositing, setIsDepositing] = useState<boolean>(false)
  const [backendOnline, setBackendOnline] = useState<boolean>(true)
  const [statusNotice, setStatusNotice] = useState<string | null>(null)

  const iframeRef = useRef<HTMLIFrameElement | null>(null)
  const activeEngine = TWO_PHASE_ENGINES.find((e) => e.id === activeEngineId) || TWO_PHASE_ENGINES[0]

  // Load backend balance on mount
  const loadPoolState = useCallback(async () => {
    try {
      const state = await fetchPoolState()
      setPoolState(state)
      setBalanceSec(state.balance_seconds)
      setBackendOnline(true)

      // Send to iframe
      if (iframeRef.current?.contentWindow) {
        iframeRef.current.contentWindow.postMessage(
          { type: 'SET_BALANCE', seconds: state.balance_seconds },
          '*'
        )
      }
    } catch {
      setBackendOnline(false)
      // Allow seamless offline gameplay
    }
  }, [])

  useEffect(() => {
    loadPoolState()
  }, [loadPoolState])

  // PostMessage communication listener
  useEffect(() => {
    const handleMessage = async (event: MessageEvent) => {
      if (!event.data || typeof event.data !== 'object') return

      if (event.data.type === 'DEPOSIT_STARTED') {
        setIsDepositing(true)
      } else if (event.data.type === 'DEPOSIT_COMMITTED') {
        const depositedSeconds = Number(event.data.seconds) || 0
        setBalanceSec((prev) => prev + depositedSeconds)
        setIsDepositing(false)

        // Attempt persistence to backend ledger
        try {
          const updatedState = await depositToPool({
            seconds: depositedSeconds,
            source: `${activeEngine.name} Engine`,
            category: 'grind',
            speed: 1.0,
            notes: `Kinetic Two-Phase Deposit (${activeEngine.id})`,
          })
          setPoolState(updatedState)
          setBackendOnline(true)
          setStatusNotice(`+${(depositedSeconds / 3600).toFixed(2)}h committed to Sovereign SQLite Ledger`)
          setTimeout(() => setStatusNotice(null), 3500)
        } catch {
          setBackendOnline(false)
          setStatusNotice(`+${(depositedSeconds / 3600).toFixed(2)}h recorded in active session`)
          setTimeout(() => setStatusNotice(null), 3500)
        }
      }
    }

    window.addEventListener('message', handleMessage)
    return () => window.removeEventListener('message', handleMessage)
  }, [activeEngine])

  // Handle iframe load to inject current balance
  const handleIframeLoad = () => {
    if (iframeRef.current?.contentWindow && balanceSec > 0) {
      iframeRef.current.contentWindow.postMessage(
        { type: 'SET_BALANCE', seconds: balanceSec },
        '*'
      )
    }
  }

  // Trigger deposit via React custom hours input
  const handleCustomDeposit = (e: React.FormEvent) => {
    e.preventDefault()
    const h = parseFloat(customHours)
    if (!h || h <= 0) return

    const seconds = h * 3600
    if (iframeRef.current?.contentWindow) {
      iframeRef.current.contentWindow.postMessage(
        { type: 'TRIGGER_DEPOSIT', seconds },
        '*'
      )
    }
    setCustomHours('')
  }

  const handleFullscreen = () => {
    const iframe = iframeRef.current
    if (!iframe) return
    if (iframe.requestFullscreen) {
      iframe.requestFullscreen()
    } else if ((iframe as any).webkitRequestFullscreen) {
      ;(iframe as any).webkitRequestFullscreen()
    }
  }

  const handleOpenRaw = () => {
    window.open(`/animations/2-phases/${activeEngine.file}?balance=${balanceSec}`, '_blank')
  }

  return (
    <div className="space-y-4">
      {/* ── 1. Engine Selector Matrix Bar ──────────────────────────────── */}
      <div className="p-3.5 rounded-2xl bg-[#0f0b17]/95 border border-[#2b203a] shadow-xl flex flex-col md:flex-row items-center justify-between gap-3">
        {/* Engine Pills */}
        <div className="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-1 md:pb-0 custom-scrollbar">
          {TWO_PHASE_ENGINES.map((engine) => {
            const isSelected = activeEngineId === engine.id
            return (
              <button
                key={engine.id}
                type="button"
                onClick={() => setActiveEngineId(engine.id)}
                className={`min-h-[46px] px-3.5 rounded-xl border flex items-center gap-2 text-xs font-cinzel font-bold transition-all cursor-pointer whitespace-nowrap active:scale-95 ${
                  isSelected
                    ? 'bg-gradient-to-r from-[#2a1d3d] to-[#1a1226] text-white shadow-lg'
                    : 'bg-[#150f21] hover:bg-[#1f1730] text-[#9a8da8] hover:text-white border-[#332646]'
                }`}
                style={{
                  borderColor: isSelected ? engine.themeColor : undefined,
                  boxShadow: isSelected ? `0 0 16px ${engine.themeColor}33` : undefined,
                }}
              >
                <span className="text-base">{engine.icon}</span>
                <span>{engine.name}</span>
              </button>
            )
          })}
        </div>

        {/* Viewport Control Buttons */}
        <div className="flex items-center gap-2 self-end md:self-auto">
          <button
            type="button"
            onClick={handleFullscreen}
            className="min-h-[42px] px-3 rounded-xl bg-[#171124] hover:bg-[#251b38] border border-[#372a4d] hover:border-[#ffd86b] text-[#ffd86b] text-xs font-mono transition flex items-center gap-1.5 cursor-pointer active:scale-95"
            title="Fullscreen Animation Stage"
          >
            <Maximize2 className="w-3.5 h-3.5" />
            <span className="hidden sm:inline">Fullscreen</span>
          </button>
          <button
            type="button"
            onClick={handleOpenRaw}
            className="min-h-[42px] px-3 rounded-xl bg-[#171124] hover:bg-[#251b38] border border-[#372a4d] hover:border-[#ffd86b] text-[#cbd5e1] hover:text-white text-xs font-mono transition flex items-center gap-1.5 cursor-pointer active:scale-95"
            title="Open HTML in new window"
          >
            <ExternalLink className="w-3.5 h-3.5" />
            <span className="hidden sm:inline">Open File</span>
          </button>
        </div>
      </div>

      {/* ── 2. The Original 2-Phase Kinetic Animation Stage ────────────── */}
      <div className="relative w-full rounded-2xl overflow-hidden border border-[#382b4c] bg-[#030206] shadow-2xl">
        <iframe
          key={activeEngine.id}
          ref={iframeRef}
          src={`/animations/2-phases/${activeEngine.file}?balance=${balanceSec}`}
          title={activeEngine.name}
          onLoad={handleIframeLoad}
          className="w-full h-[640px] md:h-[680px] border-0 block"
          sandbox="allow-scripts allow-same-origin"
        />

        {/* Top Active Theme Subtitle Chip */}
        <div className="absolute top-3 left-4 pointer-events-none z-20 flex items-center gap-2 px-3 py-1 rounded-full bg-[#0d0918]/85 border border-white/10 backdrop-blur-md text-[11px] font-mono text-[#cbd5e1]">
          <span className="w-2 h-2 rounded-full animate-pulse" style={{ background: activeEngine.themeColor }} />
          <span>{activeEngine.desc}</span>
        </div>

        {/* Backend Status Telemetry Badge */}
        <div className="absolute top-3 right-4 pointer-events-none z-20 flex items-center gap-2 px-3 py-1 rounded-full bg-[#0d0918]/85 border border-white/10 backdrop-blur-md text-[10px] font-mono">
          <Database className="w-3 h-3 text-[#ffd86b]" />
          {backendOnline ? (
            <span className="text-emerald-400 font-bold">SQLITE SSOT ONLINE</span>
          ) : (
            <span className="text-amber-400">SESSION MODE</span>
          )}
        </div>
      </div>

      {/* ── 3. Bottom Quick Commands & Custom Hours Injector ───────────── */}
      <div className="p-4 rounded-2xl bg-[#0f0b17]/95 border border-[#2b203a] shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4">
        {/* Status Notice Banner */}
        <div className="flex items-center gap-3 min-h-[24px]">
          {statusNotice ? (
            <div className="flex items-center gap-2 text-xs font-mono text-emerald-400 bg-emerald-950/40 px-3 py-1 rounded-lg border border-emerald-500/30">
              <Sparkles className="w-3.5 h-3.5" />
              <span>{statusNotice}</span>
            </div>
          ) : (
            <div className="flex items-center gap-2 text-xs font-mono text-[#8a7c9d]">
              <span className="text-[#ffd86b] font-bold">Tip:</span>
              <span>Click the preset buttons inside the stage or input custom hours below.</span>
              {poolState && poolState.total_earned_seconds > 0 && (
                <span className="ml-2 text-[#cbd5e1] border-l border-white/10 pl-2">
                  All-time: <strong className="text-[#ffd86b]">{formatDuration(poolState.total_earned_seconds)}</strong>
                </span>
              )}
            </div>
          )}
        </div>

        {/* Custom Hours Input Form */}
        <form onSubmit={handleCustomDeposit} className="flex items-center gap-2 w-full sm:w-auto">
          <div className="relative flex-1 sm:w-44">
            <input
              type="number"
              min="0.05"
              step="0.25"
              value={customHours}
              onChange={(e) => setCustomHours(e.target.value)}
              placeholder="Custom Hours..."
              disabled={isDepositing}
              className="w-full min-h-[44px] px-3.5 rounded-xl bg-[#161022] border border-[#36274a] focus:border-[#ffd86b] text-xs font-mono text-white placeholder-[#685b79] outline-none transition"
            />
          </div>
          <button
            type="submit"
            disabled={isDepositing || !customHours || parseFloat(customHours) <= 0}
            className="min-h-[44px] px-4 rounded-xl bg-gradient-to-r from-[#d4af37] via-[#ffd86b] to-[#b38f22] text-black font-cinzel font-bold text-xs tracking-wider transition hover:brightness-110 active:scale-95 disabled:opacity-50 cursor-pointer flex items-center gap-1.5 whitespace-nowrap"
          >
            <PlusCircle className="w-3.5 h-3.5 fill-black" />
            <span>{isDepositing ? 'SPOOLING...' : 'CHANNEL HOURS'}</span>
          </button>
        </form>
      </div>
    </div>
  )
}

export default YellowPoolTab
