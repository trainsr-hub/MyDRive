// path: src/apps/heraclitus/components/ChronoAccumulatorCanvas.tsx
// Tier 4: Canvas-based kinetic particle visualizer for Two-Phase Accumulator
// Clean separation of physics, particle magnet-pull, and render loop

import React, { useEffect, useRef, useImperativeHandle, forwardRef } from 'react'
import { chronoAudio } from '../services/chronoAudio'

export type ChronoEngineTheme = 'spool_shatter' | 'singularity' | 'prismatic' | 'cyber' | 'supernova'

export interface ChronoAccumulatorRef {
  deposit: (seconds: number) => void
  reset: () => void
}

interface Particle {
  x: number
  y: number
  vx: number
  vy: number
  secVal: number
  age: number
  magnetWait: number
  size: number
  color: string
  char?: string
}

interface Shockwave {
  r: number
  maxR: number
  alpha: number
}

interface LightningArc {
  x1: number
  y1: number
  x2: number
  y2: number
  life: number
}

interface ChronoAccumulatorCanvasProps {
  theme: ChronoEngineTheme
  vaultTargetRef: React.RefObject<HTMLDivElement | null>
  onSpoolProgress?: (sec: number, progress: number) => void
  onShatter?: (targetSec: number) => void
  onAbsorb?: (secVal: number) => void
}

export const ChronoAccumulatorCanvas = forwardRef<ChronoAccumulatorRef, ChronoAccumulatorCanvasProps>(
  ({ theme, vaultTargetRef, onSpoolProgress, onShatter, onAbsorb }, ref) => {
    const canvasRef = useRef<HTMLCanvasElement | null>(null)
    const animRef = useRef<number | null>(null)

    // Physics & state refs
    const stateRef = useRef({
      W: 800,
      H: 600,
      cx: 400,
      cy: 300,
      isSpooling: false,
      targetSec: 0,
      spoolProgress: 0,
      screenShake: 0,
    })

    const particlesRef = useRef<Particle[]>([])
    const shockwavesRef = useRef<Shockwave[]>([])
    const arcsRef = useRef<LightningArc[]>([])

    // Expose deposit and reset
    useImperativeHandle(ref, () => ({
      deposit(seconds: number) {
        stateRef.current.isSpooling = true
        stateRef.current.targetSec = seconds
        stateRef.current.spoolProgress = 0
      },
      reset() {
        stateRef.current.isSpooling = false
        stateRef.current.spoolProgress = 0
        stateRef.current.screenShake = 0
        particlesRef.current = []
        shockwavesRef.current = []
        arcsRef.current = []
      },
    }))

    useEffect(() => {
      const canvas = canvasRef.current
      if (!canvas) return
      const ctx = canvas.getContext('2d')
      if (!ctx) return

      function resize() {
        if (!canvas) return
        const parent = canvas.parentElement
        const w = parent ? parent.clientWidth : window.innerWidth
        const h = parent ? parent.clientHeight : window.innerHeight
        canvas.width = w
        canvas.height = h
        stateRef.current.W = w
        stateRef.current.H = h
        stateRef.current.cx = w / 2
        stateRef.current.cy = h / 2 - 15
      }

      window.addEventListener('resize', resize)
      resize()

      function triggerShatterInternal() {
        stateRef.current.isSpooling = false
        const targetSec = stateRef.current.targetSec
        chronoAudio.playShatter()
        stateRef.current.screenShake = Math.min(32, 10 + (targetSec / 3600) * 3)

        const maxR = Math.min(stateRef.current.W, stateRef.current.H) * 0.65
        shockwavesRef.current.push({ r: 25, maxR, alpha: 1.0 })

        const pCount = Math.min(200, Math.max(45, Math.floor(targetSec / 80)))
        const secPerP = targetSec / pCount

        for (let i = 0; i < pCount; i++) {
          const a = Math.random() * Math.PI * 2
          const sp = 5 + Math.random() * 16
          const isGolden = Math.random() > 0.35
          const color = theme === 'cyber' ? '#5eead4' : theme === 'singularity' ? '#e879f9' : isGolden ? '#facc15' : '#38bdf8'

          particlesRef.current.push({
            x: stateRef.current.cx,
            y: stateRef.current.cy,
            vx: Math.cos(a) * sp,
            vy: Math.sin(a) * sp - 2,
            secVal: secPerP,
            age: 0,
            magnetWait: 14 + Math.random() * 16,
            size: 3 + Math.random() * 3.5,
            color,
            char: Math.random() > 0.5 ? '1' : '0',
          })
        }

        if (onShatter) onShatter(targetSec)
      }

      function render() {
        if (!ctx) return
        const s = stateRef.current
        const { cx, cy, W, H } = s

        ctx.save()
        if (s.screenShake > 0) {
          ctx.translate((Math.random() - 0.5) * s.screenShake, (Math.random() - 0.5) * s.screenShake)
          s.screenShake *= 0.88
          if (s.screenShake < 0.2) s.screenShake = 0
        }

        ctx.fillStyle = 'rgba(4, 2, 8, 0.28)'
        ctx.fillRect(-20, -20, W + 40, H + 40)
        const t = Date.now() * 0.002

        // Phase 1: Rapid non-linear spooling
        if (s.isSpooling) {
          s.spoolProgress += 0.045
          const curSec = Math.round(s.targetSec * Math.min(1.0, Math.pow(s.spoolProgress, 1.3)))
          if (onSpoolProgress) onSpoolProgress(curSec, s.spoolProgress)
          s.screenShake = 1.0 + s.spoolProgress * 8
          chronoAudio.playTick(420 + s.spoolProgress * 700)

          // Inward lightning arcs
          if (Math.random() < 0.6) {
            const a = Math.random() * Math.PI * 2
            const d = 80 + Math.random() * 90
            arcsRef.current.push({
              x1: cx + Math.cos(a) * d,
              y1: cy + Math.sin(a) * d,
              x2: cx,
              y2: cy,
              life: 3,
            })
          }

          const coreR = 34 + s.spoolProgress * 36 + Math.sin(t * 16) * 3
          ctx.beginPath()
          ctx.arc(cx, cy, coreR, 0, Math.PI * 2)
          ctx.fillStyle = s.spoolProgress > 0.8 ? '#fef08a' : 'rgba(249, 115, 22, 0.45)'
          ctx.shadowColor = '#f97316'
          ctx.shadowBlur = 20 + s.spoolProgress * 25
          ctx.fill()

          if (s.spoolProgress >= 1.0) {
            triggerShatterInternal()
          }
        } else {
          // Idle core
          const idleR = 34 + Math.sin(t * 3) * 2
          ctx.beginPath()
          ctx.arc(cx, cy, idleR, 0, Math.PI * 2)
          ctx.fillStyle = theme === 'cyber' ? 'rgba(0, 240, 255, 0.35)' : theme === 'singularity' ? 'rgba(192, 132, 252, 0.35)' : 'rgba(249, 115, 22, 0.35)'
          ctx.shadowColor = theme === 'cyber' ? '#00f0ff' : theme === 'singularity' ? '#c084fc' : '#f97316'
          ctx.shadowBlur = 18
          ctx.fill()
        }

        // Draw Lightning Arcs
        ctx.strokeStyle = '#fde047'
        ctx.lineWidth = 1.8
        for (let i = arcsRef.current.length - 1; i >= 0; i--) {
          const a = arcsRef.current[i]
          ctx.beginPath()
          ctx.moveTo(a.x1, a.y1)
          ctx.lineTo((a.x1 + a.x2) / 2 + (Math.random() - 0.5) * 16, (a.y1 + a.y2) / 2 + (Math.random() - 0.5) * 16)
          ctx.lineTo(a.x2, a.y2)
          ctx.stroke()
          if (--a.life <= 0) arcsRef.current.splice(i, 1)
        }

        // Phase 2: Particle Ingestion to Target Vault
        let targetX = cx
        let targetY = 90
        if (vaultTargetRef.current && canvasRef.current) {
          const r = vaultTargetRef.current.getBoundingClientRect()
          const cRect = canvasRef.current.getBoundingClientRect()
          targetX = r.left + r.width / 2 - cRect.left
          targetY = r.top + r.height / 2 - cRect.top
        }

        for (let i = particlesRef.current.length - 1; i >= 0; i--) {
          const p = particlesRef.current[i]
          p.age++
          if (p.age < p.magnetWait) {
            p.x += p.vx
            p.y += p.vy
            p.vx *= 0.94
            p.vy *= 0.94
          } else {
            const dx = targetX - p.x
            const dy = targetY - p.y
            const dist = Math.hypot(dx, dy)
            if (dist < 26) {
              if (onAbsorb) onAbsorb(p.secVal)
              chronoAudio.playAbsorb(880 + (p.age % 10) * 75)
              particlesRef.current.splice(i, 1)
              continue
            }
            const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95)
            p.vx = (dx / dist) * pull
            p.vy = (dy / dist) * pull
            p.x += p.vx
            p.y += p.vy
          }

          ctx.beginPath()
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2)
          ctx.fillStyle = p.color
          ctx.shadowColor = p.color
          ctx.shadowBlur = 10
          ctx.fill()
        }

        // Shockwaves
        for (let i = shockwavesRef.current.length - 1; i >= 0; i--) {
          const sw = shockwavesRef.current[i]
          sw.r += 14
          sw.alpha -= 0.035
          if (sw.alpha <= 0) {
            shockwavesRef.current.splice(i, 1)
            continue
          }
          ctx.beginPath()
          ctx.arc(cx, cy, sw.r, 0, Math.PI * 2)
          ctx.strokeStyle = `rgba(254, 240, 138, ${sw.alpha})`
          ctx.lineWidth = 4
          ctx.shadowColor = '#f59e0b'
          ctx.shadowBlur = 18
          ctx.stroke()
        }

        ctx.restore()
        animRef.current = requestAnimationFrame(render)
      }

      animRef.current = requestAnimationFrame(render)

      return () => {
        window.removeEventListener('resize', resize)
        if (animRef.current) cancelAnimationFrame(animRef.current)
      }
    }, [theme, vaultTargetRef, onSpoolProgress, onShatter, onAbsorb])

    return <canvas ref={canvasRef} className="chrono-canvas" />
  }
)

ChronoAccumulatorCanvas.displayName = 'ChronoAccumulatorCanvas'
