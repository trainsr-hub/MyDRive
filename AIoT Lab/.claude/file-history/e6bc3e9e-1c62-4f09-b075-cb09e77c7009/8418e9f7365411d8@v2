// Tier 4 Presentation Component: SQLite Ledger Transaction History (<120 lines)

import React from 'react'
import { Database, RefreshCw } from 'lucide-react'
import type { PoolTransaction } from '../types'

interface TransactionsLedgerProps {
  transactions: PoolTransaction[]
  totalEarnedSeconds: number
  backendOnline: boolean
  onRefresh: () => void
}

export const TransactionsLedger: React.FC<TransactionsLedgerProps> = ({
  transactions,
  totalEarnedSeconds,
  backendOnline,
  onRefresh,
}) => {
  return (
    <div className="p-4 rounded-2xl bg-[#0f0b17]/95 border border-[#2b203a] shadow-xl space-y-3">
      {/* Header */}
      <div className="flex items-center justify-between border-b border-[#241a33] pb-2.5">
        <div className="flex items-center gap-2">
          <Database className="w-4 h-4 text-[#ffd86b]" />
          <h3 className="font-cinzel font-bold text-xs text-white uppercase tracking-wider">
            SQLite Ledger Manifest
          </h3>
          <span className="text-[10px] font-mono text-[#8a7c9d]">
            ({transactions.length} recorded)
          </span>
          <span className={`text-[9px] font-mono px-2 py-0.5 rounded ${backendOnline ? 'bg-emerald-950/40 text-emerald-400 border border-emerald-500/30' : 'bg-amber-950/40 text-amber-400 border border-amber-500/30'}`}>
            {backendOnline ? 'SQLite WAL' : 'Offline'}
          </span>
        </div>

        <div className="flex items-center gap-3">
          <span className="text-[10px] font-mono text-[#cbd5e1] hidden sm:inline">
            All-time: <strong className="text-[#ffd86b]">{(totalEarnedSeconds / 3600).toFixed(2)}h</strong>
          </span>
          <button
            type="button"
            onClick={onRefresh}
            className="p-1.5 rounded-lg bg-[#181124] hover:bg-[#261b38] border border-[#37294d] text-[#8a7c9d] hover:text-[#ffd86b] transition cursor-pointer"
            title="Refresh SQLite ledger"
          >
            <RefreshCw className="w-3.5 h-3.5" />
          </button>
        </div>
      </div>

      {/* Transaction List */}
      {transactions.length === 0 ? (
        <div className="text-center py-6 text-xs font-mono text-[#6c5e7f]">
          No deposits recorded yet in SQLite ledger. Initiate your first session above!
        </div>
      ) : (
        <div className="max-h-[220px] overflow-y-auto space-y-1.5 pr-1 custom-scrollbar">
          {transactions.map((tx) => (
            <div
              key={tx.id}
              className="p-2.5 rounded-xl bg-[#140f1f] hover:bg-[#1b1529] border border-[#281d38] flex items-center justify-between gap-3 text-xs font-mono transition group"
            >
              {/* Left: Source & Timestamp */}
              <div className="flex items-center gap-2.5 min-w-0">
                <div className="w-1.5 h-1.5 rounded-full bg-[#ffd86b] flex-shrink-0" />
                <div className="truncate">
                  <div className="text-white font-medium truncate">{tx.source}</div>
                  <div className="text-[10px] text-[#786b8b]">
                    {new Date(tx.timestamp).toLocaleString(undefined, {
                      month: 'short',
                      day: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit',
                      second: '2-digit',
                    })}
                  </div>
                </div>
              </div>

              {/* Right: Category, Speed, and Formatted Duration */}
              <div className="flex items-center gap-2 flex-shrink-0">
                <span className="px-2 py-0.5 rounded bg-[#201730] border border-[#3c2a54] text-[10px] text-[#c4b5d6] capitalize">
                  {tx.category}
                </span>
                {tx.speed > 1.0 && (
                  <span className="px-1.5 py-0.5 rounded bg-amber-500/10 border border-amber-500/30 text-[10px] text-amber-300">
                    {tx.speed}x
                  </span>
                )}
                <span className="font-bold text-[#ffd86b] text-xs">
                  +{tx.formatted}
                </span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  )
}
