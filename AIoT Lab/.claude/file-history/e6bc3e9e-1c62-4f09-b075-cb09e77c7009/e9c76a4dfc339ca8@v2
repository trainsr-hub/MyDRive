import asyncio
import json
import subprocess
import time
import urllib.request
import websockets

async def test_image3():
    chrome_path = r'C:\Program Files\Google\Chrome\Application\chrome.exe'
    proc = subprocess.Popen([
        chrome_path,
        '--headless=new',
        '--remote-debugging-port=9226',
        '--disable-gpu',
        '--no-first-run',
        '--no-default-browser-check',
        'http://localhost:5173/heraclitus'
    ])
    await asyncio.sleep(2.0)

    console_messages = []
    try:
        tabs = json.loads(urllib.request.urlopen('http://localhost:9226/json').read())
        target_tab = None
        for t in tabs:
            if 'heraclitus' in t.get('url', ''):
                target_tab = t
                break

        if not target_tab:
            print("Heraclitus tab not found!")
            return False

        ws_url = target_tab['webSocketDebuggerUrl']
        print(f"Connected to Heraclitus tab: {ws_url}")

        async with websockets.connect(ws_url) as ws:
            await ws.send(json.dumps({'id': 1, 'method': 'Log.enable'}))
            await ws.send(json.dumps({'id': 2, 'method': 'Runtime.enable'}))

            # Switch to Yellow Pool tab inside Heraclitus
            click_tab_js = """
            const tabs = Array.from(document.querySelectorAll('button'));
            const ypTab = tabs.find(b => b.textContent && b.textContent.includes('Yellow Pool'));
            if (ypTab) ypTab.click();
            """
            await ws.send(json.dumps({
                'id': 3,
                'method': 'Runtime.evaluate',
                'params': {'expression': click_tab_js}
            }))
            await asyncio.sleep(1.0)

            # Verify elements matching Image #3 exist
            check_dom_js = """
            (() => {
                const button = document.querySelector('.chrono-summon-button');
                const wagerBar = document.querySelector('.chrono-wager-bar');
                const iframe = document.querySelector('iframe');
                return {
                    buttonText: button ? button.innerText.trim() : null,
                    wagerBarText: wagerBar ? wagerBar.innerText.trim() : null,
                    iframeSrc: iframe ? iframe.src : null
                };
            })()
            """
            await ws.send(json.dumps({
                'id': 4,
                'method': 'Runtime.evaluate',
                'params': {'expression': check_dom_js, 'returnByValue': True}
            }))

            # Now click the Summon button to roll!
            click_summon_js = """
            const btn = document.querySelector('.chrono-summon-button');
            if (btn) btn.click();
            """
            await ws.send(json.dumps({
                'id': 5,
                'method': 'Runtime.evaluate',
                'params': {'expression': click_summon_js}
            }))

            # Collect events for 3.5 seconds during gacha roll and kinetic explosion
            t_end = time.time() + 3.5
            dom_check_result = None

            while time.time() < t_end:
                try:
                    raw = await asyncio.wait_for(ws.recv(), timeout=0.3)
                    msg = json.loads(raw)
                    if msg.get('id') == 4:
                        dom_check_result = msg.get('result', {}).get('result', {}).get('value')
                    method = msg.get('method', '')
                    if method == 'Log.entryAdded':
                        console_messages.append(msg.get('params', {}).get('entry', {}))
                    elif method == 'Runtime.consoleAPICalled':
                        params = msg.get('params', {})
                        args = [a.get('value', str(a)) for a in params.get('args', [])]
                        console_messages.append({
                            'level': params.get('type'),
                            'text': ' '.join(str(x) for x in args),
                        })
                except asyncio.TimeoutError:
                    pass

            print("\n--- DOM VERIFICATION RESULTS (Matching Image #3) ---")
            print("Detected DOM Elements:", dom_check_result)

            errors_or_warnings = [
                m for m in console_messages
                if m.get('level') in ('error', 'warning')
            ]

            print("\n--- CONSOLE LOGS DURING GACHA ROLL ---")
            if errors_or_warnings:
                print("❌ Errors/Warnings found:", errors_or_warnings)
                return False
            else:
                print("✅ 0 console errors and 0 console warnings during live Gacha roll!")
                return True

    finally:
        proc.terminate()

if __name__ == '__main__':
    asyncio.run(test_image3())
