<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chronos Singularity · Event Horizon Ingestion</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: radial-gradient(circle at 50% 45%, #0a0414 0%, #020104 100%);
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #fff; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }
.hud-layer {
  position: fixed; inset: 0; pointer-events: none; display: flex; flex-direction: column;
  justify-content: space-between; align-items: center; padding: 26px 20px 24px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 10px; letter-spacing: .35em; text-transform: uppercase; color: #c084fc; font-weight: 700; }
.main-title { font-size: 18px; font-weight: 800; letter-spacing: .12em; color: #fff; text-shadow: 0 0 16px rgba(192,132,252,0.4); }
.pool-vault {
  pointer-events: auto; display: flex; align-items: center; gap: 14px;
  background: rgba(12, 6, 24, 0.9); border: 1.5px solid rgba(192,132,252,0.4);
  border-radius: 16px; padding: 12px 24px; margin-top: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.7), 0 0 24px rgba(192,132,252,0.25);
  transition: transform .1s ease, border-color .1s ease;
}
.pool-vault.absorb { transform: scale(1.05); border-color: #f0abfc; box-shadow: 0 0 36px rgba(192,132,252,0.8); }
.vault-icon {
  width: 42px; height: 42px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #e9d5ff, #7e22ce);
  box-shadow: 0 0 16px rgba(192,132,252,0.8); display: flex; align-items: center; justify-content: center;
  font-size: 20px; font-weight: 900; color: #3b0764;
}
.vault-meta { display: flex; flex-direction: column; }
.vault-lbl { font-size: 9px; letter-spacing: .2em; color: #d8b4fe; text-transform: uppercase; }
.vault-val { font-size: 28px; font-weight: 900; font-family: 'Consolas', monospace; color: #f5d0fe; text-shadow: 0 0 14px rgba(216,180,254,0.6); }

/* Downward Smooth Sink Dissolve */
.burst-badge {
  position: absolute; top: calc(50% + 64px); left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 2px; pointer-events: none; opacity: 0;
}
.burst-badge.spooling { opacity: 1; transform: translateX(-50%) scale(1); transition: opacity .12s ease; }
.burst-badge.slow-fade { animation: smoothSinkFade 1.0s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
@keyframes smoothSinkFade {
  0% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1.05); filter: drop-shadow(0 0 20px rgba(232,121,249,0.9)); }
  100% { opacity: 0; transform: translateX(-50%) translateY(24px) scale(0.95); filter: drop-shadow(0 0 2px rgba(232,121,249,0)); }
}
.burst-lbl {
  font-size: 10px; font-family: monospace; letter-spacing: .25em; text-transform: uppercase;
  color: #c084fc; font-weight: 800; text-shadow: 0 0 10px rgba(192,132,252,0.8);
}
.burst-val { font-size: 26px; font-weight: 900; font-family: 'Consolas', monospace; color: #f5d0fe; letter-spacing: .08em; text-shadow: 0 0 18px rgba(216,180,254,0.8); }
.burst-val.lingering { font-size: 30px; color: #fff; text-shadow: 0 0 24px #f0abfc, 0 0 50px rgba(192,132,252,0.8); }

.controls { pointer-events: auto; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; width: 100%; max-width: 860px; }
.btn {
  min-height: 52px; padding: 0 24px; background: rgba(18, 10, 32, 0.9);
  border: 1.5px solid rgba(192,132,252,0.35); border-radius: 12px; color: #f5d0fe;
  font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  cursor: pointer; transition: all .1s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center; gap: 6px;
}
.btn:hover { background: #331558; border-color: #f0abfc; color: #fff; box-shadow: 0 0 24px rgba(192,132,252,0.5); transform: translateY(-2px); }
.btn:active { transform: scale(0.95); background: #7e22ce; color: #fff; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="hud-layer">
  <div class="header">
    <div class="sub-title">Astrophysical Accretion Engine</div>
    <div class="main-title">Chronos Singularity · Gravitational Shatter</div>
    <div class="pool-vault" id="poolVault">
      <div class="vault-icon">⚛</div>
      <div class="vault-meta"><span class="vault-lbl">Accumulated Event Horizon</span><span class="vault-val" id="poolVal">0s</span></div>
    </div>
  </div>

  <div class="burst-badge" id="burstBadge">
    <span class="burst-lbl" id="burstLabel">ACCRETING</span>
    <span class="burst-val" id="burstVal">0s</span>
  </div>

  <div class="controls">
    <button class="btn" onclick="depositSession(1800)">Accrete 30m</button>
    <button class="btn" onclick="depositSession(7200)">Accrete 2h</button>
    <button class="btn" onclick="depositSession(21600)">Accrete 6h</button>
    <button class="btn" onclick="resetAll()">Reset</button>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const poolVaultEl = document.getElementById('poolVault'), poolValEl = document.getElementById('poolVal');
const burstBadgeEl = document.getElementById('burstBadge'), burstLabelEl = document.getElementById('burstLabel');
const burstValEl = document.getElementById('burstVal');

let W, H, cx, cy, targetX = 0, targetY = 0, permanentSec = 0, displayPermanentSec = 0;
let isSpooling = false, spoolSec = 0, targetSpoolSec = 0, spoolProgress = 0;
let screenShake = 0, particles = [], shockwaves = [], accretionStream = [], audioCtx = null, lingerTimeout = null;

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; cx = W / 2; cy = H / 2 - 20;
  const r = poolVaultEl.getBoundingClientRect(); targetX = r.left + r.width / 2; targetY = r.top + r.height / 2;
}
window.addEventListener('resize', resize);
resize();

function formatDuration(sec) {
  if (!sec || isNaN(sec) || sec < 0) return '0s';
  let s = Math.floor(sec);
  const Y = Math.floor(s / 31536000); s %= 31536000;
  const M = Math.floor(s / 2592000); s %= 2592000;
  const D = Math.floor(s / 86400); s %= 86400;
  const h = Math.floor(s / 3600); s %= 3600;
  const m = Math.floor(s / 60); const rem = s % 60;
  const p = [];
  if (Y > 0) p.push(`${Y}Y`); if (M > 0) p.push(`${M}M`); if (D > 0) p.push(`${D}D`);
  if (h > 0) p.push(`${h}h`); if (m > 0) p.push(`${m}m`); if (rem > 0 || p.length === 0) p.push(`${rem}s`);
  return p.join('');
}

function playSound(type, freq) {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    if (type === 'tick') {
      osc.type = 'sine'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.04, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.04); osc.start(t); osc.stop(t + 0.04);
    } else if (type === 'shatter') {
      osc.type = 'sawtooth'; osc.frequency.setValueAtTime(140, t); osc.frequency.exponentialRampToValueAtTime(26, t + 0.55);
      gain.gain.setValueAtTime(0.5, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.55); osc.start(t); osc.stop(t + 0.55);
    } else {
      osc.type = 'sine'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.04, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.07); osc.start(t); osc.stop(t + 0.07);
    }
    osc.connect(gain); gain.connect(audioCtx.destination);
  } catch(e) {}
}

function depositSession(seconds) {
  isSpooling = true; targetSpoolSec = seconds; spoolSec = 0; spoolProgress = 0;
  clearTimeout(lingerTimeout);
  burstBadgeEl.className = 'burst-badge spooling'; burstValEl.className = 'burst-val';
  burstLabelEl.textContent = 'ACCRETING'; burstValEl.textContent = '0s';
}

function triggerShatter() {
  isSpooling = false; playSound('shatter', 0);
  screenShake = Math.min(32, 10 + (targetSpoolSec / 3600) * 3);
  shockwaves.push({ r: 25, maxR: Math.min(W, H) * 0.65, alpha: 1.0 });

  burstLabelEl.textContent = 'GRAVITATIONAL YIELD';
  burstValEl.textContent = formatDuration(targetSpoolSec);
  burstValEl.className = 'burst-val lingering';
  burstBadgeEl.className = 'burst-badge slow-fade';

  const pCount = Math.min(220, Math.max(45, Math.floor(targetSpoolSec / 80)));
  const secPerP = targetSpoolSec / pCount;
  for (let i = 0; i < pCount; i++) {
    const a = Math.random() * Math.PI * 2, sp = 5 + Math.random() * 16;
    particles.push({
      x: cx, y: cy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 2,
      secVal: secPerP, age: 0, magnetWait: 14 + Math.random() * 16,
      size: 3 + Math.random() * 3.5, color: Math.random() > 0.4 ? '#e879f9' : '#38bdf8'
    });
  }

  clearTimeout(lingerTimeout);
  lingerTimeout = setTimeout(() => { burstBadgeEl.className = 'burst-badge'; }, 1000);
}

function resetAll() {
  clearTimeout(lingerTimeout); isSpooling = false; permanentSec = 0; displayPermanentSec = 0;
  particles = []; shockwaves = []; screenShake = 0; poolValEl.textContent = '0s';
  burstBadgeEl.className = 'burst-badge'; burstValEl.className = 'burst-val';
}

function draw() {
  ctx.save();
  if (screenShake > 0) {
    ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
    screenShake *= 0.88; if (screenShake < 0.2) screenShake = 0;
  }
  ctx.fillStyle = 'rgba(2, 1, 4, 0.28)'; ctx.fillRect(-20, -20, W + 40, H + 40);
  const t = Date.now() * 0.002;

  // Accretion disk & Singularity
  if (isSpooling) {
    spoolProgress += 0.045;
    spoolSec = Math.round(targetSpoolSec * Math.min(1.0, Math.pow(spoolProgress, 1.3)));
    burstValEl.textContent = formatDuration(spoolSec);
    screenShake = 1.0 + spoolProgress * 8;
    playSound('tick', 350 + spoolProgress * 650);

    // Infalling accretion particles
    if (Math.random() < 0.6) {
      const a = Math.random() * Math.PI * 2, r = 90 + Math.random() * 80;
      accretionStream.push({ a, r, speed: 6 + spoolProgress * 8 });
    }
    for (let i = accretionStream.length - 1; i >= 0; i--) {
      const s = accretionStream[i]; s.r -= s.speed; s.a += 0.08;
      if (s.r <= 14) { accretionStream.splice(i, 1); continue; }
      ctx.beginPath(); ctx.arc(cx + Math.cos(s.a) * s.r, cy + Math.sin(s.a) * s.r, 2, 0, Math.PI * 2);
      ctx.fillStyle = '#f0abfc'; ctx.fill();
    }

    // Shrinking Hyper-Dense Event Horizon
    const holeR = Math.max(14, (38 - spoolProgress * 22));
    ctx.beginPath(); ctx.arc(cx, cy, holeR, 0, Math.PI * 2);
    ctx.fillStyle = '#000'; ctx.strokeStyle = '#e879f9'; ctx.lineWidth = 2.5;
    ctx.shadowColor = '#c084fc'; ctx.shadowBlur = 24; ctx.fill(); ctx.stroke();

    if (spoolProgress >= 1.0) triggerShatter();
  } else {
    // Resting Singularity
    ctx.beginPath(); ctx.arc(cx, cy, 28, 0, Math.PI * 2);
    ctx.fillStyle = '#000'; ctx.strokeStyle = 'rgba(192, 132, 252, 0.4)'; ctx.lineWidth = 2;
    ctx.shadowColor = '#c084fc'; ctx.shadowBlur = 16; ctx.fill(); ctx.stroke();
  }

  // Shockwaves
  for (let i = shockwaves.length - 1; i >= 0; i--) {
    const sw = shockwaves[i]; sw.r += 14; sw.alpha -= 0.035;
    if (sw.alpha <= 0) { shockwaves.splice(i, 1); continue; }
    ctx.beginPath(); ctx.arc(cx, cy, sw.r, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(240, 171, 252, ${sw.alpha})`; ctx.lineWidth = 4;
    ctx.shadowColor = '#c084fc'; ctx.shadowBlur = 18; ctx.stroke();
  }

  // Particle Swarm Ingestion
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i]; p.age++;
    if (p.age < p.magnetWait) {
      p.x += p.vx; p.y += p.vy; p.vx *= 0.94; p.vy *= 0.94;
    } else {
      const dx = targetX - p.x, dy = targetY - p.y, dist = Math.hypot(dx, dy);
      if (dist < 26) {
        permanentSec += p.secVal; poolVaultEl.classList.add('absorb');
        setTimeout(() => poolVaultEl.classList.remove('absorb'), 70);
        playSound('absorb', 880 + (p.age % 10) * 75);
        particles.splice(i, 1); continue;
      }
      const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95);
      p.vx = (dx / dist) * pull; p.vy = (dy / dist) * pull; p.x += p.vx; p.y += p.vy;
    }
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10; ctx.fill();
  }

  if (displayPermanentSec < permanentSec) {
    displayPermanentSec += Math.ceil((permanentSec - displayPermanentSec) * 0.2);
    poolValEl.textContent = formatDuration(displayPermanentSec);
  }
  ctx.restore();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);

// ── Universe 25 Parent PostMessage Bridge ──
(function initBridge() {
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.has('balance')) {
    permanentSec = parseFloat(urlParams.get('balance')) || 0;
    displayPermanentSec = permanentSec;
    if (poolValEl) poolValEl.textContent = formatDuration(permanentSec);
  }

  window.addEventListener('message', (event) => {
    if (!event.data) return;
    if (event.data.type === 'SET_BALANCE') {
      permanentSec = parseFloat(event.data.seconds) || 0;
      displayPermanentSec = permanentSec;
      if (poolValEl) poolValEl.textContent = formatDuration(permanentSec);
    } else if (event.data.type === 'TRIGGER_DEPOSIT') {
      depositSession(parseFloat(event.data.seconds) || 1800);
    } else if (event.data.type === 'RESET') {
      resetAll();
    }
  });

  const origDepositSession = depositSession;
  window.depositSession = function(seconds) {
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({ type: 'DEPOSIT_STARTED', seconds: seconds }, '*');
    }
    origDepositSession(seconds);
  };

  const origTriggerShatter = triggerShatter;
  window.triggerShatter = function() {
    origTriggerShatter();
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({ type: 'DEPOSIT_COMMITTED', seconds: targetSpoolSec }, '*');
    }
  };
})();
</script>
</body>
</html>