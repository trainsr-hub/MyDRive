  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const poolVaultEl = document.getElementById('poolVault'), poolValEl = document.getElementById('poolVal');
const burstBadgeEl = document.getElementById('burstBadge'), burstLabelEl = document.getElementById('burstLabel');
const burstValEl = document.getElementById('burstVal');

let W, H, cx, cy, targetX = 0, targetY = 0, permanentSec = 0, displayPermanentSec = 0;
let isSpooling = false, spoolSec = 0, targetSpoolSec = 0, spoolProgress = 0;
let screenShake = 0, particles = [], shockwaves = [], stellarArcs = [], audioCtx = null, lingerTimeout = null;

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; cx = W / 2; cy = H / 2 - 20;
  const r = poolVaultEl.getBoundingClientRect(); targetX = r.left + r.width / 2; targetY = r.top + r.height / 2;
}
window.addEventListener('resize', resize);
resize();

function formatDuration(sec) {
  if (!sec || isNaN(sec) || sec < 0) return '0s';
  let s = Math.floor(sec);
  const Y = Math.floor(s / 31536000); s %= 31536000;
  const M = Math.floor(s / 2592000); s %= 2592000;
  const D = Math.floor(s / 86400); s %= 86400;
  const h = Math.floor(s / 3600); s %= 3600;
  const m = Math.floor(s / 60); const rem = s % 60;
  const p = [];
  if (Y > 0) p.push(`${Y}Y`); if (M > 0) p.push(`${M}M`); if (D > 0) p.push(`${D}D`);
  if (h > 0) p.push(`${h}h`); if (m > 0) p.push(`${m}m`); if (rem > 0 || p.length === 0) p.push(`${rem}s`);
  return p.join('');
}

let userInteracted = false;
window.addEventListener('pointerdown', () => {
  userInteracted = true;
  try {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (AudioContextClass) audioCtx = new AudioContextClass();
    } else if (audioCtx.state === 'suspended') {
      audioCtx.resume().catch(() => {});
    }
  } catch(e) {}
}, { passive: true });

function getAudioCtx() {
  if (!userInteracted) return null;
  try {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (AudioContextClass) audioCtx = new AudioContextClass();
    }
    return (audioCtx && audioCtx.state === 'running') ? audioCtx : null;
  } catch(e) {
    return null;
  }
}

function playSound(type, freq) {
  try {
    const actx = getAudioCtx();
    if (!actx) return;
    const t = actx.currentTime, osc = actx.createOscillator(), gain = actx.createGain();
    if (type === 'tick') {
      osc.type = 'sawtooth'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.04, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.04); osc.start(t); osc.stop(t + 0.04);
    } else if (type === 'shatter') {
      osc.type = 'triangle'; osc.frequency.setValueAtTime(140, t); osc.frequency.exponentialRampToValueAtTime(24, t + 0.6);
      gain.gain.setValueAtTime(0.5, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.6); osc.start(t); osc.stop(t + 0.6);
    } else {
      osc.type = 'sine'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.04, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.06); osc.start(t); osc.stop(t + 0.06);
    }
    osc.connect(gain); gain.connect(actx.destination);
  } catch(e) {}
}

function depositSession(seconds) {
  isSpooling = true; targetSpoolSec = seconds; spoolSec = 0; spoolProgress = 0;
  clearTimeout(lingerTimeout);
  burstBadgeEl.className = 'burst-badge spooling'; burstValEl.className = 'burst-val';
  burstLabelEl.textContent = 'ACCRETING MASS'; burstValEl.textContent = '0s';
}

function triggerShatter() {
  isSpooling = false; playSound('shatter', 0);
  screenShake = Math.min(32, 10 + (targetSpoolSec / 3600) * 3);
  shockwaves.push({ r: 25, maxR: Math.min(W, H) * 0.7, alpha: 1.0 });

  burstLabelEl.textContent = 'STELLAR YIELD';
  burstValEl.textContent = formatDuration(targetSpoolSec);
  burstValEl.className = 'burst-val lingering';
  burstBadgeEl.className = 'burst-badge slow-fade';

  const btn = document.getElementById('summonBtn');
  const btnTxt = document.getElementById('btnText');
  if (btn) btn.classList.remove('is-spooling');
  if (btnTxt) {
    btnTxt.textContent = wager > 1
      ? 'Summon ' + wager + 'x Chrono Duration (Gacha)'
      : 'Summon Chrono Duration (Gacha)';
  }

  const pCount = Math.min(220, Math.max(45, Math.floor(targetSpoolSec / 80)));
  const secPerP = targetSpoolSec / pCount;
  for (let i = 0; i < pCount; i++) {
    const a = Math.random() * Math.PI * 2, sp = 5 + Math.random() * 18;
    particles.push({
      x: cx, y: cy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 2,
      secVal: secPerP, age: 0, magnetWait: 14 + Math.random() * 16,
      size: 3 + Math.random() * 3.5, color: Math.random() > 0.4 ? '#f59e0b' : '#ef4444'
    });
  }

  clearTimeout(lingerTimeout);
  lingerTimeout = setTimeout(() => { burstBadgeEl.className = 'burst-badge'; }, 1000);
}

function resetAll() {
  clearTimeout(lingerTimeout); isSpooling = false; permanentSec = 0; displayPermanentSec = 0;
  particles = []; shockwaves = []; screenShake = 0; poolValEl.textContent = '0s';
  burstBadgeEl.className = 'burst-badge'; burstValEl.className = 'burst-val';
}

function draw() {
  ctx.save();
  if (screenShake > 0) {
    ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
    screenShake *= 0.88; if (screenShake < 0.2) screenShake = 0;
  }
  ctx.fillStyle = 'rgba(12, 9, 20, 0.28)'; ctx.fillRect(-20, -20, W + 40, H + 40);
  const t = Date.now() * 0.002;

  if (isSpooling) {
    spoolProgress += 0.045;
    spoolSec = Math.round(targetSpoolSec * Math.min(1.0, Math.pow(spoolProgress, 1.3)));
    burstValEl.textContent = formatDuration(spoolSec);
    screenShake = 1.0 + spoolProgress * 8;
    playSound('tick', 300 + spoolProgress * 700);

    // Infalling accretion particles
    if (Math.random() < 0.6) {
      const a = Math.random() * Math.PI * 2, r = 140 + Math.random() * 50;
      stellarArcs.push({ a, r, speed: 6 + spoolProgress * 7 });
    }
    for (let i = stellarArcs.length - 1; i >= 0; i--) {
      const s = stellarArcs[i]; s.r -= s.speed;
      if (s.r <= 18) { stellarArcs.splice(i, 1); continue; }
      ctx.beginPath(); ctx.arc(cx + Math.cos(s.a) * s.r, cy + Math.sin(s.a) * s.r, 2, 0, Math.PI * 2);
      ctx.fillStyle = '#fde047'; ctx.fill();
    }

    // Shrinking Hyper-Dense Core (Thermal Collapse)
    const coreR = Math.max(16, (44 - spoolProgress * 26)) + Math.sin(t * 18) * 3;
    ctx.beginPath(); ctx.arc(cx, cy, coreR, 0, Math.PI * 2);
    ctx.fillStyle = spoolProgress > 0.6 ? '#ffffff' : '#f97316';
    ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 30 + spoolProgress * 30; ctx.fill();

    if (spoolProgress >= 1.0) triggerShatter();
  } else {
    // Resting Protostar
    ctx.beginPath(); ctx.arc(cx, cy, 34 + Math.sin(t * 3) * 2, 0, Math.PI * 2);
    ctx.fillStyle = '#f97316'; ctx.shadowColor = '#ea580c'; ctx.shadowBlur = 18; ctx.fill();
  }

  // Shockwaves
  for (let i = shockwaves.length - 1; i >= 0; i--) {
    const sw = shockwaves[i]; sw.r += 14; sw.alpha -= 0.035;
    if (sw.alpha <= 0) { shockwaves.splice(i, 1); continue; }
    ctx.beginPath(); ctx.arc(cx, cy, sw.r, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(254, 240, 138, ${sw.alpha})`; ctx.lineWidth = 4;
    ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 20; ctx.stroke();
  }

  // Particle Swarm to Vault
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i]; p.age++;
    if (p.age < p.magnetWait) {
      p.x += p.vx; p.y += p.vy; p.vx *= 0.94; p.vy *= 0.94;
    } else {
      const dx = targetX - p.x, dy = targetY - p.y, dist = Math.hypot(dx, dy);
      if (dist < 26) {
        permanentSec += p.secVal; poolVaultEl.classList.add('absorb');
        setTimeout(() => poolVaultEl.classList.remove('absorb'), 70);
        playSound('absorb', 880 + (p.age % 10) * 80);
        particles.splice(i, 1); continue;
      }
      const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95);
      p.vx = (dx / dist) * pull; p.vy = (dy / dist) * pull; p.x += p.vx; p.y += p.vy;
    }
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10; ctx.fill();
  }

  if (displayPermanentSec < permanentSec) {
    displayPermanentSec += Math.ceil((permanentSec - displayPermanentSec) * 0.2);
    poolValEl.textContent = formatDuration(displayPermanentSec);
  }
  ctx.restore();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);

// ── Gacha Mechanics & Image #3 Controller ──
const GACHA_WEIGHTS = [
  { tier: 'COMMON', weight: 60, min: 900, max: 2700, step: 300 },
  { tier: 'RARE', weight: 25, min: 3600, max: 10800, step: 900 },
  { tier: 'EPIC', weight: 10, min: 14400, max: 28800, step: 1800 },
  { tier: 'LEGENDARY', weight: 4, min: 43200, max: 86400, step: 3600 },
  { tier: 'MYTHIC', weight: 1, min: 172800, max: 432000, step: 14400 }
];

let tickets = parseInt(localStorage.getItem('chrono_tickets_v1') || '15');
let wager = 1;

function updateTicketDisplay() {
  const el = document.getElementById('ticketCount');
  if (el) el.textContent = tickets + ' Left';
  try { localStorage.setItem('chrono_tickets_v1', String(tickets)); } catch(e) {}
}

function handleClaimTickets() {
  tickets += 10;
  updateTicketDisplay();
}

function handleWagerChange(val) {
  wager = parseInt(val) || 1;
  const btnTxt = document.getElementById('btnText');
  if (btnTxt && !isSpooling) {
    btnTxt.textContent = wager > 1
      ? 'Summon ' + wager + 'x Chrono Duration (Gacha)'
      : 'Summon Chrono Duration (Gacha)';
  }
}

function switchVariant(targetHtml) {
  const currentBal = Math.max(permanentSec, displayPermanentSec);
  window.location.href = targetHtml + '?balance=' + currentBal;
}

function rollDuration() {
  let rand = Math.random() * 100;
  let chosen = GACHA_WEIGHTS[0];
  for (const t of GACHA_WEIGHTS) {
    if (rand < t.weight) { chosen = t; break; }
    rand -= t.weight;
  }
  const raw = chosen.min + Math.random() * (chosen.max - chosen.min);
  const stepped = Math.round(raw / chosen.step) * chosen.step;
  return Math.max(chosen.min, Math.min(chosen.max, stepped));
}

function handleSummonClick() {
  if (isSpooling) return;
  if (tickets < wager) {
    tickets += 10;
  }
  tickets = Math.max(0, tickets - wager);
  updateTicketDisplay();

  const baseSec = rollDuration();
  const totalSec = baseSec * wager;

  const btn = document.getElementById('summonBtn');
  const btnTxt = document.getElementById('btnText');
  if (btn) btn.classList.add('is-spooling');
  if (btnTxt) btnTxt.textContent = 'Spooling Chrono Kinetic Stream...';

  depositSession(totalSec);
}

// ── Universe 25 Parent PostMessage Bridge ──
(function initBridge() {
  updateTicketDisplay();
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.has('balance')) {
    permanentSec = parseFloat(urlParams.get('balance')) || 0;
    displayPermanentSec = permanentSec;
    if (poolValEl) poolValEl.textContent = formatDuration(permanentSec);
  }

  window.addEventListener('message', (event) => {
    if (!event.data) return;
    if (event.data.type === 'SET_BALANCE') {
      permanentSec = parseFloat(event.data.seconds) || 0;
      displayPermanentSec = permanentSec;
      if (poolValEl) poolValEl.textContent = formatDuration(permanentSec);
    } else if (event.data.type === 'TRIGGER_DEPOSIT') {
      depositSession(parseFloat(event.data.seconds) || 1800);
    } else if (event.data.type === 'RESET') {
      resetAll();
    }
  });

  const origDepositSession = depositSession;
  window.depositSession = function(seconds) {
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({ type: 'DEPOSIT_STARTED', seconds: seconds }, '*');
    }
    origDepositSession(seconds);
  };

  const origTriggerShatter = triggerShatter;
  window.triggerShatter = function() {
    origTriggerShatter();
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({ type: 'DEPOSIT_COMMITTED', seconds: targetSpoolSec }, '*');
    }
  };

  if (window.parent && window.parent !== window) {
    window.parent.postMessage({ type: 'IFRAME_READY' }, '*');
  }
})();
</script>
