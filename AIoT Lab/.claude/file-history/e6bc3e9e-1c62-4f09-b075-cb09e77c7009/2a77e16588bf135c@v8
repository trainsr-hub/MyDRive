}

.chrono-summon-button.is-spooling {
  background: linear-gradient(180deg, #2e1045 0%, #501777 50%, #7c2299 100%);
  border-color: #f0abfc;
  box-shadow: 0 8px 28px rgba(217, 70, 239, 0.45), 0 0 20px rgba(240, 171, 252, 0.5);
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.star-icon {
  font-size: 16px;
  filter: drop-shadow(0 0 6px #ffd86b);
}

/* WAGER BAR (Image #3) */
.chrono-wager-bar {
  width: 100%;
  padding: 8px 14px;
  border-radius: 12px;
  background: rgba(14, 10, 24, 0.95);
  border: 1px solid rgba(251, 191, 36, 0.35);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  user-select: none;
}

.chrono-wager-label {
  font-size: 11.5px;
  font-weight: 800;
  color: #ffd86b;
  font-family: monospace;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  white-space: nowrap;
}

.chrono-wager-select-wrapper {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
}

.chrono-wager-select {
  width: 100%;
  appearance: none;
  -webkit-appearance: none;
  padding: 6px 28px 6px 12px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 800;
  font-family: monospace;
  border: 1px solid rgba(251, 191, 36, 0.35);
  background: rgba(18, 12, 30, 0.95);
  color: #f5f0e8;
  cursor: pointer;
  outline: none;
  transition: all 0.12s ease-out;
}

.chrono-wager-select:hover {
  border-color: #ffd700;
  box-shadow: 0 0 10px rgba(255, 215, 0, 0.25);
}

.select-arrow {
  position: absolute;
  right: 10px;
  font-size: 9px;
  color: #ffd86b;
  pointer-events: none;
}

.ticket-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 8px;
  background: #120a1f;
  border: 1px solid rgba(212, 175, 55, 0.4);
  color: #ffd86b;
  font-family: monospace;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.12s ease;
  white-space: nowrap;
}

.ticket-pill:hover {
  border-color: #ffd700;
  box-shadow: 0 0 10px rgba(255, 215, 0, 0.25);
}
</style>
