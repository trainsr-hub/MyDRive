<body>
<canvas id="c"></canvas>
<div class="hud-layer">
  <div class="header">
    <div class="variant-pill-row">
      <a href="javascript:void(0)" onclick="switchVariant('phase_005_spool_and_shatter.html')" class="variant-pill">⏳ Thermal</a>
      <a href="javascript:void(0)" onclick="switchVariant('phase_009_chronos_singularity.html')" class="variant-pill">⚛ Singularity</a>
