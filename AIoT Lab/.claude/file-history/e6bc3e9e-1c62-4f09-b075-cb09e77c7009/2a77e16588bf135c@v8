<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: transparent; font-family: 'Segoe UI', system-ui, sans-serif;
  color: #fff; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }
.hud-layer {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  align-items: center; padding: 24px 20px 22px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 10px; letter-spacing: .35em; text-transform: uppercase; color: #f59e0b; font-weight: 700; margin-bottom: 2px; }
.main-title { font-size: 18px; font-weight: 800; letter-spacing: .12em; color: #fff; text-shadow: 0 0 16px rgba(245,158,11,0.4); }

.pool-vault {
  pointer-events: auto; display: flex; align-items: center; gap: 14px;
  background: rgba(14, 8, 22, 0.9); border: 1.5px solid rgba(251,191,36,0.4);
  border-radius: 16px; padding: 12px 24px; margin-top: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.7), 0 0 24px rgba(251,191,36,0.2);
  transition: transform .1s ease, border-color .1s ease;
}
.pool-vault.absorb { transform: scale(1.05); border-color: #fde047; box-shadow: 0 0 36px rgba(251,191,36,0.7); }
.vault-icon {
  width: 42px; height: 42px; border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #fef08a, #ca8a04);
  box-shadow: 0 0 16px rgba(250,204,21,0.8);
  display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; color: #78350f;
}
.vault-meta { display: flex; flex-direction: column; }
.vault-lbl { font-size: 9px; letter-spacing: .2em; color: #a1a1aa; text-transform: uppercase; }
.vault-val { font-size: 28px; font-weight: 900; font-family: 'Consolas', monospace; color: #fef08a; text-shadow: 0 0 14px rgba(254,240,138,0.5); }

/* Downward Smooth Sink Dissolve */
.burst-badge {
  position: absolute; top: calc(50% + 64px); left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 2px; pointer-events: none; opacity: 0;
}
.burst-badge.spooling { opacity: 1; transform: translateX(-50%) scale(1); transition: opacity .12s ease; }
.burst-badge.slow-fade { animation: smoothSinkFade 1.0s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
@keyframes smoothSinkFade {
  0% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1.05); filter: drop-shadow(0 0 20px rgba(254,240,138,0.9)); }
  100% { opacity: 0; transform: translateX(-50%) translateY(24px) scale(0.95); filter: drop-shadow(0 0 2px rgba(254,240,138,0)); }
}
.burst-lbl {
  font-size: 10px; font-family: monospace; letter-spacing: .25em; text-transform: uppercase;
  color: #f59e0b; font-weight: 800; text-shadow: 0 0 10px rgba(245,158,11,0.8);
}
.burst-val { font-size: 26px; font-weight: 900; font-family: 'Consolas', monospace; color: #fef08a; letter-spacing: .08em; text-shadow: 0 0 18px rgba(254,240,138,0.8); }
.burst-val.lingering { font-size: 30px; color: #fff; text-shadow: 0 0 24px #fde047, 0 0 50px rgba(234,179,8,0.8); }

/* ── Integrated Controls (Golden Standard matching Image #3) ── */
.controls {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  width: 100%;
  max-width: 460px;
  margin-bottom: 8px;
}

.variant-pill-row {
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 999px;
  background: rgba(14, 10, 24, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  margin-bottom: 8px;
}

.variant-pill {
  text-decoration: none;
  font-size: 11.5px;
  font-weight: 700;
  font-family: monospace;
  color: #8a7c9d;
  padding: 4px 10px;
  border-radius: 999px;
  transition: all 0.12s ease;
  display: flex;
  align-items: center;
  gap: 4px;
}

.variant-pill:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.08);
}

.variant-pill.active {
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
