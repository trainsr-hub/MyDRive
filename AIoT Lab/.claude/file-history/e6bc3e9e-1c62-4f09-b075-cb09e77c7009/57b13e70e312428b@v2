import asyncio
import json
import subprocess
import time
import urllib.request
import websockets

PHASE_FILES = [
    'phase_005_spool_and_shatter.html',
    'phase_006_prismatic_crystal.html',
    'phase_007_cyber_matrix.html',
    'phase_009_chronos_singularity.html',
    'phase_010_supernova_spool.html'
]

async def test_file(file_name, port):
    chrome_path = r'C:\Program Files\Google\Chrome\Application\chrome.exe'
    proc = subprocess.Popen([
        chrome_path,
        '--headless=new',
        f'--remote-debugging-port={port}',
        '--disable-gpu',
        '--no-first-run',
        '--no-default-browser-check',
        f'http://localhost:5173/animations/2-phases/{file_name}'
    ])
    await asyncio.sleep(1.8)

    console_messages = []
    try:
        tabs = json.loads(urllib.request.urlopen(f'http://localhost:{port}/json').read())
        target_tab = None
        for t in tabs:
            if file_name in t.get('url', ''):
                target_tab = t
                break

        if not target_tab:
            print(f"❌ {file_name}: Tab not found!")
            return False

        ws_url = target_tab['webSocketDebuggerUrl']
        async with websockets.connect(ws_url) as ws:
            await ws.send(json.dumps({'id': 1, 'method': 'Log.enable'}))
            await ws.send(json.dumps({'id': 2, 'method': 'Runtime.enable'}))

            # Trigger deposit
            await ws.send(json.dumps({
                'id': 3,
                'method': 'Runtime.evaluate',
                'params': {'expression': 'depositSession(1800)'}
            }))

            # Collect for 2.5 seconds
            t_end = time.time() + 2.5
            while time.time() < t_end:
                try:
                    raw = await asyncio.wait_for(ws.recv(), timeout=0.3)
                    msg = json.loads(raw)
                    method = msg.get('method', '')
                    if method == 'Log.entryAdded':
                        entry = msg.get('params', {}).get('entry', {})
                        console_messages.append(entry)
                    elif method == 'Runtime.consoleAPICalled':
                        params = msg.get('params', {})
                        args = [a.get('value', str(a)) for a in params.get('args', [])]
                        console_messages.append({
                            'level': params.get('type'),
                            'text': ' '.join(str(x) for x in args),
                        })
                except asyncio.TimeoutError:
                    pass

        errors_or_warnings = [m for m in console_messages if m.get('level') in ('error', 'warning')]
        if errors_or_warnings:
            print(f"❌ {file_name}: Errors/Warnings found: {len(errors_or_warnings)}")
            for ew in errors_or_warnings[:5]:
                print(f"   [{ew.get('level')}] {ew.get('text')}")
            return False
        else:
            print(f"✅ {file_name}: 0 errors, 0 warnings (Deposit & Explosion clean!)")
            return True

    finally:
        proc.terminate()
        await asyncio.sleep(0.5)

async def main():
    print("Testing all 5 original animation engines in headless Chrome...")
    results = []
    port = 9300
    for f in PHASE_FILES:
        res = await test_file(f, port)
        results.append(res)
        port += 1

    if all(results):
        print("\n🎉 ALL 5 ENGINES PASSED ZERO-ERROR & ZERO-WARNING VERIFICATION!")
    else:
        print("\n❌ SOME ENGINES FAILED!")

if __name__ == '__main__':
    asyncio.run(main())
