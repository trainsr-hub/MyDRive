// path: src/apps/heraclitus/components/YellowPoolTab.tsx
// Tier 4 Transport/UI: Yellow Pool Tab with direct Two-Phase Kinetic Accumulator Engine

import React, { useState, useEffect, useRef, useTransition } from 'react'
import { fetchPoolState, depositToPool } from '../services/heraclitusApi'
import { ChronoAccumulatorCanvas } from './ChronoAccumulatorCanvas'
import type { ChronoAccumulatorRef, ChronoEngineTheme } from './ChronoAccumulatorCanvas'
import { formatDuration } from '../animations/twoPhaseEngine'
import type { YellowTimePoolState } from '../types'
import { Sparkles, RotateCcw, Clock, Zap } from 'lucide-react'

export const YellowPoolTab: React.FC = () => {
  const [poolState, setPoolState] = useState<YellowTimePoolState | null>(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [hours, setHours] = useState('')
  const [depositing, setDepositing] = useState(false)

  // Two-Phase engine controls
  const [activeTheme, setActiveTheme] = useState<ChronoEngineTheme>('spool_shatter')
  const [spoolSec, setSpoolSec] = useState<number>(0)
  const [isSpooling, setIsSpooling] = useState<boolean>(false)
  const [isLingering, setIsLingering] = useState<boolean>(false)
  const [displayPoolSec, setDisplayPoolSec] = useState<number>(0)

  // Vault and canvas refs
  const canvasRef = useRef<ChronoAccumulatorRef | null>(null)
  const vaultTargetRef = useRef<HTMLDivElement | null>(null)
  const lingerTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null)
  const [, startTransition] = useTransition()

  const balanceSec = poolState?.balance_seconds ?? 0

  useEffect(() => {
    load()
  }, [])

  useEffect(() => {
    setDisplayPoolSec(balanceSec)
  }, [balanceSec])

  async function load() {
    setLoading(true)
    setError(null)
    try {
      const state = await fetchPoolState()
      setPoolState(state)
      setDisplayPoolSec(state.balance_seconds)
    } catch (e: any) {
      setError(e.message)
    } finally {
      setLoading(false)
    }
  }

  // Trigger deposit through the Two-Phase Kinetic Accumulator Canvas
  const triggerDepositSequence = (depositSec: number) => {
    if (depositing || depositSec <= 0) return

    if (lingerTimeoutRef.current) {
      clearTimeout(lingerTimeoutRef.current)
    }

    setIsSpooling(true)
    setIsLingering(false)
    setSpoolSec(0)
    setDepositing(true)

    if (canvasRef.current) {
      canvasRef.current.deposit(depositSec)
    }
  }

  const handleManualDeposit = (e: React.FormEvent) => {
    e.preventDefault()
    const h = parseFloat(hours)
    if (!h || h <= 0) {
      setError('Enter a valid number of hours')
      return
    }
    setError(null)
    triggerDepositSequence(h * 3600)
    setHours('')
  }

  const handleShatter = async (targetSec: number) => {
    setIsSpooling(false)
    setIsLingering(true)
    setSpoolSec(targetSec)

    if (lingerTimeoutRef.current) clearTimeout(lingerTimeoutRef.current)
    lingerTimeoutRef.current = setTimeout(() => {
      setIsLingering(false)
    }, 1000)

    try {
      const state = await depositToPool({
        seconds: targetSec,
        source: 'Chrono Two-Phase Deposit',
        category: 'grind',
        speed: 1.0,
      })
      setPoolState(state)
    } catch (err: any) {
      setError(err?.message || 'Failed to sync deposit with backend ledger')
    } finally {
      setDepositing(false)
    }
  }

  const handleAbsorb = (secVal: number) => {
    if (vaultTargetRef.current) {
      vaultTargetRef.current.classList.add('absorb')
      setTimeout(() => {
        vaultTargetRef.current?.classList.remove('absorb')
      }, 70)
    }

    startTransition(() => {
      setDisplayPoolSec((prev) => prev + secVal)
    })
  }

  const handleReset = () => {
    if (canvasRef.current) {
      canvasRef.current.reset()
    }
    setIsSpooling(false)
    setIsLingering(false)
    setSpoolSec(0)
    setDepositing(false)
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[500px]">
        <div className="text-center space-y-3">
          <div className="w-14 h-14 rounded-full border-2 border-[#ffd86b]/20 border-t-[#ffd86b] animate-spin mx-auto" />
          <p className="text-[#6b5a7f] font-mono text-[10px] tracking-widest uppercase">
            Initializing Chrono Accumulator Engine
          </p>
        </div>
      </div>
    )
  }

  return (
    <div className={`chrono-scene theme-${activeTheme === 'spool_shatter' ? 'spool' : activeTheme}`}>
      {/* ── 1. The Two-Phase Canvas Engine ───────────────────────────────── */}
      <ChronoAccumulatorCanvas
        ref={canvasRef}
        theme={activeTheme}
        vaultTargetRef={vaultTargetRef}
        onSpoolProgress={(sec) => setSpoolSec(sec)}
        onShatter={handleShatter}
        onAbsorb={handleAbsorb}
      />

      {/* ── 2. The Interactive HUD Layer ─────────────────────────────────── */}
      <div className="chrono-hud">
        {/* Header and Permanent Pool Vault */}
        <div className="chrono-header">
          <div className="chrono-sub-title">Two-Phase Kinetic Spool & Instant Shatter</div>
          <div className="chrono-main-title font-cinzel">Chrono Accumulator Engine</div>

          <div className="chrono-pool-vault" ref={vaultTargetRef} id="poolVault">
            <div className="chrono-vault-icon">
              {activeTheme === 'singularity' ? '⚛' : activeTheme === 'cyber' ? '💾' : activeTheme === 'prismatic' ? '💎' : '⏳'}
            </div>
            <div className="chrono-vault-meta">
              <span className="chrono-vault-lbl">Accumulated Permanent Pool</span>
              <span className="chrono-vault-val">{formatDuration(displayPoolSec)}</span>
            </div>
          </div>
        </div>

        {/* Dynamic Burst Badge: Hidden in idle; pops during Spooling & Lingers upon Detonation */}
        <div
          className={`chrono-burst-badge ${isSpooling ? 'spooling' : ''} ${
            isLingering ? 'slow-fade' : ''
          }`}
        >
          <span className="chrono-burst-lbl">
            {isSpooling ? 'ACCUMULATING VELOCITY' : 'DETONATION YIELD'}
          </span>
          <span className={`chrono-burst-val ${isLingering ? 'lingering' : ''}`}>
            {formatDuration(spoolSec)}
          </span>
        </div>

        {/* Bottom Interactive Controls */}
        <div className="chrono-controls">
          {/* Quick Preset Deposit Buttons */}
          <div className="chrono-btn-row">
            <button
              type="button"
              disabled={depositing}
              onClick={() => triggerDepositSequence(1800)}
              className="chrono-btn"
            >
              <Clock className="w-3.5 h-3.5 text-[#ffd86b]" />
              <span>Deposit 30m</span>
            </button>
            <button
              type="button"
              disabled={depositing}
              onClick={() => triggerDepositSequence(7200)}
              className="chrono-btn"
            >
              <Zap className="w-3.5 h-3.5 text-amber-400" />
              <span>Deposit 2h</span>
            </button>
            <button
              type="button"
              disabled={depositing}
              onClick={() => triggerDepositSequence(21600)}
              className="chrono-btn"
            >
              <Sparkles className="w-3.5 h-3.5 text-orange-400" />
              <span>Deposit 6h</span>
            </button>
            <button
              type="button"
              onClick={handleReset}
              className="chrono-btn hover:text-rose-400"
              title="Reset state"
            >
              <RotateCcw className="w-3.5 h-3.5" />
              <span>Reset</span>
            </button>
          </div>

          {/* Manual Numeric Input */}
          <form
            onSubmit={handleManualDeposit}
            className="flex items-center gap-2 w-full max-w-sm mt-1"
          >
            <div className="relative flex-1">
              <input
                type="number"
                min="0.1"
                step="0.25"
                value={hours}
                onChange={(e) => setHours(e.target.value)}
                placeholder="Hours (e.g. 1.5)"
                disabled={depositing}
                className="w-full min-h-[44px] px-3.5 rounded-xl bg-[#140b20]/90 border border-[#3e2e54] text-xs font-mono text-white placeholder-[#786b8b] outline-none focus:border-[#ffd86b] transition"
              />
            </div>
            <button
              type="submit"
              disabled={depositing || !hours || parseFloat(hours) <= 0}
              className="min-h-[44px] px-4 rounded-xl bg-gradient-to-r from-[#d4af37] via-[#ffd86b] to-[#b38f22] text-black font-cinzel font-bold text-xs tracking-wider transition hover:brightness-110 active:scale-95 disabled:opacity-50 cursor-pointer"
            >
              {depositing ? 'SPOOLING...' : '+ DEPOSIT'}
            </button>
          </form>

          {/* Theme Selector Matrix */}
          <div className="flex items-center gap-1.5 pt-1">
            <span className="text-[10px] font-mono text-[#8a7a9e] uppercase tracking-wider mr-1">
              Engine:
            </span>
            {[
              { id: 'spool_shatter', label: 'Thermal' },
              { id: 'singularity', label: 'Singularity' },
              { id: 'prismatic', label: 'Prism' },
              { id: 'cyber', label: 'Cyber' },
              { id: 'supernova', label: 'Supernova' },
            ].map((t) => (
              <button
                key={t.id}
                type="button"
                onClick={() => setActiveTheme(t.id as ChronoEngineTheme)}
                className={`px-2.5 py-1 rounded-lg text-[10px] font-mono transition border ${
                  activeTheme === t.id
                    ? 'bg-[#ffd86b]/20 border-[#ffd86b] text-[#ffd86b] font-bold shadow-[0_0_10px_rgba(255,216,107,0.3)]'
                    : 'bg-[#150e22] border-[#312543] text-[#8c7a9e] hover:text-white'
                }`}
              >
                {t.label}
              </button>
            ))}
          </div>

          {/* Error Message */}
          {error && (
            <div className="text-rose-400 text-xs font-mono text-center max-w-sm mt-1">
              {error}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
