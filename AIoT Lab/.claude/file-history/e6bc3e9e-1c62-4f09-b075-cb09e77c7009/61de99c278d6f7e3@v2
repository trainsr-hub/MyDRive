/* Arc Jurassic Golden Standard Gacha Button Styles */

.chrono-gacha-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin-top: 4px;
  user-select: none;
}

/* PRIMARY SUMMON BUTTON (Golden Standard from Arc Jurassic) */
.chrono-summon-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: min(440px, 92%);
  min-height: 58px;
  border: 1px solid rgba(212, 175, 55, 0.5);
  border-radius: 14px;
  padding: 12px 32px;
  font-size: 17px;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #1f1430 0%, #3b1d6e 50%, #7c4dff 100%);
  box-shadow: 0 8px 24px rgba(81, 45, 168, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  transition: transform 0.08s ease-out, box-shadow 0.08s ease-out, border-color 0.08s ease-out;
  white-space: nowrap;
  cursor: pointer;
  user-select: none;
}

.chrono-summon-button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(124, 77, 255, 0.5), 0 0 16px rgba(255, 215, 0, 0.3);
  border-color: #ffd700;
}

.chrono-summon-button:active:not(:disabled) {
  transform: translateY(0) scale(0.98);
}

.chrono-summon-button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

/* HIGH WAGER MODE (Arc Jurassic is-target-evo-mode) */
.chrono-summon-button.is-high-wager {
  background: linear-gradient(135deg, #1a0f2e 0%, #4a2174 40%, #c28800 100%);
  border-color: #ffd700;
  box-shadow: 0 8px 26px rgba(255, 215, 0, 0.28), 0 0 16px rgba(194, 136, 0, 0.4);
}

.chrono-summon-button.is-high-wager:hover:not(:disabled) {
  box-shadow: 0 12px 32px rgba(255, 215, 0, 0.45), 0 0 24px rgba(255, 215, 0, 0.5);
  border-color: #fff275;
}

/* SPOOLING ACTIVE MODE (Arc Jurassic is-max-evo-mode) */
.chrono-summon-button.is-spooling {
  background: linear-gradient(135deg, #2b0f0a 0%, #68260b 45%, #d97706 80%, #fbbf24 100%);
  border-color: #fde047;
  box-shadow: 0 8px 28px rgba(217, 119, 6, 0.45), 0 0 20px rgba(251, 191, 36, 0.5);
}

/* WAGER BAR (Golden Standard from Arc Jurassic gacha-multiplier-bar) */
.chrono-wager-bar {
  width: min(440px, 92%);
  padding: 8px 14px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(22, 17, 30, 0.95), rgba(10, 8, 14, 0.98));
  border: 1px solid rgba(255, 215, 0, 0.3);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  user-select: none;
}

.chrono-wager-label {
  font-size: 11.5px;
  font-weight: 700;
  color: #ffd86b;
  font-family: monospace;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  white-space: nowrap;
}

.chrono-wager-select-wrapper {
  position: relative;
  flex: 1;
  max-width: 240px;
  display: flex;
  align-items: center;
}

.chrono-wager-select {
  width: 100%;
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  padding: 6px 30px 6px 12px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 800;
  font-family: monospace;
  border: 1px solid rgba(255, 215, 0, 0.35);
  background: rgba(14, 10, 22, 0.95);
  color: #ffd86b;
  cursor: pointer;
  outline: none;
  transition: all 0.12s ease-out;
}

.chrono-wager-select:hover {
  border-color: #ffd700;
  box-shadow: 0 0 10px rgba(255, 215, 0, 0.25);
  color: #ffffff;
}

.chrono-wager-select:focus {
  border-color: #ffd700;
  box-shadow: 0 0 12px rgba(255, 215, 0, 0.4);
}

.chrono-select-chevron {
  position: absolute;
  right: 8px;
  width: 14px;
  height: 14px;
  color: #ffd86b;
  pointer-events: none;
}
