// ── Animation helpers ─────────────────────────────────────────────────────────

function restart(el: HTMLElement | null, cls: string) {
  if (!el) return
  el.classList.remove(cls)
  void el.offsetWidth
  el.classList.add(cls)
}

function spawnParticles(field: HTMLElement, count = 160) {
  field.innerHTML = ''
  for (let i = 0; i < count; i++) {
    const p = document.createElement('div')
    const radius = 140 + Math.random() * 360
    const angle  = Math.random() * 360
    const size   = 1.5 + Math.random() * 5
    const op     = .35 + Math.random() * .65
    const ot     = 900 + Math.random() * 1400
    const ct     = 700 + Math.random() * 600
    p.className = 'yp-particle'
    p.style.setProperty('--rad', `${radius}px`)
    p.style.setProperty('--ang', `${angle}deg`)
    p.style.setProperty('--sz',  `${size}px`)
    p.style.setProperty('--op',  String(op))
    p.style.setProperty('--ot',  `${ot}ms`)
    p.style.setProperty('--ct',  `${ct}ms`)
    field.appendChild(p)
  }
  requestAnimationFrame(() => {
    Array.from(field.children).forEach((child, i) => {
      setTimeout(() => child.classList.add('orbit'), Math.random() * 600 + i * 2)
    })
  })
}

function compressParticles(field: HTMLElement) {
  Array.from(field.children).forEach((child, i) => {
    const el = child as HTMLElement
    const rad = el.style.getPropertyValue('--rad')
    const ang = parseFloat(el.style.getPropertyValue('--ang'))
    el.style.setProperty('--rad2', rad)
    el.style.setProperty('--ang2', `${ang + Math.random() * 90}deg`)
    setTimeout(() => {
      el.classList.remove('orbit')
      el.classList.add('compress')
    }, Math.random() * 400 + i * .7)
  })
}

function spawnMatter(field: HTMLElement, count = 130) {
  field.innerHTML = ''
  for (let i = 0; i < count; i++) {
    const p = document.createElement('div')
    const angle    = Math.random() * 360
    const distance = 200 + Math.random() * 440
    const dur      = 800 + Math.random() * 900
    const size     = 1.5 + Math.random() * 5.5
    p.className = 'yp-matter'
    p.style.setProperty('--ang',  `${angle}deg`)
    p.style.setProperty('--dist', `${distance}px`)
    p.style.setProperty('--dur',  `${dur}ms`)
    p.style.setProperty('--sz',   `${size}px`)
    field.appendChild(p)
    setTimeout(() => p.classList.add('active'), 400 + Math.random() * 500)
  }
}

// ── Main Component ────────────────────────────────────────────────────────────

export const YellowPoolTab: React.FC = () => {
  const [poolState, setPoolState] = useState<YellowTimePoolState | null>(null)
  const [loading, setLoading]     = useState(true)
  const [error, setError]         = useState<string | null>(null)
  const [hours, setHours]         = useState('')
  const [depositing, setDepositing] = useState(false)

  // DOM refs for animation targets
  const particleRef  = useRef<HTMLDivElement>(null)
  const matterRef    = useRef<HTMLDivElement>(null)
  const shockRef     = useRef<HTMLDivElement>(null)
  const novaRef      = useRef<HTMLDivElement>(null)
  const rebirthRef   = useRef<HTMLDivElement>(null)
  const distortRef   = useRef<HTMLDivElement>(null)
  const orbRef       = useRef<HTMLDivElement>(null)

  const balanceSec = poolState?.balance_seconds ?? 0
  const animated   = useAnimatedValue(balanceSec)

  // Orb ambient glow: 0h = dead, 100h = fully lit
  const MAX_H   = 100 * 3600
  const fillPct = Math.min(balanceSec / MAX_H, 1)

  useEffect(() => { load() }, [])

  // Inject CSS once
  useEffect(() => {
    const id = 'yp-styles'
    if (!document.getElementById(id)) {
      const s = document.createElement('style')
      s.id = id
      s.textContent = POOL_CSS
      document.head.appendChild(s)
    }
    return () => { /* leave styles — no other users */ }
  }, [])

  // Idle ambient particle loop
  useEffect(() => {
    let alive = true
    async function idleLoop() {
      while (alive) {
        if (particleRef.current) {
          spawnParticles(particleRef.current, 120)
          await delay(1200)
          if (!alive) break
          compressParticles(particleRef.current)
          await delay(3000)
        } else {
          await delay(1000)
        }
      }
    }
    idleLoop()
    return () => { alive = false }
  }, [])

  async function load() {
    setLoading(true); setError(null)
    try { setPoolState(await fetchPoolState()) }
    catch (e: any) { setError(e.message) }
    finally { setLoading(false) }
  }

  async function handleDeposit(e: React.FormEvent) {
    e.preventDefault()
    const h = parseFloat(hours)
    if (!h || h <= 0) { setError('Enter a valid number of hours'); return }

    setDepositing(true); setError(null)
    try {
      // Trigger full black-hole-style burst sequence
      if (distortRef.current) restart(distortRef.current, 'active')
      await delay(90)

      if (particleRef.current) spawnParticles(particleRef.current, 180)
      await delay(1050)
      if (particleRef.current) compressParticles(particleRef.current)
      await delay(280)

      // Shockwave + supernova
      if (shockRef.current)  restart(shockRef.current, 'active')
      if (novaRef.current)   restart(novaRef.current, 'active')
      await delay(480)

      // Gold matter ejection + rebirth ring
      if (matterRef.current)  spawnMatter(matterRef.current, 140)
      if (rebirthRef.current) restart(rebirthRef.current, 'active')

      // Persist to backend
      const state = await depositToPool({
        seconds: h * 3600,
        source: 'Manual Deposit',
        category: 'grind',
        speed: 1.0,
      })
      setPoolState(state)
      setHours('')
    } catch (e: any) {
      setError(e.message)
    } finally {
      setDepositing(false)
    }
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[500px]">
        <div className="text-center space-y-3">
          <div className="w-14 h-14 rounded-full border-2 border-[#ffd86b]/20 border-t-[#ffd86b] animate-spin mx-auto" />
          <p className="text-[#6b5a7f] font-mono text-[10px] tracking-widest uppercase">Initializing Pool</p>
        </div>
      </div>
    )
  }

  return (
    <div className="yp-scene py-8 px-4" style={{ minHeight: 600 }}>
      <div className="yp-stars" />

      {/* ── ORB ARENA ─────────────────────────────────────────────────── */}
      <div className="yp-orb-wrap" ref={orbRef} style={{ transformStyle: 'preserve-3d', perspective: '1000px' }}>

        {/* Ambient glow rings that swell with fill */}
        <div className="yp-glow-ring" style={{
          width:  `${380 + fillPct * 80}px`,
          height: `${380 + fillPct * 80}px`,
          '--gop': String(0.05 + fillPct * 0.2),
          transition: 'width 1.4s ease, height 1.4s ease, opacity 1.4s ease',
        } as React.CSSProperties} />
        <div className="yp-glow-ring" style={{
          width:  `${360 + fillPct * 50}px`,
          height: `${360 + fillPct * 50}px`,
          '--gop': String(0.08 + fillPct * 0.28),
        } as React.CSSProperties} />

        {/* Distortion */}
        <div className="yp-distortion" ref={distortRef} />

        {/* Orbiting rings */}
        <div className="yp-ring yp-ring-1" />
        <div className="yp-ring yp-ring-2" />
        <div className="yp-ring yp-ring-3" />
        <div className="yp-ring yp-ring-4" />

        {/* Event horizon core */}
        <div className="yp-core" />

        {/* Particle field */}
        <div className="yp-particle-field" ref={particleRef} />

        {/* Deposit burst effects */}
        <div className="yp-shockwave" ref={shockRef} />
        <div className="yp-supernova"  ref={novaRef} />
        <div className="yp-rebirth"    ref={rebirthRef} />
        <div className="yp-matter-field" ref={matterRef} />

        {/* Balance readout */}
        <div className="yp-readout">
          <p style={{ fontSize: 10, fontFamily: 'monospace', color: 'rgba(255,216,107,.45)', letterSpacing: '0.25em', textTransform: 'uppercase', marginBottom: 4 }}>
            Balance
          </p>
          <p style={{
            fontFamily: 'monospace',
            fontWeight: 900,
            fontSize: 'clamp(1.3rem,5vw,1.9rem)',
            color: '#ffd86b',
            lineHeight: 1,
            textShadow: `0 0 ${16 + fillPct * 24}px rgba(255,216,107,${0.35 + fillPct * 0.55})`,
            transition: 'text-shadow 1.4s ease',
          }}>
            {formatBalance(animated)}
          </p>
          <p style={{ fontSize: 10, fontFamily: 'monospace', color: 'rgba(255,216,107,.3)', marginTop: 6 }}>
            {(animated / 3600).toFixed(2)}h total
          </p>
        </div>
      </div>

      {/* ── INPUT + BUTTON ────────────────────────────────────────────── */}
      <form onSubmit={handleDeposit} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 16, width: '100%', marginTop: 8 }}>
        <div className="yp-input-wrap">
          <input
            type="number"
            min="0"
            step="0.25"
            value={hours}
            onChange={e => { setHours(e.target.value); setError(null) }}
            placeholder="0"
            disabled={depositing}
            className="yp-input"
          />
          <span className="yp-input-unit">h</span>
        </div>

        <button
          type="submit"
          disabled={depositing || !hours || parseFloat(hours) <= 0}
          className="yp-btn"
        >
          {depositing
            ? <span style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8 }}>
                <span style={{ width: 14, height: 14, borderRadius: '50%', border: '2px solid rgba(12,9,20,.3)', borderTopColor: '#0c0914', display: 'inline-block', animation: 'spin 0.7s linear infinite' }} />
                Depositing
              </span>
            : '+ Deposit Hours'
          }
        </button>
      </form>

      {/* Error */}
      {error && (
        <p style={{ color: '#f87171', fontFamily: 'monospace', fontSize: 12, marginTop: 8, textAlign: 'center', maxWidth: 300 }}>{error}</p>
      )}

      {/* All-time total */}
      {poolState && poolState.total_earned_seconds > 0 && (
        <p style={{ color: 'rgba(255,216,107,.18)', fontFamily: 'monospace', fontSize: 10, letterSpacing: '0.2em', textTransform: 'uppercase', marginTop: 12, textAlign: 'center' }}>
          All-time — {formatBalance(poolState.total_earned_seconds)}
        </p>
      )}

      {/* Spin keyframe for deposit spinner */}
      <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
    </div>
  )
}

function delay(ms: number) {
  return new Promise<void>(r => setTimeout(r, ms))
}
