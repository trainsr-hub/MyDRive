import React, { useState, useEffect, useRef, useCallback } from 'react'
import { fetchPoolState, depositToPool } from '../services/heraclitusApi'
import type { YellowTimePoolState } from '../types'

// ── Helpers ──────────────────────────────────────────────────────────────────

function formatBalance(seconds: number): string {
  const total = Math.floor(seconds)
  const d = Math.floor(total / 86400)
  const h = Math.floor((total % 86400) / 3600)
  const m = Math.floor((total % 3600) / 60)
  const s = total % 60
  if (d > 0) return `${d}d ${h}h ${m}m`
  if (h > 0) return `${h}h ${m}m ${s}s`
  if (m > 0) return `${m}m ${s}s`
  return `${s}s`
}

// Rolling animated number hook
function useAnimatedValue(target: number, duration = 900): number {
  const [display, setDisplay] = useState(target)
  const rafRef = useRef<number | null>(null)
  const startRef = useRef<{ from: number; to: number; t0: number } | null>(null)

  useEffect(() => {
    const from = display
    if (from === target) return
    const t0 = performance.now()
    startRef.current = { from, to: target, t0 }

    function tick(now: number) {
      const { from, to, t0 } = startRef.current!
      const p = Math.min((now - t0) / duration, 1)
      // Ease out expo
      const ease = p === 1 ? 1 : 1 - Math.pow(2, -10 * p)
      setDisplay(from + (to - from) * ease)
      if (p < 1) rafRef.current = requestAnimationFrame(tick)
    }

    rafRef.current = requestAnimationFrame(tick)
    return () => { if (rafRef.current) cancelAnimationFrame(rafRef.current) }
  }, [target]) // eslint-disable-line react-hooks/exhaustive-deps

  return display
}

// ── Ripple Canvas ─────────────────────────────────────────────────────────────

interface RippleCanvasProps { trigger: number }

const RippleCanvas: React.FC<RippleCanvasProps> = ({ trigger }) => {
  const canvasRef = useRef<HTMLCanvasElement>(null)
  const ripplesRef = useRef<{ r: number; alpha: number; max: number }[]>([])
  const rafRef = useRef<number | null>(null)

  const draw = useCallback(() => {
    const canvas = canvasRef.current
    if (!canvas) return
    const ctx = canvas.getContext('2d')!
    const { width: W, height: H } = canvas
    ctx.clearRect(0, 0, W, H)
    const cx = W / 2, cy = H / 2

    ripplesRef.current = ripplesRef.current.filter(r => r.alpha > 0.005)
    ripplesRef.current.forEach(r => {
      ctx.beginPath()
      ctx.arc(cx, cy, r.r, 0, Math.PI * 2)
      ctx.strokeStyle = `rgba(255, 216, 107, ${r.alpha})`
      ctx.lineWidth = 2
      ctx.stroke()
      r.r += 3.5
      r.alpha *= 0.92
    })

    if (ripplesRef.current.length > 0) {
      rafRef.current = requestAnimationFrame(draw)
    } else {
      rafRef.current = null
    }
  }, [])

  // Spawn ripples on deposit trigger
  useEffect(() => {
    if (trigger === 0) return
    for (let i = 0; i < 5; i++) {
      setTimeout(() => {
        ripplesRef.current.push({ r: 10 + i * 18, alpha: 0.9 - i * 0.12, max: 200 })
        if (!rafRef.current) rafRef.current = requestAnimationFrame(draw)
      }, i * 60)
    }
  }, [trigger, draw])

  return (
    <canvas
      ref={canvasRef}
      width={400}
      height={400}
      className="absolute inset-0 w-full h-full pointer-events-none"
      style={{ mixBlendMode: 'screen' }}
    />
  )
}

// ── Orb Fill SVG ──────────────────────────────────────────────────────────────

const OrbFill: React.FC<{ fillFraction: number }> = ({ fillFraction }) => {
  // fillFraction: 0..1, clamped
  const f = Math.max(0, Math.min(1, fillFraction))
  // Liquid wave path inside a circle (r=120, cx=150, cy=150)
  const R = 120, CX = 150, CY = 150
  const waterY = CY + R - f * 2 * R
  // SVG clip: rectangle from waterY down
  const clipY = waterY

  return (
    <svg viewBox="0 0 300 300" className="w-full h-full" style={{ overflow: 'visible' }}>
      <defs>
        <clipPath id="orb-clip">
          <circle cx={CX} cy={CY} r={R} />
        </clipPath>
        <radialGradient id="orb-bg" cx="50%" cy="35%" r="60%">
          <stop offset="0%" stopColor="#2a1f3d" />
          <stop offset="100%" stopColor="#0c0914" />
        </radialGradient>
        <linearGradient id="water-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stopColor="#ffd86b" stopOpacity="0.85" />
          <stop offset="100%" stopColor="#b38f00" stopOpacity="0.95" />
        </linearGradient>
        {/* Glow filter */}
        <filter id="orb-glow">
          <feGaussianBlur stdDeviation="8" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
        <filter id="liquid-glow">
          <feGaussianBlur stdDeviation="4" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      {/* Outer ambient glow ring */}
      <circle cx={CX} cy={CY} r={R + 18}
        fill="none" stroke="#ffd86b" strokeWidth="1"
        opacity={0.08 + f * 0.25}
        style={{ transition: 'opacity 1.2s ease' }}
      />
      <circle cx={CX} cy={CY} r={R + 8}
        fill="none" stroke="#ffd86b" strokeWidth="1.5"
        opacity={0.12 + f * 0.35}
        style={{ transition: 'opacity 1.2s ease' }}
      />

      {/* Orb base */}
      <circle cx={CX} cy={CY} r={R} fill="url(#orb-bg)" />

      {/* Liquid fill */}
      {f > 0 && (
        <g clipPath="url(#orb-clip)" filter="url(#liquid-glow)">
          {/* Animated wave */}
          <WavePath cx={CX} cy={CY} r={R} waterY={clipY} fraction={f} />
        </g>
      )}

      {/* Orb rim */}
      <circle cx={CX} cy={CY} r={R}
        fill="none"
        stroke="#ffd86b"
        strokeWidth={1.5 + f * 1.5}
        opacity={0.35 + f * 0.5}
        style={{ transition: 'stroke-width 1.2s ease, opacity 1.2s ease' }}
      />

      {/* Inner highlight */}
      <ellipse cx={CX - 32} cy={CY - 42} rx={22} ry={14}
        fill="white" opacity={0.07 + f * 0.04}
        transform="rotate(-20, 120, 105)"
      />
    </svg>
  )
}

// Animated wave path component
const WavePath: React.FC<{ cx: number; cy: number; r: number; waterY: number; fraction: number }> = ({ cx, cy, r, waterY, fraction }) => {
  const phaseRef = useRef(0)
  const pathRef = useRef<SVGPathElement>(null)
  const rafRef = useRef<number | null>(null)

  useEffect(() => {
    const amp = 6 * (1 - Math.abs(fraction - 0.5) * 1.5)
    function tick() {
      phaseRef.current += 0.04
      if (!pathRef.current) return
      const steps = 32
      const left = cx - r, right = cx + r
      const bottom = cy + r + 4
      let d = `M ${left} ${bottom} L ${left} ${waterY} `
      for (let i = 0; i <= steps; i++) {
        const x = left + (right - left) * (i / steps)
        const y = waterY + Math.sin(phaseRef.current + i * 0.45) * amp
        d += `L ${x} ${y} `
      }
      d += `L ${right} ${bottom} Z`
      pathRef.current.setAttribute('d', d)
      rafRef.current = requestAnimationFrame(tick)
    }
    rafRef.current = requestAnimationFrame(tick)
    return () => { if (rafRef.current) cancelAnimationFrame(rafRef.current) }
  }, [waterY, fraction, cx, cy, r])

  return <path ref={pathRef} fill="url(#water-grad)" />
}

// ── Main Component ────────────────────────────────────────────────────────────

export const YellowPoolTab: React.FC = () => {
  const [poolState, setPoolState] = useState<YellowTimePoolState | null>(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [hours, setHours] = useState('')
  const [depositing, setDepositing] = useState(false)
  const [rippleTrigger, setRippleTrigger] = useState(0)

  // For animated balance display
  const balanceSec = poolState?.balance_seconds ?? 0
  const animatedSec = useAnimatedValue(balanceSec)

  // Orb fill: treat 100h = full orb
  const MAX_HOURS_FULL = 100 * 3600
  const animFraction = Math.min(animatedSec / MAX_HOURS_FULL, 1)

  useEffect(() => { load() }, [])

  async function load() {
    setLoading(true); setError(null)
    try { setPoolState(await fetchPoolState()) }
    catch (e: any) { setError(e.message) }
    finally { setLoading(false) }
  }

  async function handleDeposit(e: React.FormEvent) {
    e.preventDefault()
    const h = parseFloat(hours)
    if (!h || h <= 0) { setError('Enter a valid number of hours'); return }

    setDepositing(true); setError(null)
    try {
      const state = await depositToPool({
        seconds: h * 3600,
        source: 'Manual Deposit',
        category: 'grind',
        speed: 1.0,
      })
      setPoolState(state)
      setHours('')
      setRippleTrigger(t => t + 1)
    } catch (e: any) {
      setError(e.message)
    } finally {
      setDepositing(false)
    }
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[500px]">
        <div className="text-center space-y-3">
          <div className="w-16 h-16 rounded-full border-2 border-[#ffd86b]/30 border-t-[#ffd86b] animate-spin mx-auto" />
          <p className="text-[#9e8fb3] font-mono text-xs tracking-widest uppercase">Initializing Pool</p>
        </div>
      </div>
    )
  }

  return (
    <div className="flex flex-col items-center gap-10 py-8 px-4">

      {/* ── ORB ───────────────────────────────────────────────────────────── */}
      <div className="relative w-72 h-72 flex-shrink-0 select-none">
        {/* Ripple canvas sits behind */}
        <RippleCanvas trigger={rippleTrigger} />

        {/* Orb graphic */}
        <div className="absolute inset-0">
          <OrbFill fillFraction={animFraction} />
        </div>

        {/* Balance readout centered in orb */}
        <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
          <p className="text-[10px] font-mono tracking-[0.25em] text-[#ffd86b]/60 uppercase mb-1">Balance</p>
          <p
            className="font-mono font-black text-[#ffd86b] leading-none"
            style={{ fontSize: 'clamp(1.4rem, 5vw, 2rem)', textShadow: '0 0 24px rgba(255,216,107,0.6)' }}
          >
            {formatBalance(animatedSec)}
          </p>
          <p className="text-[10px] font-mono text-[#ffd86b]/40 mt-1">
            {(animatedSec / 3600).toFixed(2)}h
          </p>
        </div>
      </div>

      {/* ── INPUT + BUTTON ────────────────────────────────────────────────── */}
      <form onSubmit={handleDeposit} className="w-full max-w-xs space-y-4">
        <div className="relative">
          <input
            type="number"
            min="0"
            step="0.25"
            value={hours}
            onChange={e => { setHours(e.target.value); setError(null) }}
            onKeyDown={e => e.key === 'Enter' && handleDeposit(e as any)}
            placeholder="0"
            disabled={depositing}
            className="
              w-full text-center text-4xl font-mono font-black
              bg-transparent border-0 border-b-2 border-[#ffd86b]/30
              focus:border-[#ffd86b] focus:outline-none
              text-[#f5f0e8] placeholder-[#ffd86b]/15
              pb-2 pt-1
              transition-colors duration-200
              disabled:opacity-40
            "
            style={{ caretColor: '#ffd86b' }}
          />
          <span className="absolute right-0 bottom-3 text-[#ffd86b]/40 font-mono text-sm pointer-events-none">h</span>
        </div>

        <button
          type="submit"
          disabled={depositing || !hours || parseFloat(hours) <= 0}
          className="
            w-full py-4 rounded-2xl font-mono font-black text-sm tracking-widest uppercase
            bg-[#ffd86b] text-[#0c0914]
            hover:bg-[#ffe485] active:scale-[0.97]
            disabled:bg-[#ffd86b]/15 disabled:text-[#ffd86b]/30 disabled:cursor-not-allowed
            transition-all duration-150
            relative overflow-hidden
          "
          style={{ boxShadow: depositing ? 'none' : '0 0 32px rgba(255,216,107,0.25)' }}
        >
          {depositing ? (
            <span className="flex items-center justify-center gap-2">
              <span className="w-4 h-4 rounded-full border-2 border-[#0c0914]/40 border-t-[#0c0914] animate-spin inline-block" />
              Depositing
            </span>
          ) : (
            '+ Deposit'
          )}
        </button>
      </form>

      {/* ── ERROR ─────────────────────────────────────────────────────────── */}
      {error && (
        <p className="text-red-400 font-mono text-xs text-center max-w-xs">{error}</p>
      )}

      {/* ── TOTAL EARNED ──────────────────────────────────────────────────── */}
      {poolState && poolState.total_earned_seconds > 0 && (
        <p className="text-[#ffd86b]/25 font-mono text-[10px] tracking-widest uppercase text-center">
          All-time — {formatBalance(poolState.total_earned_seconds)}
        </p>
      )}
    </div>
  )
}
