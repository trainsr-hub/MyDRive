// path: src/apps/heraclitus/components/YellowPoolTab.tsx

import React, { useState, useEffect } from 'react'
import { Droplet, Plus, TrendingUp, Clock, Calendar } from 'lucide-react'
import { fetchPoolState, depositToPool } from '../services/heraclitusApi'
import type { YellowTimePoolState, PoolTransaction } from '../types'

export const YellowPoolTab: React.FC = () => {
  const [poolState, setPoolState] = useState<YellowTimePoolState | null>(null)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)

  // Deposit form state
  const [depositSeconds, setDepositSeconds] = useState('')
  const [depositSource, setDepositSource] = useState('')
  const [depositCategory, setDepositCategory] = useState('grind')
  const [depositSpeed, setDepositSpeed] = useState('1.0')
  const [depositNotes, setDepositNotes] = useState('')
  const [depositing, setDepositing] = useState(false)

  useEffect(() => {
    loadPoolState()
  }, [])

  async function loadPoolState() {
    setLoading(true)
    setError(null)
    try {
      const state = await fetchPoolState()
      setPoolState(state)
    } catch (err: any) {
      setError(err.message)
    } finally {
      setLoading(false)
    }
  }

  async function handleDeposit(e: React.FormEvent) {
    e.preventDefault()
    if (!depositSeconds || !depositSource.trim()) {
      setError('Seconds and source are required')
      return
    }

    setDepositing(true)
    setError(null)
    try {
      const state = await depositToPool({
        seconds: parseFloat(depositSeconds),
        source: depositSource.trim(),
        category: depositCategory,
        speed: parseFloat(depositSpeed),
        notes: depositNotes.trim() || undefined,
      })
      setPoolState(state)
      // Reset form
      setDepositSeconds('')
      setDepositSource('')
      setDepositCategory('grind')
      setDepositSpeed('1.0')
      setDepositNotes('')
    } catch (err: any) {
      setError(err.message)
    } finally {
      setDepositing(false)
    }
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[400px]">
        <div className="text-center">
          <Droplet className="w-12 h-12 text-[#ffd86b] animate-pulse mx-auto mb-3" />
          <p className="text-[#9e8fb3] font-mono text-sm">Loading Yellow Time Pool...</p>
        </div>
      </div>
    )
  }

  return (
    <div className="space-y-6">
      {/* Pool Balance Banner */}
      <div className="bg-gradient-to-br from-[#2a1f3d] to-[#1a1428] border-2 border-[#ffd86b] rounded-2xl p-6">
        <div className="flex items-center gap-3 mb-4">
          <Droplet className="w-6 h-6 text-[#ffd86b]" />
          <h2 className="text-xl font-bold text-[#ffd86b]">Yellow Time Pool</h2>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div className="bg-[#0c0914]/50 rounded-xl p-4 border border-[#372a4d]">
            <div className="flex items-center gap-2 mb-2">
              <Clock className="w-4 h-4 text-[#9e8fb3]" />
              <span className="text-xs text-[#9e8fb3] font-mono uppercase">Current Balance</span>
            </div>
            <p className="text-2xl font-bold text-[#ffd86b] font-mono">
              {poolState?.formatted_balance || '0s'}
            </p>
            <p className="text-xs text-[#6b5a7f] mt-1">
              {poolState?.balance_seconds.toFixed(0) || 0} seconds
            </p>
          </div>
          <div className="bg-[#0c0914]/50 rounded-xl p-4 border border-[#372a4d]">
            <div className="flex items-center gap-2 mb-2">
              <TrendingUp className="w-4 h-4 text-[#9e8fb3]" />
              <span className="text-xs text-[#9e8fb3] font-mono uppercase">Total Earned</span>
            </div>
            <p className="text-2xl font-bold text-[#f5f0e8] font-mono">
              {poolState?.formatted_total_earned || '0s'}
            </p>
            <p className="text-xs text-[#6b5a7f] mt-1">
              {poolState?.total_earned_seconds.toFixed(0) || 0} seconds
            </p>
          </div>
        </div>
      </div>

      {/* Deposit Form */}
      <div className="bg-[#171124] border border-[#372a4d] rounded-xl p-6">
        <div className="flex items-center gap-3 mb-4">
          <Plus className="w-5 h-5 text-[#ffd86b]" />
          <h3 className="text-lg font-bold text-[#f5f0e8]">Manual Deposit</h3>
        </div>
        <form onSubmit={handleDeposit} className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label className="block text-xs text-[#9e8fb3] font-mono mb-2 uppercase">
                Seconds Earned
              </label>
              <input
                type="number"
                min="0"
                step="0.01"
                value={depositSeconds}
                onChange={(e) => setDepositSeconds(e.target.value)}
                className="w-full bg-[#0c0914] border border-[#372a4d] rounded-lg px-4 py-3 text-[#f5f0e8] font-mono focus:outline-none focus:border-[#ffd86b] transition-colors"
                placeholder="3600"
                disabled={depositing}
              />
            </div>
            <div>
              <label className="block text-xs text-[#9e8fb3] font-mono mb-2 uppercase">
                Source / Activity
              </label>
              <input
                type="text"
                value={depositSource}
                onChange={(e) => setDepositSource(e.target.value)}
                className="w-full bg-[#0c0914] border border-[#372a4d] rounded-lg px-4 py-3 text-[#f5f0e8] focus:outline-none focus:border-[#ffd86b] transition-colors"
                placeholder="YouTube Grinding"
                disabled={depositing}
              />
            </div>
          </div>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label className="block text-xs text-[#9e8fb3] font-mono mb-2 uppercase">
                Category
              </label>
              <select
                value={depositCategory}
                onChange={(e) => setDepositCategory(e.target.value)}
                className="w-full bg-[#0c0914] border border-[#372a4d] rounded-lg px-4 py-3 text-[#f5f0e8] font-mono focus:outline-none focus:border-[#ffd86b] transition-colors"
                disabled={depositing}
              >
                <option value="grind">Grind</option>
                <option value="study">Study</option>
                <option value="work">Work</option>
                <option value="practice">Practice</option>
              </select>
            </div>
            <div>
              <label className="block text-xs text-[#9e8fb3] font-mono mb-2 uppercase">
                Speed Multiplier
              </label>
              <select
                value={depositSpeed}
                onChange={(e) => setDepositSpeed(e.target.value)}
                className="w-full bg-[#0c0914] border border-[#372a4d] rounded-lg px-4 py-3 text-[#f5f0e8] font-mono focus:outline-none focus:border-[#ffd86b] transition-colors"
                disabled={depositing}
              >
                <option value="1.0">1.0x</option>
                <option value="1.25">1.25x</option>
                <option value="1.5">1.5x</option>
                <option value="1.75">1.75x</option>
                <option value="2.0">2.0x</option>
              </select>
            </div>
            <div>
              <label className="block text-xs text-[#9e8fb3] font-mono mb-2 uppercase">
                Notes (Optional)
              </label>
              <input
                type="text"
                value={depositNotes}
                onChange={(e) => setDepositNotes(e.target.value)}
                className="w-full bg-[#0c0914] border border-[#372a4d] rounded-lg px-4 py-3 text-[#f5f0e8] focus:outline-none focus:border-[#ffd86b] transition-colors"
                placeholder="Quick notes..."
                disabled={depositing}
              />
            </div>
          </div>
          <button
            type="submit"
            disabled={depositing || !depositSeconds || !depositSource.trim()}
            className="w-full bg-[#ffd86b] hover:bg-[#ffdf8c] disabled:bg-[#4a3f5c] disabled:cursor-not-allowed text-[#0c0914] font-bold py-3 rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <Plus className="w-5 h-5" />
            {depositing ? 'Depositing...' : 'Deposit Time'}
          </button>
        </form>
      </div>

      {/* Error Display */}
      {error && (
        <div className="bg-red-900/20 border border-red-500/50 rounded-lg p-4">
          <p className="text-red-400 text-sm">{error}</p>
        </div>
      )}

      {/* Transaction History */}
      <div className="bg-[#171124] border border-[#372a4d] rounded-xl p-6">
        <div className="flex items-center gap-3 mb-4">
          <Calendar className="w-5 h-5 text-[#ffd86b]" />
          <h3 className="text-lg font-bold text-[#f5f0e8]">Transaction History</h3>
          <span className="ml-auto text-xs text-[#9e8fb3] font-mono">
            {poolState?.transactions.length || 0} entries
          </span>
        </div>
        {poolState?.transactions && poolState.transactions.length > 0 ? (
          <div className="space-y-2 max-h-[500px] overflow-y-auto">
            {poolState.transactions.map((tx) => (
              <TransactionRow key={tx.id} transaction={tx} />
            ))}
          </div>
        ) : (
          <div className="text-center py-12">
            <Droplet className="w-12 h-12 text-[#372a4d] mx-auto mb-3" />
            <p className="text-[#6b5a7f] text-sm">No transactions yet. Start depositing time!</p>
          </div>
        )}
      </div>
    </div>
  )
}

interface TransactionRowProps {
  transaction: PoolTransaction
}

const TransactionRow: React.FC<TransactionRowProps> = ({ transaction }) => {
  const date = new Date(transaction.timestamp)
  const timeStr = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })
  const dateStr = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })

  return (
    <div className="bg-[#0c0914]/50 border border-[#372a4d] rounded-lg p-4 hover:border-[#ffd86b]/30 transition-colors">
      <div className="flex items-start justify-between gap-4">
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2 mb-1">
            <span className="text-[#f5f0e8] font-semibold truncate">{transaction.source}</span>
            <span className="text-xs px-2 py-0.5 rounded bg-[#372a4d] text-[#9e8fb3] font-mono uppercase">
              {transaction.category}
            </span>
            {transaction.speed > 1.0 && (
              <span className="text-xs px-2 py-0.5 rounded bg-[#ffd86b]/20 text-[#ffd86b] font-mono">
                {transaction.speed}x
              </span>
            )}
          </div>
          {transaction.notes && (
            <p className="text-xs text-[#9e8fb3] mb-2">{transaction.notes}</p>
          )}
          <div className="flex items-center gap-3 text-xs text-[#6b5a7f] font-mono">
            <span>{dateStr} at {timeStr}</span>
            <span>•</span>
            <span>ID: {transaction.id}</span>
          </div>
        </div>
        <div className="text-right">
          <p className="text-xl font-bold text-[#ffd86b] font-mono">
            +{transaction.formatted}
          </p>
          <p className="text-xs text-[#6b5a7f] font-mono mt-1">
            {transaction.seconds.toFixed(0)}s
          </p>
        </div>
      </div>
    </div>
  )
}
