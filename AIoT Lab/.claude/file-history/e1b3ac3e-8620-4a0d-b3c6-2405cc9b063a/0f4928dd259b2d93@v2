import React, { useState, useEffect } from 'react';
import { Quote, Sparkles, Shuffle, BookOpen, RotateCcw } from 'lucide-react';

interface EvoQuoteBannerProps {
  currentDino: any;
  nextRank: number;
  currentRank: number;
  hoveredRank?: number | null;
}

export const EvoQuoteBanner: React.FC<EvoQuoteBannerProps> = ({
  currentDino,
  nextRank,
  currentRank,
  hoveredRank = null,
}) => {
  const [manualFactIndex, setManualFactIndex] = useState<number | null>(null);

  // Compute target fact index (0-indexed) for the EVO currently being hatched/unlocked
  const targetFactIndex = Math.max(0, Math.min(3, (nextRank || 1) - 1));

  // Auto-reset manual selection whenever the specimen or nextRank changes
  const dinoId = currentDino?.uuid || currentDino?.id || currentDino?.name;
  useEffect(() => {
    setManualFactIndex(null);
  }, [dinoId, nextRank]);

  if (!currentDino) return null;

  const facts: string[] = Array.isArray(currentDino.facts) && currentDino.facts.length > 0
    ? currentDino.facts
    : [
        `${currentDino.name || 'Specimen'} is a formidable prehistoric entity awaiting biometric incubation.`,
      ];

  // Active fact index prioritization:
  // 1. Milestone card hover (temporary preview)
  // 2. User manual cycle/selection (intentional browsing)
  // 3. Target EVO about to unlock (default)
  const isHovered =
    hoveredRank !== null &&
    hoveredRank !== undefined &&
    hoveredRank >= 1 &&
    hoveredRank <= facts.length;

  const activeFactIndex = isHovered
    ? Math.max(0, Math.min(facts.length - 1, (hoveredRank as number) - 1))
    : manualFactIndex !== null
    ? Math.max(0, Math.min(facts.length - 1, manualFactIndex))
    : Math.min(facts.length - 1, targetFactIndex);

  const displayedRank = activeFactIndex + 1;
  const isTargetRank = displayedRank === nextRank;
  const quoteText = facts[activeFactIndex] || facts[0];

  const handleCycleQuote = (e: React.MouseEvent) => {
    e.stopPropagation();
    setManualFactIndex((prev) => {
      const current = prev !== null ? prev : targetFactIndex;
      return (current + 1) % facts.length;
    });
  };

  const handleResetToTarget = (e: React.MouseEvent) => {
    e.stopPropagation();
    setManualFactIndex(null);
  };

  return (
    <div
      onClick={(e) => {
        // Prevent outer hitbox toggle if user clicks inside the quote banner
        e.stopPropagation();
      }}
      className="relative z-10 w-full mt-5 rounded-2xl p-4 sm:p-5 border transition-all duration-300 shadow-xl bg-gradient-to-r from-[#170f24]/95 via-[#231538]/90 to-[#140c20]/95 border-amber-500/40 hover:border-amber-400/70 select-none group"
      style={{
        boxShadow: '0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 216, 107, 0.15)',
      }}
    >
      {/* ── HEADER STRIP ── */}
      <div className="flex items-center justify-between gap-2 pb-2.5 border-b border-amber-500/20 flex-wrap">
        <div className="flex items-center gap-2">
          <div className="p-1.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 shadow-[0_0_12px_rgba(251,191,36,0.2)]">
            <Quote className="w-3.5 h-3.5 fill-amber-400/30" />
          </div>
          <div className="flex items-center gap-1.5 flex-wrap">
            <span className="font-cinzel text-xs sm:text-sm font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-amber-200 to-amber-400 tracking-wider uppercase">
              {currentDino.name}
            </span>
            <span className="text-zinc-600 font-mono text-xs">•</span>
            <span className="font-cinzel font-bold text-xs text-amber-300 tracking-wider">
              EVO {displayedRank} ARCHIVE DOSSIER
            </span>
          </div>
        </div>

        {/* Right Badges & Controls */}
        <div className="flex items-center gap-2 flex-wrap">
          {/* Status Badge */}
          {isHovered ? (
            <span className="px-2 py-0.5 rounded-full bg-purple-950/80 border border-purple-400/50 text-purple-300 text-[10px] font-mono tracking-wider uppercase flex items-center gap-1">
              <span>HOVER PREVIEW</span>
            </span>
          ) : isTargetRank ? (
            <span className="px-2.5 py-0.5 rounded-full bg-amber-500/20 border border-amber-400/50 text-amber-300 text-[10px] font-mono font-bold tracking-wider uppercase flex items-center gap-1 shadow-sm">
              <Sparkles className="w-3 h-3 text-amber-400 animate-pulse" />
              <span>HATCHING TARGET</span>
            </span>
          ) : displayedRank <= currentRank ? (
            <span className="px-2 py-0.5 rounded-full bg-emerald-950/70 border border-emerald-500/40 text-emerald-300 text-[10px] font-mono font-bold tracking-wider uppercase">
              ✓ UNLOCKED
            </span>
          ) : (
            <span className="px-2 py-0.5 rounded-full bg-[#1b1229] border border-[#3e2b54] text-zinc-400 text-[10px] font-mono tracking-wider uppercase">
              FUTURE TIER
            </span>
          )}

          {/* Cycle Quote Button */}
          {facts.length > 1 && (
            <button
              type="button"
              onClick={handleCycleQuote}
              title="Cycle through specimen archive quotes for this dinosaur"
              className="px-2.5 py-1 rounded-xl bg-[#201530] hover:bg-[#2d1e44] border border-[#4a3666] hover:border-amber-400/50 text-[#ffd86b] text-[10.5px] font-mono flex items-center gap-1.5 transition cursor-pointer active:scale-95 shadow-sm"
            >
              <Shuffle className="w-3 h-3 text-amber-400" />
              <span className="hidden sm:inline">Random Quote</span>
              <span className="text-zinc-400 font-sans">({displayedRank}/{facts.length})</span>
            </button>
          )}

          {/* Reset to Target Button (visible when manually browsing a different tier) */}
          {manualFactIndex !== null && manualFactIndex !== targetFactIndex && (
            <button
              type="button"
              onClick={handleResetToTarget}
              title={`Reset back to target EVO ${nextRank} quote`}
              className="px-2 py-1 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 text-amber-300 text-[10px] font-cinzel font-bold uppercase transition cursor-pointer active:scale-95 flex items-center gap-1"
            >
              <RotateCcw className="w-2.5 h-2.5" />
              <span>EVO {nextRank}</span>
            </button>
          )}
        </div>
      </div>

      {/* ── QUOTE PRESENTATION BODY ── */}
      <div className="relative pt-3 pb-0.5 flex items-start gap-3">
        <span className="font-serif text-3xl sm:text-4xl text-amber-400/30 leading-none select-none shrink-0 -mt-1">
          “
        </span>
        <div className="flex-1 min-w-0">
          <blockquote className="font-sans italic text-xs sm:text-sm text-zinc-100 leading-relaxed sm:leading-relaxed tracking-wide select-text cursor-text">
            {quoteText}
          </blockquote>
          <div className="flex items-center justify-between gap-2 mt-2 pt-1.5 border-t border-white/5 text-[10px] font-mono text-[#8c7a9e] flex-wrap">
            <span className="flex items-center gap-1.5 text-amber-400/80 font-cinzel tracking-wider uppercase">
              <BookOpen className="w-3 h-3 text-amber-400" />
              <span>Paleontological Archive Log • Evolution Tier {displayedRank}</span>
            </span>
            <span className="text-[#a493bc] italic">
              {isTargetRank
                ? 'Incubate to 00:00 to unlock this evolutionary milestone'
                : `Level ${displayedRank * 10} Genetic Archive`}
            </span>
          </div>
        </div>
        <span className="font-serif text-3xl sm:text-4xl text-amber-400/30 leading-none select-none shrink-0 self-end -mb-1">
          ”
        </span>
      </div>
    </div>
  );
};
