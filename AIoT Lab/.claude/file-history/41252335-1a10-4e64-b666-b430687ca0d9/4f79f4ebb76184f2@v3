@echo off
REM ============================================================
REM Faust Sovereign Junction Setup Script
REM Recreates NTFS Directory Junctions and Links pointing to
REM the Master Sovereign Vault at D:\My Heraclitus\Backups\Faust
REM Run as Administrator or with Developer Mode enabled.
REM ============================================================

setlocal enabledelayedexpansion

:: Configuration
set "PROJECT_ROOT=D:\My Drive\Blue AI"
set "CLAUDE_USER_DIR=%USERPROFILE%\.claude"
set "MASTER_ROOT=D:\My Heraclitus\Backups\Faust"
set "MASTER_AGENTS=%MASTER_ROOT%\.agents"
set "MASTER_CLAUDE=%MASTER_ROOT%\.claude"

if "!PROJECT_ROOT:~-1!" == "\" set "PROJECT_ROOT=!PROJECT_ROOT:~0,-1!"
if "!CLAUDE_USER_DIR:~-1!" == "\" set "CLAUDE_USER_DIR=!CLAUDE_USER_DIR:~0,-1!"

echo ============================================================
echo Faust Sovereign Junction & Link Setup
echo ============================================================
echo Master Sovereign Vault: %MASTER_ROOT%
echo Project Root (Drive D): %PROJECT_ROOT%
echo User Profile (Drive C): %CLAUDE_USER_DIR%
echo ============================================================

:: 1. Verify Master Exists
if not exist "%MASTER_AGENTS%\" (
    echo [ERROR] Master .agents not found: %MASTER_AGENTS%
    pause
    exit /b 1
)
if not exist "%MASTER_CLAUDE%\" (
    echo [ERROR] Master .claude not found: %MASTER_CLAUDE%
    pause
    exit /b 1
)

:: 2. Project Workspace Junctions (D:\My Drive\Blue AI)
echo.
echo [STEP 1/3] Setting up Project Workspace Junctions...
call :CreateJunction "%PROJECT_ROOT%\.agents" "%MASTER_AGENTS%"
call :CreateJunction "%PROJECT_ROOT%\.claude" "%MASTER_CLAUDE%"

:: 3. Global Claude User Directory Links (C:\Users\Admin\.claude)
echo.
echo [STEP 2/3] Setting up Global User Profile Links on C:...
if not exist "%CLAUDE_USER_DIR%\" mkdir "%CLAUDE_USER_DIR%"
call :CreateJunction "%CLAUDE_USER_DIR%\skills" "%MASTER_CLAUDE%\skills"
call :CreateJunction "%CLAUDE_USER_DIR%\plugins" "%MASTER_CLAUDE%\plugins"
call :CreateFileLink "%CLAUDE_USER_DIR%\settings.json" "%MASTER_CLAUDE%\settings.json"

:: 4. Project CLI Memory Junction (C:\Users\Admin\.claude\projects\D--My-Drive-Blue-AI)
echo.
echo [STEP 3/3] Setting up CLI Project Memory Junction on C:...
set "CLI_PROJ_DIR=%CLAUDE_USER_DIR%\projects\D--My-Drive-Blue-AI"
if not exist "%CLI_PROJ_DIR%\" mkdir "%CLI_PROJ_DIR%"
call :CreateJunction "%CLI_PROJ_DIR%\memory" "%MASTER_AGENTS%\memory"
call :CreateFileLink "%CLI_PROJ_DIR%\MEMORY.md" "%MASTER_AGENTS%\memory\MEMORY.md"

echo.
echo ============================================================
echo All Sovereign Junctions and Links verified successfully.
echo C: and My Drive contain strictly junctions and links.
echo Master files reside exclusively in My Heraclitus.
echo ============================================================
pause
exit /b 0

:: -------------------------------------------------------------
:: Helper: Create Directory Junction
:: -------------------------------------------------------------
:CreateJunction
set "TARGET=%~1"
set "SOURCE=%~2"

echo   [DIR] %TARGET% -> %SOURCE%
if not exist "%SOURCE%\" (
    echo     [ERROR] Source folder does not exist: %SOURCE%
    goto :eof
)
if exist "%TARGET%\" (
    rmdir "%TARGET%" 2>nul
    if exist "%TARGET%\" rd /s /q "%TARGET%" 2>nul
)
mklink /J "%TARGET%" "%SOURCE%" >nul 2>&1
if errorlevel 1 (
    echo     [WARN] Standard mklink failed, retrying...
    cmd /c "mklink /J \"%TARGET%\" \"%SOURCE%\""
) else (
    echo     [OK] Junction created.
)
goto :eof

:: -------------------------------------------------------------
:: Helper: Create File Symbolic Link
:: -------------------------------------------------------------
:CreateFileLink
set "TARGET=%~1"
set "SOURCE=%~2"

echo   [FILE] %TARGET% -> %SOURCE%
if not exist "%SOURCE%" (
    echo     [ERROR] Source file does not exist: %SOURCE%
    goto :eof
)
if exist "%TARGET%" del /f /q "%TARGET%" 2>nul
mklink "%TARGET%" "%SOURCE%" >nul 2>&1
if errorlevel 1 (
    cmd /c "mklink \"%TARGET%\" \"%SOURCE%\""
) else (
    echo     [OK] Symbolic link created.
)
goto :eof