// path: src/apps/golden-hour/components/gacha/RenderListAndDict.tsx

import React, { useState, useEffect } from 'react';
import type { PullItem } from '../../types';
import { MOCK_CARD_COVERS } from '../../mock/mockGachaData';
import { RARITY_TABLE } from '../../store/useGoldenHourStore';
import { HazardBadge } from '../../../../components/HazardBadge';
import { Sparkles, Zap } from 'lucide-react';

interface RenderListAndDictProps {
  items: PullItem[];
  dict: Record<string, number>;
  onClose: () => void;
  onRollAgain?: () => void;
  canRollAgain?: boolean;
  ticketCostText?: string;
}

export const RenderListAndDict: React.FC<RenderListAndDictProps> = ({
  items,
  dict,
  onClose,
  onRollAgain,
  canRollAgain = false,
  ticketCostText,
}) => {
  const [visible, setVisible] = useState(false);
  const [showContent, setShowContent] = useState(false);

  useEffect(() => {
    if (items && items.length > 0) {
      setVisible(true);
      const timer = setTimeout(() => setShowContent(true), 50);
      return () => clearTimeout(timer);
    }
  }, [items]);

  if (!visible) return null;

  const handleClose = () => {
    setShowContent(false);
    setTimeout(() => {
      setVisible(false);
      onClose();
    }, 350);
  };

  return (
    <div
      onClick={handleClose}
      className="fixed inset-0 z-50 flex items-center justify-center p-4 md:p-8 overflow-y-auto"
      style={{
        background: 'radial-gradient(circle at center, rgba(28, 20, 36, 0.95) 0%, rgba(10, 8, 15, 0.98) 100%)',
        backdropFilter: 'blur(16px)',
      }}
    >
      {/* Central Content Box */}
      <div
        onClick={(e) => e.stopPropagation()}
        className="w-full max-w-5xl my-auto p-4 md:p-6 rounded-3xl bg-[#120f18]/90 border border-[#d4af37]/50 shadow-2xl space-y-6 text-center transition-all duration-300 transform"
        style={{
          opacity: showContent ? 1 : 0,
          transform: showContent ? 'scale(1) translateY(0)' : 'scale(0.95) translateY(20px)',
        }}
      >
        {/* Header Title */}
        <div className="flex flex-col items-center gap-1 border-b border-white/10 pb-4">
          <div className="flex items-center gap-2 text-[#ffd86b] font-cinzel text-xl md:text-2xl font-black">
            <Sparkles className="w-6 h-6 animate-pulse" />
            <span>Summoning Archives — Materialized Relics</span>
          </div>
          <p className="text-xs font-mono text-[#8c7a9e]">
            {items.length} Item{items.length !== 1 ? 's' : ''} Synthesized & Auto-Stored in Vault
          </p>
        </div>

        {/* 🎴 Unboxed Cards Grid */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 max-h-[50vh] overflow-y-auto p-2">
          {items.map((item, index) => {
            const baseKey = item.name.replace(/\s+\d+u$/, '').trim();
            const meta = MOCK_CARD_COVERS[baseKey] || MOCK_CARD_COVERS[item.name];
            const rarityMeta = RARITY_TABLE[item.rarity] || RARITY_TABLE.common;

            return (
              <div
                key={item.id || index}
                className="relative flex flex-col items-center justify-between p-3.5 rounded-2xl border transition-all duration-200 hover:scale-[1.03] overflow-hidden group shadow-lg"
                style={{
                  borderColor: rarityMeta.borderColor,
                  background: meta?.background || 'linear-gradient(135deg, #1c1424 0%, #100d16 100%)',
                }}
              >
                {/* Rarity Aura & Rank Badge */}
                <div className="w-full flex items-center justify-between z-10 text-[10px] font-mono">
                  <span
                    className="px-2 py-0.5 rounded font-bold uppercase"
                    style={{
                      backgroundColor: rarityMeta.bgColor,
                      color: rarityMeta.color,
                      border: `1px solid ${rarityMeta.borderColor}`,
                    }}
                  >
                    {rarityMeta.label}
                  </span>

                  <HazardBadge score={item.score} rank={item.rank} size="sm" />
                </div>

                {/* Main Item Visual Icon / Image */}
                <div className="my-2.5 relative z-10 w-24 h-24 rounded-xl overflow-hidden border border-white/10 shadow-md bg-black/40 flex items-center justify-center">
                  {meta?.cover ? (
                    <img
                      src={meta.cover}
                      alt={item.name}
                      className="w-full h-full object-cover transition-transform group-hover:scale-110"
                      onError={(e) => {
                        (e.target as HTMLImageElement).style.display = 'none';
                      }}
                    />
                  ) : (
                    <span className="text-4xl">{item.iconEmoji}</span>
                  )}
                </div>

                {/* Item Name & Details */}
                <div className="w-full z-10 space-y-1">
                  <div className="font-cinzel text-xs font-bold text-white leading-tight truncate" title={item.name}>
                    {item.name}
                  </div>
                  <div className="text-[10px] font-mono text-[#8c7a9e] capitalize">
                    {item.category.replace('-', ' ')}
                  </div>

                  {/* Relic Stats Preview */}
                  {item.category === 'relic' && item.stats && (
                    <div className="flex items-center justify-center gap-2 pt-1 text-[10px] font-mono border-t border-white/10">
                      <span className="text-emerald-400">ATK +{item.stats.find(s => s.name === 'ATK')?.value || 0}</span>
                      <span className="text-sky-400">DEF +{item.stats.find(s => s.name === 'DEF')?.value || 0}</span>
                    </div>
                  )}

                  {/* Energy Core Preview */}
                  {item.category === 'energy-core' && item.energyCores && (
                    <div className="flex items-center justify-center gap-1 pt-1 text-[10px] font-mono text-[#ffd86b] border-t border-white/10">
                      <Zap className="w-3 h-3" />
                      <span>+{item.energyCores[0]?.amount}u {item.energyCores[0]?.attribute.toUpperCase()}</span>
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        {/* 📊 Aggregated Summary Dictionary Breakdown (CardPacks UI Standard) */}
        <div className="max-w-md mx-auto w-full">
          <div
            className="p-4 rounded-2xl text-left shadow-2xl border"
            style={{
              backgroundColor: 'rgba(18, 15, 24, 0.95)',
              borderColor: '#d4af37',
              boxShadow: '0 8px 24px rgba(0, 0, 0, 0.8), 0 0 15px rgba(212, 175, 55, 0.2)',
            }}
          >
            <div className="text-xs font-mono font-bold text-[#ffd86b] uppercase tracking-wider mb-2 pb-1.5 border-b border-white/10 flex items-center justify-between">
              <span>Item Breakdown Summary</span>
              <span className="text-[10px] text-[#8c7a9e]">Sorted Descending</span>
            </div>

            <div className="max-h-40 overflow-y-auto space-y-1.5 font-mono text-xs">
              {Object.entries(dict)
                .sort(([keyA, valA], [keyB, valB]) => {
                  if (valB !== valA) return valB - valA;
                  return keyA.localeCompare(keyB);
                })
                .map(([key, count], idx) => (
                  <div
                    key={idx}
                    className="flex items-center justify-between py-1 px-2 rounded-lg bg-white/5 border border-white/5"
                  >
                    <strong className="text-[#38bdf8] truncate max-w-[240px] text-xs" title={key}>
                      {key}:
                    </strong>
                    <span className="text-[#ffd86b] font-bold text-sm bg-[#1c1424] px-2 py-0.5 rounded border border-[#ffd86b]/30">
                      ×{count}
                    </span>
                  </div>
                ))}
            </div>
          </div>
        </div>

        {/* Modal Actions */}
        <div className="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          {onRollAgain && canRollAgain && (
            <button
              onClick={onRollAgain}
              className="px-6 py-2.5 rounded-xl font-cinzel font-bold text-xs bg-[#ffd86b] hover:bg-[#ffe391] text-black shadow-lg shadow-[#ffd86b]/30 transition-all cursor-pointer flex items-center gap-2 active:scale-95"
            >
              <Sparkles className="w-4 h-4" />
              <span>Summon Again {ticketCostText ? `(${ticketCostText})` : ''}</span>
            </button>
          )}

          <button
            onClick={handleClose}
            className="px-6 py-2.5 rounded-xl font-mono text-xs bg-[#1f172b] hover:bg-[#2b203d] border border-white/20 text-white transition-all cursor-pointer shadow-md active:scale-95"
          >
            Return to Lobby (Click anywhere)
          </button>
        </div>
      </div>
    </div>
  );
};

export default RenderListAndDict;
