import type { TicketType, GachaRarity, ElementalAttribute } from '../types';

export interface RawDeckPack {
  id: string;
  Title: string;
  Note: string;
  Cards: number;                // Number of pulls per pack open
  ticketType: TicketType;
  ticketCost: number;
  Cover: string;                // Static cover image / visual
  Animation: string;            // Hover animated visual / effect
  Button: string;               // Button color or asset
  ButtonText?: string;          // Button label (defaults to "Engage")
  color: string;
  borderColor: string;
  bgGradient: string;
  Unpack: string[];             // Drop table rules (e.g., "Babylonian Scepter ~ 1%", "Aether Residue ...")
  Guarantee?: string[];         // Guaranteed slot drops
}

export interface ItemVisualMeta {
  cover: string;                // Icon / cover image
  background: string;           // Background card art / gradient
  category: 'relic' | 'collectible' | 'energy-core';
  rarity: GachaRarity;
  description: string;
  energyAttribute?: ElementalAttribute;
  energyAmount?: number;
}

