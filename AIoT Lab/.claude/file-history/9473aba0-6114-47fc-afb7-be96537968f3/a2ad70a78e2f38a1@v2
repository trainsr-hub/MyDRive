/* 📊 Top-Right Hover Stats HUD */
.total-dict {
  position: fixed;
  top: 80px;
  right: 24px;
  z-index: 40;
  max-width: 320px;
  width: calc(100% - 48px);
  background: rgba(18, 15, 24, 0.92);
  border: 1px solid #d4af37;
  border-radius: 14px;
  padding: 14px 18px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 15px rgba(212, 175, 55, 0.2);
  backdrop-filter: blur(12px);
  animation: totalDictFadeIn 0.25s ease-out;
  pointer-events: none;
}

@keyframes totalDictFadeIn {
  from { opacity: 0; transform: translateY(-8px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.total-dict-list {
  max-height: 220px;
  overflow-y: auto;
  margin-bottom: 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.total-dict-item {
  font-family: monospace;
  font-size: 11px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #cbd5e1;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding-bottom: 4px;
}

.total-dict-item strong {
  color: #ffd86b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 190px;
}

/* 🃏 Card Packs Grid Container */
.cards-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  width: 100%;
  margin: 0 auto;
}

/* 🎴 Single Card Pack Container */
.card {
  background: #120f18;
  border: 1px solid #2b2238;
  border-radius: 18px;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
}

.card:hover {
  transform: translateY(-4px) scale(1.015);
  border-color: #d4af37;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 175, 55, 0.25);
}

.card.active {
  border-color: #ffd86b;
  box-shadow: 0 0 25px rgba(255, 216, 107, 0.4);
  transform: translateY(-4px) scale(1.02);
}

/* Pack Image / Animation Wrapper */
.card-img-wrapper {
  width: 100%;
  height: 220px;
  position: relative;
  overflow: hidden;
  background: #0a080f;
}

.card-img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.card:hover .card-img-wrapper img {
  transform: scale(1.06);
}

/* Pack Body */
.card-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
  justify-content: space-between;
  gap: 12px;
  background: linear-gradient(180deg, #16121f 0%, #100d16 100%);
}

.card-title {
  font-family: 'Cinzel', serif, system-ui;
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-footer {
  position: relative;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 10px;
}

.card-note {
  font-size: 11px;
  color: var(--note-color, #9c93a8);
  font-style: italic;
  line-height: 1.3;
  transition: color 0.2s ease;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* Action Button Row */
.button-row {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  animation: buttonRowFadeIn 0.2s ease-out;
}

@keyframes buttonRowFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.card-button {
  flex: 1;
  padding: 9px 14px;
  border-radius: 10px;
  font-family: 'Cinzel', serif, system-ui;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.5px;
  color: #000000;
  background: #ffd86b;
  border: 1px solid rgba(255, 255, 255, 0.3);
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(255, 216, 107, 0.3);
  transition: all 0.15s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.card-button:hover:not(:disabled) {
  background: #ffe391;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(255, 216, 107, 0.45);
}

.card-button:active:not(:disabled) {
  transform: translateY(1px);
}

.card-button:disabled {
  background: #2a2238;
  color: #6d5f7f;
  border-color: #3b304f;
  cursor: not-allowed;
  box-shadow: none;
}
