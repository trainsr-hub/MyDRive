import type { PullItem, TicketType, GachaRarity, GlobalRankTier, ElementalAttribute } from '../types';
import { MOCK_CARD_COVERS, type RawDeckPack } from '../mock/mockGachaData';

export interface EvaluatedPoolEntry {
  raw: string;
  itemPattern: string;
  rate: number;         // 0 to 1
  cumulative: number;   // 0 to 1
}

export interface CompiledDeck {
  deck: RawDeckPack;
  standardPool: EvaluatedPoolEntry[];
  guaranteePool: EvaluatedPoolEntry[];
}

export interface RollEngineResult {
  items: PullItem[];
  stringList: string[];
  dict: Record<string, number>;
}

// =============================================================================
// HELPER UTILITIES
// =============================================================================

function getRandomInt(min: number, max: number): number {
  const low = Math.ceil(min);
  const high = Math.floor(max);
  return Math.floor(Math.random() * (high - low + 1)) + low;
}

/**
 * Evaluates expressions like:
 * - "OptionA | OptionB" -> randomly picks one
 * - "Core 30...60" -> replaces range with a random integer in [30, 60]
 */
export function resolveItemPattern(pattern: string): { cleanName: string; parsedAmount?: number; baseKey: string } {
  let resolved = pattern.trim();

  // 1. Resolve random pipe choices: "A | B | C"
  if (resolved.includes('|')) {
    const choices = resolved.split('|').map((s) => s.trim()).filter(Boolean);
    resolved = choices[Math.floor(Math.random() * choices.length)];
  }

  // 2. Resolve range syntax: "10...50"
  let parsedAmount: number | undefined;
  const rangeMatch = resolved.match(/(\d+)\.\.\.(\d+)/);
  if (rangeMatch) {
    const min = parseInt(rangeMatch[1], 10);
    const max = parseInt(rangeMatch[2], 10);
    parsedAmount = getRandomInt(min, max);
    resolved = resolved.replace(rangeMatch[0], `${parsedAmount}u`);
  }

  // 3. Determine base key for cover/metadata lookup
  // Strips trailing units/amounts to match keys in MOCK_CARD_COVERS
  const baseKey = resolved.replace(/\s+\d+u$/, '').replace(/\s+\d+\.\.\.\d+$/, '').trim();

  return { cleanName: resolved, parsedAmount, baseKey };
}

// =============================================================================
// COMPILATION & CUMULATIVE PROBABILITY TABLE
// =============================================================================

export function compileDeckPool(deck: RawDeckPack): CompiledDeck {
  const compileEntries = (rawList: string[]): EvaluatedPoolEntry[] => {
    if (!rawList || rawList.length === 0) return [];

    let totalExplicitRate = 0;
    const itemsWithoutRate: string[] = [];

    const parsedList: { pattern: string; raw: string; rate?: number }[] = [];

    for (const entry of rawList) {
      if (entry.includes('~')) {
        const [pattern, rateStr] = entry.split('~').map((s) => s.trim());
        const rate = parseFloat(rateStr.replace('%', '')) / 100;
        totalExplicitRate += rate;
        parsedList.push({ pattern, raw: entry, rate });
      } else {
        itemsWithoutRate.push(entry.trim());
        parsedList.push({ pattern: entry.trim(), raw: entry });
      }
    }

    const remainderRate = Math.max(0, 1 - totalExplicitRate);
    const fallbackRate = itemsWithoutRate.length > 0 ? remainderRate / itemsWithoutRate.length : 0;

    let cumulative = 0;
    return parsedList.map((item) => {
      const rate = item.rate !== undefined ? item.rate : fallbackRate;
      cumulative += rate;
      return {
        raw: item.raw,
        itemPattern: item.pattern,
        rate,
        cumulative,
      };
    });
  };

  return {
    deck,
    standardPool: compileEntries(deck.Unpack),
    guaranteePool: deck.Guarantee ? compileEntries(deck.Guarantee) : [],
  };
}

// Cache compiled decks for O(1) execution
const COMPILED_DECKS_CACHE = new Map<string, CompiledDeck>();

export function getOrCompileDeck(deck: RawDeckPack): CompiledDeck {
  if (!COMPILED_DECKS_CACHE.has(deck.id)) {
    COMPILED_DECKS_CACHE.set(deck.id, compileDeckPool(deck));
  }
  return COMPILED_DECKS_CACHE.get(deck.id)!;
}

// =============================================================================
// FAST SAMPLING & PULL ITEM BUILDER
// =============================================================================

function sampleFromPool(pool: EvaluatedPoolEntry[]): string {
  if (pool.length === 0) return 'Residual Matter Fragment';
  const roll = Math.random();
  for (const entry of pool) {
    if (roll <= entry.cumulative) {
      return entry.itemPattern;
    }
  }
  return pool[pool.length - 1].itemPattern;
}

export function createPullItemFromPattern(
  pattern: string,
  ticketType: TicketType
): PullItem {
  const { cleanName, parsedAmount, baseKey } = resolveItemPattern(pattern);
  const meta = MOCK_CARD_COVERS[baseKey] || {
    cover: 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=200&auto=format&fit=crop&q=80',
    background: 'linear-gradient(135deg, #1e293b 0%, #0f172a 50%, #000 100%)',
    category: 'collectible' as const,
    rarity: 'common' as const,
    description: 'A mysterious artifact materialized through dimensional gacha synthesis.',
  };

  const id = `item_${Date.now()}_${Math.random().toString(36).substring(2, 8)}`;
  const rarity: GachaRarity = meta.rarity;

  const scoreMultiplier = {
    common: 2.0,
    uncommon: 4.0,
    rare: 6.0,
    epic: 8.5,
    legendary: 11.0,
  }[rarity];

  const score = Math.round((Math.random() * 1.5 + scoreMultiplier) * 100) / 100;
  const rank: GlobalRankTier =
    rarity === 'legendary' ? '✦'
    : rarity === 'epic' ? 'Ψ'
    : rarity === 'rare' ? 'S₁'
    : rarity === 'uncommon' ? 'A+'
    : 'B';

  if (meta.category === 'relic') {
    const atk = Math.floor(Math.random() * 20 * (scoreMultiplier / 2));
    const def = Math.floor(Math.random() * 15 * (scoreMultiplier / 2));
    const spd = Math.floor(Math.random() * 10 * (scoreMultiplier / 2));
    const luck = Math.floor(Math.random() * 10 * (scoreMultiplier / 2));
    const penalty = Math.floor(Math.random() * 8) + 2;

    return {
      id,
      name: cleanName,
      description: meta.description,
      category: 'relic',
      rarity,
      rank,
      score,
      origin: ticketType,
      iconEmoji: '⚔️',
      stats: [
        { name: 'ATK', value: atk },
        { name: 'DEF', value: def },
        { name: 'SPD', value: spd - penalty },
        { name: 'LUCK', value: luck },
      ],
      buffs: [
        {
          name: `${cleanName} Resonance`,
          description: `Amplifies Golden Hour efficiency multiplier by +${(scoreMultiplier * 2.2).toFixed(1)}%.`,
          magnitude: scoreMultiplier * 0.022,
        },
      ],
      downsides: [
        {
          name: 'Entropic Friction',
          description: `Imposes a -${penalty} speed penalty during tactical traversal.`,
          severity: Math.min(5, Math.ceil(penalty / 2)),
        },
      ],
      pulledAt: new Date().toISOString(),
    };
  }

  if (meta.category === 'energy-core') {
    const element: ElementalAttribute = meta.energyAttribute || 'aether';
    const amount = parsedAmount || meta.energyAmount || getRandomInt(20, 50);

    return {
      id,
      name: cleanName,
      description: meta.description,
      category: 'energy-core',
      rarity,
      rank: 'D',
      score: 1.5,
      origin: ticketType,
      iconEmoji: '⚡',
      energyCores: [{ attribute: element, amount }],
      pulledAt: new Date().toISOString(),
    };
  }

  // Collectible default
  return {
    id,
    name: cleanName,
    description: meta.description,
    category: 'collectible',
    rarity,
    rank: rarity === 'legendary' ? 'Ø' : rank,
    score,
    origin: ticketType,
    iconEmoji: '🏺',
    seriesName: 'Babylonian Codex Archive',
    loreText: `Synthesized during the Golden Hour cycle from dimensional world [${ticketType}].`,
    pulledAt: new Date().toISOString(),
  };
}

// =============================================================================
// MAIN PACK ROLLING ACTION (High-Efficiency Multi-Pull Batch)
// =============================================================================

export function executePackRoll(deck: RawDeckPack, multiplier: number = 1): RollEngineResult {
  const compiled = getOrCompileDeck(deck);
  const totalCards = Math.max(1, deck.Cards * multiplier);

  const items: PullItem[] = [];
  const stringList: string[] = [];
  const dict: Record<string, number> = {};

  // 1. Guaranteed slots first
  const guaranteeCount = (compiled.guaranteePool.length > 0 ? 1 : 0) * multiplier;
  for (let g = 0; g < guaranteeCount; g++) {
    const rawPattern = sampleFromPool(compiled.guaranteePool);
    const item = createPullItemFromPattern(rawPattern, deck.ticketType);
    items.push(item);
    const token = `${item.name} ~ ${item.category}`;
    stringList.push(token);
    dict[item.name] = (dict[item.name] || 0) + 1;
  }

  // 2. Standard pool rolls
  const standardRolls = Math.max(0, totalCards - guaranteeCount);
  for (let i = 0; i < standardRolls; i++) {
    const rawPattern = sampleFromPool(compiled.standardPool);
    const item = createPullItemFromPattern(rawPattern, deck.ticketType);
    items.push(item);
    const token = `${item.name} ~ ${item.category}`;
    stringList.push(token);
    dict[item.name] = (dict[item.name] || 0) + 1;
  }

  return { items, stringList, dict };
}
