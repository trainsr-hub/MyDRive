<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Plasma Crucible · Ingot Smelter Accumulator</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #0a0503; font-family: 'Segoe UI', system-ui, sans-serif;
  color: #ffedd5; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }

.hud {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  padding: 24px; z-index: 10;
}
.header { text-align: center; }
.sub-title {
  font-size: 11px; letter-spacing: .25em; text-transform: uppercase;
  color: #f97316; font-weight: 700; margin-bottom: 4px;
}
.main-title {
  font-size: 20px; font-weight: 800; letter-spacing: .12em;
  color: #fff7ed; text-shadow: 0 0 16px rgba(249,115,22,0.5);
}

/* ── Vault Rack ── */
.ingot-rack {
  position: absolute; right: 30px; top: 40px;
  background: rgba(22, 10, 6, 0.85); border: 1.5px solid rgba(249,115,22,0.4);
  border-radius: 14px; padding: 12px 20px; display: flex; flex-direction: column; gap: 4px;
  box-shadow: 0 0 20px rgba(249,115,22,0.25);
}
.rack-label { font-size: 10px; letter-spacing: .2em; color: #fdba74; text-transform: uppercase; }
.rack-val {
  font-size: 24px; font-weight: 800; font-family: monospace;
  color: #ffedd5; text-shadow: 0 0 10px rgba(249,115,22,0.6);
}

/* ── Command Bar ── */
.controls {
  pointer-events: auto; display: flex; justify-content: center;
  gap: 12px; flex-wrap: wrap; width: 100%;
}
.btn {
  min-height: 52px; padding: 0 24px;
  background: rgba(30, 14, 8, 0.85); border: 1.5px solid rgba(249,115,22,0.4);
  border-radius: 12px; color: #fdba74; font-size: 12px; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase; cursor: pointer;
  transition: all .15s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
}
.btn:hover {
  background: #431407; border-color: #fb923c; color: #fff;
  box-shadow: 0 0 24px rgba(249,115,22,0.5); transform: translateY(-2px);
}
.btn:active { transform: translateY(1px); }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div class="hud">
  <div class="header">
    <div class="sub-title">Thermal Smelting Complex</div>
    <div class="main-title">Thermonuclear Plasma Crucible</div>
  </div>

  <div class="ingot-rack">
    <span class="rack-label">Refined Ingots</span>
    <span class="rack-val" id="ingotCount">0 BARS</span>
  </div>

  <div class="controls">
    <button class="btn" onclick="feedOre(1)">🔥 Feed Raw Ore (+1)</button>
    <button class="btn" onclick="feedOre(5)">🌋 Feed Batch (+5)</button>
    <button class="btn" onclick="triggerPistonStamp()">🔨 Forge Stamp Ingot</button>
    <button class="btn" onclick="clearRack()">📦 Ship Cargo</button>
  </div>
</div>

<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
const ingotCountEl = document.getElementById('ingotCount');
let W, H, cx, cy, ores = [], sparks = [], ingots = 0;
let heatLevel = 0.2, pistonY = 0, stamping = false;

// ── Web Audio Synth ─────────────────────────────────────────────
let audioCtx = null;
function playHeavyStamp() {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(110, t);
    osc.frequency.exponentialRampToValueAtTime(30, t + 0.35);
    gain.gain.setValueAtTime(0.4, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
    osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(t); osc.stop(t + 0.35);
  } catch(e) {}
}

function resize() {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
  cx = W / 2; cy = H / 2;
}
window.addEventListener('resize', resize);
resize();

function feedOre(count = 1) {
  for (let i = 0; i < count; i++) {
    ores.push({
      x: cx + (Math.random() - 0.5) * 80,
      y: cy - 220,
      vy: 2 + Math.random() * 3,
      size: 10 + Math.random() * 6
    });
  }
}

function triggerPistonStamp() {
  if (stamping) return;
  stamping = true;
  pistonY = 0;
  playHeavyStamp();
  setTimeout(() => {
    ingots++;
    ingotCountEl.textContent = `${ingots} BARS`;
    spawnMoltenSparks(cx, cy + 30, 30);
  }, 120);
  setTimeout(() => { stamping = false; }, 350);
}

function clearRack() {
  ingots = 0;
  ingotCountEl.textContent = '0 BARS';
}

function spawnMoltenSparks(x, y, count = 20) {
  for (let i = 0; i < count; i++) {
    const a = Math.random() * Math.PI * 2;
    const s = 3 + Math.random() * 8;
    sparks.push({
      x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 2,
      life: 1, decay: 0.03 + Math.random() * 0.04
    });
  }
}

// ── Render Loop ─────────────────────────────────────────────────
function draw() {
  ctx.fillStyle = 'rgba(10, 5, 3, 0.3)';
  ctx.fillRect(0, 0, W, H);

  // Crucible Vat Outer Shell
  const vatW = 200, vatH = 140;
  const vx = cx - vatW / 2, vy = cy;

  // Draw Hydraulic Piston
  const targetPiston = stamping ? 80 : 0;
  pistonY += (targetPiston - pistonY) * 0.35;
  ctx.fillStyle = '#292524';
  ctx.fillRect(cx - 30, cy - 180 + pistonY, 60, 100);
  ctx.fillStyle = '#f97316';
  ctx.fillRect(cx - 28, cy - 82 + pistonY, 56, 4);

  // Dropping Raw Ore Chunks
  for (let i = ores.length - 1; i >= 0; i--) {
    const o = ores[i];
    o.y += o.vy;
    o.vy += 0.4;
    ctx.beginPath();
    ctx.arc(o.x, o.y, o.size, 0, Math.PI * 2);
    ctx.fillStyle = '#ea580c';
    ctx.shadowColor = '#f97316';
    ctx.shadowBlur = 12;
    ctx.fill();

    if (o.y >= cy + 40) {
      spawnMoltenSparks(o.x, cy + 40, 8);
      ores.splice(i, 1);
    }
  }

  // Molten Plasma Core in Vat
  ctx.save();
  ctx.beginPath();
  ctx.roundRect(vx, vy, vatW, vatH, [0, 0, 24, 24]);
  ctx.fillStyle = '#1c1917';
  ctx.fill();
  ctx.strokeStyle = '#78350f';
  ctx.lineWidth = 3;
  ctx.stroke();

  // Glowing Plasma Liquid
  const mGrad = ctx.createLinearGradient(0, vy + 30, 0, vy + vatH);
  mGrad.addColorStop(0, '#f97316');
  mGrad.addColorStop(0.5, '#ea580c');
  mGrad.addColorStop(1, '#7c2d12');
  ctx.fillStyle = mGrad;
  ctx.shadowColor = '#f97316';
  ctx.shadowBlur = 30;
  ctx.beginPath();
  ctx.roundRect(vx + 10, vy + 30, vatW - 20, vatH - 40, [0, 0, 18, 18]);
  ctx.fill();
  ctx.restore();

  // Sparks
  for (let i = sparks.length - 1; i >= 0; i--) {
    const s = sparks[i];
    s.x += s.vx; s.y += s.vy;
    s.vy += 0.25;
    s.life -= s.decay;
    ctx.beginPath();
    ctx.arc(s.x, s.y, 2.5, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(254, 215, 170, ${s.life})`;
    ctx.shadowColor = '#f97316';
    ctx.shadowBlur = 8;
    ctx.fill();
    if (s.life <= 0) sparks.splice(i, 1);
  }

  requestAnimationFrame(draw);
}

requestAnimationFrame(draw);
</script>
</body>
</html>