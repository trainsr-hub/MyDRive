<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Accumulation Suite · Faust Design Sandbox</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #040307; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  color: #f3f4f6; user-select: none;
}
.app-container { display: flex; width: 100%; height: 100%; position: relative; }
.sidebar {
  width: 330px; height: 100%; background: #08060f;
  border-right: 1px solid rgba(255,255,255,0.08);
  display: flex; flex-direction: column; z-index: 20;
  box-shadow: 4px 0 24px rgba(0,0,0,0.6);
}
.brand-header { padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,0.06); }
.brand-sub { font-size: 10px; letter-spacing: .25em; text-transform: uppercase; color: #f59e0b; font-weight: 700; }
.brand-title { font-size: 18px; font-weight: 800; letter-spacing: .08em; color: #fff; text-shadow: 0 0 16px rgba(245,158,11,0.4); }

.nav-list { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
.nav-item {
  min-height: 54px; width: 100%; padding: 0 14px;
  background: rgba(255,255,255,0.02); border: 1.5px solid transparent;
  border-radius: 12px; cursor: pointer; text-align: left;
  display: flex; align-items: center; gap: 12px; transition: all .15s ease; color: #d1d5db;
}
.nav-item:hover { background: rgba(255,255,255,0.06); border-color: rgba(245,158,11,0.3); color: #fff; transform: translateX(3px); }
.nav-item.active {
  background: linear-gradient(90deg, rgba(245,158,11,0.18), rgba(245,158,11,0.04));
  border-color: #f59e0b; color: #fff; box-shadow: 0 0 18px rgba(245,158,11,0.25);
}
.nav-icon { font-size: 18px; width: 24px; text-align: center; }
.nav-meta { display: flex; flex-direction: column; }
.nav-name { font-size: 12px; font-weight: 700; letter-spacing: .02em; }
.nav-desc { font-size: 10px; color: #9ca3af; }

.sidebar-footer {
  padding: 14px 18px; border-top: 1px solid rgba(255,255,255,0.06);
  display: flex; flex-direction: column; gap: 4px; font-family: monospace; font-size: 11px; color: #9ca3af;
}
.footer-row { display: flex; justify-content: space-between; }
.footer-row span:last-child { color: #f59e0b; font-weight: 700; }

.viewport-frame { flex: 1; height: 100%; position: relative; background: #000; }
iframe { width: 100%; height: 100%; border: none; display: block; }
.top-actions { position: absolute; top: 18px; right: 20px; z-index: 30; display: flex; gap: 10px; }
.action-btn {
  min-height: 44px; padding: 0 18px; background: rgba(12, 10, 20, 0.85);
  border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; color: #e5e7eb;
  font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  cursor: pointer; transition: all .15s ease; backdrop-filter: blur(8px);
}
.action-btn:hover { background: #f59e0b; border-color: #fde047; color: #000; box-shadow: 0 0 20px rgba(245,158,11,0.5); }
</style>
</head>
<body>
<div class="app-container">
  <aside class="sidebar">
    <div class="brand-header">
      <div class="brand-sub">Faust Design Sandbox</div>
      <div class="brand-title">Two-Phase Accumulator</div>
    </div>
    <nav class="nav-list" id="navList"></nav>
    <div class="sidebar-footer">
      <div class="footer-row"><span>SUITE:</span><span>2 PHASES LAB</span></div>
      <div class="footer-row"><span>TOTAL MODULES:</span><span>5 ENGINES</span></div>
      <div class="footer-row"><span>DISK LOCATION:</span><span>LOCAL D: VAULT</span></div>
    </div>
  </aside>
  <main class="viewport-frame">
    <div class="top-actions">
      <button class="action-btn" onclick="openFullscreen()">⛶ Fullscreen</button>
      <button class="action-btn" onclick="openInNewTab()">↗ Open File</button>
    </div>
    <iframe id="engineFrame" src="2 Phases/phase_001_supernova_core.html"></iframe>
  </main>
</div>

<script>
const MODULES = [
  { file: '2 Phases/phase_001_supernova_core.html', name: 'Supernova Collapse', desc: 'Gravitational Accretion & Stardust Shockwave', icon: '☀️' },
  { file: '2 Phases/phase_002_chrono_capacitor.html', name: 'Chrono Capacitor', desc: 'Dielectric Spool & Twin Arc Discharge', icon: '⚡' },
  { file: '2 Phases/phase_003_hydraulic_geyser.html', name: 'Hydraulic Geyser', desc: 'Valve Squeeze & High-Plume Water Burst', icon: '🌊' },
  { file: '2 Phases/phase_004_chrono_seal.html', name: 'Mystic Rune Seal', desc: 'Sacred Geometry Etch & Glass Shatter', icon: '🔯' },
  { file: '2 Phases/two_phase_hold_release.html', name: 'Chrono Railgun Core', desc: 'Violent Kinetic Compression & Detonation', icon: '💥' }
];

let activeIdx = 0;
const navListEl = document.getElementById('navList'), frameEl = document.getElementById('engineFrame');

function renderNav() {
  navListEl.innerHTML = '';
  MODULES.forEach((mod, idx) => {
    const btn = document.createElement('button');
    btn.className = `nav-item ${idx === activeIdx ? 'active' : ''}`;
    btn.onclick = () => selectModule(idx);
    btn.innerHTML = `
      <span class="nav-icon">${mod.icon}</span>
      <div class="nav-meta"><span class="nav-name">${mod.name}</span><span class="nav-desc">${mod.desc}</span></div>
    `;
    navListEl.appendChild(btn);
  });
}

function selectModule(idx) {
  activeIdx = idx;
  frameEl.src = MODULES[idx].file;
  renderNav();
}

function openFullscreen() {
  if (frameEl.requestFullscreen) frameEl.requestFullscreen();
  else if (frameEl.webkitRequestFullscreen) frameEl.webkitRequestFullscreen();
}
function openInNewTab() { window.open(MODULES[activeIdx].file, '_blank'); }

renderNav();
</script>
</body>
</html>