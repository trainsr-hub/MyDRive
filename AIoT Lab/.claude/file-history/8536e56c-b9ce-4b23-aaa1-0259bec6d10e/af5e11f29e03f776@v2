<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aether Siphon · Cosmic Accumulator</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #03030a; font-family: 'Segoe UI', system-ui, sans-serif;
  color: #e2e8f0; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }
.hud-overlay {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  padding: 24px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: #38bdf8; font-weight: 700; margin-bottom: 4px; }
.main-title { font-size: 22px; font-weight: 800; letter-spacing: .12em; color: #f0f9ff; text-shadow: 0 0 20px rgba(56,189,248,0.5); }
.core-telemetry {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  display: flex; flex-direction: column; align-items: center; pointer-events: none;
}
.telemetry-val { font-size: 32px; font-weight: 900; font-family: monospace; color: #e0f2fe; text-shadow: 0 0 16px rgba(56,189,248,0.8); }
.telemetry-label { font-size: 10px; letter-spacing: .25em; text-transform: uppercase; color: #7dd3fc; opacity: .8; }
.controls { pointer-events: auto; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; width: 100%; }
.btn {
  min-height: 52px; padding: 0 24px; background: rgba(8, 14, 26, 0.85);
  border: 1.5px solid rgba(56,189,248,0.35); border-radius: 12px; color: #bae6fd;
  font-size: 12px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase;
  cursor: pointer; transition: all .15s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
}
.btn:hover { background: rgba(14, 28, 54, 0.95); border-color: #38bdf8; color: #fff; box-shadow: 0 0 24px rgba(56,189,248,0.45); transform: translateY(-2px); }
.btn:active { transform: translateY(1px); }
.btn.active { background: #0284c7; color: #fff; border-color: #e0f2fe; box-shadow: 0 0 28px rgba(56,189,248,0.8); }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="hud-overlay">
  <div class="header">
    <div class="sub-title">Dark Singularity Array</div>
    <div class="main-title">Aether Vortex Siphon</div>
  </div>
  <div class="core-telemetry">
    <div class="telemetry-val" id="chargeVal">0.0%</div>
    <div class="telemetry-label" id="tierLabel">Storage Primed</div>
  </div>
  <div class="controls">
    <button class="btn" onclick="injectMotes(30)">✦ Siphon Stream (+5%)</button>
    <button class="btn" onclick="injectMotes(120)">⚡ Solar Surge (+25%)</button>
    <button class="btn" onclick="dischargeNova()">💥 Overcharge Nova</button>
    <button class="btn" id="siphonToggle" onclick="toggleContinuous()">🌀 Auto-Siphon</button>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const chargeValEl = document.getElementById('chargeVal'), tierLabelEl = document.getElementById('tierLabel');
let W, H, cx, cy, particles = [], shockwaves = [], arcs = [];
let charge = 0, isAuto = false, autoInterval = null, audioCtx = null;

function playSiphonTone(freq = 240, duration = 0.25) {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'sine'; osc.frequency.setValueAtTime(freq, t);
    osc.frequency.exponentialRampToValueAtTime(freq * 1.8, t + duration);
    gain.gain.setValueAtTime(0.08, t); gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
    osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(t); osc.stop(t + duration);
  } catch(e) {}
}

function playNovaExplosion() {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'sawtooth'; osc.frequency.setValueAtTime(140, t);
    osc.frequency.exponentialRampToValueAtTime(32, t + 1.2);
    gain.gain.setValueAtTime(0.3, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 1.2);
    osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(t); osc.stop(t + 1.2);
  } catch(e) {}
}

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight;
  cx = W / 2; cy = H / 2;
}
window.addEventListener('resize', resize);
resize();

function injectMotes(count = 30) {
  for (let i = 0; i < count; i++) {
    const angle = Math.random() * Math.PI * 2, dist = Math.min(W, H) * (0.35 + Math.random() * 0.25);
    particles.push({
      x: cx + Math.cos(angle) * dist, y: cy + Math.sin(angle) * dist,
      angle, radius: dist, speed: 1.8 + Math.random() * 3.2,
      angularVel: (0.015 + Math.random() * 0.02) * (Math.random() > 0.5 ? 1 : -1),
      size: 1.5 + Math.random() * 2.5, hue: Math.random() > 0.4 ? 195 : 275
    });
  }
  playSiphonTone(180 + charge * 3, 0.15);
}

function dischargeNova() {
  if (charge < 10) return;
  shockwaves.push({ r: 40, maxR: Math.max(W, H) * 0.75, alpha: 1 });
  playNovaExplosion();
  charge = 0; tierLabelEl.textContent = 'Energy Discharged';
}

function toggleContinuous() {
  isAuto = !isAuto;
  document.getElementById('siphonToggle').classList.toggle('active', isAuto);
  if (isAuto) autoInterval = setInterval(() => injectMotes(10), 220);
  else clearInterval(autoInterval);
}

function updateArcs() {
  if (Math.random() < charge / 80) {
    const a1 = Math.random() * Math.PI * 2, r1 = 30 + (charge / 100) * 45;
    arcs.push({
      x1: cx + Math.cos(a1) * r1, y1: cy + Math.sin(a1) * r1,
      x2: cx + Math.cos(a1 + 0.6) * (r1 + 25), y2: cy + Math.sin(a1 + 0.6) * (r1 + 25), life: 5
    });
  }
  for (let i = arcs.length - 1; i >= 0; i--) if (--arcs[i].life <= 0) arcs.splice(i, 1);
}

function draw() {
  ctx.fillStyle = 'rgba(3, 3, 10, 0.22)';
  ctx.fillRect(0, 0, W, H);

  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.radius -= p.speed; p.angle += p.angularVel;
    p.x = cx + Math.cos(p.angle) * p.radius; p.y = cy + Math.sin(p.angle) * p.radius;
    if (p.radius <= 35) { charge = Math.min(100, charge + 0.12); particles.splice(i, 1); continue; }
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fillStyle = `hsl(${p.hue}, 90%, 65%)`; ctx.shadowColor = ctx.fillStyle; ctx.shadowBlur = 8; ctx.fill();
  }

  const coreR = 30 + (charge / 100) * 35, pulse = Math.sin(Date.now() * 0.005) * 3;
  ctx.save();
  ctx.beginPath(); ctx.arc(cx, cy, 75 + pulse, 0, Math.PI * 2);
  ctx.strokeStyle = 'rgba(56,189,248,0.2)'; ctx.lineWidth = 2; ctx.stroke();

  ctx.beginPath(); ctx.arc(cx, cy, 75 + pulse, -Math.PI / 2, -Math.PI / 2 + (Math.PI * 2 * (charge / 100)));
  ctx.strokeStyle = charge > 80 ? '#f43f5e' : (charge > 40 ? '#a855f7' : '#38bdf8');
  ctx.lineWidth = 4; ctx.shadowColor = ctx.strokeStyle; ctx.shadowBlur = 14; ctx.stroke();

  const grad = ctx.createRadialGradient(cx, cy, 5, cx, cy, coreR);
  grad.addColorStop(0, '#ffffff');
  grad.addColorStop(0.3, charge > 80 ? '#fb7185' : (charge > 40 ? '#c084fc' : '#38bdf8'));
  grad.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = grad;
  ctx.beginPath(); ctx.arc(cx, cy, coreR + pulse, 0, Math.PI * 2); ctx.fill();
  ctx.restore();

  updateArcs();
  ctx.strokeStyle = '#e0f2fe'; ctx.lineWidth = 1.5;
  for (const arc of arcs) {
    ctx.beginPath(); ctx.moveTo(arc.x1, arc.y1);
    ctx.lineTo((arc.x1 + arc.x2) / 2 + (Math.random() - 0.5) * 12, (arc.y1 + arc.y2) / 2 + (Math.random() - 0.5) * 12);
    ctx.lineTo(arc.x2, arc.y2); ctx.stroke();
  }

  for (let i = shockwaves.length - 1; i >= 0; i--) {
    const sw = shockwaves[i]; sw.r += 14; sw.alpha -= 0.025;
    if (sw.alpha <= 0) { shockwaves.splice(i, 1); continue; }
    ctx.save(); ctx.beginPath(); ctx.arc(cx, cy, sw.r, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(240, 249, 255, ${sw.alpha})`; ctx.lineWidth = 4;
    ctx.shadowColor = '#38bdf8'; ctx.shadowBlur = 20; ctx.stroke(); ctx.restore();
  }

  chargeValEl.textContent = `${charge.toFixed(1)}%`;
  tierLabelEl.textContent = charge >= 100 ? 'CRITICAL OVERCHARGE' : (charge > 50 ? 'Hyper-Siphoning Active' : 'Storage Primed');
  tierLabelEl.style.color = charge >= 100 ? '#f43f5e' : (charge > 50 ? '#c084fc' : '#7dd3fc');
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>