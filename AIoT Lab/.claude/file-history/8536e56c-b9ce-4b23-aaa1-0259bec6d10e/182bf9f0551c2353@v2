<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Neural Lattice · Synaptic Neuroplasticity</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #02070d; font-family: 'Segoe UI', system-ui, sans-serif;
  color: #cffafe; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }
.hud {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  padding: 24px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 11px; letter-spacing: .35em; text-transform: uppercase; color: #06b6d4; font-weight: 700; margin-bottom: 2px; }
.main-title { font-size: 20px; font-weight: 800; letter-spacing: .12em; color: #ecfeff; text-shadow: 0 0 16px rgba(6,182,212,0.5); }
.neuro-stats {
  position: absolute; left: 30px; top: 50%; transform: translateY(-50%);
  background: rgba(4, 18, 30, 0.85); border: 1.5px solid rgba(6,182,212,0.35);
  border-radius: 14px; padding: 18px 22px; display: flex; flex-direction: column; gap: 8px;
  pointer-events: auto; min-width: 220px; box-shadow: 0 0 24px rgba(0,0,0,0.6);
}
.stat-lbl { font-size: 10px; letter-spacing: .2em; color: #67e8f9; text-transform: uppercase; }
.stat-hrs { font-size: 32px; font-weight: 900; font-family: monospace; color: #fff; text-shadow: 0 0 14px rgba(6,182,212,0.8); }
.stat-tier { font-size: 11px; font-weight: 700; color: #22d3ee; letter-spacing: .08em; }
.controls { pointer-events: auto; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; width: 100%; }
.btn {
  min-height: 52px; padding: 0 22px; background: rgba(8, 26, 42, 0.85);
  border: 1.5px solid rgba(6,182,212,0.35); border-radius: 12px; color: #a5f3fc;
  font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  cursor: pointer; transition: all .15s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
}
.btn:hover { background: #0e3b5e; border-color: #22d3ee; color: #fff; box-shadow: 0 0 24px rgba(6,182,212,0.5); transform: translateY(-2px); }
.btn:active { transform: translateY(1px); }
.btn.active { background: #0891b2; border-color: #cffafe; color: #fff; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="hud">
  <div class="header">
    <div class="sub-title">Cerebral Neuroplastic Rewiring</div>
    <div class="main-title">The Synaptic Dendrite Lattice</div>
  </div>
  <div class="neuro-stats">
    <span class="stat-lbl">Synaptic Practice</span>
    <span class="stat-hrs" id="hoursVal">0 h</span>
    <span class="stat-tier" id="tierVal">Unmyelinated Soma</span>
  </div>
  <div class="controls">
    <button class="btn" onclick="bankHours(10)">🧠 Deliberate Drill (+10h)</button>
    <button class="btn" onclick="bankHours(100)">⚡ Skill Imprint (+100h)</button>
    <button class="btn" onclick="bankHours(1000)">🌐 Myelin Surge (+1,000h)</button>
    <button class="btn" id="synapseBtn" onclick="toggleFlow()">🧬 Continuous Plasticity</button>
    <button class="btn" onclick="resetHours()">🔄 Reset Cortex</button>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const hoursValEl = document.getElementById('hoursVal'), tierValEl = document.getElementById('tierVal');
let W, H, cx, cy, hours = 0, targetHours = 0, nodes = [], signals = [], isFlowing = false, flowTimer = null, audioCtx = null;
const MAX_HOURS = 10000;

function playSynapseClick() {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'sine'; osc.frequency.setValueAtTime(800 + (hours / MAX_HOURS) * 600, t);
    gain.gain.setValueAtTime(0.04, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
    osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(t); osc.stop(t + 0.05);
  } catch(e) {}
}

function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; cx = W / 2; cy = H / 2; initTree(); }
function initTree() {
  nodes = [{ x: cx, y: cy, parent: null, depth: 0, children: [] }];
}
window.addEventListener('resize', resize);
resize();

function bankHours(n) {
  targetHours = Math.min(MAX_HOURS, targetHours + n);
  growLattice();
  playSynapseClick();
}

function toggleFlow() {
  isFlowing = !isFlowing;
  document.getElementById('synapseBtn').classList.toggle('active', isFlowing);
  if (isFlowing) flowTimer = setInterval(() => bankHours(8), 120);
  else clearInterval(flowTimer);
}
function resetHours() { targetHours = 0; hours = 0; signals = []; initTree(); }

function growLattice() {
  if (nodes.length > 280) return;
  const parent = nodes[Math.floor(Math.random() * nodes.length)];
  const angle = Math.random() * Math.PI * 2;
  const dist = 25 + Math.random() * 35;
  const newNode = {
    x: parent.x + Math.cos(angle) * dist,
    y: parent.y + Math.sin(angle) * dist,
    parent, depth: parent.depth + 1, children: []
  };
  parent.children.push(newNode);
  nodes.push(newNode);
  signals.push({ from: parent, to: newNode, progress: 0 });
}

function draw() {
  ctx.fillStyle = 'rgba(2, 7, 13, 0.22)'; ctx.fillRect(0, 0, W, H);
  hours += (targetHours - hours) * 0.08;
  const rounded = Math.round(hours);
  hoursValEl.textContent = `${rounded.toLocaleString()} h`;

  if (hours >= 10000) tierValEl.textContent = '🌟 TRANSCENDENT COGNITIVE COHERENCE';
  else if (hours >= 7500) tierValEl.textContent = '🔮 Intuitive Synthesis (7,500h+)';
  else if (hours >= 5000) tierValEl.textContent = '⚡ Hyper-Myelinated Complex (5,000h+)';
  else if (hours >= 2500) tierValEl.textContent = '🧬 Dense Dendrite Arbor (2,500h+)';
  else if (hours >= 1000) tierValEl.textContent = '🌱 Synaptic Sprout (1,000h+)';
  else tierValEl.textContent = 'Unmyelinated Soma';

  // Draw Axon Connections
  ctx.strokeStyle = 'rgba(6, 182, 212, 0.25)'; ctx.lineWidth = 1.2;
  for (let i = 1; i < nodes.length; i++) {
    const n = nodes[i];
    ctx.beginPath(); ctx.moveTo(n.parent.x, n.parent.y); ctx.lineTo(n.x, n.y); ctx.stroke();
  }

  // Draw Signals
  for (let i = signals.length - 1; i >= 0; i--) {
    const s = signals[i]; s.progress += 0.05;
    const px = s.from.x + (s.to.x - s.from.x) * s.progress;
    const py = s.from.y + (s.to.y - s.from.y) * s.progress;
    ctx.beginPath(); ctx.arc(px, py, 3, 0, Math.PI * 2);
    ctx.fillStyle = '#67e8f9'; ctx.shadowColor = '#06b6d4'; ctx.shadowBlur = 10; ctx.fill();
    if (s.progress >= 1) signals.splice(i, 1);
  }

  // Draw Synaptic Nodes
  for (const n of nodes) {
    ctx.beginPath(); ctx.arc(n.x, n.y, n.depth === 0 ? 8 : 3, 0, Math.PI * 2);
    ctx.fillStyle = n.depth === 0 ? '#ecfeff' : '#0891b2';
    ctx.shadowColor = '#06b6d4'; ctx.shadowBlur = n.depth === 0 ? 20 : 6;
    ctx.fill();
  }

  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>