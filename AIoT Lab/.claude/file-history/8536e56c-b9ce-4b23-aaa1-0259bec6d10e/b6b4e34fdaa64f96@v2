<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Resource Accumulation Matrix · Faust Design Sandbox</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #06050b; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  color: #f3f4f6; user-select: none;
}
.app-container {
  display: flex; width: 100%; height: 100%; position: relative;
}

/* ── Left Navigation Drawer (Full-Surface Targets) ── */
.sidebar {
  width: 320px; height: 100%; background: #0c0a14;
  border-right: 1px solid rgba(255,255,255,0.08);
  display: flex; flex-direction: column; z-index: 20;
  box-shadow: 4px 0 24px rgba(0,0,0,0.6);
}
.brand-header {
  padding: 24px 20px; border-bottom: 1px solid rgba(255,255,255,0.06);
}
.brand-sub {
  font-size: 10px; letter-spacing: .25em; text-transform: uppercase;
  color: #a855f7; font-weight: 700; margin-bottom: 2px;
}
.brand-title {
  font-size: 18px; font-weight: 800; letter-spacing: .08em;
  color: #fff; text-shadow: 0 0 16px rgba(168,85,247,0.4);
}

.nav-list {
  flex: 1; overflow-y: auto; padding: 14px 12px;
  display: flex; flex-direction: column; gap: 8px;
}
.nav-item {
  min-height: 54px; width: 100%; padding: 0 16px;
  background: rgba(255,255,255,0.02); border: 1.5px solid transparent;
  border-radius: 12px; cursor: pointer; text-align: left;
  display: flex; align-items: center; gap: 12px;
  transition: all .15s ease; color: #d1d5db;
}
.nav-item:hover {
  background: rgba(255,255,255,0.06); border-color: rgba(168,85,247,0.3);
  color: #fff; transform: translateX(3px);
}
.nav-item.active {
  background: linear-gradient(90deg, rgba(168,85,247,0.18), rgba(168,85,247,0.04));
  border-color: #a855f7; color: #fff;
  box-shadow: 0 0 18px rgba(168,85,247,0.25);
}
.nav-icon {
  font-size: 20px; width: 28px; text-align: center;
}
.nav-meta { display: flex; flex-direction: column; }
.nav-name { font-size: 13px; font-weight: 700; letter-spacing: .02em; }
.nav-desc { font-size: 10px; color: #9ca3af; }

/* ── Telemetry Status Footer ── */
.sidebar-footer {
  padding: 16px; border-top: 1px solid rgba(255,255,255,0.06);
  display: flex; flex-direction: column; gap: 4px;
}
.footer-row {
  display: flex; justify-content: space-between; font-size: 11px;
  font-family: monospace; color: #9ca3af;
}
.footer-row span:last-child { color: #4ade80; font-weight: 700; }

/* ── Main Canvas Viewport ── */
.viewport-frame {
  flex: 1; height: 100%; position: relative; background: #000;
}
iframe {
  width: 100%; height: 100%; border: none; display: block;
}
.top-actions {
  position: absolute; top: 18px; right: 20px; z-index: 30;
  display: flex; gap: 10px;
}
.action-btn {
  min-height: 44px; padding: 0 18px;
  background: rgba(12, 10, 20, 0.85); border: 1px solid rgba(255,255,255,0.2);
  border-radius: 8px; color: #e5e7eb; font-size: 11px; font-weight: 700;
  letter-spacing: .1em; text-transform: uppercase; cursor: pointer;
  transition: all .15s ease; backdrop-filter: blur(8px);
}
.action-btn:hover {
  background: #a855f7; border-color: #c084fc; color: #fff;
  box-shadow: 0 0 20px rgba(168,85,247,0.5);
}
</style>
</head>
<body>
<div class="app-container">
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="brand-header">
      <div class="brand-sub">Faust System Design</div>
      <div class="brand-title">Accumulation Matrix</div>
    </div>

    <nav class="nav-list" id="navList"></nav>

    <div class="sidebar-footer">
      <div class="footer-row">
        <span>ENGINE:</span>
        <span>HTML5 CANVAS + AUDIO</span>
      </div>
      <div class="footer-row">
        <span>FRAME RATE:</span>
        <span>60.0 FPS LOCKED</span>
      </div>
      <div class="footer-row">
        <span>SOVEREIGN VAULT:</span>
        <span>DISK D: VERIFIED</span>
      </div>
    </div>
  </aside>

  <!-- Viewport -->
  <main class="viewport-frame">
    <div class="top-actions">
      <button class="action-btn" onclick="openFullscreen()">⛶ Fullscreen Active</button>
      <button class="action-btn" onclick="openInNewTab()">↗ Open File</button>
    </div>
    <iframe id="engineFrame" src="accum_001_kinetic_coins.html"></iframe>
  </main>
</div>

<script>
const MODULES = [
  {
    id: 'coins',
    file: 'accum_001_kinetic_coins.html',
    name: 'Kinetic Coin & Gem Magnet',
    desc: 'Arcade Parabolic Burst & Ease-In Pull',
    icon: '💰'
  },
  {
    id: 'aether',
    file: 'accum_002_aether_siphon.html',
    name: 'Aether Vortex Siphon',
    desc: 'Logarithmic Spiral Singularity Harvester',
    icon: '🌀'
  },
  {
    id: 'fluid',
    file: 'accum_003_fluid_manifold.html',
    name: 'Volumetric Fluid Manifold',
    desc: 'Spring-Damper Wave Liquid Tank',
    icon: '🧪'
  },
  {
    id: 'celestial',
    file: 'accum_004_celestial_nexus.html',
    name: 'Celestial Nexus & Runes',
    desc: 'Sacred Constellation Alignment Network',
    icon: '⭐'
  },
  {
    id: 'cyber',
    file: 'accum_005_cyber_buffer.html',
    name: 'Cybernetic Packet Buffer',
    desc: 'Vector Field Data Stream Accelerator',
    icon: '💾'
  },
  {
    id: 'crucible',
    file: 'accum_006_plasma_crucible.html',
    name: 'Plasma Crucible Smelter',
    desc: 'Thermonuclear Ingot Forge & Stamp',
    icon: '🔥'
  }
];

let activeIdx = 0;
const navListEl = document.getElementById('navList');
const frameEl = document.getElementById('engineFrame');

function renderNav() {
  navListEl.innerHTML = '';
  MODULES.forEach((mod, idx) => {
    const btn = document.createElement('button');
    btn.className = `nav-item ${idx === activeIdx ? 'active' : ''}`;
    btn.onclick = () => selectModule(idx);
    btn.innerHTML = `
      <span class="nav-icon">${mod.icon}</span>
      <div class="nav-meta">
        <span class="nav-name">${mod.name}</span>
        <span class="nav-desc">${mod.desc}</span>
      </div>
    `;
    navListEl.appendChild(btn);
  });
}

function selectModule(idx) {
  activeIdx = idx;
  frameEl.src = MODULES[idx].file;
  renderNav();
}

function openFullscreen() {
  if (frameEl.requestFullscreen) frameEl.requestFullscreen();
  else if (frameEl.webkitRequestFullscreen) frameEl.webkitRequestFullscreen();
}

function openInNewTab() {
  window.open(MODULES[activeIdx].file, '_blank');
}

renderNav();
</script>
</body>
</html>