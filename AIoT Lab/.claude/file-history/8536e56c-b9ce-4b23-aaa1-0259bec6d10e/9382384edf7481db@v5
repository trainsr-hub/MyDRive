<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chrono Matrix · Spam-Friendly Cyber Defrag</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #01080e; font-family: 'Consolas', 'Courier New', monospace;
  color: #00f0ff; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }
.hud-layer {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  align-items: center; padding: 26px 20px 24px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 10px; letter-spacing: .35em; text-transform: uppercase; color: #00f0ff; opacity: .8; }
.main-title { font-size: 18px; font-weight: 800; letter-spacing: .12em; color: #e0faff; text-shadow: 0 0 16px rgba(0,240,255,0.6); }

.pool-vault {
  pointer-events: auto; display: flex; align-items: center; gap: 14px;
  background: rgba(2, 18, 30, 0.9); border: 1.5px solid #00f0ff;
  border-radius: 12px; padding: 12px 24px; margin-top: 8px;
  box-shadow: 0 0 24px rgba(0,240,255,0.3); transition: transform .1s ease, border-color .1s ease;
}
.pool-vault.absorb { transform: scale(1.05); border-color: #fff; box-shadow: 0 0 36px rgba(0,240,255,0.8); }
.vault-icon {
  width: 42px; height: 42px; border-radius: 8px; background: #002b47; border: 1.5px solid #00f0ff;
  display: flex; align-items: center; justify-content: center; font-size: 20px; color: #00f0ff;
}
.vault-meta { display: flex; flex-direction: column; }
.vault-lbl { font-size: 9px; letter-spacing: .2em; color: #5eead4; text-transform: uppercase; }
.vault-val { font-size: 28px; font-weight: 900; color: #fff; text-shadow: 0 0 12px rgba(0,240,255,0.7); }

/* ── Non-Blocking Lingering Toast Notification Stack Below Voxel ── */
.toast-stack {
  position: absolute; top: calc(50% + 55px); left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column-reverse; align-items: center; gap: 6px;
  pointer-events: none; z-index: 15; width: 300px;
}
.worth-toast {
  padding: 6px 18px; border-radius: 8px;
  background: rgba(2, 24, 38, 0.92); border: 1.5px solid rgba(0,240,255,0.5);
  box-shadow: 0 4px 20px rgba(0,0,0,0.6), 0 0 16px rgba(0,240,255,0.3);
  display: flex; align-items: center; gap: 8px; font-family: inherit;
  font-size: 16px; font-weight: 900; color: #5eead4; text-shadow: 0 0 10px rgba(94,234,212,0.7);
  animation: toastFade 2.2s cubic-bezier(.16,1,.3,1) forwards;
}
.toast-tag { font-size: 9px; letter-spacing: .2em; text-transform: uppercase; color: #00f0ff; }
@keyframes toastFade {
  0% { opacity: 0; transform: translateY(14px) scale(0.85); }
  12% { opacity: 1; transform: translateY(0) scale(1.04); }
  22% { transform: scale(1); }
  75% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-16px) scale(0.92); }
}

.controls { pointer-events: auto; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; width: 100%; max-width: 860px; }
.btn {
  min-height: 52px; padding: 0 22px; background: #021422; border: 1.5px solid #00f0ff;
  border-radius: 8px; color: #00f0ff; font-family: inherit; font-size: 12px; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: all .1s ease;
  box-shadow: 0 0 16px rgba(0,240,255,0.2); display: flex; align-items: center; justify-content: center; gap: 6px;
}
.btn:hover { background: #00f0ff; color: #01080e; box-shadow: 0 0 28px rgba(0,240,255,0.7); transform: translateY(-2px); }
.btn:active { transform: scale(0.95); background: #38bdf8; color: #01080e; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="hud-layer">
  <div class="header">
    <div class="sub-title">Neural Cyber-Voxel Matrix</div>
    <div class="main-title">Chrono Buffer Ingestion & Nanite Stream</div>
    <div class="pool-vault" id="poolVault">
      <div class="vault-icon">💾</div>
      <div class="vault-meta">
        <span class="vault-lbl">Mainframe Vault Ledger</span>
        <span class="vault-val" id="poolVal">0s</span>
      </div>
    </div>
  </div>

  <div class="toast-stack" id="toastStack"></div>

  <div class="controls">
    <button class="btn" onclick="depositSession(1800)">Compile 30m</button>
    <button class="btn" onclick="depositSession(7200)">Compile 2h</button>
    <button class="btn" onclick="depositSession(21600)">Compile 6h</button>
    <button class="btn" onclick="resetAll()">Reset</button>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const poolVaultEl = document.getElementById('poolVault'), poolValEl = document.getElementById('poolVal');
const toastStackEl = document.getElementById('toastStack');
let W, H, cx, cy, targetX = 0, targetY = 0, permanentSec = 0, displayPermanentSec = 0;
let voxelPulse = 0, screenShake = 0, bits = [], audioCtx = null;

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; cx = W / 2; cy = H / 2 - 25;
  const r = poolVaultEl.getBoundingClientRect(); targetX = r.left + r.width / 2; targetY = r.top + r.height / 2;
}
window.addEventListener('resize', resize);
resize();

function formatDuration(sec) {
  if (!sec || isNaN(sec) || sec < 0) return '0s';
  let s = Math.floor(sec);
  const Y = Math.floor(s / 31536000); s %= 31536000;
  const M = Math.floor(s / 2592000); s %= 2592000;
  const D = Math.floor(s / 86400); s %= 86400;
  const h = Math.floor(s / 3600); s %= 3600;
  const m = Math.floor(s / 60); const rem = s % 60;
  const p = [];
  if (Y > 0) p.push(`${Y}Y`); if (M > 0) p.push(`${M}M`); if (D > 0) p.push(`${D}D`);
  if (h > 0) p.push(`${h}h`); if (m > 0) p.push(`${m}m`); if (rem > 0 || p.length === 0) p.push(`${rem}s`);
  return p.join('');
}

function initAudio() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  if (audioCtx.state === 'suspended') audioCtx.resume();
}

function playCyberChirp(freq) {
  try {
    initAudio();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'square'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.04, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + 0.03); osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(t); osc.stop(t + 0.03);
  } catch(e) {}
}

function playDefragBoom() {
  try {
    initAudio();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'sawtooth'; osc.frequency.setValueAtTime(240, t); osc.frequency.exponentialRampToValueAtTime(30, t + 0.4);
    gain.gain.setValueAtTime(0.4, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
    osc.connect(gain); gain.connect(audioCtx.destination); osc.start(t); osc.stop(t + 0.4);
  } catch(e) {}
}

function depositSession(seconds) {
  playDefragBoom();
  screenShake = Math.min(30, screenShake + 8 + (seconds / 3600) * 3);
  voxelPulse = 28;

  spawnWorthToast(formatDuration(seconds));

  const pCount = Math.min(180, Math.max(40, Math.floor(seconds / 90)));
  const secPerP = seconds / pCount;
  for (let i = 0; i < pCount; i++) {
    const angle = Math.random() * Math.PI * 2, burstSpeed = 5 + Math.random() * 16;
    bits.push({
      x: cx, y: cy, vx: Math.cos(angle) * burstSpeed, vy: Math.sin(angle) * burstSpeed,
      secVal: secPerP, age: 0, magnetWait: 12 + Math.random() * 16,
      char: Math.random() > 0.5 ? '1' : '0'
    });
  }
}

function spawnWorthToast(durText) {
  const toast = document.createElement('div');
  toast.className = 'worth-toast';
  toast.innerHTML = `<span class="toast-tag">DEFRAG WORTH</span><span>${durText}</span>`;
  toastStackEl.appendChild(toast);
  setTimeout(() => toast.remove(), 2200);
}

function resetAll() {
  permanentSec = 0; displayPermanentSec = 0; bits = []; screenShake = 0;
  toastStackEl.innerHTML = ''; poolValEl.textContent = '0s';
}

function draw() {
  ctx.save();
  if (screenShake > 0) {
    ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
    screenShake *= 0.88; if (screenShake < 0.2) screenShake = 0;
  }
  ctx.fillStyle = 'rgba(1, 8, 14, 0.28)'; ctx.fillRect(-20, -20, W + 40, H + 40);

  ctx.strokeStyle = 'rgba(0, 240, 255, 0.06)'; ctx.lineWidth = 1;
  for (let x = 0; x < W; x += 50) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }

  if (voxelPulse > 0) voxelPulse *= 0.88;
  const boxSize = 56 + voxelPulse;
  ctx.save(); ctx.translate(cx, cy); ctx.rotate(Date.now() * 0.002);
  ctx.strokeStyle = voxelPulse > 5 ? '#fff' : '#00f0ff'; ctx.lineWidth = 2; ctx.shadowColor = '#00f0ff'; ctx.shadowBlur = 18 + voxelPulse;
  ctx.strokeRect(-boxSize / 2, -boxSize / 2, boxSize, boxSize);
  ctx.fillStyle = voxelPulse > 5 ? 'rgba(255,255,255,0.4)' : 'rgba(0, 240, 255, 0.25)';
  ctx.fillRect(-boxSize / 2 + 6, -boxSize / 2 + 6, boxSize - 12, boxSize - 12);
  ctx.restore();

  ctx.font = '12px Consolas, monospace';
  for (let i = bits.length - 1; i >= 0; i--) {
    const p = bits[i]; p.age++;
    if (p.age < p.magnetWait) {
      p.x += p.vx; p.y += p.vy; p.vx *= 0.93; p.vy *= 0.93;
    } else {
      const dx = targetX - p.x, dy = targetY - p.y, dist = Math.hypot(dx, dy);
      if (dist < 26) {
        permanentSec += p.secVal; poolVaultEl.classList.add('absorb');
        setTimeout(() => poolVaultEl.classList.remove('absorb'), 70);
        playCyberChirp(900 + (p.age % 10) * 80);
        bits.splice(i, 1); continue;
      }
      const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95);
      p.vx = (dx / dist) * pull; p.vy = (dy / dist) * pull;
      p.x += p.vx; p.y += p.vy;
    }
    ctx.fillStyle = '#5eead4'; ctx.shadowColor = '#00f0ff'; ctx.shadowBlur = 8;
    ctx.fillText(p.char, p.x, p.y);
  }

  if (displayPermanentSec < permanentSec) {
    displayPermanentSec += Math.ceil((permanentSec - displayPermanentSec) * 0.2);
    poolValEl.textContent = formatDuration(displayPermanentSec);
  }
  ctx.restore();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>