<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chrono Spool & Shatter · Explosion Worth Standard</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: radial-gradient(circle at 50% 45%, #0d0818 0%, #030206 100%);
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #fff; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }

.hud-layer {
  position: fixed; inset: 0; pointer-events: none; display: flex; flex-direction: column;
  justify-content: space-between; align-items: center; padding: 26px 20px 24px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 10px; letter-spacing: .35em; text-transform: uppercase; color: #fbbf24; font-weight: 700; }
.main-title { font-size: 18px; font-weight: 800; letter-spacing: .12em; color: #fff; text-shadow: 0 0 16px rgba(251,191,36,0.35); }
.pool-vault {
  pointer-events: auto; display: flex; align-items: center; gap: 14px;
  background: rgba(14, 10, 24, 0.9); border: 1.5px solid rgba(251,191,36,0.4);
  border-radius: 16px; padding: 12px 24px; margin-top: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.7), 0 0 24px rgba(251,191,36,0.2);
  transition: transform .1s ease, border-color .1s ease;
}
.pool-vault.absorb { transform: scale(1.05); border-color: #fde047; box-shadow: 0 0 36px rgba(251,191,36,0.7); }
.vault-icon {
  width: 42px; height: 42px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fef08a, #ca8a04);
  box-shadow: 0 0 16px rgba(250,204,21,0.8); display: flex; align-items: center; justify-content: center;
  font-size: 20px; font-weight: 900; color: #78350f;
}
.vault-meta { display: flex; flex-direction: column; }
.vault-lbl { font-size: 9px; letter-spacing: .2em; color: #a1a1aa; text-transform: uppercase; }
.vault-val { font-size: 28px; font-weight: 900; font-family: 'Consolas', monospace; color: #fef08a; text-shadow: 0 0 14px rgba(254,240,138,0.5); }

/* ── Value Display Positioned Cleanly Below Block ── */
.burst-yield-container {
  position: absolute; top: calc(50% + 68px); left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 2px; pointer-events: none;
}
.yield-lbl {
  font-size: 10px; font-family: monospace; letter-spacing: .25em; text-transform: uppercase;
  color: #64748b; font-weight: 700; transition: color .2s ease;
}
.yield-lbl.active { color: #f59e0b; text-shadow: 0 0 10px rgba(245,158,11,0.8); }
.spool-odometer {
  font-size: 24px; font-weight: 900; font-family: 'Consolas', monospace;
  color: #d1d5db; letter-spacing: .08em; transition: all .2s ease;
}
.spool-odometer.lingering {
  font-size: 28px; color: #fef08a; text-shadow: 0 0 20px rgba(254,240,138,0.9), 0 0 35px rgba(245,158,11,0.6);
  transform: scale(1.06);
}
.controls { pointer-events: auto; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; width: 100%; max-width: 860px; }
.btn {
  min-height: 52px; padding: 0 24px; background: rgba(18, 12, 30, 0.9);
  border: 1.5px solid rgba(251,191,36,0.35); border-radius: 12px; color: #fef08a;
  font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  cursor: pointer; transition: all .15s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center; gap: 6px;
}
.btn:hover:not(:disabled) { background: #2b1845; border-color: #fde047; color: #fff; box-shadow: 0 0 24px rgba(251,191,36,0.5); transform: translateY(-2px); }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn:disabled { opacity: 0.35; cursor: not-allowed; }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div class="hud-layer">
  <div class="header">
    <div class="sub-title">Kinetic Burst & Ingestion</div>
    <div class="main-title">Chrono Compression & Instant Shatter</div>
    <div class="pool-vault" id="poolVault">
      <div class="vault-icon">⏳</div>
      <div class="vault-meta">
        <span class="vault-lbl">Accumulated Permanent Pool</span>
        <span class="vault-val" id="poolVal">0s</span>
      </div>
    </div>
  </div>

  <!-- Positioned cleanly BELOW the accumulating block -->
  <div class="burst-yield-container">
    <span class="yield-lbl" id="yieldLabel">STANDBY</span>
    <span class="spool-odometer" id="spoolOdometer">0s</span>
  </div>

  <div class="controls">
    <button class="btn" onclick="depositSession(1800)">Deposit 30m Session</button>
    <button class="btn" onclick="depositSession(7200)">Deposit 2h Session</button>
    <button class="btn" onclick="depositSession(21600)">Deposit 6h Session</button>
    <button class="btn" onclick="resetAll()">Reset</button>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const poolVaultEl = document.getElementById('poolVault'), poolValEl = document.getElementById('poolVal');
const yieldLabelEl = document.getElementById('yieldLabel'), spoolOdometerEl = document.getElementById('spoolOdometer');

let W, H, cx, cy, targetX = 0, targetY = 0, permanentSec = 0, displayPermanentSec = 0;
let phase = 'idle', currentSpoolSec = 0, targetSessionSec = 0, spoolProgress = 0;
let screenShake = 0, particles = [], shockwaves = [], arcs = [], audioCtx = null;

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight;
  cx = W / 2; cy = H / 2 - 15;
  const r = poolVaultEl.getBoundingClientRect(); targetX = r.left + r.width / 2; targetY = r.top + r.height / 2;
}
window.addEventListener('resize', resize);
resize();

function formatDuration(sec) {
  if (!sec || isNaN(sec) || sec < 0) return '0s';
  let s = Math.floor(sec);
  const Y = Math.floor(s / 31536000); s %= 31536000;
  const M = Math.floor(s / 2592000); s %= 2592000;
  const D = Math.floor(s / 86400); s %= 86400;
  const h = Math.floor(s / 3600); s %= 3600;
  const m = Math.floor(s / 60); const rem = s % 60;
  const p = [];
  if (Y > 0) p.push(`${Y}Y`); if (M > 0) p.push(`${M}M`); if (D > 0) p.push(`${D}D`);
  if (h > 0) p.push(`${h}h`); if (m > 0) p.push(`${m}m`); if (rem > 0 || p.length === 0) p.push(`${rem}s`);
  return p.join('');
}

function playSound(type, freq) {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    if (type === 'click') {
      osc.type = 'triangle'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.04, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.03); osc.start(t); osc.stop(t + 0.03);
    } else if (type === 'shatter') {
      osc.type = 'sawtooth'; osc.frequency.setValueAtTime(160, t); osc.frequency.exponentialRampToValueAtTime(28, t + 0.5);
      gain.gain.setValueAtTime(0.45, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.5); osc.start(t); osc.stop(t + 0.5);
    } else {
      osc.type = 'sine'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.04, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.06); osc.start(t); osc.stop(t + 0.06);
    }
    osc.connect(gain); gain.connect(audioCtx.destination);
  } catch(e) {}
}

function depositSession(totalSeconds) {
  if (phase !== 'idle') return;
  phase = 'spooling'; targetSessionSec = totalSeconds; currentSpoolSec = 0; spoolProgress = 0;
  yieldLabelEl.className = 'yield-lbl active'; yieldLabelEl.textContent = 'ACCUMULATING BURST';
  spoolOdometerEl.classList.remove('lingering');
  document.querySelectorAll('.btn').forEach(b => b.disabled = true);
}

// ── Immediate Shatter Detonation: Block disappears, final hours linger below ──
function triggerPhase2Shatter() {
  phase = 'shattering';
  playSound('shatter', 0);
  screenShake = Math.min(32, 10 + (targetSessionSec / 3600) * 4);
  shockwaves.push({ r: 25, maxR: Math.min(W, H) * 0.65, alpha: 1.0 });

  // Value below lingers proudly
  yieldLabelEl.className = 'yield-lbl active';
  yieldLabelEl.textContent = 'EXPLOSION WORTH';
  spoolOdometerEl.textContent = formatDuration(targetSessionSec);
  spoolOdometerEl.classList.add('lingering');

  // Block explodes instantly into particle swarm
  const pCount = Math.min(220, Math.max(45, Math.floor(targetSessionSec / 80)));
  const secPerP = targetSessionSec / pCount;
  for (let i = 0; i < pCount; i++) {
    const a = Math.random() * Math.PI * 2, sp = 5 + Math.random() * 16;
    particles.push({
      x: cx, y: cy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 2,
      secVal: secPerP, age: 0, magnetWait: 14 + Math.random() * 16,
      size: 3 + Math.random() * 3.5, color: Math.random() > 0.35 ? '#facc15' : '#38bdf8'
    });
  }
}

function resetAll() {
  phase = 'idle'; permanentSec = 0; displayPermanentSec = 0; currentSpoolSec = 0;
  particles = []; shockwaves = []; screenShake = 0; poolValEl.textContent = '0s';
  yieldLabelEl.className = 'yield-lbl'; yieldLabelEl.textContent = 'STANDBY';
  spoolOdometerEl.textContent = '0s'; spoolOdometerEl.classList.remove('lingering');
  document.querySelectorAll('.btn').forEach(b => b.disabled = false);
}

function draw() {
  ctx.save();
  if (screenShake > 0) {
    ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
    screenShake *= 0.88; if (screenShake < 0.2) screenShake = 0;
  }
  ctx.fillStyle = 'rgba(4, 2, 8, 0.28)'; ctx.fillRect(-20, -20, W + 40, H + 40);
  const t = Date.now() * 0.002;

  // Phase 1: Block Compresses & Numbers Spool Below
  if (phase === 'spooling') {
    spoolProgress += 0.035;
    currentSpoolSec = Math.round(targetSessionSec * Math.min(1.0, Math.pow(spoolProgress, 1.4)));
    spoolOdometerEl.textContent = formatDuration(currentSpoolSec);
    screenShake = 1.0 + spoolProgress * 8;
    playSound('click', 400 + spoolProgress * 700);

    // Inward Lightning Arcs
    if (Math.random() < 0.6) {
      const a = Math.random() * Math.PI * 2, d = 90 + Math.random() * 100;
      arcs.push({ x1: cx + Math.cos(a) * d, y1: cy + Math.sin(a) * d, x2: cx, y2: cy, life: 3 });
    }

    // The Central Accumulating Block (clean geometric core, no giant text inside)
    const blockR = 32 + spoolProgress * 32 + Math.sin(t * 16) * 3;
    ctx.beginPath(); ctx.arc(cx, cy, blockR, 0, Math.PI * 2);
    ctx.fillStyle = spoolProgress > 0.8 ? '#fef08a' : 'rgba(249, 115, 22, 0.45)';
    ctx.shadowColor = '#f97316'; ctx.shadowBlur = 20 + spoolProgress * 25; ctx.fill();

    // Reached peak -> Explode normally!
    if (spoolProgress >= 1.0) {
      triggerPhase2Shatter();
    }
  }

  // Draw Lightning Arcs
  ctx.strokeStyle = '#fde047'; ctx.lineWidth = 1.8;
  for (let i = arcs.length - 1; i >= 0; i--) {
    const a = arcs[i]; ctx.beginPath(); ctx.moveTo(a.x1, a.y1);
    ctx.lineTo((a.x1 + a.x2) / 2 + (Math.random() - 0.5) * 16, (a.y1 + a.y2) / 2 + (Math.random() - 0.5) * 16);
    ctx.lineTo(a.x2, a.y2); ctx.stroke();
    if (--a.life <= 0) arcs.splice(i, 1);
  }

  // Phase 2: Swarm to Permanent Pool (Block is gone, final hours linger below)
  if (phase === 'shattering') {
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i]; p.age++;
      if (p.age < p.magnetWait) {
        p.x += p.vx; p.y += p.vy; p.vx *= 0.94; p.vy *= 0.94;
      } else {
        const dx = targetX - p.x, dy = targetY - p.y, dist = Math.hypot(dx, dy);
        if (dist < 26) {
          permanentSec += p.secVal; poolVaultEl.classList.add('absorb');
          setTimeout(() => poolVaultEl.classList.remove('absorb'), 70);
          playSound('absorb', 880 + (p.age % 10) * 75);
          particles.splice(i, 1); continue;
        }
        const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95);
        p.vx = (dx / dist) * pull; p.vy = (dy / dist) * pull;
        p.x += p.vx; p.y += p.vy;
      }
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10; ctx.fill();
    }

    // All particles absorbed -> After short delay, reset yield label
    if (particles.length === 0) {
      phase = 'idle';
      setTimeout(() => {
        yieldLabelEl.className = 'yield-lbl'; yieldLabelEl.textContent = 'STANDBY';
        spoolOdometerEl.classList.remove('lingering');
        document.querySelectorAll('.btn').forEach(b => b.disabled = false);
      }, 1200);
    }
  }

  // Shockwaves
  for (let i = shockwaves.length - 1; i >= 0; i--) {
    const sw = shockwaves[i]; sw.r += 14; sw.alpha -= 0.035;
    if (sw.alpha <= 0) { shockwaves.splice(i, 1); continue; }
    ctx.beginPath(); ctx.arc(cx, cy, sw.r, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(254, 240, 138, ${sw.alpha})`; ctx.lineWidth = 4;
    ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 18; ctx.stroke();
  }

  // Smooth lerp permanent reservoir
  if (displayPermanentSec < permanentSec) {
    displayPermanentSec += Math.ceil((permanentSec - displayPermanentSec) * 0.2);
    poolValEl.textContent = formatDuration(displayPermanentSec);
  }
  ctx.restore();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>