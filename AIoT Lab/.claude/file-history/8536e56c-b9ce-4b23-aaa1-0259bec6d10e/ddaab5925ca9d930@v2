<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Supernova Core · Gravitational Collapse & Nucleosynthesis</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #020106; font-family: 'Segoe UI', system-ui, sans-serif;
  color: #fff; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }
.hud-layer {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  align-items: center; padding: 24px 20px 22px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 10px; letter-spacing: .35em; text-transform: uppercase; color: #f59e0b; font-weight: 700; margin-bottom: 2px; }
.main-title { font-size: 18px; font-weight: 800; letter-spacing: .12em; color: #fff; text-shadow: 0 0 16px rgba(245,158,11,0.4); }

.pool-vault {
  pointer-events: auto; display: flex; align-items: center; gap: 14px;
  background: rgba(14, 8, 22, 0.9); border: 1.5px solid rgba(251,191,36,0.4);
  border-radius: 16px; padding: 12px 24px; margin-top: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.7), 0 0 24px rgba(251,191,36,0.2);
  transition: transform .1s ease, border-color .1s ease;
}
.pool-vault.absorb { transform: scale(1.05); border-color: #fde047; box-shadow: 0 0 36px rgba(251,191,36,0.7); }
.vault-icon {
  width: 42px; height: 42px; border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #fef08a, #ca8a04);
  box-shadow: 0 0 16px rgba(250,204,21,0.8);
  display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; color: #78350f;
}
.vault-meta { display: flex; flex-direction: column; }
.vault-lbl { font-size: 9px; letter-spacing: .2em; color: #a1a1aa; text-transform: uppercase; }
.vault-val { font-size: 28px; font-weight: 900; font-family: 'Consolas', monospace; color: #fef08a; text-shadow: 0 0 14px rgba(254,240,138,0.5); }

.trigger-deck { pointer-events: auto; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.hold-btn {
  width: 250px; min-height: 64px; border-radius: 20px; cursor: pointer;
  background: linear-gradient(135deg, rgba(239,68,68,0.2), rgba(245,158,11,0.2));
  border: 2px solid rgba(239,68,68,0.5); color: #fef3c7;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 0 24px rgba(239,68,68,0.3); transition: transform .1s ease, border-color .15s ease;
}
.hold-btn:hover { border-color: #fde047; box-shadow: 0 0 32px rgba(245,158,11,0.5); }
.hold-btn.charging { transform: scale(0.96); border-color: #ffffff; box-shadow: 0 0 45px rgba(255,255,255,0.8); }
.btn-txt-main { font-size: 13px; font-weight: 900; letter-spacing: .15em; text-transform: uppercase; }
.btn-txt-sub { font-size: 10px; font-family: monospace; letter-spacing: .1em; color: #fde68a; opacity: 0.8; }
.preset-bar { display: flex; gap: 10px; }
.preset-btn {
  min-height: 44px; padding: 0 16px; border-radius: 10px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12);
  color: #d1d5db; font-size: 11px; font-weight: 700; font-family: monospace; cursor: pointer;
}
.preset-btn:hover { background: rgba(255,255,255,0.1); color: #fff; border-color: #f59e0b; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="hud-layer">
  <div class="header">
    <div class="sub-title">Astrophysical Accretion Engine</div>
    <div class="main-title">Supernova Core · Gravitational Collapse</div>
    <div class="pool-vault" id="poolVault">
      <div class="vault-icon">☀️</div>
      <div class="vault-meta">
        <span class="vault-lbl">Accumulated Permanent Pool</span>
        <span class="vault-val" id="poolVal">00:00:00</span>
      </div>
    </div>
  </div>

  <div class="trigger-deck">
    <div class="hold-btn" id="holdTrigger">
      <span class="btn-txt-main" id="btnMain">HOLD TO ACCRETE MASS</span>
      <span class="btn-txt-sub" id="btnSub">RELEASE TO DETONATE</span>
    </div>
    <div class="preset-bar">
      <button class="preset-btn" onclick="autoCharge(1800)">Auto +30m</button>
      <button class="preset-btn" onclick="autoCharge(7200)">Auto +2h</button>
      <button class="preset-btn" onclick="autoCharge(21600)">Auto +6h</button>
      <button class="preset-btn" onclick="resetAll()">Reset</button>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const poolVaultEl = document.getElementById('poolVault'), poolValEl = document.getElementById('poolVal');
const holdTriggerEl = document.getElementById('holdTrigger');
const btnMainEl = document.getElementById('btnMain'), btnSubEl = document.getElementById('btnSub');
let W, H, cx, cy, targetX = 0, targetY = 0, permanentSec = 0, displayPermanentSec = 0;
let isHolding = false, chargeSec = 0, screenShake = 0, phase = 'idle';
let particles = [], shockwaves = [], stellarArcs = [], audioCtx = null;

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; cx = W / 2; cy = H / 2 - 20;
  const r = poolVaultEl.getBoundingClientRect(); targetX = r.left + r.width / 2; targetY = r.top + r.height / 2;
}
window.addEventListener('resize', resize);
resize();

function formatHMS(sec) {
  const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = Math.floor(sec % 60);
  return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
}

function playPitchTone(freq, dur = 0.08) {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'sawtooth'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.08, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + dur); osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(t); osc.stop(t + dur);
  } catch(e) {}
}

function playSupernovaExplosion() {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'triangle'; osc.frequency.setValueAtTime(140, t); osc.frequency.exponentialRampToValueAtTime(24, t + 0.6);
    gain.gain.setValueAtTime(0.5, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.6);
    osc.connect(gain); gain.connect(audioCtx.destination); osc.start(t); osc.stop(t + 0.6);
  } catch(e) {}
}

['mousedown', 'touchstart'].forEach(e => holdTriggerEl.addEventListener(e, (ev) => {
  ev.preventDefault(); if (phase === 'supernova') return;
  isHolding = true; phase = 'collapse'; chargeSec = 0; holdTriggerEl.classList.add('charging');
}));
['mouseup', 'mouseleave', 'touchend'].forEach(e => holdTriggerEl.addEventListener(e, () => {
  if (isHolding && phase === 'collapse') { isHolding = false; holdTriggerEl.classList.remove('charging'); detonateSupernova(); }
}));

function autoCharge(sec) { if (phase === 'idle') { chargeSec = sec; detonateSupernova(); } }

function detonateSupernova() {
  if (chargeSec < 60) { phase = 'idle'; return; }
  phase = 'supernova'; playSupernovaExplosion();
  screenShake = Math.min(30, 8 + (chargeSec / 3600) * 4);
  shockwaves.push({ r: 25, maxR: Math.min(W, H) * 0.7, alpha: 1.0 });

  const pCount = Math.min(240, Math.max(40, Math.floor(chargeSec / 60)));
  const secPerP = chargeSec / pCount;
  for (let i = 0; i < pCount; i++) {
    const a = Math.random() * Math.PI * 2, sp = 5 + Math.random() * 18;
    particles.push({
      x: cx, y: cy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 2,
      secVal: secPerP, age: 0, magnetWait: 14 + Math.random() * 16,
      size: 2.5 + Math.random() * 3.5, color: Math.random() > 0.4 ? '#f59e0b' : '#ef4444'
    });
  }
  btnMainEl.textContent = 'STELLAR EXPANSION'; btnSubEl.textContent = 'INFUSING VAULT'; chargeSec = 0;
}

function resetAll() {
  permanentSec = 0; displayPermanentSec = 0; particles = []; shockwaves = [];
  phase = 'idle'; poolValEl.textContent = '00:00:00';
  btnMainEl.textContent = 'HOLD TO ACCRETE MASS'; btnSubEl.textContent = 'RELEASE TO DETONATE';
}

function draw() {
  ctx.save();
  if (screenShake > 0) {
    ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
    screenShake *= 0.88; if (screenShake < 0.2) screenShake = 0;
  }
  ctx.fillStyle = 'rgba(2, 1, 6, 0.28)'; ctx.fillRect(-20, -20, W + 40, H + 40);
  const t = Date.now() * 0.002;

  if (phase === 'collapse' && isHolding) {
    chargeSec += 90;
    const prog = Math.min(1.0, chargeSec / 21600);
    screenShake = 1.5 + prog * 10;
    btnMainEl.textContent = `COLLAPSING +${formatHMS(chargeSec)}`;
    btnSubEl.textContent = `CORE DENSITY: ${(prog * 100).toFixed(0)}%`;
    if (Math.random() < 0.3) playPitchTone(200 + prog * 900);

    if (Math.random() < 0.6) {
      const a = Math.random() * Math.PI * 2, r = 160 + Math.random() * 50;
      stellarArcs.push({ a, r, speed: 5 + prog * 6 });
    }
    for (let i = stellarArcs.length - 1; i >= 0; i--) {
      const s = stellarArcs[i]; s.r -= s.speed;
      if (s.r <= 20) { stellarArcs.splice(i, 1); continue; }
      ctx.beginPath(); ctx.arc(cx + Math.cos(s.a) * s.r, cy + Math.sin(s.a) * s.r, 2, 0, Math.PI * 2);
      ctx.fillStyle = '#fde047'; ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 8; ctx.fill();
    }

    const coreR = Math.max(16, (48 - prog * 28)) + Math.sin(t * 18) * 3;
    ctx.beginPath(); ctx.arc(cx, cy, coreR, 0, Math.PI * 2);
    ctx.fillStyle = prog > 0.6 ? '#ffffff' : '#f97316';
    ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 30 + prog * 35; ctx.fill();

    ctx.font = `900 18px 'Consolas', monospace`; ctx.fillStyle = '#000';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(`+${formatHMS(chargeSec)}`, cx, cy);
  }

  if (phase === 'supernova') {
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i]; p.age++;
      if (p.age < p.magnetWait) {
        p.x += p.vx; p.y += p.vy; p.vx *= 0.94; p.vy *= 0.94;
      } else {
        const dx = targetX - p.x, dy = targetY - p.y, dist = Math.hypot(dx, dy);
        if (dist < 26) {
          permanentSec += p.secVal; poolVaultEl.classList.add('absorb');
          setTimeout(() => poolVaultEl.classList.remove('absorb'), 70);
          playPitchTone(880 + (p.age % 10) * 80, 0.04);
          particles.splice(i, 1); continue;
        }
        const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95);
        p.vx = (dx / dist) * pull; p.vy = (dy / dist) * pull; p.x += p.vx; p.y += p.vy;
      }
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10; ctx.fill();
    }
    if (particles.length === 0) {
      phase = 'idle'; btnMainEl.textContent = 'HOLD TO ACCRETE MASS'; btnSubEl.textContent = 'RELEASE TO DETONATE';
    }
  }

  for (let i = shockwaves.length - 1; i >= 0; i--) {
    const sw = shockwaves[i]; sw.r += 14; sw.alpha -= 0.035;
    if (sw.alpha <= 0) { shockwaves.splice(i, 1); continue; }
    ctx.beginPath(); ctx.arc(cx, cy, sw.r, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(254, 240, 138, ${sw.alpha})`; ctx.lineWidth = 4;
    ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 20; ctx.stroke();
  }

  if (displayPermanentSec < permanentSec) {
    displayPermanentSec += Math.ceil((permanentSec - displayPermanentSec) * 0.2);
    poolValEl.textContent = formatHMS(displayPermanentSec);
  }
  ctx.restore();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>