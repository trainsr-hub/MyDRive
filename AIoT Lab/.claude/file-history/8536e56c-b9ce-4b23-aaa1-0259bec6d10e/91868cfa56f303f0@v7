<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chrono Spool & Shatter · Spam-Friendly Notification Feed</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: radial-gradient(circle at 50% 45%, #0d0818 0%, #030206 100%);
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #fff; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }

.hud-layer {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  align-items: center; padding: 26px 20px 24px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 10px; letter-spacing: .35em; text-transform: uppercase; color: #fbbf24; font-weight: 700; }
.main-title { font-size: 18px; font-weight: 800; letter-spacing: .12em; color: #fff; text-shadow: 0 0 16px rgba(251,191,36,0.35); }

/* ── Top Permanent Reservoir ── */
.pool-vault {
  pointer-events: auto; display: flex; align-items: center; gap: 14px;
  background: rgba(14, 10, 24, 0.9); border: 1.5px solid rgba(251,191,36,0.4);
  border-radius: 16px; padding: 12px 24px; margin-top: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.7), 0 0 24px rgba(251,191,36,0.2);
  transition: transform .1s ease, border-color .1s ease;
}
.pool-vault.absorb { transform: scale(1.05); border-color: #fde047; box-shadow: 0 0 36px rgba(251,191,36,0.7); }
.vault-icon {
  width: 42px; height: 42px; border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #fef08a, #ca8a04);
  box-shadow: 0 0 16px rgba(250,204,21,0.8);
  display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; color: #78350f;
}
.vault-meta { display: flex; flex-direction: column; }
.vault-lbl { font-size: 9px; letter-spacing: .2em; color: #a1a1aa; text-transform: uppercase; }
.vault-val { font-size: 28px; font-weight: 900; font-family: 'Consolas', monospace; color: #fef08a; text-shadow: 0 0 14px rgba(254,240,138,0.5); }

/* ── Non-Blocking Lingering Toast Notification Stack Below Block ── */
.toast-stack {
  position: absolute; top: calc(50% + 55px); left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column-reverse; align-items: center; gap: 6px;
  pointer-events: none; z-index: 15; width: 300px;
}
.worth-toast {
  padding: 6px 18px; border-radius: 12px;
  background: rgba(20, 12, 34, 0.92); border: 1.5px solid rgba(251,191,36,0.5);
  box-shadow: 0 4px 20px rgba(0,0,0,0.6), 0 0 16px rgba(251,191,36,0.3);
  display: flex; align-items: center; gap: 8px; font-family: 'Consolas', monospace;
  font-size: 16px; font-weight: 900; color: #fef08a; text-shadow: 0 0 10px rgba(254,240,138,0.7);
  animation: toastFade 2.2s cubic-bezier(.16,1,.3,1) forwards;
}
.toast-tag { font-size: 9px; letter-spacing: .2em; text-transform: uppercase; color: #fdba74; }
@keyframes toastFade {
  0% { opacity: 0; transform: translateY(14px) scale(0.85); }
  12% { opacity: 1; transform: translateY(0) scale(1.04); }
  22% { transform: scale(1); }
  75% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-16px) scale(0.92); }
}

/* ── Command Bar (Spam-Friendly: Zero Lockout) ── */
.controls { pointer-events: auto; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; width: 100%; max-width: 860px; }
.btn {
  min-height: 52px; padding: 0 24px; background: rgba(18, 12, 30, 0.9);
  border: 1.5px solid rgba(251,191,36,0.35); border-radius: 12px; color: #fef08a;
  font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  cursor: pointer; transition: all .1s ease; box-shadow: 0 4px 16px rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center; gap: 6px;
}
.btn:hover { background: #2b1845; border-color: #fde047; color: #fff; box-shadow: 0 0 24px rgba(251,191,36,0.5); transform: translateY(-2px); }
.btn:active { transform: scale(0.95); background: #ca8a04; color: #000; }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div class="hud-layer">
  <div class="header">
    <div class="sub-title">Spontaneous Detonation Engine</div>
    <div class="main-title">Chrono Compression & Swarm Absorption</div>
    <div class="pool-vault" id="poolVault">
      <div class="vault-icon">⏳</div>
      <div class="vault-meta">
        <span class="vault-lbl">Accumulated Permanent Pool</span>
        <span class="vault-val" id="poolVal">0s</span>
      </div>
    </div>
  </div>

  <!-- Non-blocking toast stack positioned cleanly BELOW the block -->
  <div class="toast-stack" id="toastStack"></div>

  <!-- Command buttons: Spam-Friendly, NEVER disabled -->
  <div class="controls">
    <button class="btn" onclick="depositSession(1800)">Deposit 30m</button>
    <button class="btn" onclick="depositSession(7200)">Deposit 2h</button>
    <button class="btn" onclick="depositSession(21600)">Deposit 6h</button>
    <button class="btn" onclick="resetAll()">Reset</button>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const poolVaultEl = document.getElementById('poolVault'), poolValEl = document.getElementById('poolVal');
const toastStackEl = document.getElementById('toastStack');

let W, H, cx, cy, targetX = 0, targetY = 0, permanentSec = 0, displayPermanentSec = 0;
let blockPulse = 0, screenShake = 0, particles = [], shockwaves = [], arcs = [], audioCtx = null;

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight;
  cx = W / 2; cy = H / 2 - 25;
  const r = poolVaultEl.getBoundingClientRect(); targetX = r.left + r.width / 2; targetY = r.top + r.height / 2;
}
window.addEventListener('resize', resize);
resize();

function formatDuration(sec) {
  if (!sec || isNaN(sec) || sec < 0) return '0s';
  let s = Math.floor(sec);
  const Y = Math.floor(s / 31536000); s %= 31536000;
  const M = Math.floor(s / 2592000); s %= 2592000;
  const D = Math.floor(s / 86400); s %= 86400;
  const h = Math.floor(s / 3600); s %= 3600;
  const m = Math.floor(s / 60); const rem = s % 60;
  const p = [];
  if (Y > 0) p.push(`${Y}Y`); if (M > 0) p.push(`${M}M`); if (D > 0) p.push(`${D}D`);
  if (h > 0) p.push(`${h}h`); if (m > 0) p.push(`${m}m`); if (rem > 0 || p.length === 0) p.push(`${rem}s`);
  return p.join('');
}

function playSound(type, freq) {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    if (type === 'shatter') {
      osc.type = 'sawtooth'; osc.frequency.setValueAtTime(180, t); osc.frequency.exponentialRampToValueAtTime(32, t + 0.35);
      gain.gain.setValueAtTime(0.4, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.35); osc.start(t); osc.stop(t + 0.35);
    } else {
      osc.type = 'sine'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.04, t);
      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.05); osc.start(t); osc.stop(t + 0.05);
    }
    osc.connect(gain); gain.connect(audioCtx.destination);
  } catch(e) {}
}

// ── Non-Blocking Deposit Trigger: Instant Boom + Lingering Notification Toast ──
function depositSession(seconds) {
  playSound('shatter', 0);
  screenShake = Math.min(32, screenShake + 8 + (seconds / 3600) * 3);
  blockPulse = 28;
  shockwaves.push({ r: 25, maxR: Math.min(W, H) * 0.6, alpha: 1.0 });

  // 1. Spawn non-blocking toast notification that lingers for 2.2s
  spawnWorthToast(formatDuration(seconds));

  // 2. Explode into particle swarm
  const pCount = Math.min(180, Math.max(40, Math.floor(seconds / 90)));
  const secPerP = seconds / pCount;
  for (let i = 0; i < pCount; i++) {
    const a = Math.random() * Math.PI * 2, sp = 5 + Math.random() * 16;
    particles.push({
      x: cx, y: cy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 2,
      secVal: secPerP, age: 0, magnetWait: 12 + Math.random() * 16,
      size: 3 + Math.random() * 3.5, color: Math.random() > 0.35 ? '#facc15' : '#38bdf8'
    });
  }
}

function spawnWorthToast(durText) {
  const toast = document.createElement('div');
  toast.className = 'worth-toast';
  toast.innerHTML = `<span class="toast-tag">BURST WORTH</span><span>${durText}</span>`;
  toastStackEl.appendChild(toast);
  setTimeout(() => toast.remove(), 2200);
}

function resetAll() {
  permanentSec = 0; displayPermanentSec = 0; particles = []; shockwaves = []; screenShake = 0;
  toastStackEl.innerHTML = ''; poolValEl.textContent = '0s';
}

function draw() {
  ctx.save();
  if (screenShake > 0) {
    ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
    screenShake *= 0.88; if (screenShake < 0.2) screenShake = 0;
  }
  ctx.fillStyle = 'rgba(4, 2, 8, 0.28)'; ctx.fillRect(-20, -20, W + 40, H + 40);

  // Central Accumulating Block (breathes and flashes with each deposit)
  if (blockPulse > 0) blockPulse *= 0.88;
  const coreR = 36 + blockPulse;
  ctx.beginPath(); ctx.arc(cx, cy, coreR, 0, Math.PI * 2);
  ctx.fillStyle = blockPulse > 5 ? '#fef08a' : 'rgba(249, 115, 22, 0.45)';
  ctx.shadowColor = '#f97316'; ctx.shadowBlur = 18 + blockPulse * 1.5; ctx.fill();

  // Draw Shockwaves
  for (let i = shockwaves.length - 1; i >= 0; i--) {
    const sw = shockwaves[i]; sw.r += 14; sw.alpha -= 0.035;
    if (sw.alpha <= 0) { shockwaves.splice(i, 1); continue; }
    ctx.beginPath(); ctx.arc(cx, cy, sw.r, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(254, 240, 138, ${sw.alpha})`; ctx.lineWidth = 4;
    ctx.shadowColor = '#f59e0b'; ctx.shadowBlur = 18; ctx.stroke();
  }

  // Draw & Update Particles flowing to Permanent Vault
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i]; p.age++;
    if (p.age < p.magnetWait) {
      p.x += p.vx; p.y += p.vy; p.vx *= 0.94; p.vy *= 0.94;
    } else {
      const dx = targetX - p.x, dy = targetY - p.y, dist = Math.hypot(dx, dy);
      if (dist < 26) {
        permanentSec += p.secVal; poolVaultEl.classList.add('absorb');
        setTimeout(() => poolVaultEl.classList.remove('absorb'), 70);
        playSound('absorb', 880 + (p.age % 10) * 75);
        particles.splice(i, 1); continue;
      }
      const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95);
      p.vx = (dx / dist) * pull; p.vy = (dy / dist) * pull;
      p.x += p.vx; p.y += p.vy;
    }
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10; ctx.fill();
  }

  // Smooth lerp permanent reservoir
  if (displayPermanentSec < permanentSec) {
    displayPermanentSec += Math.ceil((permanentSec - displayPermanentSec) * 0.2);
    poolValEl.textContent = formatDuration(displayPermanentSec);
  }
  ctx.restore();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>