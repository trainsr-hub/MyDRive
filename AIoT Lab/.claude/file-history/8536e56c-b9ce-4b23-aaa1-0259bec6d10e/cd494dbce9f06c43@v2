<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chrono Capacitor · High-Voltage Arc Discharge</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #02070d; font-family: 'Consolas', 'Courier New', monospace;
  color: #00f0ff; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }

.hud-layer {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  align-items: center; padding: 24px 20px 22px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 10px; letter-spacing: .35em; text-transform: uppercase; color: #00f0ff; opacity: .8; margin-bottom: 2px; }
.main-title { font-size: 18px; font-weight: 800; letter-spacing: .12em; color: #e0faff; text-shadow: 0 0 16px rgba(0,240,255,0.6); }

.pool-vault {
  pointer-events: auto; display: flex; align-items: center; gap: 14px;
  background: rgba(2, 18, 30, 0.9); border: 1.5px solid #00f0ff;
  border-radius: 12px; padding: 12px 24px; margin-top: 8px;
  box-shadow: 0 0 24px rgba(0,240,255,0.3); transition: transform .1s ease, border-color .1s ease;
}
.pool-vault.absorb { transform: scale(1.05); border-color: #fff; box-shadow: 0 0 36px rgba(0,240,255,0.8); }
.vault-icon {
  width: 42px; height: 42px; border-radius: 10px;
  background: #002b47; border: 1.5px solid #00f0ff;
  display: flex; align-items: center; justify-content: center; font-size: 20px; color: #00f0ff;
  box-shadow: inset 0 0 10px rgba(0,240,255,0.5);
}
.vault-meta { display: flex; flex-direction: column; }
.vault-lbl { font-size: 9px; letter-spacing: .2em; color: #5eead4; text-transform: uppercase; }
.vault-val { font-size: 28px; font-weight: 900; color: #fff; text-shadow: 0 0 12px rgba(0,240,255,0.7); }

.trigger-deck { pointer-events: auto; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.hold-btn {
  width: 250px; min-height: 64px; border-radius: 12px; cursor: pointer;
  background: #021a2d; border: 2px solid #00f0ff; color: #00f0ff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 0 24px rgba(0,240,255,0.3); transition: transform .1s ease, border-color .15s ease;
}
.hold-btn:hover { background: #00365c; color: #fff; box-shadow: 0 0 36px rgba(0,240,255,0.6); }
.hold-btn.charging { transform: scale(0.96); border-color: #f43f5e; color: #f43f5e; box-shadow: 0 0 45px rgba(244,63,94,0.8); }
.btn-txt-main { font-size: 13px; font-weight: 900; letter-spacing: .15em; text-transform: uppercase; }
.btn-txt-sub { font-size: 10px; letter-spacing: .1em; color: #67e8f9; }
.preset-bar { display: flex; gap: 10px; }
.preset-btn {
  min-height: 44px; padding: 0 16px; border-radius: 8px;
  background: rgba(0,240,255,0.06); border: 1px solid rgba(0,240,255,0.25);
  color: #67e8f9; font-size: 11px; font-weight: 700; font-family: inherit; cursor: pointer;
}
.preset-btn:hover { background: #00f0ff; color: #02070d; }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div class="hud-layer">
  <div class="header">
    <div class="sub-title">High-Voltage Chrono Capacitor</div>
    <div class="main-title">Dielectric Arc Spool & Discharge</div>
    <div class="pool-vault" id="poolVault">
      <div class="vault-icon">⚡</div>
      <div class="vault-meta">
        <span class="vault-lbl">Main Grid Capacity</span>
        <span class="vault-val" id="poolVal">00:00:00</span>
      </div>
    </div>
  </div>

  <div class="trigger-deck">
    <div class="hold-btn" id="holdTrigger">
      <span class="btn-txt-main" id="btnMain">HOLD TO CHARGE DIELECTRIC</span>
      <span class="btn-txt-sub" id="btnSub">RELEASE TO ARC DISCHARGE</span>
    </div>
    <div class="preset-bar">
      <button class="preset-btn" onclick="autoCharge(1800)">Spool 30m</button>
      <button class="preset-btn" onclick="autoCharge(7200)">Spool 2h</button>
      <button class="preset-btn" onclick="autoCharge(21600)">Spool 6h</button>
      <button class="preset-btn" onclick="resetAll()">Purge</button>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const poolVaultEl = document.getElementById('poolVault'), poolValEl = document.getElementById('poolVal');
const holdTriggerEl = document.getElementById('holdTrigger');
const btnMainEl = document.getElementById('btnMain'), btnSubEl = document.getElementById('btnSub');
let W, H, cx, cy, targetX = 0, targetY = 0, permanentSec = 0, displayPermanentSec = 0;
let isHolding = false, chargeSec = 0, screenShake = 0, phase = 'idle';
let sparkPackets = [], lightningBolts = [], audioCtx = null;

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight;
  cx = W / 2; cy = H / 2 - 20;
  const r = poolVaultEl.getBoundingClientRect(); targetX = r.left + r.width / 2; targetY = r.top + r.height / 2;
}
window.addEventListener('resize', resize);
resize();

function formatHMS(sec) {
  const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = Math.floor(sec % 60);
  return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
}

function playBuzzerTone(freq) {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'sawtooth'; osc.frequency.setValueAtTime(freq, t); gain.gain.setValueAtTime(0.06, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + 0.04); osc.connect(gain); gain.connect(audioCtx.destination);
    osc.start(t); osc.stop(t + 0.04);
  } catch(e) {}
}

function playArcBlast() {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'square'; osc.frequency.setValueAtTime(280, t); osc.frequency.exponentialRampToValueAtTime(40, t + 0.4);
    gain.gain.setValueAtTime(0.35, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
    osc.connect(gain); gain.connect(audioCtx.destination); osc.start(t); osc.stop(t + 0.4);
  } catch(e) {}
}

['mousedown', 'touchstart'].forEach(e => holdTriggerEl.addEventListener(e, (ev) => {
  ev.preventDefault(); if (phase === 'discharging') return;
  isHolding = true; phase = 'spooling'; chargeSec = 0; holdTriggerEl.classList.add('charging');
}));
['mouseup', 'mouseleave', 'touchend'].forEach(e => holdTriggerEl.addEventListener(e, () => {
  if (isHolding && phase === 'spooling') { isHolding = false; holdTriggerEl.classList.remove('charging'); releaseDischarge(); }
}));

function autoCharge(sec) { if (phase === 'idle') { chargeSec = sec; releaseDischarge(); } }

function releaseDischarge() {
  if (chargeSec < 60) { phase = 'idle'; return; }
  phase = 'discharging'; playArcBlast();
  screenShake = Math.min(26, 6 + (chargeSec / 3600) * 4);

  const pCount = Math.min(200, Math.max(35, Math.floor(chargeSec / 60)));
  const secPerP = chargeSec / pCount;
  for (let i = 0; i < pCount; i++) {
    const a = Math.random() * Math.PI * 2, sp = 6 + Math.random() * 18;
    sparkPackets.push({
      x: cx, y: cy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
      secVal: secPerP, age: 0, magnetWait: 12 + Math.random() * 16,
      size: 3 + Math.random() * 3, color: Math.random() > 0.3 ? '#00f0ff' : '#ffffff'
    });
  }
  btnMainEl.textContent = 'ARC INGESTION'; btnSubEl.textContent = 'CAPACITOR DISCHARGING'; chargeSec = 0;
}

function resetAll() {
  permanentSec = 0; displayPermanentSec = 0; sparkPackets = []; lightningBolts = [];
  phase = 'idle'; poolValEl.textContent = '00:00:00';
  btnMainEl.textContent = 'HOLD TO CHARGE DIELECTRIC'; btnSubEl.textContent = 'RELEASE TO ARC DISCHARGE';
}

function draw() {
  ctx.save();
  if (screenShake > 0) {
    ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
    screenShake *= 0.88; if (screenShake < 0.2) screenShake = 0;
  }
  ctx.fillStyle = 'rgba(2, 7, 13, 0.28)'; ctx.fillRect(-20, -20, W + 40, H + 40);

  // Digital Circuit Grid
  ctx.strokeStyle = 'rgba(0, 240, 255, 0.05)'; ctx.lineWidth = 1;
  for (let x = 0; x < W; x += 60) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }

  // Phase 1: High Voltage Spooling
  if (phase === 'spooling' && isHolding) {
    chargeSec += 90;
    const prog = Math.min(1.0, chargeSec / 21600);
    screenShake = 1.2 + prog * 8;
    btnMainEl.textContent = `SPOOLING +${formatHMS(chargeSec)}`;
    btnSubEl.textContent = `VOLTAGE: ${(prog * 500).toFixed(0)} kV`;
    if (Math.random() < 0.4) playBuzzerTone(400 + prog * 1200);

    // Chaotic Electric Arcs between plates
    if (Math.random() < 0.7) {
      const a = Math.random() * Math.PI * 2, d = 40 + Math.random() * 80;
      lightningBolts.push({ x1: cx + Math.cos(a) * d, y1: cy + Math.sin(a) * d, x2: cx, y2: cy, life: 3 });
    }

    // Twin Capacitor Plates
    const pw = 120, ph = 14;
    ctx.fillStyle = prog > 0.7 ? '#f43f5e' : '#00f0ff';
    ctx.shadowColor = ctx.fillStyle; ctx.shadowBlur = 20;
    ctx.fillRect(cx - pw / 2, cy - 35, pw, ph);
    ctx.fillRect(cx - pw / 2, cy + 21, pw, ph);

    // Glowing Stored Plasma Core
    ctx.font = `900 20px Consolas, monospace`; ctx.fillStyle = '#fff';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(`+${formatHMS(chargeSec)}`, cx, cy);
  }

  // Draw Lightning Bolts
  ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.5; ctx.shadowColor = '#00f0ff'; ctx.shadowBlur = 10;
  for (let i = lightningBolts.length - 1; i >= 0; i--) {
    const b = lightningBolts[i];
    ctx.beginPath(); ctx.moveTo(b.x1, b.y1);
    ctx.lineTo((b.x1 + b.x2) / 2 + (Math.random() - 0.5) * 16, (b.y1 + b.y2) / 2 + (Math.random() - 0.5) * 16);
    ctx.lineTo(b.x2, b.y2); ctx.stroke();
    if (--b.life <= 0) lightningBolts.splice(i, 1);
  }

  // Phase 2: Electric Packets Ingestion
  if (phase === 'discharging') {
    for (let i = sparkPackets.length - 1; i >= 0; i--) {
      const p = sparkPackets[i]; p.age++;
      if (p.age < p.magnetWait) {
        p.x += p.vx; p.y += p.vy; p.vx *= 0.93; p.vy *= 0.93;
      } else {
        const dx = targetX - p.x, dy = targetY - p.y, dist = Math.hypot(dx, dy);
        if (dist < 26) {
          permanentSec += p.secVal; poolVaultEl.classList.add('absorb');
          setTimeout(() => poolVaultEl.classList.remove('absorb'), 70);
          playBuzzerTone(900 + (p.age % 10) * 90);
          sparkPackets.splice(i, 1); continue;
        }
        const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95);
        p.vx = (dx / dist) * pull; p.vy = (dy / dist) * pull; p.x += p.vx; p.y += p.vy;
      }
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10; ctx.fill();
    }
    if (sparkPackets.length === 0) {
      phase = 'idle'; btnMainEl.textContent = 'HOLD TO CHARGE DIELECTRIC'; btnSubEl.textContent = 'RELEASE TO ARC DISCHARGE';
    }
  }

  if (displayPermanentSec < permanentSec) {
    displayPermanentSec += Math.ceil((permanentSec - displayPermanentSec) * 0.2);
    poolValEl.textContent = formatHMS(displayPermanentSec);
  }
  ctx.restore();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>