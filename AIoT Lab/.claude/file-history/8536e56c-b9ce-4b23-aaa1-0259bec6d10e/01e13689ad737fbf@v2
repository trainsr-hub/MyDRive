<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chrono Seal · Rune Lock Fracture</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #06020c; font-family: 'Segoe UI', system-ui, sans-serif;
  color: #f5f3ff; user-select: none;
}
canvas { position: fixed; inset: 0; display: block; }

.hud-layer {
  position: fixed; inset: 0; pointer-events: none;
  display: flex; flex-direction: column; justify-content: space-between;
  align-items: center; padding: 24px 20px 22px; z-index: 10;
}
.header { text-align: center; }
.sub-title { font-size: 10px; letter-spacing: .35em; text-transform: uppercase; color: #c084fc; font-weight: 700; margin-bottom: 2px; }
.main-title { font-size: 18px; font-weight: 800; letter-spacing: .12em; color: #fff; text-shadow: 0 0 16px rgba(192,132,252,0.5); }

.pool-vault {
  pointer-events: auto; display: flex; align-items: center; gap: 14px;
  background: rgba(18, 10, 32, 0.9); border: 1.5px solid rgba(192,132,252,0.4);
  border-radius: 16px; padding: 12px 24px; margin-top: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.7), 0 0 24px rgba(192,132,252,0.25);
  transition: transform .1s ease, border-color .1s ease;
}
.pool-vault.absorb { transform: scale(1.05); border-color: #d8b4fe; box-shadow: 0 0 36px rgba(192,132,252,0.8); }
.vault-icon {
  width: 42px; height: 42px; border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #e9d5ff, #7e22ce);
  box-shadow: 0 0 16px rgba(192,132,252,0.8);
  display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; color: #3b0764;
}
.vault-meta { display: flex; flex-direction: column; }
.vault-lbl { font-size: 9px; letter-spacing: .2em; color: #d8b4fe; text-transform: uppercase; }
.vault-val { font-size: 28px; font-weight: 900; font-family: 'Consolas', monospace; color: #fff; text-shadow: 0 0 14px rgba(192,132,252,0.6); }

.trigger-deck { pointer-events: auto; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.hold-btn {
  width: 250px; min-height: 64px; border-radius: 20px; cursor: pointer;
  background: linear-gradient(135deg, rgba(168,85,247,0.2), rgba(236,72,153,0.2));
  border: 2px solid rgba(192,132,252,0.5); color: #f5d0fe;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 0 24px rgba(192,132,252,0.3); transition: transform .1s ease, border-color .15s ease;
}
.hold-btn:hover { border-color: #f0abfc; box-shadow: 0 0 32px rgba(192,132,252,0.5); }
.hold-btn.charging { transform: scale(0.96); border-color: #fff; box-shadow: 0 0 45px rgba(236,72,153,0.8); }
.btn-txt-main { font-size: 13px; font-weight: 900; letter-spacing: .15em; text-transform: uppercase; }
.btn-txt-sub { font-size: 10px; font-family: monospace; letter-spacing: .1em; color: #e9d5ff; opacity: 0.8; }
.preset-bar { display: flex; gap: 10px; }
.preset-btn {
  min-height: 44px; padding: 0 16px; border-radius: 10px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12);
  color: #e9d5ff; font-size: 11px; font-weight: 700; font-family: monospace; cursor: pointer;
}
.preset-btn:hover { background: #7e22ce; color: #fff; }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div class="hud-layer">
  <div class="header">
    <div class="sub-title">Mystic Geometric Binding</div>
    <div class="main-title">Chrono Rune Seal · Fracture & Unbinding</div>
    <div class="pool-vault" id="poolVault">
      <div class="vault-icon">🔯</div>
      <div class="vault-meta">
        <span class="vault-lbl">Sanctum Mana Reserve</span>
        <span class="vault-val" id="poolVal">00:00:00</span>
      </div>
    </div>
  </div>

  <div class="trigger-deck">
    <div class="hold-btn" id="holdTrigger">
      <span class="btn-txt-main" id="btnMain">HOLD TO ETCH RUNE SEAL</span>
      <span class="btn-txt-sub" id="btnSub">RELEASE TO SHATTER LOCK</span>
    </div>
    <div class="preset-bar">
      <button class="preset-btn" onclick="autoCharge(1800)">Etch +30m</button>
      <button class="preset-btn" onclick="autoCharge(7200)">Etch +2h</button>
      <button class="preset-btn" onclick="autoCharge(21600)">Etch +6h</button>
      <button class="preset-btn" onclick="resetAll()">Dispel</button>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
const poolVaultEl = document.getElementById('poolVault'), poolValEl = document.getElementById('poolVal');
const holdTriggerEl = document.getElementById('holdTrigger');
const btnMainEl = document.getElementById('btnMain'), btnSubEl = document.getElementById('btnSub');
let W, H, cx, cy, targetX = 0, targetY = 0, permanentSec = 0, displayPermanentSec = 0;
let isHolding = false, chargeSec = 0, screenShake = 0, phase = 'idle';
let runeShards = [], runeGlow = 0, audioCtx = null;

function resize() {
  W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight;
  cx = W / 2; cy = H / 2 - 20;
  const r = poolVaultEl.getBoundingClientRect(); targetX = r.left + r.width / 2; targetY = r.top + r.height / 2;
}
window.addEventListener('resize', resize);
resize();

function formatHMS(sec) {
  const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = Math.floor(sec % 60);
  return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
}

function playMysticChime(pitch) {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'sine'; osc.frequency.setValueAtTime(440 * pitch, t);
    gain.gain.setValueAtTime(0.08, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
    osc.connect(gain); gain.connect(audioCtx.destination); osc.start(t); osc.stop(t + 0.15);
  } catch(e) {}
}

function playGlassShatter() {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.type = 'sawtooth'; osc.frequency.setValueAtTime(880, t); osc.frequency.exponentialRampToValueAtTime(110, t + 0.4);
    gain.gain.setValueAtTime(0.4, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
    osc.connect(gain); gain.connect(audioCtx.destination); osc.start(t); osc.stop(t + 0.4);
  } catch(e) {}
}

['mousedown', 'touchstart'].forEach(e => holdTriggerEl.addEventListener(e, (ev) => {
  ev.preventDefault(); if (phase === 'shattered') return;
  isHolding = true; phase = 'etching'; chargeSec = 0; holdTriggerEl.classList.add('charging');
}));
['mouseup', 'mouseleave', 'touchend'].forEach(e => holdTriggerEl.addEventListener(e, () => {
  if (isHolding && phase === 'etching') { isHolding = false; holdTriggerEl.classList.remove('charging'); releaseSeal(); }
}));

function autoCharge(sec) { if (phase === 'idle') { chargeSec = sec; releaseSeal(); } }

function releaseSeal() {
  if (chargeSec < 60) { phase = 'idle'; return; }
  phase = 'shattered'; playGlassShatter();
  screenShake = Math.min(26, 6 + (chargeSec / 3600) * 4);

  const pCount = Math.min(200, Math.max(35, Math.floor(chargeSec / 60)));
  const secPerP = chargeSec / pCount;
  for (let i = 0; i < pCount; i++) {
    const a = Math.random() * Math.PI * 2, sp = 5 + Math.random() * 16;
    runeShards.push({
      x: cx, y: cy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
      secVal: secPerP, age: 0, magnetWait: 14 + Math.random() * 16,
      size: 3 + Math.random() * 3.5, color: Math.random() > 0.35 ? '#d8b4fe' : '#f472b6'
    });
  }
  btnMainEl.textContent = 'RUNE LIBERATION'; btnSubEl.textContent = 'SANCTUM ABSORBING'; chargeSec = 0;
}

function resetAll() {
  permanentSec = 0; displayPermanentSec = 0; runeShards = [];
  phase = 'idle'; poolValEl.textContent = '00:00:00';
  btnMainEl.textContent = 'HOLD TO ETCH RUNE SEAL'; btnSubEl.textContent = 'RELEASE TO SHATTER LOCK';
}

function draw() {
  ctx.save();
  if (screenShake > 0) {
    ctx.translate((Math.random() - 0.5) * screenShake, (Math.random() - 0.5) * screenShake);
    screenShake *= 0.88; if (screenShake < 0.2) screenShake = 0;
  }
  ctx.fillStyle = 'rgba(6, 2, 12, 0.28)'; ctx.fillRect(-20, -20, W + 40, H + 40);

  const t = Date.now() * 0.002;

  // Phase 1: Etching Sacred Geometry Mandalas under hold
  if (phase === 'etching' && isHolding) {
    chargeSec += 90;
    const prog = Math.min(1.0, chargeSec / 21600);
    screenShake = 1.2 + prog * 8;
    btnMainEl.textContent = `ETCHING +${formatHMS(chargeSec)}`;
    btnSubEl.textContent = `BINDING: ${(prog * 100).toFixed(0)}%`;
    if (Math.random() < 0.3) playMysticChime(1.0 + prog * 2.0);

    // Rotating Octagonal Rune Circles
    const rR = 40 + prog * 45;
    ctx.strokeStyle = '#c084fc'; ctx.lineWidth = 2; ctx.shadowColor = '#c084fc'; ctx.shadowBlur = 18;
    ctx.beginPath(); ctx.arc(cx, cy, rR, t, t + Math.PI * 2 * prog); ctx.stroke();

    // Geometric Interlocking Hexagram
    ctx.save(); ctx.translate(cx, cy); ctx.rotate(-t * 2);
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const a = (i / 6) * Math.PI * 2;
      const px = Math.cos(a) * (rR * 0.8), py = Math.sin(a) * (rR * 0.8);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.closePath(); ctx.stroke(); ctx.restore();

    ctx.font = `900 18px 'Consolas', monospace`; ctx.fillStyle = '#fff';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(`+${formatHMS(chargeSec)}`, cx, cy);
  }

  // Phase 2: Crystalline Shards Ingestion
  if (phase === 'shattered') {
    for (let i = runeShards.length - 1; i >= 0; i--) {
      const p = runeShards[i]; p.age++;
      if (p.age < p.magnetWait) {
        p.x += p.vx; p.y += p.vy; p.vx *= 0.94; p.vy *= 0.94;
      } else {
        const dx = targetX - p.x, dy = targetY - p.y, dist = Math.hypot(dx, dy);
        if (dist < 26) {
          permanentSec += p.secVal; poolVaultEl.classList.add('absorb');
          setTimeout(() => poolVaultEl.classList.remove('absorb'), 70);
          playMysticChime(1.5 + (p.age % 8) * 0.1);
          runeShards.splice(i, 1); continue;
        }
        const pull = Math.min(26, 2.0 + (p.age - p.magnetWait) * 0.95);
        p.vx = (dx / dist) * pull; p.vy = (dy / dist) * pull; p.x += p.vx; p.y += p.vy;
      }
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = p.color; ctx.shadowColor = p.color; ctx.shadowBlur = 10; ctx.fill();
    }
    if (runeShards.length === 0) {
      phase = 'idle'; btnMainEl.textContent = 'HOLD TO ETCH RUNE SEAL'; btnSubEl.textContent = 'RELEASE TO SHATTER LOCK';
    }
  }

  if (displayPermanentSec < permanentSec) {
    displayPermanentSec += Math.ceil((permanentSec - displayPermanentSec) * 0.2);
    poolValEl.textContent = formatHMS(displayPermanentSec);
  }
  ctx.restore();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);
</script>
</body>
</html>