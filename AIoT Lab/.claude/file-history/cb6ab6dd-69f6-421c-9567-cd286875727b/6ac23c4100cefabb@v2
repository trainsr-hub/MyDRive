            onError: (e: any) => {
              console.warn('[YouTube Player] Playback error code:', e?.data);
              consecutiveErrorsRef.current += 1;
              if (consecutiveErrorsRef.current <= 5) {
                setTimeout(() => {
                  if (isMountedRef.current) {
                    handleNextSong(null);
                  }
                }, 1200);
              }
            },
          },
