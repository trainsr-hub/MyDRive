                    if (lastLoggedTrackIdRef.current !== activeTrack.id) {
                      const scoreToLog =
                        selectedScoreRef.current || settingsRef.current.defaultPassScore || '4+';
                      logActionToTier2(activeTrack, scoreToLog);
                    }
                  }
                  handleNextSong(null);
