    <h2>📝 Example: Complete Minimal Sketch</h2>

    <pre><code>#include &lt;Arduino.h&gt;
#include &lt;WiFi.h&gt;
#include &lt;HTTPClient.h&gt;
#include &lt;ArduinoJson.h&gt;
#include &lt;TFT_eSPI.h&gt;
#include &lt;Preferences.h&gt;

TFT_eSPI display = TFT_eSPI();
Preferences prefs;

const char* SSID = "YourSSID";
const char* PASSWORD = "YourPassword";
const char* API_BASE = "https://rien-bluerose-backend.kha70929.workers.dev";

struct QuotePayload {
  long idx;
  String content;
  String specificName;
  String containerName;
  String effectiveDate;
};

void setup() {
  Serial.begin(115200);

  // Initialize display
  display.init();
  display.setRotation(1); // Landscape
  display.fillScreen(0x0000);
  display.setTextColor(0xFFFF);
  display.println("Initializing...");

  // Connect WiFi
  WiFi.begin(SSID, PASSWORD);
  int timeout = 20;
  while (WiFi.status() != WL_CONNECTED && timeout-- &gt; 0) {
    delay(500);
    Serial.print(".");
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi connected!");
    QuotePayload q = fetchRandomQuote();
    renderQuote(q);
    cacheQuote(q);
  } else {
    Serial.println("\nWiFi failed. Using cache.");
    QuotePayload q = restoreCachedQuote();
    renderQuote(q);
  }
}

void loop() {
  // Check GPIO buttons for user input
  delay(100);
}

QuotePayload fetchRandomQuote() {
  HTTPClient http;
  http.begin(String(API_BASE) + "/api/quote/random");
  int httpCode = http.GET();

  QuotePayload result = {};
  if (httpCode == 200) {
    DynamicJsonDocument doc(4096);
    deserializeJson(doc, http.getString());
    result.idx = doc["idx"];
    result.content = doc["content"].as&lt;String&gt;();
    result.specificName = doc["specificName"].as&lt;String&gt;();
    result.containerName = doc["containerName"].as&lt;String&gt;();
    result.effectiveDate = doc["effectiveDate"].as&lt;String&gt;();
  }
  http.end();
  return result;
}

void renderQuote(const QuotePayload &q) {
  display.fillScreen(0x0000);
  display.setTextColor(0x632C);
  display.setFont(&FreeMono9pt7b);
  display.setCursor(16, 20);
  display.printf("#%ld ~ %s", q.idx, q.specificName.c_str());

  display.setTextColor(0xFFFF);
  display.setFont(&FreeMono14pt7b);
  display.setCursor(16, 50);
  display.println(q.content.c_str());

  display.setTextColor(0xFD01); // Gold accent
  display.setFont(&FreeMono9pt7b);
  display.setCursor(display.width() - 120, display.height() - 10);
  display.print(q.containerName.c_str());
}

void cacheQuote(const QuotePayload &q) {
  prefs.begin("quotes", false);
  prefs.putLong("idx", q.idx);
  prefs.putString("content", q.content);
  prefs.putString("specific", q.specificName);
  prefs.putString("container", q.containerName);
  prefs.putString("date", q.effectiveDate);
  prefs.end();
}

QuotePayload restoreCachedQuote() {
  prefs.begin("quotes", true);
  QuotePayload q;
  q.idx = prefs.getLong("idx", 0);
  q.content = prefs.getString("content", "No cache");
  q.specificName = prefs.getString("specific", "");
  q.containerName = prefs.getString("container", "");
  q.effectiveDate = prefs.getString("date", "");
  prefs.end();
  return q;
}
</code></pre>

