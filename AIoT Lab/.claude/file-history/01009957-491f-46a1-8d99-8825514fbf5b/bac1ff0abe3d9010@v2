    <h2>🔌 C++ Firmware Implementation Pattern</h2>

    <h3>1. WiFi Connection Setup</h3>
    <pre><code>#include &lt;WiFi.h&gt;
#include &lt;HTTPClient.h&gt;
#include &lt;ArduinoJson.h&gt;

const char* SSID = "YOUR_SSID";
const char* PASSWORD = "YOUR_PASSWORD";
const char* API_BASE = "https://rien-bluerose-backend.kha70929.workers.dev";

void setupWiFi() {
  WiFi.begin(SSID, PASSWORD);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected!");
}</code></pre>

    <h3>2. Fetch Random Prescript</h3>
    <pre><code>struct QuotePayload {
  long idx;
  String content;
  String specificName;
  String containerName;
  String effectiveDate;
  String category;
  String context;
  // hashtagThemes as comma-separated string or array
};

QuotePayload fetchRandomQuote() {
  HTTPClient http;
  String url = String(API_BASE) + "/api/quote/random";

  http.begin(url);
  int httpCode = http.GET();

  QuotePayload result = {};

  if (httpCode == 200) {
    String payload = http.getString();
    DynamicJsonDocument doc(4096); // Adjust size for your quote length
    deserializeJson(doc, payload);

    result.idx = doc["idx"];
    result.content = doc["content"].as&lt;String&gt;();
    result.specificName = doc["specificName"].as&lt;String&gt;();
    result.containerName = doc["containerName"].as&lt;String&gt;();
    result.effectiveDate = doc["effectiveDate"].as&lt;String&gt;();
    result.category = doc["category"].as&lt;String&gt;();
    result.context = doc["context"].as&lt;String&gt;();
  }

  http.end();
  return result;
}
</code></pre>

