    <h2>🔄 Connection & Caching Strategy</h2>

    <div class="info">
      <strong>Cold Start (No Cache):</strong> On first power-on, fetch a random quote immediately. Display while fetching.
    </div>

    <div class="info">
      <strong>Warm Restart:</strong> Restore last viewed quote from NVS (Non-Volatile Storage). Fetch new ones on user navigation.
    </div>

    <div class="warning">
      <strong>Network Timeout:</strong> If API is unreachable, fall back to embedded offline cache or last cached quote. Never leave display blank.
    </div>

    <h3>NVS Storage Pattern (ESP32)</h3>
    <pre><code>#include &lt;Preferences.h&gt;

Preferences prefs;

void cacheQuote(const QuotePayload &q) {
  prefs.begin("quotes", false); // false = read-write
  prefs.putLong("lastIdx", q.idx);
  prefs.putString("lastContent", q.content);
  prefs.putString("lastSpecific", q.specificName);
  prefs.putString("lastContainer", q.containerName);
  prefs.putString("lastDate", q.effectiveDate);
  prefs.end();
}

QuotePayload restoreCachedQuote() {
  prefs.begin("quotes", true); // true = read-only
  QuotePayload q;
  q.idx = prefs.getLong("lastIdx", 0);
  q.content = prefs.getString("lastContent", "");
  q.specificName = prefs.getString("lastSpecific", "");
  q.containerName = prefs.getString("lastContainer", "");
  q.effectiveDate = prefs.getString("lastDate", "");
  prefs.end();
  return q;
}
</code></pre>

