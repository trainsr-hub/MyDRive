#!/usr/bin/env python3
"""
Tier 4: Telegram Ingress Poller
Long-polling loop via standard library urllib.request (zero open ports, zero tunnels).
Drops pending webhooks on startup, enforces Manager ID authorization, and handles backoff.
"""

import json
import logging
import threading
import time
import urllib.error
import urllib.request
from typing import Dict, Any, Callable, Optional, List

from domain import TelegramDirective


logger = logging.getLogger("faust.daemon.poller")


class TelegramPoller:
    """Long-polling ingress transport for Telegram Bot API."""

    def __init__(
        self,
        bot_token: str,
        manager_id: int,
        on_directive: Callable[[TelegramDirective, Optional[Callable[[str], None]]], None]
    ) -> None:
        self.bot_token = bot_token
        self.manager_id = manager_id
        self.on_directive = on_directive
        self.offset = 0
        self._consecutive_errors = 0

    def delete_webhook(self) -> bool:
        """Clears any residual webhook to avoid HTTP 409 Conflict with getUpdates."""
        url = f"https://api.telegram.org/bot{self.bot_token}/deleteWebhook?drop_pending_updates=false"
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Faust-Poller/1.0"})
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                return data.get("ok", False)
        except Exception as e:
            logger.warning(f"deleteWebhook failed (may already be deleted): {e}")
            return False

    def fetch_updates(self, timeout: int = 30) -> List[Dict[str, Any]]:
        """Polls for incoming messages with long-polling timeout."""
        url = f"https://api.telegram.org/bot{self.bot_token}/getUpdates"
        payload = {
            "offset": self.offset,
            "timeout": timeout,
            "allowed_updates": ["message"]
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json", "User-Agent": "Faust-Poller/1.0"},
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=timeout + 10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            if data.get("ok"):
                return data.get("result", [])
        return []

    def start(self, stop_event: threading.Event, progress_cb_factory: Optional[Callable[[str, str], Callable[[str], None]]] = None) -> None:
        """Main ingress loop. Runs until stop_event is set."""
        self.delete_webhook()
        logger.info("Starting Telegram long-polling loop...")

        while not stop_event.is_set():
            try:
                updates = self.fetch_updates(timeout=30)
                self._consecutive_errors = 0

                for u in updates:
                    uid = u.get("update_id", 0)
                    self.offset = max(self.offset, uid + 1)

                    msg = u.get("message")
                    if not msg:
                        continue

                    from_user = msg.get("from", {})
                    user_id = from_user.get("id", 0)

                    # Security Gate: Whitelist Manager strictly
                    if user_id != self.manager_id:
                        logger.warning(f"Unauthorized update dropped from user {user_id}")
                        continue

                    text = msg.get("text", "")
                    if not text:
                        continue

                    chat_id = str(msg.get("chat", {}).get("id", ""))
                    thread_id = str(msg.get("message_thread_id", ""))
                    message_id = str(msg.get("message_id", "0"))

                    directive = TelegramDirective(
                        text=text,
                        message_id=message_id,
                        chat_id=chat_id,
                        thread_id=thread_id,
                        user_id=user_id
                    )

                    progress_cb = None
                    if progress_cb_factory:
                        progress_cb = progress_cb_factory(thread_id, message_id)

                    try:
                        self.on_directive(directive, progress_cb)
                    except Exception as ex:
                        logger.error(f"Directive handling exception: {ex}")

            except urllib.error.HTTPError as he:
                self._consecutive_errors += 1
                if he.code == 429:
                    logger.warning("Rate limited by Telegram API (429). Sleeping 10s...")
                    time.sleep(10)
                elif he.code == 409:
                    logger.warning("Webhook conflict (409). Calling deleteWebhook again...")
                    self.delete_webhook()
                    time.sleep(3)
                else:
                    sleep_time = min(30, 2 ** min(self._consecutive_errors, 5))
                    logger.error(f"HTTP error {he.code}: {he}. Backing off {sleep_time}s...")
                    time.sleep(sleep_time)

            except Exception as e:
                self._consecutive_errors += 1
                sleep_time = min(30, 2 ** min(self._consecutive_errors, 5))
                logger.error(f"Polling socket error: {e}. Retrying in {sleep_time}s...")
                time.sleep(sleep_time)
