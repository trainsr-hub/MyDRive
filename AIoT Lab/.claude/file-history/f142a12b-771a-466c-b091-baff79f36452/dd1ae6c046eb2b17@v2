#!/usr/bin/env python3
"""
Faust Acoustic Presence & C2 Unified Dispatcher
Sovereign skill entry point for acoustic voice synthesis and Telegram mirroring.

Usage:
    python .claude/skills/sound/scripts/cli.py "<speech_text>"
    python .claude/skills/sound/scripts/cli.py speak "<speech_text>"
    python .claude/skills/sound/scripts/cli.py --status
    python .claude/skills/sound/scripts/cli.py --no-tg "<speech_text>"
    python .claude/skills/sound/scripts/cli.py --no-tts "<speech_text>"
"""
import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

# Base Paths
SCRIPT_PATH = Path(__file__).resolve()
SKILL_DIR = SCRIPT_PATH.parents[1]
CLAUDE_DIR = SKILL_DIR.parent
PROJECT_ROOT = CLAUDE_DIR.parent

# C2 Infrastructure Configuration
DAEMON_HOST = os.getenv("FAUST_AUDIO_HOST", "127.0.0.1")
DAEMON_PORT = int(os.getenv("FAUST_AUDIO_PORT", "20129"))
TG_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "8886654932:AAFq6vaPlJig3oekr8BEW2PuRvMejIUB7VU")
TG_CHAT_ID = int(os.getenv("TELEGRAM_CHAT_ID", "-1004405650953"))

# Locate Audio Daemon Script (support both .claude/audio and .agents/audio)
CANDIDATE_DAEMON_PATHS = [
    CLAUDE_DIR / "audio" / "audio_daemon.py",
    PROJECT_ROOT / ".agents" / "audio" / "audio_daemon.py",
    CLAUDE_DIR.parent / ".agents" / "audio" / "audio_daemon.py",
    Path("D:/My Heraclitus/Backups/Faust/.agents/audio/audio_daemon.py"),
]


def _resolve_daemon_script() -> Path:
    for p in CANDIDATE_DAEMON_PATHS:
        if p.exists():
            return p
    return CANDIDATE_DAEMON_PATHS[0]


def is_daemon_online() -> bool:
    """Check health of the resident audio daemon on Port 20129."""
    try:
        url = f"http://{DAEMON_HOST}:{DAEMON_PORT}/health"
        req = urllib.request.Request(url, headers={"User-Agent": "Faust-Sound-CLI/1.0"})
        with urllib.request.urlopen(req, timeout=0.6) as resp:
            return resp.status == 200
    except Exception:
        return False


def ensure_daemon_running():
    """Windowless self-bootstrapping of the resident Kokoro audio daemon."""
    if is_daemon_online():
        return
    daemon_script = _resolve_daemon_script()
    if not daemon_script.exists():
        return

    flags = (
        subprocess.CREATE_NEW_PROCESS_GROUP
        | subprocess.DETACHED_PROCESS
        | subprocess.CREATE_NO_WINDOW
        if os.name == "nt"
        else 0
    )
    try:
        subprocess.Popen(
            [sys.executable, str(daemon_script)],
            cwd=str(daemon_script.parent),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            creationflags=flags,
        )
        for _ in range(15):
            time.sleep(0.3)
            if is_daemon_online():
                break
    except Exception:
        pass


def _speak_daemon(text: str) -> bool:
    """Post speech synthesis request to resident Kokoro audio daemon."""
    url = f"http://{DAEMON_HOST}:{DAEMON_PORT}/speak"
    data = json.dumps({"text": text, "block": True}).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json", "User-Agent": "Faust-Sound-CLI/1.0"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        return resp.status == 200


def _speak_sapi_fallback(text: str):
    """Transparent fallback to native Windows SpeechSynthesizer if daemon is offline."""
    clean_text = text.replace("'", " ").replace('"', " ").replace("\n", " ")
    ps_cmd = (
        f"Add-Type -AssemblyName System.Speech; "
        f"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; "
        f"$s.Speak('{clean_text}')"
    )
    try:
        subprocess.run(
            ["powershell", "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
    except Exception:
        pass


def speak(text: str) -> bool:
    """Vocalize speech text via Kokoro neural daemon or transparent SAPI fallback."""
    if not is_daemon_online():
        ensure_daemon_running()
    try:
        if is_daemon_online() and _speak_daemon(text):
            return True
    except Exception:
        pass
    _speak_sapi_fallback(text)
    return True


def notify_telegram(text: str) -> bool:
    """Mirror spoken text directly to the Manager's Telegram command link."""
    if not TG_BOT_TOKEN or not TG_CHAT_ID:
        return False
    url = f"https://api.telegram.org/bot{TG_BOT_TOKEN}/sendMessage"
    payload = {"chat_id": TG_CHAT_ID, "text": f"🔊 {text}"}
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json", "User-Agent": "Faust-Sound-CLI/1.0"},
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            return resp.status == 200
    except Exception:
        return False


def get_status() -> dict:
    """Fetch status of acoustic and C2 subsystems."""
    daemon_online = is_daemon_online()
    return {
        "resident_daemon": {
            "host": DAEMON_HOST,
            "port": DAEMON_PORT,
            "online": daemon_online,
            "script": str(_resolve_daemon_script()),
        },
        "telegram_mirror": {
            "chat_id": TG_CHAT_ID,
            "configured": bool(TG_BOT_TOKEN and TG_CHAT_ID),
        },
    }


def main():
    parser = argparse.ArgumentParser(description="Faust Acoustic Core & C2 Speech Dispatcher")
    parser.add_argument("text", nargs="*", default=None, help="Text to speak")
    parser.add_argument("--no-tg", action="store_true", help="Disable Telegram mirroring")
    parser.add_argument("--no-tts", action="store_true", help="Disable acoustic vocalization")
    parser.add_argument("--status", action="store_true", help="Print subsystem status")

    args = parser.parse_args()

    if args.status:
        status = get_status()
        print("=== Faust Acoustic Core Status ===")
        print(f"  Audio Daemon: {'ONLINE (Port ' + str(DAEMON_PORT) + ')' if status['resident_daemon']['online'] else 'OFFLINE (Fallback Active)'}")
        print(f"  Daemon Path:  {status['resident_daemon']['script']}")
        print(f"  Telegram C2:  {'CONFIGURED (Chat ' + str(TG_CHAT_ID) + ')' if status['telegram_mirror']['configured'] else 'OFFLINE'}")
        return

    words = args.text or []
    if words and words[0].lower() == "speak":
        words = words[1:]
    speech_text = " ".join(words).strip() or "Faust acoustic core online."

    if not args.no_tts:
        speak(speech_text)
    if not args.no_tg:
        notify_telegram(speech_text)


if __name__ == "__main__":
    main()
