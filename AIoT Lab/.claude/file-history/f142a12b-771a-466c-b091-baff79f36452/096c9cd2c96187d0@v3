class AgentExecutionLoop:
    """Executes multi-step ReAct agent loops for natural language directives."""

    def __init__(self, session_repo: Optional[SessionRepository] = None) -> None:
        self.session_repo = session_repo or SessionRepository()
        self.secrets = load_secrets()

    def _execute_tool(self, name: str, args: Dict[str, Any], cwd: str) -> str:
        """Dispatches tool call to SovereignTools or JobManager."""
        try:
            if name == "run_shell":
                res = SovereignTools.run_shell(args.get("command", ""), cwd=cwd)
            elif name == "read_file":
                res = SovereignTools.read_file(
                    args.get("file_path", ""), cwd=cwd,
                    max_lines=args.get("max_lines", 150),
                    offset=args.get("offset", 1)
                )
            elif name == "write_file":
                res = SovereignTools.write_file(args.get("file_path", ""), args.get("content", ""), cwd=cwd)
            elif name == "edit_file":
                res = SovereignTools.edit_file(
                    args.get("file_path", ""),
                    args.get("old_str", ""),
                    args.get("new_str", ""),
                    cwd=cwd
                )
            elif name == "list_dir":
                res = SovereignTools.list_dir(args.get("dir_path", "."), cwd=cwd)
            elif name == "git_status":
                res = SovereignTools.git_status(cwd=cwd)
            elif name == "git_diff":
                res = SovereignTools.git_diff(cwd=cwd, stat_only=args.get("stat_only", True))
            elif name == "start_background":
                res = JobManager.start_background(args.get("command", ""), args.get("name", "app"), cwd=cwd)
            elif name == "stop_background":
                res = JobManager.stop_background(args.get("job_id", ""))
            elif name == "tail_log":
                res = JobManager.tail_log(args.get("job_id", ""), lines=args.get("lines", 50))
            else:
                return f"Error: Unknown tool '{name}'."

            out = res.output if res.success else f"Error: {res.error}"
            return out[:3500]
        except Exception as e:
            return f"Tool execution exception: {str(e)}"

    def execute_directive(
        self,
        text: str,
        cwd: str,
        workspace_name: str,
        thread_id: str,
        progress_cb: Optional[Callable[[str], None]] = None
    ) -> ExecutionResult:
        """Runs iterative agent loop until resolution or max steps."""
        gemini_key = self.secrets.get("GEMINI_API_KEY", "")
        anthropic_key = self.secrets.get("ANTHROPIC_API_KEY", "")

        if not gemini_key and not anthropic_key:
            # Fallback to local authenticated Claude Code CLI if available
            if progress_cb:
                progress_cb("🔄 Synthesizing directive via Claude Code engine...")
            try:
                import subprocess
                cmd = ["claude", "-p", text, "--dangerously-skip-permissions"]
                res = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=120)
                if res.returncode == 0 and res.stdout.strip():
                    return ExecutionResult(success=True, output=res.stdout.strip())
                err_msg = res.stderr.strip() or "No output from CLI engine."
                return ExecutionResult(
                    success=False, output="",
                    error=f"Claude CLI returned exit code {res.returncode}: {err_msg[:300]}"
                )
            except Exception as e:
                return ExecutionResult(
                    success=False, output="",
                    error=f"Model engine unavailable. Please configure GEMINI_API_KEY or ANTHROPIC_API_KEY in D:\\Program Data\\faust_daemon\\secrets.env. Error: {str(e)}"
                )

        system_prompt = (
            f"You are Faust, sovereign analytical intelligence for The Manager.\n"
            f"Active Workspace: {workspace_name} (Directory: {cwd})\n"
            f"Storage Policy: Local Disk D:\\ STRICTLY. Never write to C:\\.\n"
            f"Modularity: Keep code clean, modular, and fail-loud with clear errors.\n"
            f"Tools: Call tools to inspect, edit, build, or run apps. Once done, provide a clear briefing."
        )

        # Load recent context
        history = self.session_repo.get_recent_history(thread_id, limit=8)
        messages = [{"role": h.role, "content": h.content} for h in history]
        messages.append({"role": "user", "content": text})

        for step in range(10):
            try:
                if gemini_key:
                    resp = ModelProvider.call_gemini(messages, TOOLS_DECLARATION, system_prompt, gemini_key)
                else:
                    resp = ModelProvider.call_anthropic(messages, TOOLS_DECLARATION, system_prompt, anthropic_key)
            except Exception as e:
                return ExecutionResult(success=False, output="", error=f"Model API error: {str(e)}")

            tool_calls = resp.get("tool_calls", [])
            reply_text = resp.get("text", "")

            if not tool_calls:
                return ExecutionResult(success=True, output=reply_text or "Task completed.")

            for tc in tool_calls:
                t_name = tc.get("name")
                t_args = tc.get("args", {})
                if progress_cb:
                    progress_cb(f"🔄 Executing <code>{t_name}</code>...")

                t_out = self._execute_tool(t_name, t_args, cwd=cwd)
                messages.append({"role": "assistant", "content": f"Called tool {t_name} with {json.dumps(t_args)}"})
                messages.append({"role": "user", "content": f"Tool {t_name} result:\n{t_out}"})

        return ExecutionResult(success=True, output="Completed maximum allowed execution steps.")
