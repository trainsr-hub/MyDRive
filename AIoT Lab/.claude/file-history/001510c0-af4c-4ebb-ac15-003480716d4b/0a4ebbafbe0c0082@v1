{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrescriptQuote",
  "description": "Canonical Schema for Prescripts / Entropy Rose Quote System with flexible dates, hex speaker entities, and O(1) CQRS projections",
  "type": "object",
  "required": ["id", "index", "main_content", "date"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16}$",
      "description": "Deterministic 16-character hex-encoded millisecond timestamp for O(1) temporal sorting"
    },
    "index": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing human-readable integer sequence identifier (1 => inf)"
    },
    "main_content": {
      "type": "string",
      "description": "Primary quote or core wisdom text"
    },
    "context": {
      "type": "string",
      "description": "Situational backdrop, interpretation, or genesis context"
    },
    "date": {
      "type": "string",
      "description": "Flexible date string: YYYY (e.g. 2020), YYYY-MM (e.g. 2023-05), YYYY-MM-DD (e.g. 2026-09-30), or range (e.g. 2020~2023-05)"
    },
    "specific_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of 16-character hex IDs pointing to specific endpoints (works, characters, diary, wisdom in Table 3)"
    },
    "preference": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of 16-character hex IDs of quotes that respond to or follow up on this quote"
    },
    "backlink": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of URL strings or reference links"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of semantic taxonomy tags defined by the Manager"
    },
    "sentiment": {
      "type": "string",
      "description": "Emotional, psychological, or philosophical resonance (e.g. stoic, nostalgic, analytical)"
    }
  }
}
