    // ========== SVG TREE DIAGRAM ENGINE ==========
    const NODE_W = 200, NODE_H = 36, GAP_X = 40, GAP_Y = 28, PAD = 20;

    function truncText(t, max = 22) {
      return t && t.length > max ? t.substring(0, max) + '…' : (t || '');
    }

    function svgNode(x, y, label, sublabel, color, isMockId) {
      const mockTag = isMockId ? `<text x="${x + NODE_W - 8}" y="${y + 12}" text-anchor="end" font-size="8" font-weight="700" fill="${color}" opacity="0.7">M</text>` : '';
      return `
        <rect x="${x}" y="${y}" width="${NODE_W}" height="${NODE_H}" rx="6" fill="var(--bg-card)" stroke="${color}" stroke-width="1.5"/>
        <text x="${x + 10}" y="${y + 15}" font-size="11" font-weight="700" fill="var(--text-vivid)">${truncText(label, 24)}</text>
        ${sublabel ? `<text x="${x + 10}" y="${y + 28}" font-size="9" fill="var(--text-muted)">${truncText(sublabel, 28)}</text>` : ''}
        ${mockTag}
      `;
    }

    function svgLine(x1, y1, x2, y2, color) {
      const midY = (y1 + y2) / 2;
      return `<path d="M${x1},${y1} C${x1},${midY} ${x2},${midY} ${x2},${y2}" fill="none" stroke="${color}" stroke-width="1.2" opacity="0.5"/>`;
    }

    // 1. Container => Specific => Quotes (Multiple Trees)
    function renderCSQTreeDiagram(canvas) {
      document.getElementById('tree-visual-title').textContent = "1. Container → Specific → Quotes";
      document.getElementById('tree-visual-desc').textContent = "Each Container is a separate tree root. M = mock scaffolding data.";

      let allSVGs = '';

      availableContainers.forEach(c => {
        const specs = availableSpecifics.filter(s => s.container_id === c.id);
        if (specs.length === 0) return;

        let totalLeaves = 0;
        const specData = specs.map(s => {
          const quotes = allQuotesList.filter(q => q.specific_id === s.id);
          totalLeaves += Math.max(quotes.length, 1);
          return { spec: s, quotes };
        });

        const treeH = totalLeaves * (NODE_H + GAP_Y) + PAD * 2;
        const treeW = NODE_W * 3 + GAP_X * 2 + PAD * 2;

        let svg = `<svg width="${treeW}" height="${treeH}" xmlns="http://www.w3.org/2000/svg" style="display:block; margin-bottom:1.5rem;">`;

        // Root node (Container)
        const rootX = PAD;
        const rootY = treeH / 2 - NODE_H / 2;
        svg += svgNode(rootX, rootY, c.name, c.type || 'origin', 'var(--accent)', isMock(c.id));

        // Specific nodes (Level 2)
        const specX = PAD + NODE_W + GAP_X;
        let leafIdx = 0;

        specData.forEach(({ spec: s, quotes }) => {
          const childCount = Math.max(quotes.length, 1);
          const blockH = childCount * (NODE_H + GAP_Y);
          const specY = PAD + leafIdx * (NODE_H + GAP_Y) + blockH / 2 - NODE_H / 2;

          svg += svgLine(rootX + NODE_W, rootY + NODE_H / 2, specX, specY + NODE_H / 2, 'var(--accent)');
          svg += svgNode(specX, specY, s.name, s.category || 'endpoint', 'var(--border-bright)', isMock(s.id));

          // Quote nodes (Level 3)
          const quoteX = specX + NODE_W + GAP_X;
          if (quotes.length === 0) {
            const qY = PAD + leafIdx * (NODE_H + GAP_Y);
            svg += svgLine(specX + NODE_W, specY + NODE_H / 2, quoteX, qY + NODE_H / 2, 'var(--border-mid)');
            svg += svgNode(quoteX, qY, '(no quotes)', '', 'var(--border-dim)', false);
            leafIdx++;
          } else {
            quotes.forEach(q => {
              const qY = PAD + leafIdx * (NODE_H + GAP_Y);
              svg += svgLine(specX + NODE_W, specY + NODE_H / 2, quoteX, qY + NODE_H / 2, 'var(--border-mid)');
              svg += svgNode(quoteX, qY, `#${q.index} "${truncText(q.main_content.split('\n')[0], 18)}"`, q.date, 'var(--hazard-low)', isMock(q.id));
              leafIdx++;
            });
          }
        });

        svg += '</svg>';
        allSVGs += svg;
      });

      canvas.innerHTML = allSVGs || '<div style="color:var(--text-muted); padding:1rem;">No containers with specifics found.</div>';
    }

    // 2. Themes (child_of) — Multiple Root Trees
    function renderThemesTreeDiagram(canvas) {
      document.getElementById('tree-visual-title').textContent = "2. Themes (child_of Hierarchy)";
      document.getElementById('tree-visual-desc').textContent = "Each root theme is a separate tree. Sub-themes branch recursively.";

      const roots = availableThemes.filter(t => !t.child_of);
      const childrenMap = {};
      availableThemes.forEach(t => {
        if (t.child_of) {
          if (!childrenMap[t.child_of]) childrenMap[t.child_of] = [];
          childrenMap[t.child_of].push(t);
        }
      });

      function countLeaves(nodeId) {
        const children = childrenMap[nodeId] || [];
        if (children.length === 0) return 1;
        return children.reduce((sum, c) => sum + countLeaves(c.id), 0);
      }

      function renderBranch(node, x, yStart, yEnd) {
        const nodeY = (yStart + yEnd) / 2 - NODE_H / 2;
        let svg = svgNode(x, nodeY, node.name, node.notes || '', 'var(--accent)', isMock(node.id));

        const children = childrenMap[node.id] || [];
        if (children.length === 0) return svg;

        const childX = x + NODE_W + GAP_X;
        let childYCursor = yStart;

        children.forEach(child => {
          const leafCount = countLeaves(child.id);
          const childBlockH = leafCount * (NODE_H + GAP_Y);
          const childNodeY = childYCursor + childBlockH / 2 - NODE_H / 2;

          svg += svgLine(x + NODE_W, nodeY + NODE_H / 2, childX, childNodeY + NODE_H / 2, 'var(--accent)');
          svg += renderBranch(child, childX, childYCursor, childYCursor + childBlockH);
          childYCursor += childBlockH;
        });

        return svg;
      }

      function getDepth(nodeId) {
        const children = childrenMap[nodeId] || [];
        if (children.length === 0) return 1;
        return 1 + Math.max(...children.map(c => getDepth(c.id)));
      }

      let allSVGs = '';

      roots.forEach(root => {
        const leaves = countLeaves(root.id);
        const depth = getDepth(root.id);
        const treeH = leaves * (NODE_H + GAP_Y) + PAD * 2;
        const treeW = depth * (NODE_W + GAP_X) + PAD * 2;

        let svg = `<svg width="${treeW}" height="${treeH}" xmlns="http://www.w3.org/2000/svg" style="display:block; margin-bottom:1.5rem;">`;
        svg += renderBranch(root, PAD, PAD, treeH - PAD);
        svg += '</svg>';
        allSVGs += svg;
      });

      canvas.innerHTML = allSVGs || '<div style="color:var(--text-muted); padding:1rem;">No themes found.</div>';
    }

    // 3. Specific → Usages (Multiple Trees)
    function renderSpecificUsagesTreeDiagram(canvas) {
      document.getElementById('tree-visual-title').textContent = "3. Specific → Default Usages";
      document.getElementById('tree-visual-desc').textContent = "Each Specific endpoint is a tree root with its default usage modes as children.";

      let allSVGs = '';

      availableSpecifics.forEach(s => {
        const usageIds = s.default_usage_ids || [];
        if (usageIds.length === 0) return;

        const usages = usageIds.map(uid => availableUsages.find(u => u.id === uid)).filter(Boolean);
        const leafCount = usages.length;
        const treeH = leafCount * (NODE_H + GAP_Y) + PAD * 2;
        const treeW = NODE_W * 2 + GAP_X + PAD * 2;

        let svg = `<svg width="${treeW}" height="${treeH}" xmlns="http://www.w3.org/2000/svg" style="display:block; margin-bottom:1.5rem;">`;

        const rootX = PAD;
        const rootY = treeH / 2 - NODE_H / 2;
        const cname = s.container ? s.container.name : (s.container_name || '');
        svg += svgNode(rootX, rootY, s.name, cname, 'var(--accent)', isMock(s.id));

        const childX = rootX + NODE_W + GAP_X;
        usages.forEach((u, i) => {
          const uY = PAD + i * (NODE_H + GAP_Y);
          svg += svgLine(rootX + NODE_W, rootY + NODE_H / 2, childX, uY + NODE_H / 2, 'var(--border-bright)');
          svg += svgNode(childX, uY, `${u.icon || ''} ${u.name}`, u.description || '', 'var(--hazard-low)', isMock(u.id));
        });

        svg += '</svg>';
        allSVGs += svg;
      });

      canvas.innerHTML = allSVGs || '<div style="color:var(--text-muted); padding:1rem;">No specifics with usages found.</div>';
    }

    function toggleTheme() {
      const html = document.documentElement;
      const cur = html.getAttribute('data-theme') || 'dark';
      const nxt = cur === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', nxt);
      localStorage.setItem('prescripts-theme', nxt);
    }

    // ==============================================================================
    // TURSO CLOUD ONE-WAY SYNC (LOCAL SQLITE -> TURSO CLOUD)
    // ==============================================================================
    async function syncToTursoCloud() {
      const btns = document.querySelectorAll(".btn-turso-sync");
      btns.forEach(b => {
        b.dataset.origText = b.innerHTML;
        b.disabled = true;
        b.style.opacity = "0.6";
        b.innerHTML = "⏳ Syncing to Turso...";
      });

      try {
        const res = await fetch(`${API_BASE}/api/turso/sync`, { method: "POST" });
        const data = await res.json();
        if (res.ok && data.ok) {
          const c = data.counts || {};
          fireToast(`✓ Turso Cloud Updated! (${c.quotes || 0} quotes, ${c.specifics || 0} specifics, ${c.containers || 0} containers)`);
        } else {
          alert(`Cloud Sync Error: ${data.error || res.statusText}`);
          fireToast("❌ Cloud Sync Failed");
        }
      } catch (err) {
        alert("Failed to connect to local server for Turso sync.");
      } finally {
        btns.forEach(b => {
          b.disabled = false;
          b.style.opacity = "1";
          if (b.dataset.origText) b.innerHTML = b.dataset.origText;
        });
      }
    }

    // Backend Synchronizer
    async function fetchBackendData() {
      try {
        const taxRes = await fetch(`${API_BASE}/api/taxonomy`);
        if (taxRes.ok) {
          const tax = await taxRes.json();
          if (tax.containers) availableContainers = tax.containers;
          if (tax.specifics) availableSpecifics = tax.specifics;
          if (tax.themes) availableThemes = tax.themes;
          if (tax.usages) availableUsages = tax.usages;
        }

        const qRes = await fetch(`${API_BASE}/api/quotes`);
        if (qRes.ok) {
          const quotes = await qRes.json();
          if (Object.keys(quotes).length > 0) availableQuotes = quotes;
        }

        const listRes = await fetch(`${API_BASE}/api/quotes/list`);
        if (listRes.ok) {
          allQuotesList = await listRes.json();
        }

        const idxRes = await fetch(`${API_BASE}/api/next_index`);
        if (idxRes.ok) {
          const data = await idxRes.json();
          activeQuote.index = data.next_index ?? data.next_idx ?? 1;
          activeQuote.idx = activeQuote.index;
        }
      } catch (e) {}

      renderUsagePills();
      renderPrefChips();
      renderThemeChips();
      renderLiveJSON();
    }

    // Load Archive List for View 5 (Quotes Archive)
    async function loadArchiveList() {
      try {
        const res = await fetch(`${API_BASE}/api/quotes/list`);
        if (res.ok) {
          allQuotesList = await res.json();
          renderActiveTable();
        }
      } catch (e) {}
    }

    // Global Click Listener for Dropdowns
    document.addEventListener('click', function(e) {
      if (!e.target.closest('#date-host')) {
        const dd = document.getElementById('date-dropdown');
        if (dd) dd.classList.remove('open');
      }
      if (!e.target.closest('#specific-combo-wrap')) {
        const menu = document.getElementById('specific-combo-menu');
        const trigger = document.getElementById('specific-combo-trigger');
        if (menu) menu.classList.remove('open');
        if (trigger) trigger.classList.remove('active');
      }
      if (!e.target.closest('#theme-host')) {
        const dd = document.getElementById('theme-dropdown');
        if (dd) dd.classList.remove('open');
      }
      if (!e.target.closest('#pref-host')) {
        const dd = document.getElementById('pref-dropdown');
        if (dd) dd.classList.remove('open');
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const modal = document.getElementById('generic-modal');
        if (modal && modal.classList.contains('open')) {
          handleModalExitRequest('generic-modal');
        }
      }
    });

    window.addEventListener('DOMContentLoaded', async () => {
      const savedTheme = localStorage.getItem('prescripts-theme');
      if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);
      await fetchBackendData();
    });
  </script>
</body>
