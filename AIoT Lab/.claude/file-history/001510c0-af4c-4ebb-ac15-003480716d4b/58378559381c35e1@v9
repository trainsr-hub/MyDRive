      }).join('');
      document.getElementById('active-usage-count').textContent = `${activeQuote.usage_ids.length} selected`;
    }

    function toggleUsage(id) {
      const opt = availableUsages.find(o => o.id === id);
      if (!opt) return;

      if (activeQuote.usage_ids.includes(id)) {
        activeQuote.usage_ids = activeQuote.usage_ids.filter(u => u !== id);
      } else {
        // Enforce conflict matrix: auto-remove conflicting choices!
        const conflicts = opt.conflicts_with || [];
        if (conflicts.length > 0) {
          activeQuote.usage_ids = activeQuote.usage_ids.filter(u => !conflicts.includes(u));
          fireToast(`Resolved conflict for ${opt.name}`);
        }
        activeQuote.usage_ids.push(id);
      }
      renderUsagePills();
      renderLiveJSON();
    }

