  <!-- ======================================================================
       APPLICATION JAVASCRIPT LOGIC
       ====================================================================== -->
  <script>
    const API_BASE = window.location.origin.startsWith('http') ? window.location.origin : 'http://127.0.0.1:20137';

    // State (Zero sentiment, clean relational IDs)
    let activeQuote = {
      id: "",
      index: 1,
      main_content: "",
      context: "",
      date: "",
      specific_id: null,
      theme_ids: [],
      usage_ids: [],
      preference: [],
      backlinks: [],
      scores: [],
      average_score: null
    };

    // Master Cache
    let availableContainers = [];
    let availableSpecifics = [];
    let availableThemes = [];
    let availableUsages = [
      { id: "00050001A1088D80", name: "Rewrite Craft", description: "Sentence rhythm & prose training", icon: "✍️", conflicts_with: ["00050001A1088D83"] },
      { id: "00050001A1088D81", name: "Diary Prompt", description: "Creative catalyst for morning writing", icon: "💡", conflicts_with: [] },
      { id: "00050001A1088D82", name: "Memory Anchor", description: "Core realization from personal history", icon: "⚓", conflicts_with: ["00050001A1088D84"] },
      { id: "00050001A1088D83", name: "Daily Rule", description: "Actionable principle & meta-habit", icon: "📜", conflicts_with: ["00050001A1088D80"] },
      { id: "00050001A1088D84", name: "Perspective / Levity", description: "Cosmic scale / meme / curiosity", icon: "🪐", conflicts_with: ["00050001A1088D82"] }
    ];
    let availableQuotes = {};
    let allQuotesList = [];

    // Hex Generator
    function generateHexId(prefix = "0001") {
      const now = Date.now();
      const hexTs = now.toString(16).toUpperCase().padStart(12, '0').slice(-12);
      const cleanPrefix = String(prefix).toUpperCase().padStart(4, '0').slice(0, 4);
      return `${cleanPrefix}${hexTs}`;
    }

    // View Switcher
    function switchView(viewId, btn) {
      document.querySelectorAll('.view-container').forEach(v => v.classList.remove('active'));
      document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(viewId).classList.add('active');
      if (btn) btn.classList.add('active');
    }

    function fireToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2400);
    }

    function closeAllDropdowns() {
      document.querySelectorAll('.notion-dropdown-menu').forEach(dd => dd.classList.remove('open'));
      document.querySelectorAll('.notion-combobox-trigger').forEach(tr => tr.classList.remove('active'));
    }

    function updateField(field, value) {
      activeQuote[field] = value;
      if (!activeQuote.id && activeQuote.main_content.trim()) {
        activeQuote.id = generateHexId("0001");
      }
      renderLiveJSON();
    }

    function updateBacklink(val) {
      activeQuote.backlinks = val.trim() ? [val.trim()] : [];
      renderLiveJSON();
    }

    function handleScoresInput(val) {
      let cleaned = (val || "").trim();
      if (cleaned.startsWith('[') && cleaned.endsWith(']')) {
        cleaned = cleaned.slice(1, -1);
      }
      const parts = cleaned.split(/[\s,]+/).filter(Boolean);
      const nums = [];
      for (const p of parts) {
        const n = parseFloat(p);
        if (!isNaN(n)) nums.push(Number.isInteger(n) ? parseInt(n, 10) : Math.round(n * 100) / 100);
      }
      activeQuote.scores = nums;
      if (nums.length > 0) {
        const sum = nums.reduce((a, b) => a + b, 0);
        const avg = Math.round((sum / nums.length) * 100) / 100;
        activeQuote.average_score = avg;
        const avgInput = document.getElementById('input-average-score');
        if (avgInput) avgInput.value = avg;
        const badgeVal = document.getElementById('score-preview-val');
        if (badgeVal) badgeVal.textContent = avg;
      } else {
        activeQuote.average_score = null;
        const avgInput = document.getElementById('input-average-score');
        if (avgInput) avgInput.value = '';
        const badgeVal = document.getElementById('score-preview-val');
        if (badgeVal) badgeVal.textContent = '—';
      }
      renderLiveJSON();
    }

    function handleAverageScoreInput(val) {
      const n = parseFloat(val);
      if (!isNaN(n)) {
        activeQuote.average_score = Math.round(n * 100) / 100;
        const badgeVal = document.getElementById('score-preview-val');
        if (badgeVal) badgeVal.textContent = activeQuote.average_score;
      } else {
        activeQuote.average_score = null;
        const badgeVal = document.getElementById('score-preview-val');
        if (badgeVal) badgeVal.textContent = '—';
      }
      renderLiveJSON();
    }

    function renderLiveJSON() {
      const pre = document.getElementById('live-json-pre');
      pre.textContent = JSON.stringify(activeQuote, null, 2);
      const curIdx = activeQuote.idx ?? activeQuote.index ?? 1;
      document.getElementById('live-index-badge').textContent = `IDX: ${curIdx}`;
    }

    // ==============================================================================
    // 2. DATE SUGGESTOR
    // ==============================================================================
    function handleDateInput(val) {
      activeQuote.date = val.trim();
      renderLiveJSON();

      const dropdown = document.getElementById('date-dropdown');
      const list = document.getElementById('date-options-list');
      const q = val.trim().toLowerCase();

      closeAllDropdowns();
      dropdown.classList.add('open');

      const currentYear = new Date().getFullYear();
      let suggestions = [];

      if (!q) {
        suggestions = [`${currentYear}`, `${currentYear}-10`, `${currentYear}-10-02`, `2020~${currentYear}`, `2020`];
      } else {
        if (/^\d{1,4}$/.test(q)) {
          suggestions.push(q, `${q}-01`, `${q}-05`, `${q}~${currentYear}`);
        } else if (/^\d{4}-/.test(q)) {
          suggestions.push(q, `${q}-01`, `${q}-15`);
        } else {
          suggestions.push(q);
        }
      }

      list.innerHTML = suggestions.slice(0, 6).map(s => `
        <div class="dropdown-opt-row" onclick="selectDate('${s}')">
          <span style="color:var(--accent); font-family:'JetBrains Mono'; font-weight:600;">📅 ${s}</span>
        </div>
      `).join('');
    }

    function selectDate(val) {
      document.getElementById('input-date').value = val;
      activeQuote.date = val;
      document.getElementById('date-dropdown').classList.remove('open');
      renderLiveJSON();
    }

    function clearDateInput() {
      document.getElementById('input-date').value = "";
      activeQuote.date = "";
      document.getElementById('date-dropdown').classList.remove('open');
      renderLiveJSON();
    }

    function handleDateKey(e) {
