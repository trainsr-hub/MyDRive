            <td style="text-align:right; white-space:nowrap;">
              <button class="btn-action" style="padding:0.25rem 0.5rem; font-size:0.75rem;" onclick="openEditRecordModal('${row.id}')">✏️ Edit</button>
              <button class="btn-action btn-danger" style="padding:0.25rem 0.5rem; font-size:0.75rem;" onclick="deleteRecord('${row.id}')">🗑️</button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterActiveTable(q) {
      const config = TABLES_CONFIG[currentTableKey];
      const data = config.getData();
      const query = (q || "").toLowerCase().trim();

      if (!query) {
        renderActiveTable(data);
        return;
      }

      const filtered = data.filter(row => {
        const directMatch = Object.values(row).some(val => {
          if (typeof val === 'string') return val.toLowerCase().includes(query);
          if (typeof val === 'number') return String(val).includes(query);
          if (Array.isArray(val)) return val.some(item => String(item).toLowerCase().includes(query));
          return false;
        });
        if (directMatch) return true;

        if (row.theme_ids && Array.isArray(row.theme_ids)) {
          if (row.theme_ids.some(tid => {
            const t = availableThemes.find(item => item.id === tid);
            return t && t.name.toLowerCase().includes(query);
          })) return true;
        }

        if (row.specific_id) {
          const s = availableSpecifics.find(item => item.id === row.specific_id);
          if (s && (s.name.toLowerCase().includes(query) || (s.container && s.container.name.toLowerCase().includes(query)))) return true;
        }

        return false;
      });
      renderActiveTable(filtered);
    }

