    function recalcModalAvgScore() {
      const elScores = document.getElementById('modal-field-scores');
      const elAvg = document.getElementById('modal-field-average_score');
      if (!elScores || !elAvg) return;
      let text = (elScores.value || "").trim();
      if (text.startsWith('[') && text.endsWith(']')) text = text.slice(1, -1);
      const parts = text.split(/[\s,]+/).filter(Boolean);
      const nums = parts.map(p => parseFloat(p)).filter(n => !isNaN(n));
      if (nums.length > 0) {
        const sum = nums.reduce((a, b) => a + b, 0);
        elAvg.value = Math.round((sum / nums.length) * 100) / 100;
      }
    }

    async function saveActiveRecordModal() {
      const config = TABLES_CONFIG[currentTableKey];
      const payload = {};

      for (const f of config.fields) {
        if (f.type === "multi_select") {
          const chks = document.querySelectorAll(`.modal-multi-chk-${f.key}:checked`);
          payload[f.key] = Array.from(chks).map(c => c.value);
        } else if (f.type === "scores_array") {
          const el = document.getElementById(`modal-field-${f.key}`);
          let text = el && el.value ? el.value.trim() : "";
          if (text.startsWith('[') && text.endsWith(']')) text = text.slice(1, -1);
          const parts = text.split(/[\s,]+/).filter(Boolean);
          payload[f.key] = parts.map(p => {
            const n = parseFloat(p);
            return isNaN(n) ? null : (Number.isInteger(n) ? parseInt(n, 10) : Math.round(n * 100) / 100);
          }).filter(n => n !== null);
        } else if (f.type === "decimal_number") {
          const el = document.getElementById(`modal-field-${f.key}`);
          if (el && el.value.trim() !== "") {
            payload[f.key] = Math.round(parseFloat(el.value.trim()) * 100) / 100;
          } else {
            payload[f.key] = null;
          }
        } else if (f.type === "json_array") {
          const el = document.getElementById(`modal-field-${f.key}`);
          payload[f.key] = el && el.value.trim() ? el.value.split(',').map(s => s.trim()).filter(Boolean) : [];
        } else if (f.type === "number") {
          const el = document.getElementById(`modal-field-${f.key}`);
          if (el && el.value.trim() !== "") {
            const numVal = parseInt(el.value.trim(), 10);
            payload[f.key] = numVal;
            if (f.key === 'idx') payload.index = numVal;
            if (f.key === 'index') payload.idx = numVal;
          }
        } else {
          const el = document.getElementById(`modal-field-${f.key}`);
          if (el) payload[f.key] = el.value.trim();
        }

        if (f.required && !payload[f.key]) {
          alert(`${f.label} is required.`);
          return;
        }
      }

      if (payload.scores && payload.scores.length > 0 && (payload.average_score === null || payload.average_score === undefined)) {
        const sum = payload.scores.reduce((a, b) => a + b, 0);
        payload.average_score = Math.round((sum / payload.scores.length) * 100) / 100;
      }

      try {
        const res = await fetch(config.saveEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          closeModal('generic-modal');
          fireToast(`Saved to ${config.title}`);
          await fetchBackendData();
          await loadArchiveList();
          renderActiveTable();
        } else {
          const err = await res.json().catch(() => ({}));
          alert("Error saving: " + (err.error || res.statusText));
        }
      } catch (e) {
        alert("Failed to connect to local server.");
      }
    }

