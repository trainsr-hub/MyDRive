        // Pre-fill default usage IDs from this specific endpoint
        if (s.default_usage_ids && s.default_usage_ids.length > 0) {
          activeQuote.usage_ids = [...s.default_usage_ids];
          renderUsagePills();
          fireToast(`Selected: ${s.name} (Auto-set default usage)`);
