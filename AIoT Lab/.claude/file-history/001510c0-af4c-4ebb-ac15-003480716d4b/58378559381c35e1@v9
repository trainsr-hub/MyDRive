    // ==============================================================================
    // SAVE QUOTE (DIRECT SQLITE)
    // ==============================================================================
    async function saveQuote() {
      if (!activeQuote.main_content.trim()) {
        alert("Please provide the main quote content before saving.");
        return;
      }

      if (!activeQuote.id) activeQuote.id = generateHexId("0001");
      if (!activeQuote.date) activeQuote.date = new Date().toISOString().split('T')[0];

      try {
        const res = await fetch(`${API_BASE}/api/quote`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(activeQuote)
        });

        if (res.ok) {
          const data = await res.json();
          const savedIdx = data.index ?? data.idx;
          fireToast(`✓ Saved Quote #${savedIdx} to SQLite!`);
          activeQuote.index = savedIdx + 1;
          activeQuote.idx = activeQuote.index;
          activeQuote.id = "";
          activeQuote.main_content = "";
          activeQuote.context = "";
          activeQuote.preference = [];
          activeQuote.scores = [];
          activeQuote.average_score = null;
          document.getElementById('input-main-content').value = "";
          document.getElementById('input-context').value = "";
          const sInp = document.getElementById('input-scores');
          if (sInp) sInp.value = "";
          const avgInp = document.getElementById('input-average-score');
          if (avgInp) avgInp.value = "";
          const sBadge = document.getElementById('score-preview-val');
          if (sBadge) sBadge.textContent = "—";
          renderPrefChips();
          renderLiveJSON();
          fetchBackendData();
          return;
        } else {
          const errData = await res.json().catch(() => ({}));
          fireToast("Server Error: " + (errData.error || res.statusText));
        }
      } catch (err) {
        fireToast("❌ Error: Local Server unreachable.");
      }
    }

