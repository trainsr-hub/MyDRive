    function renderUsagePills() {
      const container = document.getElementById('usage-pills-container');
      container.innerHTML = availableUsages.map(opt => {
        const isActive = activeQuote.usage_ids.includes(opt.id);
        const icon = opt.icon || '🏷️';
        return `
          <div class="btn-action ${isActive ? 'btn-primary' : ''}" style="cursor:pointer; font-size:0.82rem;" title="${opt.description || ''}" onclick="toggleUsage('${opt.id}')">
