{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrescriptQuote",
  "description": "Canonical Schema for Prescripts / Entropy Rose Pure 5-Tier Relational Quote System (Zero Sentiment, Zero Shadow Tables)",
  "type": "object",
  "required": ["id", "index", "main_content", "date"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16}$",
      "description": "Deterministic 16-character hex-encoded millisecond timestamp for O(1) temporal sorting"
    },
    "index": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing human-readable integer sequence identifier (1 => inf)"
    },
    "idx": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing integer sequence identifier (synonym for index in SQLite)"
    },
    "main_content": {
      "type": "string",
      "description": "Primary quote or core wisdom text"
    },
    "context": {
      "type": "string",
      "description": "Situational backdrop, interpretation, or genesis context"
    },
    "date": {
      "type": "string",
      "description": "Flexible date string: YYYY (e.g. 2020), YYYY-MM (e.g. 2023-05), YYYY-MM-DD (e.g. 2026-09-30), or range (e.g. 2020~2023-05)"
    },
    "specific_id": {
      "type": ["string", "null"],
      "description": "16-character hex ID pointing to specific endpoint (work, character, diary, wisdom in Table 3)"
    },
    "theme_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of 16-character hex IDs pointing to themes in hierarchical child_of tree (Table 4)"
    },
    "usage_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of 16-character hex IDs pointing to usage modes with conflict matrix (Table 5)"
    },
    "preference": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of 16-character hex IDs of quotes that respond to or follow up on this quote"
    },
    "backlinks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of URL strings or reference links"
    },
    "scores": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Array of numerical scores or ratings (e.g. [5, 6, 4, 7, 5])"
    },
    "average_score": {
      "type": ["number", "null"],
      "description": "Calculated arithmetic mean of scores (e.g. 5.4), null if scores is empty"
    }
  }
}