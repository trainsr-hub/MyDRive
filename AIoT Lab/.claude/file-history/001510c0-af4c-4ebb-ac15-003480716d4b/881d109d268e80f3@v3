<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quote Presentation Studio — E-Paper &amp; Layout Testbed</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400;1,500&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap">
  <style>
    :root {
      --bg-canvas:        #080706;
      --bg-card:          #13100d;
      --bg-card-hover:    #1c1713;
      --bg-input:         #1a1511;
      --text-vivid:       #fffcf7;
      --text-main:        #ede4d8;
      --text-muted:       #8a7b6c;
      --text-dim:         #5c5044;
      --border-dim:       #292018;
      --border-mid:       #3f3226;
      --border-bright:    #634f3c;
      --accent:           #ff9e1b;
      --accent-bg:        rgba(255, 158, 27, 0.12);
      --accent-border:    rgba(255, 158, 27, 0.4);
      --radius-sm:        6px;
      --radius-md:        10px;
      --radius-lg:        14px;
      font-family: "IBM Plex Sans", -apple-system, sans-serif;
      color-scheme: dark;
    }

    :root[data-theme="light"] {
      --bg-canvas:        #f5f3ef;
      --bg-card:          #ffffff;
      --bg-card-hover:    #f9f7f4;
      --bg-input:         #f0ebe3;
      --text-vivid:       #18130e;
      --text-main:        #2c231a;
      --text-muted:       #6b5a49;
      --text-dim:         #9e8c79;
      --border-dim:       #ded5c7;
      --border-mid:       #c5b8a5;
      --border-bright:    #8f7d67;
      --accent:           #d97706;
      --accent-bg:        rgba(217, 119, 6, 0.1);
      --accent-border:    rgba(217, 119, 6, 0.4);
      color-scheme: light;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg-canvas);
      color: var(--text-main);
      padding: 2rem 1.5rem 5rem;
      display: flex;
      justify-content: center;
      line-height: 1.6;
    }

    .container {
      width: 100%;
      max-width: 980px;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    /* Top Control Bar */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border-dim);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .title-group h1 {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-vivid);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .title-group p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .controls-row {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-mid);
      background: var(--bg-card);
      color: var(--text-main);
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .btn:hover { background: var(--bg-card-hover); border-color: var(--border-bright); }
    .btn.active { background: var(--accent); color: #000; border-color: var(--accent); font-weight: 600; }

    select.select-picker {
      padding: 0.45rem 0.8rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-mid);
      background: var(--bg-card);
      color: var(--text-vivid);
      font-size: 0.85rem;
      outline: none;
      cursor: pointer;
    }

    /* Live Adjustments & Tweaker Toolbar */
    .tweaker-panel {
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .tweak-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
    }
    .tweak-label {
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.72rem;
      letter-spacing: 0.05em;
    }

    .segmented-control {
      display: inline-flex;
      background: var(--bg-input);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-sm);
      padding: 2px;
      gap: 2px;
    }
    .seg-btn {
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
      font-weight: 500;
      background: transparent;
      border: none;
      color: var(--text-muted);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.12s ease;
    }
    .seg-btn:hover { color: var(--text-vivid); }
    .seg-btn.active { background: var(--bg-card); color: var(--text-vivid); font-weight: 700; box-shadow: 0 1px 4px rgba(0,0,0,0.2); }

    /* ==========================================================================
       E-PAPER CORE CHASSIS (SIMULATING PHYSICAL 4.2" / 2.9" E-INK HARDWARE)
       ========================================================================== */
    .epaper-chassis {
      width: 100%;
      max-width: 680px;
      margin: 0 auto;
      background: #e5e3dc;
      color: #111111;
      border: 10px solid #282828;
      border-radius: 14px;
      padding: 2.25rem 2.5rem;
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.65);
      position: relative;
      transition: all 0.2s ease;
    }

    /* Dark Inverted E-Paper Mode */
    .epaper-chassis.inverted {
      background: #121212;
      color: #e8e8e8;
      border-color: #383838;
    }
    .epaper-chassis.inverted hr { border-color: #333333; }
    .epaper-chassis.inverted .ep-status-bar { border-bottom-color: #e8e8e8; }
    .epaper-chassis.inverted .ep-footer { border-top-color: #e8e8e8; }
    .epaper-chassis.inverted .ep-context { background: rgba(255, 255, 255, 0.06); border-left-color: #e8e8e8; color: #b8b8b8; }
    .epaper-chassis.inverted .badge-container { background: #222222; border-color: #444444; color: #ffffff; }

    /* Compact 2.9" aspect ratio simulation */
    .epaper-chassis.compact {
      max-width: 520px;
      padding: 1.5rem 1.75rem;
    }

    /* E-Paper Typography Scales */
    .font-scale-sm  .ep-content { font-size: 1.05rem; line-height: 1.55; }
    .font-scale-md  .ep-content { font-size: 1.25rem; line-height: 1.65; }
    .font-scale-lg  .ep-content { font-size: 1.45rem; line-height: 1.75; }
    .font-scale-xl  .ep-content { font-size: 1.75rem; line-height: 1.75; }

    /* E-Paper Typefaces */
    .ep-font-serif .ep-content { font-family: "Lora", "IBM Plex Serif", Georgia, serif; }
    .ep-font-sans  .ep-content { font-family: "IBM Plex Sans", -apple-system, sans-serif; }
    .ep-font-mono  .ep-content { font-family: "JetBrains Mono", monospace; }

    /* Sub-Layout 1: Minimalist Clean (The Manager's Exact Specified Layout) */
    .ep-type-minimal .ep-status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid currentColor;
      padding-bottom: 0.5rem;
      margin-bottom: 1.5rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .ep-type-minimal .ep-content {
      font-style: italic;
      margin-bottom: 1.5rem;
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    .ep-type-minimal .ep-context {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.8rem;
      background: rgba(0, 0, 0, 0.05);
      border-left: 3px solid currentColor;
      padding: 0.65rem 0.9rem;
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .ep-type-minimal .ep-footer {
      border-top: 2px solid currentColor;
      padding-top: 0.75rem;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.75rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .ep-type-minimal .ep-attribution {
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .ep-type-minimal .ep-tags {
      font-weight: 700;
      opacity: 0.85;
      letter-spacing: 0.02em;
    }

    /* Sub-Layout 2: Card Frame / Book Plate */
    .ep-type-cardplate {
      border: 2px solid currentColor;
      padding: 1.5rem 1.75rem;
      position: relative;
    }
    .ep-type-cardplate .ep-card-header {
      display: flex;
      justify-content: space-between;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 1.25rem;
    }
    .ep-type-cardplate .ep-content {
      font-style: italic;
      font-size: 1.25rem;
      line-height: 1.65;
      margin-bottom: 1.5rem;
    }
    .ep-type-cardplate .ep-card-footer {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      border-top: 1px dashed currentColor;
      padding-top: 0.85rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.82rem;
    }

    /* Sub-Layout 3: Modern Typographic Poster */
    .ep-type-poster .ep-idx-huge {
      font-family: "JetBrains Mono", monospace;
      font-size: 2.75rem;
      font-weight: 800;
      line-height: 1;
      opacity: 0.2;
      margin-bottom: -0.85rem;
    }
    .ep-type-poster .ep-content {
      font-style: italic;
      font-size: 1.35rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      position: relative;
      z-index: 1;
    }
    .ep-type-poster .ep-poster-meta {
      display: flex;
      justify-content: space-between;
      border-top: 3px solid currentColor;
      padding-top: 0.65rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.82rem;
      font-weight: 700;
    }

    /* Chips */
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--bg-input);
      border: 1px solid var(--border-dim);
      padding: 0.25rem 0.6rem;
      border-radius: 100px;
      font-size: 0.75rem;
      color: var(--text-main);
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Top Control Bar -->
    <header class="top-bar">
      <div class="title-group">
        <h1><span>📟</span> E-Paper Presentation Studio</h1>
        <p>Prototyping exact microcontroller layouts: Container on left · Italic Content in “quotes” · #Tags</p>
      </div>

      <div class="controls-row">
        <!-- Quote Picker -->
        <select class="select-picker" id="quote-select" onchange="loadSelectedQuote(this.value)">
          <option value="">Loading quotes...</option>
        </select>
        <button class="btn" onclick="pickRandomQuote()">🎲 Random</button>
        <button class="btn" onclick="toggleTheme()">🌓 Theme</button>
      </div>
    </header>

    <!-- LIVE TWEAKER & EXPERIMENTATION PANEL -->
    <section class="tweaker-panel">
      <!-- 1. Layout Type Variant -->
      <div class="tweak-group">
        <span class="tweak-label">Type:</span>
        <div class="segmented-control">
          <button class="seg-btn active" id="type-btn-minimal" onclick="setSubLayout('minimal')">1. Classic Minimal</button>
          <button class="seg-btn" id="type-btn-cardplate" onclick="setSubLayout('cardplate')">2. Book Plate</button>
          <button class="seg-btn" id="type-btn-poster" onclick="setSubLayout('poster')">3. Typographic</button>
        </div>
      </div>

      <!-- 2. Typeface -->
      <div class="tweak-group">
        <span class="tweak-label">Font:</span>
        <div class="segmented-control">
          <button class="seg-btn active" id="font-btn-serif" onclick="setFontFamily('serif')">Serif</button>
          <button class="seg-btn" id="font-btn-sans" onclick="setFontFamily('sans')">Sans</button>
          <button class="seg-btn" id="font-btn-mono" onclick="setFontFamily('mono')">Mono</button>
        </div>
      </div>

      <!-- 3. Size Scale -->
      <div class="tweak-group">
        <span class="tweak-label">Size:</span>
        <div class="segmented-control">
          <button class="seg-btn" id="scale-btn-sm" onclick="setFontScale('sm')">S</button>
          <button class="seg-btn active" id="scale-btn-md" onclick="setFontScale('md')">M</button>
          <button class="seg-btn" id="scale-btn-lg" onclick="setFontScale('lg')">L</button>
          <button class="seg-btn" id="scale-btn-xl" onclick="setFontScale('xl')">XL</button>
        </div>
      </div>

      <!-- 4. Mode Toggles -->
      <div class="tweak-group">
        <button class="btn" id="toggle-context-btn" onclick="toggleContext()">Toggle Context</button>
        <button class="btn" id="toggle-compact-btn" onclick="toggleCompactMode()">2.9" / 4.2"</button>
        <button class="btn" id="toggle-invert-btn" onclick="toggleInvertMode()">Invert (B/W)</button>
      </div>
    </section>

    <!-- MAIN RENDER STAGE (CHASSIS) -->
    <main>
      <div class="epaper-chassis ep-font-serif font-scale-md" id="epaper-stage">
        <!-- Rendered dynamically via JavaScript -->
      </div>
    </main>

    <!-- Raw Payload Drawer -->
    <details style="background:var(--bg-card); border:1px solid var(--border-dim); border-radius:var(--radius-md); padding:1rem; cursor:pointer;">
      <summary style="font-size:0.85rem; font-weight:600; color:var(--text-muted); outline:none;">
        🔍 Inspect Active Quote Data Bundle
      </summary>
      <pre id="raw-payload-json" style="font-family:'JetBrains Mono'; font-size:0.8rem; color:var(--accent); margin-top:1rem; overflow-x:auto;"></pre>
    </details>
  </div>

  <script>
    const API_BASE = window.location.origin.startsWith('http') ? window.location.origin : 'http://127.0.0.1:20137';
    let quotesList = [];
    let activeQuote = null;
    let availableSpecifics = [];
    let availableThemes = [];

    // State Variables for Live Tweaker
    let currentSubLayout = 'minimal'; // 'minimal' | 'cardplate' | 'poster'
    let currentFontFamily = 'serif';   // 'serif' | 'sans' | 'mono'
    let currentFontScale = 'md';       // 'sm' | 'md' | 'lg' | 'xl'
    let showContext = true;
    let isCompact = false;
    let isInverted = false;

    async function init() {
      try {
        const [taxRes, qRes] = await Promise.all([
          fetch(`${API_BASE}/api/taxonomy`).then(r => r.json()).catch(() => ({})),
          fetch(`${API_BASE}/api/quotes/list`).then(r => r.json()).catch(() => [])
        ]);

        availableSpecifics = taxRes.specifics || [];
        availableThemes = taxRes.themes || [];
        quotesList = qRes || [];

        populateSelect();

        // Default to Quote #6 (or first available)
        const target = quotesList.find(q => q.idx === 6) || quotesList[0];
        if (target) loadSelectedQuote(target.id);
      } catch (err) {
        document.getElementById('epaper-stage').innerHTML = `<div style="padding:2rem; text-align:center;">Failed to connect to local server at ${API_BASE}.</div>`;
      }
    }

    function populateSelect() {
      const select = document.getElementById('quote-select');
      if (quotesList.length === 0) {
        select.innerHTML = `<option>No quotes in database</option>`;
        return;
      }
      select.innerHTML = quotesList.map(q => {
        const snippet = q.main_content.split('\n')[0].substring(0, 34);
        return `<option value="${q.id}">#${q.idx ?? q.index} — "${snippet}..."</option>`;
      }).join('');
    }

    function loadSelectedQuote(qid) {
      activeQuote = quotesList.find(q => q.id === qid) || quotesList[0];
      if (!activeQuote) return;

      document.getElementById('quote-select').value = activeQuote.id;
      renderActiveEpaper();
    }

    function pickRandomQuote() {
      if (quotesList.length === 0) return;
      const rnd = quotesList[Math.floor(Math.random() * quotesList.length)];
      loadSelectedQuote(rnd.id);
    }

    // Tweaker Controls
    function setSubLayout(layout) {
      currentSubLayout = layout;
      document.querySelectorAll('[id^="type-btn-"]').forEach(b => b.classList.remove('active'));
      document.getElementById(`type-btn-${layout}`).classList.add('active');
      renderActiveEpaper();
    }

    function setFontFamily(font) {
      currentFontFamily = font;
      document.querySelectorAll('[id^="font-btn-"]').forEach(b => b.classList.remove('active'));
      document.getElementById(`font-btn-${font}`).classList.add('active');
      updateChassisClasses();
    }

    function setFontScale(scale) {
      currentFontScale = scale;
      document.querySelectorAll('[id^="scale-btn-"]').forEach(b => b.classList.remove('active'));
      document.getElementById(`scale-btn-${scale}`).classList.add('active');
      updateChassisClasses();
    }

    function toggleContext() {
      showContext = !showContext;
      document.getElementById('toggle-context-btn').classList.toggle('active', showContext);
      renderActiveEpaper();
    }

    function toggleCompactMode() {
      isCompact = !isCompact;
      document.getElementById('toggle-compact-btn').classList.toggle('active', isCompact);
      updateChassisClasses();
    }

    function toggleInvertMode() {
      isInverted = !isInverted;
      document.getElementById('toggle-invert-btn').classList.toggle('active', isInverted);
      updateChassisClasses();
    }

    function updateChassisClasses() {
      const chassis = document.getElementById('epaper-stage');
      chassis.className = `epaper-chassis ep-font-${currentFontFamily} font-scale-${currentFontScale}`;
      if (isCompact) chassis.classList.add('compact');
      if (isInverted) chassis.classList.add('inverted');
    }

    // Resolve 5-point minimal metadata bundle
    function getBundle(q) {
      if (!q) return null;

      const content = q.main_content || "";
      const context = q.context || "";

      const specific = availableSpecifics.find(s => s.id === q.specific_id);
      const specificName = specific ? specific.name : "—";
      const containerName = specific && specific.container ? specific.container.name : (specific ? (specific.container_name || "—") : "—");

      let effectiveDate = (q.date || "").trim();
      let isFallback = false;
      if (!effectiveDate && specific && specific.date && specific.date.trim()) {
        effectiveDate = specific.date.trim();
        isFallback = true;
      }

      // Prefixed with # for each theme tag
      const rawThemes = (q.theme_ids || []).map(tid => {
        const th = availableThemes.find(t => t.id === tid);
        return th ? th.name : tid;
      });
      const hashtagThemes = rawThemes.map(t => `#${t}`);

      return {
        idx: q.idx ?? q.index,
        content,
        context,
        specificName,
        containerName,
        effectiveDate: effectiveDate || "—",
        isFallback,
        hashtagThemes: hashtagThemes.length > 0 ? hashtagThemes : ["#Wisdom"]
      };
    }

    function renderActiveEpaper() {
      const b = getBundle(activeQuote);
      if (!b) return;

      updateChassisClasses();
      document.getElementById('raw-payload-json').textContent = JSON.stringify(b, null, 2);

      const stage = document.getElementById('epaper-stage');

      // Format content: Italic and wrapped by quotes "“... ”"
      const formattedContent = `“<em>${b.content.replace(/\n/g, '<br>')}</em>”`;

      // Attribution: Container on the left of specifics (Container · Specific)
      const attributionStr = `${b.containerName} · ${b.specificName}`;

      // Tags: all prefixed with #
      const tagsStr = b.hashtagThemes.join(' ');

      if (currentSubLayout === 'minimal') {
        stage.innerHTML = `
          <div class="ep-type-minimal">
            <!-- 1. Status Bar: Clean #IDX and Date (No "QUOTE" or "TURSO CLOUD EDGE") -->
            <div class="ep-status-bar">
              <span>#${b.idx}</span>
              <span>${b.effectiveDate}</span>
            </div>

            <!-- 2. Content: Italic, wrapped by “” -->
            <div class="ep-content">
              ${formattedContent}
            </div>

            <!-- 3. Optional Context -->
            ${(showContext && b.context) ? `
              <div class="ep-context">
                ${b.context}
              </div>
            ` : ''}

            <!-- 4. Footer: Container on LEFT of Specific · Tags with # prefix -->
            <div class="ep-footer">
              <span class="ep-attribution">${attributionStr}</span>
              <span class="ep-tags">${tagsStr}</span>
            </div>
          </div>
        `;
      } else if (currentSubLayout === 'cardplate') {
        stage.innerHTML = `
          <div class="ep-type-cardplate">
            <div class="ep-card-header">
              <span>#${b.idx}</span>
              <span>${b.effectiveDate}</span>
            </div>

            <div class="ep-content">
              ${formattedContent}
            </div>

            ${(showContext && b.context) ? `
              <div style="font-family:'JetBrains Mono'; font-size:0.8rem; opacity:0.85; margin-bottom:1.25rem; font-style:italic;">
                ${b.context}
              </div>
            ` : ''}

            <div class="ep-card-footer">
              <div style="font-weight:700;">${attributionStr}</div>
              <div style="font-size:0.75rem; opacity:0.8;">${tagsStr}</div>
            </div>
          </div>
        `;
      } else if (currentSubLayout === 'poster') {
        stage.innerHTML = `
          <div class="ep-type-poster">
            <div class="ep-idx-huge">#${b.idx}</div>

            <div class="ep-content">
              ${formattedContent}
            </div>

            ${(showContext && b.context) ? `
              <div style="font-family:'JetBrains Mono'; font-size:0.8rem; background:rgba(0,0,0,0.06); padding:0.5rem 0.75rem; border-left:2px solid currentColor; margin-bottom:1.25rem;">
                ${b.context}
              </div>
            ` : ''}

            <div class="ep-poster-meta">
              <span>${attributionStr}</span>
              <span>${b.effectiveDate} · ${tagsStr}</span>
            </div>
          </div>
        `;
      }
    }

    function toggleTheme() {
      const html = document.documentElement;
      const cur = html.getAttribute('data-theme') || 'dark';
      const nxt = cur === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', nxt);
    }

    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>