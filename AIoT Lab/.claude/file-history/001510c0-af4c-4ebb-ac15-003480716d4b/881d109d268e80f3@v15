  <script>
    const API_BASE = window.location.origin.startsWith('http') ? window.location.origin : 'http://127.0.0.1:20137';
    let quotesList = [];
    let activeQuote = null;
    let availableSpecifics = [];
    let availableThemes = [];

    // Hardware Option State
    let showContext = true;
    let isCompact = false;
    let reRollSeed = 0;

    // 2-Color Pool for Quote Marks & Container: Gold vs Blue
    const ACCENT_POOL = [
      { name: "Sapphire Blue", hex: "#38bdf8" },
      { name: "Imperial Gold", hex: "#f59e0b" }
    ];

    // Vast Independent Color Palette for Tags (Golden-Ratio Spectrum Engine)
    function generateVastTagStyle(tagName, tagIndex) {
      let hash = 0;
      for (let i = 0; i < tagName.length; i++) {
        hash = ((hash << 5) - hash) + tagName.charCodeAt(i);
        hash |= 0;
      }
      const goldenAngle = 137.508;
      const hue = Math.abs(Math.floor((hash * goldenAngle + tagIndex * 89 + reRollSeed) % 360));

      const textColor   = `hsl(${hue}, 85%, 72%)`;
      const borderColor = `hsla(${hue}, 70%, 40%, 0.45)`;
      const bgColor     = `hsla(${hue}, 65%, 8%, 0.9)`;
      return `background: ${bgColor} !important; border-color: ${borderColor} !important; color: ${textColor} !important;`;
    }

    async function init() {
      try {
        const [taxRes, qRes] = await Promise.all([
          fetch(`${API_BASE}/api/taxonomy`).then(r => r.json()).catch(err => { console.error('Taxonomy fetch error:', err); return {}; }),
          fetch(`${API_BASE}/api/quotes/list`).then(r => r.json()).catch(err => { console.error('Quotes fetch error:', err); return []; })
        ]);

        availableSpecifics = taxRes.specifics || [];
        availableThemes = taxRes.themes || [];
        quotesList = qRes || [];

        populateSelect();

        // Default to Quote #6 (or first available)
        const target = quotesList.find(q => q.idx === 6) || quotesList[0];
        if (target) {
          loadSelectedQuote(target.id);
        } else {
          document.getElementById('epaper-stage').innerHTML = `<div style="padding:2rem; text-align:center; color:var(--text-muted);">No quotes found in database.</div>`;
        }
      } catch (err) {
        console.error("Init Error:", err);
        document.getElementById('epaper-stage').innerHTML = `<div style="padding:2rem; text-align:center; color:#f43f5e;">Client Render Error: ${err.message}</div>`;
      }
    }

    function populateSelect() {
      const select = document.getElementById('quote-select');
      if (quotesList.length === 0) {
        select.innerHTML = `<option>No quotes in database</option>`;
        return;
      }
      select.innerHTML = quotesList.map(q => {
        const snippet = q.main_content.split('\n')[0].substring(0, 34);
        return `<option value="${q.id}">#${q.idx ?? q.index} — "${snippet}..."</option>`;
      }).join('');
    }

    function loadSelectedQuote(qid) {
      activeQuote = quotesList.find(q => q.id === qid) || quotesList[0];
      if (!activeQuote) return;

      document.getElementById('quote-select').value = activeQuote.id;
      renderActiveEpaper();
    }

    function pickRandomQuote() {
      if (quotesList.length === 0) return;
      const rnd = quotesList[Math.floor(Math.random() * quotesList.length)];
      loadSelectedQuote(rnd.id);
    }

    function reRollColors() {
      reRollSeed = Math.floor(Math.random() * 1000);
      renderActiveEpaper();
    }

    function toggleContext() {
      showContext = !showContext;
      document.getElementById('toggle-context-btn').classList.toggle('active', showContext);
      renderActiveEpaper();
    }


    let currentRatio = '19';
    let autoScrollInterval = null;

    function setScreenRatio(ratioKey) {
      currentRatio = ratioKey;
      const chassis = document.getElementById('epaper-stage');
      chassis.className = 'epaper-chassis ratio-' + ratioKey;
      document.querySelectorAll('.ratio-btn').forEach(b => b.classList.remove('active'));
      const btn = document.getElementById('rb-' + ratioKey);
      if (btn) btn.classList.add('active');
    }

    function scrollViewport(offset) {
      const vp = document.getElementById('ep-viewport');
      if (vp) vp.scrollBy({ top: offset, behavior: 'smooth' });
    }

    function toggleAutoScroll() {
      const btn = document.getElementById('btn-autoscroll');
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
        btn.textContent = 'Auto-Scroll: OFF';
        btn.classList.remove('active');
      } else {
        btn.textContent = 'Auto-Scroll: ON';
        btn.classList.add('active');
        autoScrollInterval = setInterval(() => {
          const vp = document.getElementById('ep-viewport');
          if (vp) {
            if (vp.scrollTop + vp.clientHeight >= vp.scrollHeight - 2) {
              vp.scrollTop = 0;
            } else {
              vp.scrollTop += 1;
            }
          }
        }, 50);
      }
    }

    function toggleCompactMode() {
      isCompact = !isCompact;
      document.getElementById('toggle-compact-btn').classList.toggle('active', isCompact);
      const chassis = document.getElementById('epaper-stage');
      if (chassis) chassis.classList.toggle('compact', isCompact);
    }

    // Resolve minimal 5-point metadata bundle
    function getBundle(q) {
      if (!q) return null;

      const content = q.main_content || "";
      const context = q.context || "";

      const specific = availableSpecifics.find(s => s.id === q.specific_id);
      const specificName = specific ? specific.name : "—";
      const containerName = specific && specific.container ? specific.container.name : (specific ? (specific.container_name || "—") : "—");

      let effectiveDate = (q.date || "").trim();
      let isFallback = false;
      if (!effectiveDate && specific && specific.date && specific.date.trim()) {
        effectiveDate = specific.date.trim();
        isFallback = true;
      }

      const rawThemes = (q.theme_ids || []).map(tid => {
        const th = availableThemes.find(t => t.id === tid);
        return th ? th.name : tid;
      });
      const hashtagThemes = rawThemes.map(t => `#${t}`);
      const rawCategory = specific ? (specific.category || "").trim() : "";

      return {
        idx: q.idx ?? q.index,
        content,
        context,
        category: rawCategory,
        specificName,
        containerName,
        effectiveDate: effectiveDate || "—",
        isFallback,
        hashtagThemes: hashtagThemes.length > 0 ? hashtagThemes : ["#Wisdom"]
      };
    }

    function renderActiveEpaper() {
      const b = getBundle(activeQuote);
      if (!b) return;

      document.getElementById('raw-payload-json').textContent = JSON.stringify(b, null, 2);
      const stage = document.getElementById('epaper-stage');

      // Category-Driven Content Alignment: writing => justify, music/poem => left
      const catLower = (b.category || "").toLowerCase().trim();
      const isWriting = catLower === "writing" || catLower === "bài viết" || catLower === "baiviet";
      const alignClass = isWriting ? "content-justify" : "content-left";

      // Quotation Mark & Container Accent: Random pool of 2 (Gold vs Blue)
      const quoteSeed = (typeof b.idx === 'number' ? b.idx : (parseInt(String(b.idx).replace(/\D/g, ''), 10) || 1)) + reRollSeed;
      const accentIndex = Math.abs(quoteSeed % ACCENT_POOL.length);
      const activeAccent = ACCENT_POOL[accentIndex];
      const sharedAccentColor = activeAccent.hex;

      // Update toolbar accent indicator
      document.getElementById('accent-dot').style.background = sharedAccentColor;
      document.getElementById('accent-name-label').textContent = activeAccent.name;

      // Content: Italic, wrapped by distinct quotation marks matching the Container's color
      const formattedContent = `<span class="ep-qmark ep-qmark-open" style="color:${sharedAccentColor};">“</span><em>${b.content.replace(/\n/g, '<br>')}</em><span class="ep-qmark ep-qmark-close" style="color:${sharedAccentColor};">”</span>`;

      // Header components: Ghost (#666) and smaller font size
      const headerTitleHTML = `<span class="ep-header-left"><strong class="ep-idx-num">#${b.idx}</strong><span class="ep-sep">~</span><span class="ep-specific-title">${b.specificName}</span></span>`;
      const headerDateHTML = `<span class="ep-header-right"><span class="ep-date-label">Date: </span><span class="ep-date-val">${b.effectiveDate}</span></span>`;

      // Tags: Each tag receives an independent random color from the vast spectrum
      const tagsBlocks = b.hashtagThemes.map((t, idx) => {
        const tagStyle = generateVastTagStyle(t, idx);
        return `<span class="ep-tag-block" style="${tagStyle}">${t}</span>`;
      }).join('');

      // Container: Shares the exact same color as the quotation marks (Gold or Blue)
      const containerHTML = `<span class="ep-container-name" style="color:${sharedAccentColor};">${b.containerName}</span>`;

      stage.innerHTML = `
        <!-- 1. Header: #<idx> ~ <specific> on left, Date: <date> on right (Ghost gray & smaller) -->
        <div class="ep-status-bar">
          <div>${headerTitleHTML}</div>
          <div>${headerDateHTML}</div>
        </div>

        <!-- 2. Content: Italic in crisp white, category-driven alignment -->
        <div class="ep-content ${alignClass}">
          ${formattedContent}
        </div>

        <!-- 3. Optional Context -->
        ${(showContext && b.context) ? `
          <div class="ep-context">
            ${b.context}
          </div>
        ` : ''}

        </div>

        <!-- 4. Footer: Tags on LEFT (Vast random colors) · Container on RIGHT (Shared accent) -->
        <div class="ep-footer">
          <div class="ep-tags">${tagsBlocks}</div>
          <div class="ep-attribution">${containerHTML}</div>
        </div>
      `;
    }

    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
