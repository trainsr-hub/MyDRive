<body>

  <div class="container">
    <!-- Top Control Bar -->
    <header class="top-bar">
      <div class="title-group">
        <h1><span>📟</span> Rien-Prescript-Beeper Studio</h1>
        <p>Hardware Specification Preview: <code>#IDX ~ Specific</code> · <code>Date</code> · <code>“Italic”</code> · <code>#Tags</code> · <code>Container</code></p>
      </div>

      <div class="controls-row">
        <select class="select-picker" id="quote-select" onchange="loadSelectedQuote(this.value)">
          <option value="">Loading quotes...</option>
        </select>
