  <style>
    :root {
      --bg-canvas:        #060606;
      --bg-card:          #101010;
      --bg-card-hover:    #181818;
      --bg-input:         #181818;
      --text-vivid:       #ffffff;
      --text-main:        #e0e0e0;
      --text-muted:       #888888;
      --border-dim:       #222222;
      --border-mid:       #333333;
      --radius-sm:        6px;
      --radius-md:        10px;
      font-family: "JetBrains Mono", monospace;
      color-scheme: dark;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg-canvas);
      color: var(--text-main);
      padding: 2rem 1.5rem 5rem;
      display: flex;
      justify-content: center;
      line-height: 1.6;
    }

    .container {
      width: 100%;
      max-width: 860px;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* Top Control Bar */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--border-dim);
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .title-group h1 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-vivid);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .title-group p {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.15rem;
    }

    .controls-row {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.38rem 0.75rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-mid);
      background: var(--bg-card);
      color: var(--text-main);
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.12s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-family: "JetBrains Mono", monospace;
    }
    .btn:hover { background: var(--bg-card-hover); border-color: #555555; color: #fff; }
    .btn.active { background: #ffffff; color: #000000; border-color: #ffffff; font-weight: 700; }

    select.select-picker {
      padding: 0.38rem 0.75rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-mid);
      background: var(--bg-card);
      color: var(--text-vivid);
      font-size: 0.78rem;
      outline: none;
      cursor: pointer;
      font-family: "JetBrains Mono", monospace;
    }

    /* Sub-Toolbar (Active Status + Toggles) */
    .toolbar-bar {
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
      padding: 0.65rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.6rem;
      font-size: 0.75rem;
    }

    .toolbar-info {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--text-muted);
    }
    .active-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.12rem 0.45rem;
