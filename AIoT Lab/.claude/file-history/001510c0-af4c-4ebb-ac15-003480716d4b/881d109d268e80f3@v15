      border: 1px solid var(--border-mid);
      border-radius: 4px;
      color: var(--text-vivid);
      font-weight: 600;
    }

    /* ==========================================================================
       ESP32 E-PAPER HARDWARE CHASSIS
       ========================================================================== */
    .epaper-chassis {
      width: 100%;
      max-width: 760px;
      min-height: 340px;
      aspect-ratio: 16 / 8.5;
      margin: 1.5rem auto;
      border-radius: 10px;
      padding: 1.75rem 2.25rem;
      position: relative;
      background: #000000 !important;
      color: #ffffff !important;
      border: 10px solid #1c1c1c;
