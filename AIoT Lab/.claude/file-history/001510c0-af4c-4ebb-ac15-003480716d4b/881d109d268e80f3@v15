      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s ease;
    }

    /* Horizontal Landscape Content Centering */

    /* Screen Ratio Configurations */
    .ratio-19 { max-width: 680px !important; aspect-ratio: 320 / 170 !important; }
    .ratio-19 .ep-viewport { max-height: 220px !important; }
    .ratio-24 { max-width: 600px !important; aspect-ratio: 4 / 3 !important; }
    .ratio-24 .ep-viewport { max-height: 310px !important; }
    .ratio-213 { max-width: 640px !important; aspect-ratio: 250 / 122 !important; }
    .ratio-213 .ep-viewport { max-height: 185px !important; }
    .ratio-29 { max-width: 720px !important; aspect-ratio: 296 / 128 !important; }
    .ratio-29 .ep-viewport { max-height: 185px !important; }
    .ratio-169 { max-width: 530px !important; aspect-ratio: 280 / 240 !important; }
