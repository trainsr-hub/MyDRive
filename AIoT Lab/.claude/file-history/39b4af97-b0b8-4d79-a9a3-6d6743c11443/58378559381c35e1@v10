<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Prescripts Studio — Navigation &amp; Curation Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
  <style>
    /* ==========================================================================
       PRESCRIPTS STUDIO — SINGLE-PAGE CRUD & NAVIGATION HUB
       ========================================================================== */
    :root {
      --bg-canvas:        #080706;
      --bg-card:          #13100d;
      --bg-card-hover:    #1c1713;
      --bg-input:         #1a1511;
      --bg-input-focus:   #231c16;

      --text-vivid:       #fffcf7;
      --text-main:        #ede4d8;
      --text-muted:       #8a7b6c;
      --text-dim:         #5c5044;

      --border-dim:       #292018;
      --border-mid:       #3f3226;
      --border-bright:    #634f3c;

      --accent:           #ff9e1b;
      --accent-hover:     #ffb03a;
      --accent-glow:      rgba(255, 158, 27, 0.25);
      --accent-bg:        rgba(255, 158, 27, 0.12);
      --accent-border:    rgba(255, 158, 27, 0.4);

      --hazard-high:      #f43f5e;
      --hazard-low:       #10b981;

      --radius-sm:        6px;
      --radius-md:        10px;
      --radius-lg:        14px;
      --shadow-subtle:    0 4px 20px rgba(0, 0, 0, 0.5);

      color-scheme: dark;
      font-family: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14.5px;
      line-height: 1.5;
    }

    :root[data-theme="light"] {
      --bg-canvas:        #f5f3ef;
      --bg-card:          #ffffff;
      --bg-card-hover:    #f9f7f4;
      --bg-input:         #f0ebe3;
      --bg-input-focus:   #ffffff;

      --text-vivid:       #18130e;
      --text-main:        #2c231a;
      --text-muted:       #6b5a49;
      --text-dim:         #9e8c79;

      --border-dim:       #ded5c7;
      --border-mid:       #c5b8a5;
      --border-bright:    #8f7d67;

      --accent:           #d97706;
      --accent-hover:     #b45309;
      --accent-glow:      rgba(217, 119, 6, 0.2);
      --accent-bg:        rgba(217, 119, 6, 0.1);
      --accent-border:    rgba(217, 119, 6, 0.4);

      --hazard-high:      #e11d48;
      --hazard-low:       #059669;

      color-scheme: light;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100%; }

    body {
      background: var(--bg-canvas);
      color: var(--text-main);
      padding: 1.5rem 1.5rem 4rem;
      display: flex;
      justify-content: center;
      overflow-x: hidden;
    }

    .app-container {
      width: 100%;
      max-width: 1440px;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* Top Navigation */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border-dim);
      padding-bottom: 1rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .title-stack h1 {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--text-vivid);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .title-stack h1 .badge {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--accent);
      background: var(--accent-bg);
      border: 1px solid var(--accent-border);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      text-transform: uppercase;
    }

    /* Navigation Tabs */
    .nav-tabs-bar {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      padding: 0.35rem;
      border-radius: var(--radius-md);
    }

    .nav-tab-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      padding: 0.5rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.15s ease;
    }

    .nav-tab-btn:hover {
      color: var(--text-vivid);
      background: var(--bg-input);
    }

    .nav-tab-btn.active {
      background: var(--accent-bg);
      border-color: var(--accent-border);
      color: var(--accent);
      font-weight: 700;
    }

    .btn-action {
      background: var(--bg-card);
      border: 1px solid var(--border-mid);
      color: var(--text-main);
      padding: 0.5rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.15s ease;
    }

    .btn-action:hover {
      background: var(--bg-card-hover);
      border-color: var(--accent);
      color: var(--text-vivid);
    }

    .btn-action.btn-primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #080706;
      font-weight: 700;
    }

    .btn-action.btn-danger:hover {
      background: rgba(244, 63, 94, 0.15);
      border-color: var(--hazard-high);
      color: var(--hazard-high);
    }

    /* Views Host */
    .view-container {
      display: none;
      animation: fadeIn 0.15s ease;
    }

    .view-container.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Form & Workspace */
    .workspace-grid {
      display: grid;
      grid-template-columns: 1fr 420px;
      gap: 1.5rem;
      align-items: start;
    }

    @media (max-width: 1024px) {
      .workspace-grid { grid-template-columns: 1fr; }
    }

    .blocks-stream {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .entry-card {
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
      overflow: visible !important;
      position: relative;
      box-shadow: var(--shadow-subtle);
    }

    .entry-card:focus-within {
      border-color: var(--border-mid);
      z-index: 50;
    }

    .card-header {
      padding: 0.85rem 1.15rem;
      background: rgba(255, 255, 255, 0.015);
      border-bottom: 1px solid var(--border-dim);
      display: flex;
      justify-content: space-between;
      align-items: center;
      user-select: none;
    }

    .card-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text-vivid);
    }

    .card-tag {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--accent);
      background: var(--accent-bg);
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      border: 1px solid var(--accent-border);
      text-transform: uppercase;
    }

    .card-body {
      padding: 1.15rem;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .field-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
    }

    .field-hint {
      font-size: 0.72rem;
      color: var(--text-dim);
      font-family: "JetBrains Mono", monospace;
    }

    /* Inputs */
    .raw-input-box {
      width: 100%;
      height: 44px;
      background: var(--bg-input);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-sm);
      color: var(--text-vivid);
      font-family: inherit;
      font-size: 0.9rem;
      padding: 0 0.85rem;
      outline: none;
      transition: all 0.15s ease;
    }

    .raw-input-box:focus {
      background: var(--bg-input-focus);
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .raw-textarea-box {
      width: 100%;
      min-height: 100px;
      background: var(--bg-input);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-sm);
      color: var(--text-vivid);
      font-family: "JetBrains Mono", monospace;
      font-size: 0.88rem;
      padding: 0.85rem;
      outline: none;
      resize: vertical;
      line-height: 1.6;
      transition: all 0.15s ease;
    }

    .raw-textarea-box:focus {
      background: var(--bg-input-focus);
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    /* Single Selector Styles */
    .notion-combobox-wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      overflow: visible !important;
    }

    .notion-combobox-trigger {
      width: 100%;
      min-height: 44px;
      background: var(--bg-input);
      border: 1px solid var(--border-mid);
      border-radius: var(--radius-sm);
      padding: 0.35rem 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      transition: all 0.15s ease;
      user-select: none;
    }

    .notion-combobox-trigger:hover,
    .notion-combobox-trigger.active {
      background: var(--bg-input-focus);
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .selected-val-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--accent-bg);
      color: var(--accent);
      border: 1px solid var(--accent-border);
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      font-weight: 600;
      font-size: 0.85rem;
    }

    .combobox-chevron {
      color: var(--text-muted);
      font-size: 0.8rem;
      transition: transform 0.2s ease;
    }

    .notion-combobox-trigger.active .combobox-chevron {
      transform: rotate(180deg);
      color: var(--accent);
    }

    /* Suggestor Monolith */
    .suggestor-host {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      overflow: visible !important;
    }

    .searcher-monolith {
      width: 100%;
      height: 44px;
      background: var(--bg-input);
      border: 1px solid var(--border-mid);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      padding: 0 0.85rem;
      gap: 0.65rem;
      transition: all 0.15s ease;
    }

    .searcher-monolith:focus-within {
      background: var(--bg-input-focus);
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .searcher-icon {
      color: var(--accent);
      font-size: 1rem;
      flex-shrink: 0;
      user-select: none;
    }

    .searcher-input {
      width: 100%;
      height: 100%;
      background: transparent;
      border: none;
      outline: none;
      color: var(--text-vivid);
      font-size: 0.9rem;
      font-family: inherit;
    }

    .searcher-clear {
      background: rgba(255, 255, 255, 0.08);
      border: none;
      color: var(--text-muted);
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.75rem;
      flex-shrink: 0;
    }

    /* Selected Chips */
    .selected-chips-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .selected-chips-row:empty { display: none; }

    .chip-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--accent-bg);
      color: var(--accent);
      border: 1px solid var(--accent-border);
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      font-size: 0.8rem;
      font-weight: 600;
      user-select: none;
    }

    .chip-remove {
      cursor: pointer;
      opacity: 0.7;
      font-size: 0.75rem;
      padding: 0 2px;
      border-radius: 2px;
    }

    .chip-remove:hover {
      opacity: 1;
      background: rgba(244, 63, 94, 0.2);
      color: #fb7185;
    }

    /* Dropdown Menus */
    .notion-dropdown-menu {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      background: var(--bg-card);
      border: 1px solid var(--border-bright);
      border-radius: var(--radius-sm);
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.85);
      z-index: 1000 !important;
      display: none;
      flex-direction: column;
      overflow: hidden;
      max-height: 260px;
    }

    .notion-dropdown-menu.open { display: flex; }

    .dropdown-options-list {
      overflow-y: auto;
      padding: 0.4rem;
      display: flex;
      flex-direction: column;
      gap: 2px;
      max-height: 200px;
    }

    .dropdown-opt-row {
      padding: 0.55rem 0.75rem;
      border-radius: 4px;
      font-size: 0.88rem;
      color: var(--text-main);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.1s ease;
      gap: 0.5rem;
    }

    .dropdown-opt-row:hover {
      background: var(--bg-input-focus);
      color: var(--accent);
    }

    .dropdown-opt-row.selected {
      background: var(--accent-bg);
      border: 1px solid var(--accent-border);
      color: var(--accent);
    }

    .opt-label-group {
      display: flex;
      flex-direction: column;
      min-width: 0;
      flex: 1 1 auto;
      gap: 2px;
    }

    .opt-title-row {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .opt-title {
      font-weight: 600;
      font-size: 0.88rem;
      color: var(--text-vivid);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .opt-context {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-style: italic;
      opacity: 0.65;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .opt-delete-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-dim);
      width: 22px;
      height: 22px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      cursor: pointer;
      flex-shrink: 0;
    }

    .opt-delete-btn:hover {
      background: rgba(244, 63, 94, 0.18);
      border-color: rgba(244, 63, 94, 0.4);
      color: #fb7185;
    }

    .dropdown-create-row {
      padding: 0.6rem 0.75rem;
      background: var(--accent-bg);
      border-top: 1px solid var(--accent-border);
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .dropdown-create-row:hover {
      background: var(--accent);
      color: #080706;
    }

    /* CRUD Grid & Table Views */
    .crud-view-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .crud-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.25rem;
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
    }

    .crud-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    .crud-table th {
      text-align: left;
      padding: 0.75rem 1rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.72rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--border-dim);
    }

    .crud-table td {
      padding: 0.85rem 1rem;
      font-size: 0.88rem;
      border-bottom: 1px solid var(--border-dim);
      color: var(--text-main);
      vertical-align: middle;
    }

    .crud-table tr:last-child td { border-bottom: none; }
    .crud-table tr:hover td { background: var(--bg-card-hover); }

    /* Tree View for Themes */
    .theme-tree-node {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.65rem 0.85rem;
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-sm);
      margin-bottom: 0.4rem;
      transition: all 0.15s ease;
    }

    .theme-tree-node:hover {
      border-color: var(--border-mid);
      background: var(--bg-card-hover);
    }

    .theme-tree-node.child-level-1 { margin-left: 1.5rem; border-left: 3px solid var(--accent); }
    .theme-tree-node.child-level-2 { margin-left: 3rem; border-left: 3px solid var(--hazard-low); }

    /* Inspector Sticky */
    .inspector-sticky {
      position: sticky;
      top: 1.5rem;
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-subtle);
    }

    .inspector-header {
      padding: 0.75rem 1.15rem;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--border-dim);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .live-json-display {
      padding: 1rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.76rem;
      line-height: 1.5;
      color: var(--text-main);
      background: var(--bg-canvas);
      max-height: 520px;
      overflow-y: auto;
      white-space: pre-wrap;
      word-break: break-all;
    }

    /* Modal Drawer for Create/Edit */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 5000;
    }

    .modal-overlay.open { display: flex; }

    .modal-box {
      background: var(--bg-card);
      border: 1px solid var(--border-bright);
      border-radius: var(--radius-md);
      width: 100%;
      max-width: 520px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
      overflow: hidden;
      animation: modalPop 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes modalPop {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .modal-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border-dim);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .modal-footer {
      padding: 0.85rem 1.25rem;
      background: rgba(255, 255, 255, 0.015);
      border-top: 1px solid var(--border-dim);
      display: flex;
      justify-content: flex-end;
      gap: 0.6rem;
    }

    /* Toast */
    .toast-msg {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: var(--accent);
      color: #080706;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-sm);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
      z-index: 6000;
      opacity: 0;
      transform: translateY(12px);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .toast-msg.show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>

  <div class="app-container">

    <!-- Top Navigation -->
    <header class="top-bar">
      <div class="title-stack">
        <h1>
          <span>Prescripts</span>
          <span class="badge">Studio</span>
        </h1>
      </div>
      <!-- Tab Navigation Buttons -->
      <nav class="nav-tabs-bar">
        <button class="nav-tab-btn active" onclick="switchView('quotes-view', this)">📜 Quote Entry</button>
        <button class="nav-tab-btn" onclick="switchView('containers-view', this)">🏛️ Containers</button>
        <button class="nav-tab-btn" onclick="switchView('specifics-view', this)">📍 Specifics</button>
        <button class="nav-tab-btn" onclick="switchView('themes-view', this)">🌲 Themes Tree</button>
        <button class="nav-tab-btn" onclick="switchView('archive-view', this)">📚 Archive</button>
      </nav>
      <div class="header-actions">
        <button class="btn-action" onclick="toggleTheme()">🌓 Theme</button>
      </div>
    </header>

    <!-- ======================================================================
         VIEW 1: QUOTE CURATION & ENTRY FORM
         ====================================================================== -->
    <main class="view-container active" id="quotes-view">
      <div class="workspace-grid">

        <!-- Form Stream -->
        <div class="blocks-stream">

          <!-- 1. QUOTE CONTENT -->
          <section class="entry-card">
            <div class="card-header">
              <span class="card-title">1. Quote Core &amp; Reflection</span>
              <span class="card-tag">Required</span>
            </div>
            <div class="card-body">
              <div>
                <div class="field-label">
                  <span>Main Quote Content (Multi-Line)</span>
                  <span class="field-hint">Preserves line breaks</span>
                </div>
