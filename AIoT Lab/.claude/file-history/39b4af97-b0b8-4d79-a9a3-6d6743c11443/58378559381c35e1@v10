        return;
      }

      if (!activeQuote.id) activeQuote.id = generateHexId("0001");
      if (!activeQuote.date) activeQuote.date = new Date().toISOString().split('T')[0];

      try {
        const res = await fetch(`${API_BASE}/api/quote`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(activeQuote)
        });

        if (res.ok) {
          const data = await res.json();
          fireToast(`✓ Saved Quote #${data.index} to SQLite!`);
          activeQuote.index = data.index + 1;
          activeQuote.id = "";
          activeQuote.main_content = "";
          activeQuote.context = "";
          activeQuote.preference = [];
          document.getElementById('input-main-content').value = "";
          document.getElementById('input-context').value = "";
          renderPrefChips();
          renderLiveJSON();
          fetchBackendData();
          return;
        } else {
          const errData = await res.json().catch(() => ({}));
          fireToast("Server Error: " + (errData.error || res.statusText));
        }
      } catch (err) {
        fireToast("❌ Error: Local Server unreachable.");
      }
    }

