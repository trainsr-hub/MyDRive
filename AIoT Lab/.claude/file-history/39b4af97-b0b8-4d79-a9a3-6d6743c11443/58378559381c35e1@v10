      tbody.innerHTML = list.map(q => {
        const s = availableSpecifics.find(item => item.id === q.specific_id);
        const sTitle = s ? `📍 ${s.name} · ${s.container ? s.container.name : ''}` : '—';
        const snippet = q.main_content.split('\n')[0].substring(0, 48) + '...';
        return `
          <tr>
            <td style="font-family:'JetBrains Mono'; font-weight:700; color:var(--accent);">#${q.index}</td>
            <td style="font-weight:600; color:var(--text-vivid); max-width:320px;" title="${q.main_content}">“${snippet}”</td>
            <td><span class="selected-val-badge" style="font-size:0.75rem;">${sTitle}</span></td>
            <td style="font-family:'JetBrains Mono'; font-size:0.8rem;">${q.date}</td>
            <td>${(q.tags || []).map(t => `<span class="chip-badge" style="font-size:0.72rem;">#${t}</span>`).join(' ')}</td>
            <td style="text-align:right;">
              <button class="btn-action" style="padding:0.25rem 0.5rem; font-size:0.75rem;" onclick="loadQuoteForEdit('${q.id}')">✏️ Edit</button>
              <button class="btn-action btn-danger" style="padding:0.25rem 0.5rem; font-size:0.75rem;" onclick="deleteQuoteItem('${q.id}')">🗑️</button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterArchive(q) {
      const query = (q || "").toLowerCase();
      const filtered = allQuotesList.filter(item => item.main_content.toLowerCase().includes(query) || item.context.toLowerCase().includes(query));
      renderArchiveTable(filtered);
    }

    function loadQuoteForEdit(id) {
      const q = allQuotesList.find(item => item.id === id);
      if (!q) return;
      activeQuote = {
        id: q.id,
        index: q.index,
        main_content: q.main_content,
        context: q.context || "",
        date: q.date,
        specific_id: q.specific_id,
        theme_ids: q.theme_ids || [],
        usage: q.usage || [],
        preference: q.preference || [],
        backlinks: q.backlinks || [],
        tags: q.tags || [],
        sentiment: q.sentiment || ""
      };
      document.getElementById('input-main-content').value = q.main_content;
      document.getElementById('input-context').value = q.context || "";
      document.getElementById('input-date').value = q.date;
      document.getElementById('input-backlink').value = (q.backlinks || []).join(', ');

      const s = availableSpecifics.find(item => item.id === q.specific_id);
      renderSpecificBadge(s);
      renderThemeChips();
      renderUsagePills();
      renderPrefChips();
      renderLiveJSON();

      switchView('quotes-view', document.querySelector('.nav-tab-btn'));
      fireToast(`Loaded Quote #${q.index} for Editing`);
    }

    async function deleteQuoteItem(id) {
      if (!confirm("Are you sure you want to delete this quote from SQLite?")) return;
      const res = await fetch(`${API_BASE}/api/quote/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      if (res.ok) {
        fireToast("Quote deleted");
        await fetchBackendData();
        await loadArchiveList();
      }
    }

    // Modal Helpers
    function openModal(id) {
      document.getElementById(id).classList.add('open');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }

    function toggleTheme() {
      const html = document.documentElement;
      const cur = html.getAttribute('data-theme') || 'dark';
      const nxt = cur === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', nxt);
      localStorage.setItem('prescripts-theme', nxt);
    }

    // Backend Synchronizer
    async function fetchBackendData() {
      try {
        const taxRes = await fetch(`${API_BASE}/api/taxonomy`);
        if (taxRes.ok) {
          const tax = await taxRes.json();
          if (tax.containers) availableContainers = tax.containers;
          if (tax.specifics) availableSpecifics = tax.specifics;
          if (tax.themes) availableThemes = tax.themes;
        }

        const qRes = await fetch(`${API_BASE}/api/quotes`);
        if (qRes.ok) {
          const quotes = await qRes.json();
          if (Object.keys(quotes).length > 0) availableQuotes = quotes;
        }

        const idxRes = await fetch(`${API_BASE}/api/next_index`);
        if (idxRes.ok) {
          const data = await idxRes.json();
          activeQuote.index = data.next_index;
        }
      } catch (e) {}

      renderUsagePills();
      renderPrefChips();
      renderThemeChips();
      renderLiveJSON();
    }

    // Global Click Listener for Dropdowns
    document.addEventListener('click', function(e) {
      if (!e.target.closest('#date-host')) {
        const dd = document.getElementById('date-dropdown');
        if (dd) dd.classList.remove('open');
      }
      if (!e.target.closest('#specific-combo-wrap')) {
        const menu = document.getElementById('specific-combo-menu');
        const trigger = document.getElementById('specific-combo-trigger');
        if (menu) menu.classList.remove('open');
        if (trigger) trigger.classList.remove('active');
      }
      if (!e.target.closest('#theme-host')) {
        const dd = document.getElementById('theme-dropdown');
        if (dd) dd.classList.remove('open');
      }
      if (!e.target.closest('#pref-host')) {
        const dd = document.getElementById('pref-dropdown');
        if (dd) dd.classList.remove('open');
      }
    });

    window.addEventListener('DOMContentLoaded', async () => {
      const savedTheme = localStorage.getItem('prescripts-theme');
      if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);
      await fetchBackendData();
      await loadArchiveList();
    });
  </script>
</body>
</html>
