  <script>
    const API_BASE = window.location.origin.startsWith('http') ? window.location.origin : 'http://127.0.0.1:20137';

    // State
    let activeQuote = {
      id: "",
      index: 1,
      main_content: "",
      context: "",
      date: "",
      specific_id: null,
      theme_ids: [],
      usage: [],
      preference: [],
      backlinks: [],
      tags: [],
      sentiment: ""
    };

    let activeDefaultTags = [];

    // Master Cache
    let availableContainers = [];
    let availableSpecifics = [];
    let availableThemes = [];
    let availableQuotes = {};
    let allQuotesList = [];

    // Usage Options with Conflict Rules
    const USAGE_OPTIONS = [
      { id: "rewrite", label: "✍️ Rewrite Craft", desc: "Sentence rhythm & prose training", conflicts: ["rule"] },
      { id: "prompt", label: "💡 Diary Prompt", desc: "Creative catalyst for morning writing", conflicts: [] },
      { id: "anchor", label: "⚓ Memory Anchor", desc: "Core realization from personal history", conflicts: ["memento"] },
      { id: "rule", label: "📜 Daily Rule", desc: "Actionable principle & meta-habit", conflicts: ["rewrite"] },
      { id: "memento", label: "🪐 Perspective / Levity", desc: "Cosmic scale / meme / curiosity", conflicts: ["anchor"] }
    ];

    // Hex Generator
    function generateHexId(prefix = "0001") {
      const now = Date.now();
      const hexTs = now.toString(16).toUpperCase().padStart(12, '0').slice(-12);
      const cleanPrefix = String(prefix).toUpperCase().padStart(4, '0').slice(0, 4);
      return `${cleanPrefix}${hexTs}`;
    }

    // View Switcher
    function switchView(viewId, btn) {
      document.querySelectorAll('.view-container').forEach(v => v.classList.remove('active'));
      document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(viewId).classList.add('active');
      if (btn) btn.classList.add('active');

      if (viewId === 'containers-view') renderContainersTable();
      if (viewId === 'specifics-view') renderSpecificsTable();
      if (viewId === 'themes-view') renderThemesTree();
      if (viewId === 'archive-view') renderArchiveTable();
    }

    function fireToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2400);
    }

    function closeAllDropdowns() {
      document.querySelectorAll('.notion-dropdown-menu').forEach(dd => dd.classList.remove('open'));
      document.querySelectorAll('.notion-combobox-trigger').forEach(tr => tr.classList.remove('active'));
    }

    function updateField(field, value) {
      activeQuote[field] = value;
      if (!activeQuote.id && activeQuote.main_content.trim()) {
        activeQuote.id = generateHexId("0001");
      }
      renderLiveJSON();
    }

    function updateBacklink(val) {
      activeQuote.backlinks = val.trim() ? [val.trim()] : [];
      renderLiveJSON();
    }

    function renderLiveJSON() {
      const pre = document.getElementById('live-json-pre');
      pre.textContent = JSON.stringify(activeQuote, null, 2);
      document.getElementById('live-index-badge').textContent = `IDX: ${activeQuote.index}`;
    }

    // ==============================================================================
    // 2. DATE SUGGESTOR
    // ==============================================================================
    function handleDateInput(val) {
      activeQuote.date = val.trim();
      renderLiveJSON();

      const dropdown = document.getElementById('date-dropdown');
      const list = document.getElementById('date-options-list');
      const q = val.trim().toLowerCase();

      closeAllDropdowns();
      dropdown.classList.add('open');

      const currentYear = new Date().getFullYear();
      let suggestions = [];

      if (!q) {
        suggestions = [`${currentYear}`, `${currentYear}-10`, `${currentYear}-10-02`, `2020~${currentYear}`, `2020`];
      } else {
        if (/^\d{1,4}$/.test(q)) {
          suggestions.push(q, `${q}-01`, `${q}-05`, `${q}~${currentYear}`);
        } else if (/^\d{4}-/.test(q)) {
          suggestions.push(q, `${q}-01`, `${q}-15`);
        } else {
          suggestions.push(q);
        }
      }

      list.innerHTML = suggestions.slice(0, 6).map(s => `
        <div class="dropdown-opt-row" onclick="selectDate('${s}')">
          <span style="color:var(--accent); font-family:'JetBrains Mono'; font-weight:600;">📅 ${s}</span>
        </div>
      `).join('');
    }

    function selectDate(val) {
      document.getElementById('input-date').value = val;
      activeQuote.date = val;
      document.getElementById('date-dropdown').classList.remove('open');
      renderLiveJSON();
    }

    function clearDateInput() {
      document.getElementById('input-date').value = "";
      activeQuote.date = "";
      document.getElementById('date-dropdown').classList.remove('open');
      renderLiveJSON();
    }

    function handleDateKey(e) {
      if (e.key === 'Enter' || e.key === 'Escape') {
        document.getElementById('date-dropdown').classList.remove('open');
      }
    }

    // ==============================================================================
    // 3. SPECIFIC SINGLE SELECTOR
    // ==============================================================================
    function toggleSpecificDropdown() {
      const menu = document.getElementById('specific-combo-menu');
      const trigger = document.getElementById('specific-combo-trigger');
      if (!menu || !trigger) return;
      const isOpen = menu.classList.contains('open');
      closeAllDropdowns();
      if (!isOpen) {
        menu.classList.add('open');
        trigger.classList.add('active');
        const searchInput = document.getElementById('specific-search-input');
        if (searchInput) {
          searchInput.value = "";
          filterSpecificDropdown("");
          searchInput.focus();
        }
      }
    }

    function selectSpecific(id) {
      if (activeDefaultTags.length > 0) {
        activeQuote.tags = activeQuote.tags.filter(t => !activeDefaultTags.includes(t));
        activeDefaultTags = [];
      }

      activeQuote.specific_id = id;

      const s = availableSpecifics.find(item => item.id === id);
      if (s) {
        const defaults = [
          ...(s.default_tags || []),
          ...(s.container_default_tags || (s.container && s.container.default_tags ? s.container.default_tags : []))
        ].map(t => String(t).trim().toLowerCase()).filter(Boolean);

        activeDefaultTags = [...defaults];
        defaults.forEach(t => {
          if (!activeQuote.tags.includes(t)) activeQuote.tags.push(t);
        });

        renderSpecificBadge(s);
        fireToast(`Selected: ${s.name} · ${s.container ? s.container.name : ''}`);
      }

      closeAllDropdowns();
      renderLiveJSON();
    }

    function clearSpecificSelection() {
      if (activeDefaultTags.length > 0) {
        activeQuote.tags = activeQuote.tags.filter(t => !activeDefaultTags.includes(t));
        activeDefaultTags = [];
      }
      activeQuote.specific_id = null;
      renderSpecificBadge(null);
      renderLiveJSON();
    }

    function renderSpecificBadge(s) {
      const badge = document.getElementById('specific-selected-val');
      const clearBtn = document.getElementById('specific-clear-btn');
      if (s) {
        const cname = s.container ? s.container.name : '';
        badge.innerHTML = `<span class="selected-val-badge">📍 ${s.name} · <span style="opacity:0.75; font-weight:normal;">${cname}</span></span>`;
