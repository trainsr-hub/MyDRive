    // --- THEMES TREE (VIEW 4) ---
    function renderThemesTree() {
      const container = document.getElementById('themes-tree-container');
      if (availableThemes.length === 0) {
        container.innerHTML = `<div style="padding:1.5rem; text-align:center; color:var(--text-muted);">No themes yet. Click "+ Add Root Theme" to start your tree.</div>`;
        return;
      }

      // Render roots and nested children recursively
      const roots = availableThemes.filter(t => !t.child_of);
      const childrenMap = {};
      availableThemes.forEach(t => {
        if (t.child_of) {
          if (!childrenMap[t.child_of]) childrenMap[t.child_of] = [];
          childrenMap[t.child_of].push(t);
        }
      });

      function renderNodeHTML(node, level = 0) {
        const levelClass = level === 1 ? 'child-level-1' : (level >= 2 ? 'child-level-2' : '');
        const children = childrenMap[node.id] || [];
        let html = `
          <div class="theme-tree-node ${levelClass}">
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span style="color:var(--accent); font-weight:bold;">${level === 0 ? '📁' : '↳ 🏷️'}</span>
              <span style="font-weight:700; color:var(--text-vivid); font-size:0.92rem;">${node.name}</span>
              ${node.notes ? `<span style="color:var(--text-muted); font-size:0.78rem; font-style:italic;">— ${node.notes}</span>` : ''}
            </div>
            <div style="display:flex; gap:0.35rem;">
              <button class="btn-action" style="padding:0.2rem 0.45rem; font-size:0.72rem;" onclick="openCreateThemeModal('${node.id}')">+ Add Child</button>
              <button class="btn-action" style="padding:0.2rem 0.45rem; font-size:0.72rem;" onclick="openEditThemeModal('${node.id}')">✏️</button>
              <button class="btn-action btn-danger" style="padding:0.2rem 0.45rem; font-size:0.72rem;" onclick="deleteThemeNode('${node.id}')">🗑️</button>
            </div>
          </div>
        `;
        children.forEach(child => {
          html += renderNodeHTML(child, level + 1);
        });
        return html;
      }

      let treeHTML = "";
      roots.forEach(root => {
        treeHTML += renderNodeHTML(root, 0);
      });
      container.innerHTML = treeHTML;
    }

