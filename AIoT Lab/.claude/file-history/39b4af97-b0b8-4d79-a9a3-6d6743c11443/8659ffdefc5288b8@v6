"""
Entropy Rose / Prescripts: Deterministic CQRS Projection Compiler.
Compiles the pure 4-table relational schema:
  quotes -> specifics -> containers + themes (child_of tree)
into O(1) denormalized JSON projection maps for Obsidian and edge clients.
"""

import sqlite3
import json
import os
from typing import Dict, Any, List

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_DB_PATH = os.path.join(BASE_DIR, "data", "rose_quotes.db")
DEFAULT_OUT_DIR = os.path.join(BASE_DIR, "data")


def compile_projections(db_path: str = DEFAULT_DB_PATH, out_dir: str = DEFAULT_OUT_DIR) -> Dict[str, int]:
    """
    Reads authoritative SQLite tables and generates:
      1. quotes_map.json: { [hex_id]: QuoteObject } (Denormalized with Specifics, Containers & Themes)
      2. taxonomy_index.json: { containers: [...], specifics: [...], themes: [...], tags: [...] }
    """
    if not os.path.exists(db_path):
        return {"quotes": 0, "specifics": 0, "containers": 0, "themes": 0}

    os.makedirs(out_dir, exist_ok=True)
    conn = sqlite3.connect(db_path)
    conn.row_factory = sqlite3.Row

    tags_pool = set()

    # 1. Fetch all containers (Table 2)
    containers_map = {}
    containers_list = []
    try:
        cur = conn.execute("SELECT id, name, type, COALESCE(default_tags, '[]') as default_tags, notes FROM containers ORDER BY name ASC;")
        for r in cur.fetchall():
            c_tags = json.loads(r["default_tags"]) if r["default_tags"] else []
            for t in c_tags:
                if t and str(t).strip():
                    tags_pool.add(str(t).strip())
            c = {
                "id": r["id"],
                "name": r["name"],
                "type": r["type"] or "",
                "default_tags": c_tags,
                "notes": r["notes"] or ""
            }
            containers_map[r["id"]] = c
            containers_list.append(c)
    except sqlite3.OperationalError:
        pass

    # 2. Fetch all specifics (Table 3) pre-joined with containers
    specifics_map = {}
    specifics_list = []
    try:
        cur = conn.execute("SELECT id, name, container_id, category, COALESCE(default_tags, '[]') as default_tags, notes FROM specifics ORDER BY name ASC;")
        for r in cur.fetchall():
            cid = r["container_id"]
            parent_container = containers_map.get(cid, {"id": cid, "name": cid, "type": "", "default_tags": []})
            s_tags = json.loads(r["default_tags"]) if r["default_tags"] else []
            for t in s_tags:
                if t and str(t).strip():
                    tags_pool.add(str(t).strip())
            s = {
                "id": r["id"],
                "name": r["name"],
                "category": r["category"] or "",
                "default_tags": s_tags,
                "container_default_tags": parent_container.get("default_tags", []),
                "notes": r["notes"] or "",
                "container": parent_container
            }
            specifics_map[r["id"]] = s
            specifics_list.append(s)
    except sqlite3.OperationalError:
        pass

    # 3. Fetch all themes (Table 4) with child_of tree relation
    themes_map = {}
    themes_list = []
    try:
        cur = conn.execute("""
            SELECT t.id, t.name, t.child_of, t.notes, p.name as parent_name
            FROM themes t
            LEFT JOIN themes p ON t.child_of = p.id
            ORDER BY t.name ASC;
        """)
        for r in cur.fetchall():
            th = {
                "id": r["id"],
                "name": r["name"],
                "child_of": r["child_of"],
                "parent_name": r["parent_name"] or "",
                "notes": r["notes"] or ""
            }
            themes_map[r["id"]] = th
            themes_list.append(th)
    except sqlite3.OperationalError:
        pass

    # 4. Fetch all quotes (Table 1)
    quotes_map = {}

    try:
        cur = conn.execute("""
            SELECT id, idx, main_content, context, date,
                   specific_id,
                   COALESCE(theme_ids, '[]') as theme_ids,
                   COALESCE(usage, '[]') as usage,
                   COALESCE(preference, '[]') as preference,
                   COALESCE(backlinks, '[]') as backlinks,
                   COALESCE(tags, '[]') as tags,
                   COALESCE(sentiment, '') as sentiment
            FROM quotes
            ORDER BY idx ASC;
        """)

        for r in cur.fetchall():
            qid = r["id"]
            sid = r["specific_id"]
            resolved_specific = specifics_map.get(sid, None)

            # Resolve theme objects
            theme_ids = json.loads(r["theme_ids"]) if r["theme_ids"] else []
            resolved_themes = [themes_map[tid] for tid in theme_ids if tid in themes_map]

            usage = json.loads(r["usage"]) if r["usage"] else []
            preference = json.loads(r["preference"]) if r["preference"] else []
            backlinks = json.loads(r["backlinks"]) if r["backlinks"] else []

            raw_tags = json.loads(r["tags"]) if r["tags"] else []
            tags = raw_tags if isinstance(raw_tags, list) else []
            for t in tags:
                if isinstance(t, str) and t.strip():
                    tags_pool.add(t.strip())

            quotes_map[qid] = {
                "id": qid,
                "index": r["idx"],
                "main_content": r["main_content"],
                "context": r["context"] or "",
                "date": r["date"],
                "specific": resolved_specific,
                "themes": resolved_themes,
                "usage": usage,
                "preference": preference,
                "backlinks": backlinks,
                "tags": tags,
                "sentiment": r["sentiment"] or ""
            }
    except sqlite3.OperationalError:
        pass

    conn.close()

    # Write quotes_map.json
    quotes_map_path = os.path.join(out_dir, "quotes_map.json")
    with open(quotes_map_path, "w", encoding="utf-8") as f:
        json.dump(quotes_map, f, ensure_ascii=False, indent=2)

    # Write taxonomy_index.json
    taxonomy = {
        "containers": containers_list,
        "specifics": specifics_list,
        "themes": themes_list,
        "tags": sorted(list(tags_pool))
    }
    taxonomy_path = os.path.join(out_dir, "taxonomy_index.json")
    with open(taxonomy_path, "w", encoding="utf-8") as f:
        json.dump(taxonomy, f, ensure_ascii=False, indent=2)

    return {
        "quotes": len(quotes_map),
        "specifics": len(specifics_list),
        "containers": len(containers_list),
        "themes": len(themes_list)
    }


if __name__ == "__main__":
    stats = compile_projections()
    print(f"[OK] Compiled: {stats['quotes']} quotes, {stats['specifics']} specifics, {stats['containers']} containers, {stats['themes']} themes.")
