"""
Entropy Rose: Consolidated Pure 2-Table SQLite Engine.
Contains strictly two user-facing tables:
  1. 'quotes' (10 clean fields)
  2. 'speakers' (3 clean fields)
Zero shadow tables, zero dead legacy columns, zero duplicate timestamps.
"""

import sqlite3
import json
import os
from typing import Dict, Any, List, Optional

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_DB_PATH = os.path.join(BASE_DIR, "data", "rose_quotes.db")
DEFAULT_JSONL_PATH = os.path.join(BASE_DIR, "data", "quotes.jsonl")


def get_connection(db_path: str = DEFAULT_DB_PATH) -> sqlite3.Connection:
    """Creates a connection configured with WAL and concurrency pragmas."""
    os.makedirs(os.path.dirname(os.path.abspath(db_path)), exist_ok=True)
    conn = sqlite3.connect(db_path, timeout=5.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode = WAL;")
    conn.execute("PRAGMA synchronous = NORMAL;")
    conn.execute("PRAGMA busy_timeout = 5000;")
    conn.execute("PRAGMA foreign_keys = ON;")
    return conn


def init_db(db_path: str = DEFAULT_DB_PATH) -> None:
    """Initializes the pure 2-table schema."""
    conn = get_connection(db_path)
    with conn:
        conn.execute("BEGIN IMMEDIATE;")

        # Table 1: speakers (id, name, bio)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS speakers (
                id TEXT PRIMARY KEY,
                name TEXT NOT NULL UNIQUE,
                bio TEXT
            );
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_speakers_name ON speakers(name);")

        # Table 2: quotes (10 clean fields)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS quotes (
                id TEXT PRIMARY KEY,
                idx INTEGER UNIQUE NOT NULL,
                main_content TEXT NOT NULL,
                context TEXT,
                date TEXT NOT NULL,
                speaker_ids TEXT,
                preference TEXT,
                backlinks TEXT,
                tags TEXT,
                sentiment TEXT
            );
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_quotes_idx ON quotes(idx);")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_quotes_date ON quotes(date);")

    conn.close()


# ==============================================================================
# SPEAKER OPERATIONS
# ==============================================================================

def upsert_speaker(speaker: Dict[str, Any], db_path: str = DEFAULT_DB_PATH) -> None:
    """Inserts or updates a speaker entity."""
    init_db(db_path)
    conn = get_connection(db_path)
    with conn:
        conn.execute("BEGIN IMMEDIATE;")
        name = speaker["name"].strip()
        conn.execute("DELETE FROM speakers WHERE name = ? OR id = ?;", (name, speaker["id"]))
        conn.execute("""
            INSERT INTO speakers (id, name, bio)
            VALUES (?, ?, ?);
        """, (speaker["id"], name, speaker.get("bio", "")))
    conn.close()


def get_speaker(speaker_id: str, db_path: str = DEFAULT_DB_PATH) -> Optional[Dict[str, Any]]:
    """O(1) lookup of a speaker by Hex ID."""
    conn = get_connection(db_path)
    cur = conn.execute("SELECT id, name, bio FROM speakers WHERE id = ?;", (speaker_id,))
    row = cur.fetchone()
    conn.close()
    if not row:
        return None
    return {"id": row["id"], "name": row["name"], "bio": row["bio"] or ""}


def get_all_speakers(db_path: str = DEFAULT_DB_PATH) -> List[Dict[str, Any]]:
    """Returns all speakers sorted by name."""
    init_db(db_path)
    conn = get_connection(db_path)
    cur = conn.execute("SELECT id, name, bio FROM speakers ORDER BY name ASC;")
    rows = cur.fetchall()
    conn.close()
    return [{"id": r["id"], "name": r["name"], "bio": r["bio"] or ""} for r in rows]


