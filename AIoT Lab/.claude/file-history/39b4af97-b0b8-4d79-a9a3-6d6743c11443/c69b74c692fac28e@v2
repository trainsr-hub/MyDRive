def get_next_index(db_path: str = DEFAULT_DB_PATH) -> int:
    """Calculates the next monotonic human integer index (max + 1)."""
    init_db(db_path)
    conn = get_connection(db_path)
    cur = conn.execute("SELECT COALESCE(MAX(idx), 0) + 1 AS next_idx FROM quotes;")
    row = cur.fetchone()
    conn.close()
    return row["next_idx"] if row else 1


def upsert_quote(quote: Dict[str, Any], db_path: str = DEFAULT_DB_PATH, compile_after: bool = True) -> None:
    """
    Inserts or updates a quote document in SQLite.
    Resolves speakers, backlinks, response quotes, and triggers O(1) projection compilation.
    """
    init_db(db_path)
    conn = get_connection(db_path)
    with conn:
        conn.execute("BEGIN IMMEDIATE;")

        # Resolve speaker IDs and speaker display string
        speaker_ids = []
        speaker_names = []
        raw_speakers = quote.get("source_speaker", [])
        if isinstance(raw_speakers, list):
            for spk in raw_speakers:
                if isinstance(spk, str):
                    # Check if it's a known hex ID or a name
                    cur = conn.execute("SELECT id, name FROM speakers WHERE id = ? OR name = ?;", (spk, spk))
                    found = cur.fetchone()
                    if found:
                        speaker_ids.append(found["id"])
                        speaker_names.append(found["name"])
                    else:
                        # Auto-create speaker if not found
                        from seed_quote import generate_hex_id
                        new_id = generate_hex_id()
                        conn.execute("INSERT OR IGNORE INTO speakers (id, name, bio) VALUES (?, ?, ?);", (new_id, spk, ""))
                        speaker_ids.append(new_id)
                        speaker_names.append(spk)
                elif isinstance(spk, dict):
                    speaker_ids.append(spk.get("id"))
                    speaker_names.append(spk.get("name", ""))
        elif isinstance(raw_speakers, dict):
            name = raw_speakers.get("name", "")
            if name:
                speaker_names.append(name)

        speaker_name_str = ", ".join(filter(None, speaker_names)) or None

        # Tags handling
        raw_tags = quote.get("tags", [])
        if isinstance(raw_tags, list):
            tags_json_str = json.dumps(raw_tags, ensure_ascii=False)
            sentiment_str = quote.get("sentiment", "")
        elif isinstance(raw_tags, dict):
            tags_json_str = json.dumps(raw_tags, ensure_ascii=False)
            sentiment_str = raw_tags.get("sentiment", quote.get("sentiment", ""))
        else:
            tags_json_str = "[]"
            sentiment_str = quote.get("sentiment", "")

        # Preference (response quote IDs)
        preference = quote.get("preference", [])
        preference_json_str = json.dumps(preference, ensure_ascii=False)

        # Backlinks (URLs)
        backlinks = quote.get("backlink", [])
        backlinks_json_str = json.dumps(backlinks, ensure_ascii=False)

        speaker_ids_json_str = json.dumps(speaker_ids, ensure_ascii=False)

        idx = quote.get("index") or get_next_index(db_path)

        # Clean up stale record holding same index with different ID
        conn.execute("DELETE FROM quotes WHERE idx = ? AND id != ?;", (idx, quote["id"]))

        conn.execute("""
            INSERT INTO quotes (
                id, idx, main_content, context, date,
                speaker_name, speaker_role, speaker_origin,
                tags_json, sentiment, preference_json,
                speaker_ids_json, backlinks_json
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(id) DO UPDATE SET
                idx = excluded.idx,
                main_content = excluded.main_content,
                context = excluded.context,
                date = excluded.date,
                speaker_name = excluded.speaker_name,
                tags_json = excluded.tags_json,
                sentiment = excluded.sentiment,
                preference_json = excluded.preference_json,
                speaker_ids_json = excluded.speaker_ids_json,
                backlinks_json = excluded.backlinks_json;
        """, (
            quote["id"],
            idx,
            quote["main_content"].strip(),
            quote.get("context", "").strip(),
            str(quote["date"]).strip(),
            speaker_name_str,
            None,
            None,
            tags_json_str,
            sentiment_str,
            preference_json_str,
            speaker_ids_json_str,
            backlinks_json_str
        ))

        # Clear and rewrite relational backlinks
        conn.execute("DELETE FROM backlinks WHERE source_id = ?;", (quote["id"],))
        for link in backlinks:
            if isinstance(link, str):
                rel = "references" if link.startswith("http") else "related_to"
                conn.execute("INSERT OR IGNORE INTO backlinks (source_id, target_id, relation) VALUES (?, ?, ?);",
                             (quote["id"], link, rel))

    conn.close()

    # Trigger deterministic projection compilation
    if compile_after:
        try:
            from compile_projections import compile_projections
            compile_projections(db_path)
        except Exception as e:
            print(f"[WARN] Projection compilation error: {e}")


def get_quote(quote_id: str, db_path: str = DEFAULT_DB_PATH) -> Optional[Dict[str, Any]]:
    """O(1) lookup of a quote by Hex ID."""
    conn = get_connection(db_path)
    cur = conn.execute("SELECT * FROM quotes WHERE id = ?;", (quote_id,))
    row = cur.fetchone()
    if not row:
        conn.close()
        return None

    speaker_ids = json.loads(row["speaker_ids_json"]) if ("speaker_ids_json" in row.keys() and row["speaker_ids_json"]) else []
    preference = json.loads(row["preference_json"]) if ("preference_json" in row.keys() and row["preference_json"]) else []
    backlinks = json.loads(row["backlinks_json"]) if ("backlinks_json" in row.keys() and row["backlinks_json"]) else []
    tags = json.loads(row["tags_json"]) if row["tags_json"] else []

    conn.close()
    return {
        "id": row["id"],
        "index": row["idx"],
        "main_content": row["main_content"],
        "context": row["context"] or "",
        "date": row["date"],
        "source_speaker": speaker_ids,
        "speaker_name": row["speaker_name"],
        "preference": preference,
        "backlink": backlinks,
        "tags": tags,
        "sentiment": row["sentiment"] or ""
    }


def get_all_quotes(db_path: str = DEFAULT_DB_PATH) -> List[Dict[str, Any]]:
    """Returns all quotes ordered by index."""
    init_db(db_path)
    conn = get_connection(db_path)
    cur = conn.execute("SELECT * FROM quotes ORDER BY idx ASC;")
    rows = cur.fetchall()
    results = []
    for row in rows:
        results.append({
            "id": row["id"],
            "index": row["idx"],
            "main_content": row["main_content"],
            "context": row["context"] or "",
            "date": row["date"],
            "speaker_name": row["speaker_name"] or "",
            "preference": json.loads(row["preference_json"]) if ("preference_json" in row.keys() and row["preference_json"]) else [],
            "tags": json.loads(row["tags_json"]) if row["tags_json"] else [],
            "sentiment": row["sentiment"] or ""
        })
    conn.close()
    return results


def search_quotes(query: str, db_path: str = DEFAULT_DB_PATH, limit: int = 20) -> List[Dict[str, Any]]:
    """Performs FTS5 search across content, context, speaker, and tags."""
    init_db(db_path)
    conn = get_connection(db_path)
    cur = conn.execute("""
        SELECT q.*, rank
        FROM quotes_fts f
        JOIN quotes q ON f.id = q.id
        WHERE quotes_fts MATCH ?
        ORDER BY rank
        LIMIT ?;
    """, (query, limit))
    rows = cur.fetchall()
    results = []
    for r in rows:
        results.append({
            "id": r["id"],
            "index": r["idx"],
            "main_content": r["main_content"],
            "context": r["context"] or "",
            "date": r["date"],
            "speaker_name": r["speaker_name"] or "",
            "sentiment": r["sentiment"] or "",
            "preference": json.loads(r["preference_json"]) if ("preference_json" in r.keys() and r["preference_json"]) else [],
            "tags": json.loads(r["tags_json"]) if r["tags_json"] else []
        })
    conn.close()
    return results


def sync_from_jsonl(jsonl_path: str = None, db_path: str = DEFAULT_DB_PATH) -> int:
    """Ingests all records from quotes.jsonl into SQLite."""
    if jsonl_path is None:
        jsonl_path = DEFAULT_JSONL_PATH
    if not os.path.exists(jsonl_path):
        return 0
    init_db(db_path)
    count = 0
    with open(jsonl_path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            record = json.loads(line)
            upsert_quote(record, db_path, compile_after=False)
            count += 1
    # Run compiler once at the end of batch sync
    from compile_projections import compile_projections
    compile_projections(db_path)
    return count
