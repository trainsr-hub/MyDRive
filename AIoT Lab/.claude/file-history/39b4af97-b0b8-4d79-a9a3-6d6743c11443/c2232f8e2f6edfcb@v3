"""
Entropy Rose / Prescripts: Deterministic Hex ID Generator & Schema Seed Utility.
Generates 16-character uppercase hex identifiers:
  <4 HEX PREFIX><12 HEX UNIX MILLISECONDS>
Extracts exact creation timestamp down to millisecond without a created_at column.
"""

import time
from datetime import datetime, timedelta
import json
import os

BASE_DIR = os.path.dirname(os.path.abspath(__file__))

PREFIX_QUOTE = "0001"
PREFIX_SPEAKER = "0002"

# Canonical fixed IDs for foundational seed entities
# 2026-09-30T12:00:00Z = 1790769600000 ms -> 0001A1088D80 (12 hex digits)
CANONICAL_ID_VINYL_SPEAKER = "00020001A1088D80"
CANONICAL_ID_FAUST_SPEAKER = "00020001A1088D81"
CANONICAL_ID_MANAGER_SPEAKER = "00020001A1088D82"
CANONICAL_ID_MARCUS_SPEAKER = "00020001A1088D83"

CANONICAL_ID_VINYL_QUOTE = "00010001A1088D80"
CANONICAL_ID_FAUST_QUOTE = "00010001A1088D81"


def generate_hex_id(prefix: str = PREFIX_QUOTE, unix_ms: int = None) -> str:
    """
    Generates a 16-character uppercase hex identifier:
      <4 HEX PREFIX><12 HEX UNIX MILLISECONDS>
    12 hex characters cover Unix milliseconds up to ~8,900 years into the future.
    """
    if unix_ms is None:
        unix_ms = int(time.time() * 1000)
    clean_prefix = str(prefix).upper().rjust(4, "0")[:4]
    hex_ts = f"{unix_ms:012X}"[-12:]
    return f"{clean_prefix}{hex_ts}"


def parse_hex_id_timestamp(hex_id: str) -> float:
    """Extracts Unix epoch timestamp (in seconds) directly from the 16-char hex ID."""
    if len(hex_id) < 16:
        return 0.0
    unix_ms = int(hex_id[4:], 16)
    return unix_ms / 1000.0


def create_sample_quotes(deterministic: bool = True):
    if deterministic:
        id_vinyl = CANONICAL_ID_VINYL_QUOTE
        id_faust = CANONICAL_ID_FAUST_QUOTE
        date_str = "2026-09-30"
    else:
        now_ms = int(time.time() * 1000)
        id_vinyl = generate_hex_id(PREFIX_QUOTE, now_ms - 5000)
        id_faust = generate_hex_id(PREFIX_QUOTE, now_ms)
        date_str = datetime.now().strftime("%Y-%m-%d")

    # Seed core speakers first
    core_speakers = [
        {"id": CANONICAL_ID_FAUST_SPEAKER, "name": "Faust", "bio": "Strategic Analytical Intellect"},
        {"id": CANONICAL_ID_VINYL_SPEAKER, "name": "Vinyl Angel", "bio": "Lyricism from Koi no Koe"},
        {"id": CANONICAL_ID_MANAGER_SPEAKER, "name": "The Manager", "bio": "Visionary & Commander"},
        {"id": CANONICAL_ID_MARCUS_SPEAKER, "name": "Marcus Aurelius", "bio": "Stoic Emperor & Philosopher"}
    ]

    import db
    db.init_db()
    for spk in core_speakers:
        db.upsert_speaker(spk)

    # First Quote: Vinyl Angel - Koi no Koe
    quote_1 = {
        "id": id_vinyl,
        "index": 1,
        "main_content": "Static hum, thrum—needle drops,\nSpinning echo, time just stops.\nFamiliar chords fill up the room,\nWrapped inside this faded tomb.",
        "context": "Lyricism from 'Koi no Koe' by Vinyl Angel. The needle touching groove marks the suspended temporal boundary where sound transcends decaying physical media—evoking acoustic memory and temporal suspension.",
        "date": date_str,
        "source_speaker": [CANONICAL_ID_VINYL_SPEAKER],
        "preference": [],
        "backlink": ["https://vinylangel.net/lyrics/koi-no-koe"],
        "tags": ["lyricism", "memory", "music"],
        "sentiment": "nostalgic"
    }

    # Second Quote: Faust
    quote_2 = {
        "id": id_faust,
        "index": 2,
        "main_content": "The universe is built on a plan, the profound symmetry of which is somehow present in every inner corner of human thought.\nWe are not passive observers; we are the system observing itself.",
        "context": "Reflections on cybernetics and distributed consciousness.\nNoted while constructing the Faust Hivemind infrastructure at the nexus of order and entropy.",
        "date": date_str,
        "source_speaker": [CANONICAL_ID_FAUST_SPEAKER],
        "preference": [id_vinyl],
        "backlink": [],
        "tags": ["cybernetics", "symmetry", "entropy", "sovereignty"],
        "sentiment": "analytical"
    }

    out_dir = os.path.join(BASE_DIR, "data")
    os.makedirs(out_dir, exist_ok=True)

    # 1. Primary O(1) Hash-Map Store (Keyed by 16-char Hex ID)
    json_path = os.path.join(out_dir, "quotes.json")
    quotes_map = {
        id_vinyl: quote_1,
        id_faust: quote_2
    }

    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(quotes_map, f, ensure_ascii=False, indent=2)

    # 2. Append-only event log
    jsonl_path = os.path.join(out_dir, "quotes.jsonl")
    with open(jsonl_path, "w", encoding="utf-8") as f:
        f.write(json.dumps(quote_1, ensure_ascii=False) + "\n")
        f.write(json.dumps(quote_2, ensure_ascii=False) + "\n")

    # Ingest directly to SQLite
    db.upsert_quote(quote_1, compile_after=False)
    db.upsert_quote(quote_2, compile_after=True)

    print(f"[OK] Seeded Quote #1 (Vinyl Angel) [{id_vinyl}]")
    print(f"[OK] Seeded Quote #2 (Faust) [{id_faust}]")
    print(f"[OK] Synchronized SQLite rose_quotes.db and compiled O(1) projections")


if __name__ == "__main__":
    create_sample_quotes()
