def upsert_container(container: Dict[str, Any], db_path: str = DEFAULT_DB_PATH) -> None:
    """Inserts or updates a Container entity."""
    init_db(db_path)
    conn = get_connection(db_path)
    with conn:
        conn.execute("BEGIN IMMEDIATE;")
        name = container["name"].strip()
        tags = container.get("default_tags", [])
        tags_json = json.dumps(tags if isinstance(tags, list) else [], ensure_ascii=False)
        conn.execute("DELETE FROM containers WHERE name = ? OR id = ?;", (name, container["id"]))
        conn.execute("""
            INSERT INTO containers (id, name, type, default_tags, notes)
            VALUES (?, ?, ?, ?, ?);
        """, (container["id"], name, container.get("type", ""), tags_json, container.get("notes", "")))
    conn.execute("PRAGMA wal_checkpoint(PASSIVE);")
    conn.close()


def get_container(container_id: str, db_path: str = DEFAULT_DB_PATH) -> Optional[Dict[str, Any]]:
    """O(1) lookup of a Container by Hex ID."""
    conn = get_connection(db_path)
    cur = conn.execute("SELECT id, name, type, default_tags, notes FROM containers WHERE id = ?;", (container_id,))
    row = cur.fetchone()
    conn.close()
    if not row:
        return None
    tags = json.loads(row["default_tags"]) if row["default_tags"] else []
    return {"id": row["id"], "name": row["name"], "type": row["type"] or "", "default_tags": tags, "notes": row["notes"] or ""}


def get_all_containers(db_path: str = DEFAULT_DB_PATH) -> List[Dict[str, Any]]:
    """Returns all Containers sorted by name."""
    init_db(db_path)
    conn = get_connection(db_path)
    cur = conn.execute("SELECT id, name, type, default_tags, notes FROM containers ORDER BY name ASC;")
    rows = cur.fetchall()
    conn.close()
    results = []
    for r in rows:
        tags = json.loads(r["default_tags"]) if r["default_tags"] else []
        results.append({"id": r["id"], "name": r["name"], "type": r["type"] or "", "default_tags": tags, "notes": r["notes"] or ""})
    return results


def delete_container(container_id: str, db_path: str = DEFAULT_DB_PATH) -> bool:
    """Deletes a container and cascades to its specifics."""
    init_db(db_path)
    conn = get_connection(db_path)
    with conn:
        conn.execute("BEGIN IMMEDIATE;")
        conn.execute("DELETE FROM containers WHERE id = ?;", (container_id,))
    conn.execute("PRAGMA wal_checkpoint(PASSIVE);")
    conn.close()
    try:
        from compile_projections import compile_projections
        compile_projections(db_path)
    except Exception:
        pass
    return True


