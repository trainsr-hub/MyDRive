def get_specific(specific_id: str, db_path: str = DEFAULT_DB_PATH) -> Optional[Dict[str, Any]]:
    """O(1) lookup of a Specific endpoint joined with its container."""
    conn = get_connection(db_path)
    cur = conn.execute("""
        SELECT s.id, s.name, s.container_id, s.category, s.default_tags as s_tags, s.notes,
               c.name as container_name, c.type as container_type, c.default_tags as c_tags
        FROM specifics s
        JOIN containers c ON s.container_id = c.id
        WHERE s.id = ?;
    """, (specific_id,))
    row = cur.fetchone()
    conn.close()
    if not row:
        return None
    s_tags = json.loads(row["s_tags"]) if row["s_tags"] else []
    c_tags = json.loads(row["c_tags"]) if row["c_tags"] else []
    return {
        "id": row["id"],
        "name": row["name"],
        "container_id": row["container_id"],
        "container_name": row["container_name"],
        "container_type": row["container_type"] or "",
        "category": row["category"] or "",
        "default_tags": s_tags,
        "container_default_tags": c_tags,
        "notes": row["notes"] or ""
    }


