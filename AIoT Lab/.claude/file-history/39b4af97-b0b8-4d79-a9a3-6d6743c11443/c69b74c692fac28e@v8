def upsert_specific(specific: Dict[str, Any], db_path: str = DEFAULT_DB_PATH) -> None:
    """Inserts or updates a Specific endpoint."""
    init_db(db_path)
    conn = get_connection(db_path)
    with conn:
        conn.execute("BEGIN IMMEDIATE;")
        name = specific["name"].strip()
        cid = specific["container_id"]
        tags = specific.get("default_tags", [])
        tags_json = json.dumps(tags if isinstance(tags, list) else [], ensure_ascii=False)
        conn.execute("DELETE FROM specifics WHERE id = ? OR (name = ? AND container_id = ?);", (specific["id"], name, cid))
        conn.execute("""
            INSERT INTO specifics (id, name, container_id, category, default_tags, notes)
            VALUES (?, ?, ?, ?, ?, ?);
        """, (specific["id"], name, cid, specific.get("category", ""), tags_json, specific.get("notes", "")))
    conn.execute("PRAGMA wal_checkpoint(PASSIVE);")
