@echo off
title Prescripts / Entropy Rose — CQRS Quote Engine
cd /d "%~dp0"

echo ========================================================
echo   Prescripts / Entropy Rose [SQLite + O(1) Projections]
echo ========================================================
echo.
echo [1] Launch Prescripts Server & Open UI (Default)
echo [2] Re-seed quotes database (seed_quote.py)
echo [3] Re-compile projections (compile_projections.py)
echo.
set /p CHOICE="Select mode [1/2/3, default 1]: "

if "%CHOICE%"=="2" goto RESEED
if "%CHOICE%"=="3" goto COMPILE
goto LAUNCH

:LAUNCH
echo Starting Prescripts Server on http://localhost:20135 ...
start "" "http://localhost:20135/prescripts_entry.html"
python server.py
exit /b 0

:RESEED
echo Running seed_quote.py ...
python seed_quote.py
pause
exit /b 0

:COMPILE
echo Running compile_projections.py ...
python compile_projections.py
pause
exit /b 0
