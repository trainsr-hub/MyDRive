<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Prescripts — Data Entry &amp; Quote Engine</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
  <style>
    /* ==========================================================================
       PRESCRIPTS — DATA ENTRY INTERFACE
       Grounded in Master UI/UX Template (RAW_RULE.md) & Fitts's Law Hitboxes
       ========================================================================== */
    :root {
      --bg-canvas:        #080706;
      --bg-card:          #13100d;
      --bg-card-hover:    #1c1713;
      --bg-input:         #1a1511;
      --bg-input-focus:   #231c16;

      --text-vivid:       #fffcf7;
      --text-main:        #ede4d8;
      --text-muted:       #8a7b6c;
      --text-dim:         #5c5044;

      --border-dim:       #292018;
      --border-mid:       #3f3226;
      --border-bright:    #634f3c;

      --accent:           #ff9e1b;
      --accent-hover:     #ffb03a;
      --accent-glow:      rgba(255, 158, 27, 0.25);
      --accent-bg:        rgba(255, 158, 27, 0.12);
      --accent-border:    rgba(255, 158, 27, 0.4);

      --radius-sm:        6px;
      --radius-md:        10px;
      --radius-lg:        14px;
      --shadow-subtle:    0 4px 20px rgba(0, 0, 0, 0.5);

      color-scheme: dark;
      font-family: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14.5px;
      line-height: 1.5;
    }

    :root[data-theme="light"] {
      --bg-canvas:        #f5f3ef;
      --bg-card:          #ffffff;
      --bg-card-hover:    #f9f7f4;
      --bg-input:         #f0ebe3;
      --bg-input-focus:   #ffffff;

      --text-vivid:       #18130e;
      --text-main:        #2c231a;
      --text-muted:       #6b5a49;
      --text-dim:         #9e8c79;

      --border-dim:       #ded5c7;
      --border-mid:       #c5b8a5;
      --border-bright:    #8f7d67;

      --accent:           #d97706;
      --accent-hover:     #b45309;
      --accent-glow:      rgba(217, 119, 6, 0.2);
      --accent-bg:        rgba(217, 119, 6, 0.1);
      --accent-border:    rgba(217, 119, 6, 0.4);

      color-scheme: light;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100%; }

    body {
      background: var(--bg-canvas);
      color: var(--text-main);
      padding: 2rem 1.5rem 4rem;
      display: flex;
      justify-content: center;
    }

    .app-container {
      width: 100%;
      max-width: 1400px;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    /* Top Navigation */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border-dim);
      padding-bottom: 1.25rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .title-stack h1 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-vivid);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .title-stack h1 .badge {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--accent);
      background: var(--accent-bg);
      border: 1px solid var(--accent-border);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      text-transform: uppercase;
    }

    .title-stack p {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    .header-actions {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }

    .btn-action {
      background: var(--bg-card);
      border: 1px solid var(--border-mid);
      color: var(--text-main);
      padding: 0.55rem 0.95rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.15s ease;
    }

    .btn-action:hover {
      background: var(--bg-card-hover);
      border-color: var(--accent);
      color: var(--text-vivid);
      transform: translateY(-1px);
    }

    .btn-action.btn-primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #080706;
      font-weight: 700;
    }

    .btn-action.btn-primary:hover {
      background: var(--accent-hover);
      box-shadow: 0 0 12px var(--accent-glow);
    }

    /* Workspace Grid */
    .workspace-grid {
      display: grid;
      grid-template-columns: 1fr 440px;
      gap: 1.75rem;
      align-items: start;
    }

    @media (max-width: 1024px) {
      .workspace-grid { grid-template-columns: 1fr; }
    }

    /* Form Stream */
    .blocks-stream {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .entry-card {
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-subtle);
      transition: border-color 0.2s ease;
    }

    .entry-card:hover {
      border-color: var(--border-mid);
    }

    .card-header {
      padding: 0.9rem 1.25rem;
      background: rgba(255, 255, 255, 0.015);
      border-bottom: 1px solid var(--border-dim);
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      user-select: none;
    }

    .card-header-left {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .card-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-vivid);
    }

    .card-tag {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--accent);
      background: var(--accent-bg);
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      border: 1px solid var(--accent-border);
      text-transform: uppercase;
    }

    .card-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .field-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
    }

    .field-hint {
      font-size: 0.75rem;
      color: var(--text-dim);
      font-family: "JetBrains Mono", monospace;
    }

    /* Inputs */
    .raw-input-box {
      width: 100%;
      height: 46px;
      background: var(--bg-input);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-sm);
      color: var(--text-vivid);
      font-family: inherit;
      font-size: 0.92rem;
      padding: 0 1rem;
      outline: none;
      transition: all 0.15s ease;
    }

    .raw-input-box:focus {
      background: var(--bg-input-focus);
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .raw-textarea-box {
      width: 100%;
      min-height: 110px;
      background: var(--bg-input);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-sm);
      color: var(--text-vivid);
      font-family: "JetBrains Mono", monospace;
      font-size: 0.88rem;
      padding: 0.85rem 1rem;
      outline: none;
      resize: vertical;
      line-height: 1.6;
      transition: all 0.15s ease;
    }

    .raw-textarea-box:focus {
      background: var(--bg-input-focus);
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    /* Notion-Style Multi-Select Host */
    .multi-select-host {
      position: relative;
    }

    .multi-tag-box {
      width: 100%;
      min-height: 48px;
      background: var(--bg-input);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-sm);
      padding: 0.35rem 0.65rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem;
      cursor: text;
      transition: all 0.15s ease;
    }

    .multi-tag-box:hover,
    .multi-tag-box.active {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--accent-glow);
    }

    .tag-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--accent-bg);
      color: var(--accent);
      border: 1px solid var(--accent-border);
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      font-size: 0.82rem;
      font-weight: 600;
      user-select: none;
    }

    .tag-chip-remove {
      cursor: pointer;
      opacity: 0.7;
      font-size: 0.75rem;
      padding: 0 2px;
      border-radius: 2px;
    }

    .tag-chip-remove:hover {
      opacity: 1;
      background: rgba(244, 63, 94, 0.2);
      color: #fb7185;
    }

    .tag-inline-input {
      border: none;
      outline: none;
      background: transparent;
      color: var(--text-vivid);
      font-family: inherit;
      font-size: 0.88rem;
      flex: 1 1 140px;
      padding: 0.3rem;
      min-width: 100px;
    }

    /* Dropdown Menus */
    .notion-dropdown-menu {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      background: var(--bg-card);
      border: 1px solid var(--border-mid);
      border-radius: var(--radius-sm);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
      z-index: 100;
      display: none;
      flex-direction: column;
      overflow: hidden;
      max-height: 280px;
    }

    .notion-dropdown-menu.open {
      display: flex;
    }

    .dropdown-options-list {
      overflow-y: auto;
      padding: 0.4rem;
      display: flex;
      flex-direction: column;
      gap: 2px;
      max-height: 220px;
    }

    .dropdown-opt-row {
      padding: 0.55rem 0.75rem;
      border-radius: 4px;
      font-size: 0.88rem;
      color: var(--text-main);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.1s ease;
      gap: 0.5rem;
    }

    .dropdown-opt-row:hover,
    .dropdown-opt-row.selected {
      background: var(--bg-input-focus);
      color: var(--accent);
    }

    .opt-label-group {
      display: flex;
      flex-direction: column;
      min-width: 0;
      flex: 1 1 auto;
      gap: 2px;
    }

    .opt-title {
      font-weight: 600;
      font-size: 0.88rem;
      color: var(--text-vivid);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .opt-context {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-style: italic;
      opacity: 0.6;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .opt-delete-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-dim);
      width: 24px;
      height: 24px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.15s ease;
      flex-shrink: 0;
    }

    .opt-delete-btn:hover {
      background: rgba(244, 63, 94, 0.18);
      border-color: rgba(244, 63, 94, 0.4);
      color: #fb7185;
    }

    .dropdown-create-row {
      padding: 0.65rem 0.75rem;
      background: var(--accent-bg);
      border-top: 1px solid var(--accent-border);
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: background 0.15s ease;
    }

    .dropdown-create-row:hover {
      background: var(--accent);
      color: #080706;
    }

    /* Multiple-Choice Tag Pool */
    .tag-choice-board {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0.75rem;
      background: var(--bg-input);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-sm);
      min-height: 60px;
    }

    .tag-choice-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--bg-card);
      border: 1px solid var(--border-mid);
      color: var(--text-main);
      padding: 0.35rem 0.7rem;
      border-radius: 20px;
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s ease;
      user-select: none;
    }

    .tag-choice-pill:hover {
      border-color: var(--accent);
      color: var(--text-vivid);
      transform: translateY(-1px);
    }

    .tag-choice-pill.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #080706;
      font-weight: 700;
      box-shadow: 0 0 8px var(--accent-glow);
    }

    .tag-choice-delete {
      font-size: 0.7rem;
      opacity: 0.6;
      padding: 0 2px;
      border-radius: 2px;
    }

    .tag-choice-delete:hover {
      opacity: 1;
      background: rgba(0, 0, 0, 0.2);
    }

    /* Inspector Aside */
    .inspector-sticky {
      position: sticky;
      top: 2rem;
      background: var(--bg-card);
      border: 1px solid var(--border-dim);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-subtle);
    }

    .inspector-header {
      padding: 0.85rem 1.25rem;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--border-dim);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .live-json-display {
      padding: 1rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.78rem;
      line-height: 1.5;
      color: var(--text-main);
      background: var(--bg-canvas);
      max-height: 520px;
      overflow-y: auto;
      white-space: pre-wrap;
      word-break: break-all;
    }

    /* Toast */
    .toast-msg {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: var(--accent);
      color: #080706;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-sm);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
      z-index: 1000;
      opacity: 0;
      transform: translateY(12px);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .toast-msg.show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>

  <div class="app-container">

    <!-- Top Navigation -->
    <header class="top-bar">
      <div class="title-stack">
        <h1>
          <span>Prescripts</span>
          <span class="badge">CQRS Engine</span>
        </h1>
        <p>Morning Wisdom &amp; Curation Interface — Authoring Layer for 4AM ESP32 &amp; Obsidian</p>
      </div>
      <div class="header-actions">
        <button class="btn-action" onclick="toggleTheme()">🌓 Theme</button>
        <button class="btn-action" onclick="clearForm()">↺ Reset</button>
        <button class="btn-action" onclick="exportJSON()">📥 Export JSON</button>
        <button class="btn-action btn-primary" onclick="saveQuote()">💾 Save Quote</button>
      </div>
    </header>

    <!-- Workspace Grid -->
    <div class="workspace-grid">

      <!-- LEFT: Data Entry Fields -->
      <div class="blocks-stream">

        <!-- 1. QUOTE CONTENT -->
        <section class="entry-card">
          <div class="card-header">
            <div class="card-header-left">
              <span class="card-title">1. Quote Core &amp; Context</span>
            </div>
            <span class="card-tag">Required</span>
          </div>
          <div class="card-body">
            <div>
              <div class="field-label">
                <span>Main Quote Content (Multi-Line)</span>
                <span class="field-hint">Preserves line breaks</span>
              </div>
              <textarea class="raw-textarea-box" id="input-main-content" placeholder="Enter wisdom quote, poem, or reflection..." oninput="updateField('main_content', this.value)"></textarea>
            </div>
            <div>
              <div class="field-label">
                <span>Genesis Context &amp; Interpretation</span>
                <span class="field-hint">Situational backdrop</span>
              </div>
              <textarea class="raw-textarea-box" id="input-context" style="min-height: 80px;" placeholder="Genesis context, medium, or why this quote matters..." oninput="updateField('context', this.value)"></textarea>
            </div>
          </div>
        </section>

        <!-- 2. FLEXIBLE DATE -->
        <section class="entry-card">
          <div class="card-header">
            <div class="card-header-left">
              <span class="card-title">2. Flexible Date</span>
            </div>
            <span class="card-tag">Auto-Suggester</span>
          </div>
          <div class="card-body">
            <div class="multi-select-host">
              <div class="field-label">
                <span>Temporal Coordinate</span>
                <span class="field-hint">Year, Month, Range (~), or Exact</span>
              </div>
              <input type="text" class="raw-input-box" id="input-date" placeholder="Type year e.g. 2020, range 2020~2023-05, or date..." oninput="handleDateInput(this.value)" onfocus="handleDateInput(this.value)">
              <div class="notion-dropdown-menu" id="date-dropdown">
                <div class="dropdown-options-list" id="date-options-list"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- 3. SPEAKER MULTI-SELECT -->
        <section class="entry-card">
          <div class="card-header">
            <div class="card-header-left">
              <span class="card-title">3. Attribution &amp; Speaker</span>
            </div>
            <span class="card-tag">Hex ID Entities</span>
          </div>
          <div class="card-body">
            <div class="multi-select-host" id="speaker-host">
              <div class="field-label">
                <span>Select or Create Speakers</span>
                <span class="field-hint">Search / Create on Enter</span>
              </div>
              <div class="multi-tag-box" id="speaker-box" onclick="focusInput('speaker-input')">
                <div id="speaker-chips" style="display: contents;"></div>
                <input type="text" class="tag-inline-input" id="speaker-input" placeholder="+ Add or search speaker..." oninput="filterSpeakerDropdown(this.value)" onkeydown="handleSpeakerKey(event)" onfocus="filterSpeakerDropdown(this.value)">
              </div>
              <div class="notion-dropdown-menu" id="speaker-dropdown">
                <div class="dropdown-options-list" id="speaker-options-list"></div>
                <div class="dropdown-create-row" id="speaker-create-row" style="display: none;" onclick="createSpeakerOption()">
                  <span>+ Create new speaker entity "</span><span id="speaker-create-query"></span><span>"</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 4. RESPONSE QUOTES (PREFERENCE) -->
        <section class="entry-card">
          <div class="card-header">
            <div class="card-header-left">
              <span class="card-title">4. Response Quotes (Preference)</span>
            </div>
            <span class="card-tag">Content Browser</span>
          </div>
          <div class="card-body">
            <div class="multi-select-host" id="pref-host">
              <div class="field-label">
                <span>Referenced &amp; Linked Response Quotes</span>
                <span class="field-hint">Browse by Content Text</span>
              </div>
              <div class="multi-tag-box" id="pref-box" onclick="focusInput('pref-input')">
                <div id="pref-chips" style="display: contents;"></div>
                <input type="text" class="tag-inline-input" id="pref-input" placeholder="Search existing quotes by content..." oninput="filterPrefDropdown(this.value)" onfocus="filterPrefDropdown(this.value)">
              </div>
              <div class="notion-dropdown-menu" id="pref-dropdown">
                <div class="dropdown-options-list" id="pref-options-list"></div>
              </div>
            </div>
            <div class="field-hint">💡 Shows quote content snippet with subtle context. Underlying schema stores deterministic 16-character hex IDs.</div>
          </div>
        </section>

        <!-- 5. MULTIPLE-CHOICE TAG POOL -->
        <section class="entry-card">
          <div class="card-header">
            <div class="card-header-left">
              <span class="card-title">5. Multiple-Choice Tag Pool</span>
            </div>
            <span class="card-tag">Manager Domain</span>
          </div>
          <div class="card-body">
            <div class="field-label">
              <span>Click any tag to toggle ON/OFF. Hover '✕' to remove choice from pool.</span>
              <span class="field-hint" id="active-tag-count">0 selected</span>
            </div>
            <div class="tag-choice-board" id="tag-board">
              <!-- Rendered via JS -->
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.5rem;">
              <input type="text" class="raw-input-box" id="input-new-tag" placeholder="+ Type new tag name and press Enter..." style="height: 38px; font-size: 0.85rem;" onkeydown="handleNewTagKey(event)">
              <button class="btn-action" onclick="addNewTagFromInput()">+ Add Tag</button>
            </div>
          </div>
        </section>

        <!-- 6. BACKLINKS & SENTIMENT -->
        <section class="entry-card">
          <div class="card-header">
            <div class="card-header-left">
              <span class="card-title">6. Backlinks &amp; Tone</span>
            </div>
            <span class="card-tag">Metadata</span>
          </div>
          <div class="card-body">
            <div>
              <div class="field-label">
                <span>External Reference URL / Backlink</span>
                <span class="field-hint">e.g. lyrics URL, paper, book link</span>
              </div>
              <input type="text" class="raw-input-box" id="input-backlink" placeholder="https://..." oninput="updateBacklink(this.value)">
            </div>
            <div>
              <div class="field-label">
                <span>Sentiment / Philosophical Resonance</span>
                <span class="field-hint">Free text e.g. stoic, nostalgic, analytical</span>
              </div>
              <input type="text" class="raw-input-box" id="input-sentiment" placeholder="analytical" oninput="updateField('sentiment', this.value)">
            </div>
          </div>
        </section>

      </div>

      <!-- RIGHT: LIVE STATE INSPECTOR -->
      <aside class="inspector-sticky">
        <div class="inspector-header">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-weight: 700; font-size: 0.9rem; color: var(--text-vivid);">Live State Preview</span>
            <span class="card-tag" id="live-index-badge">IDX: 1</span>
          </div>
          <button class="btn-action" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;" onclick="copyJSON()">📋 Copy</button>
        </div>
        <pre class="live-json-display" id="live-json-pre">{ /* Loading live state... */ }</pre>
      </aside>

    </div>

  </div>

  <!-- Toast -->
  <div class="toast-msg" id="toast">State Updated</div>

  <script>
    // ==============================================================================
    // PRESCRIPTS CLIENT CONTROLLER
    // ==============================================================================

    // Active Quote State
    let activeQuote = {
      id: "",
      index: 1,
      main_content: "",
      context: "",
      date: "",
      source_speaker: [],
      preference: [],
      backlink: [],
      tags: [],
      sentiment: ""
    };

    // Pools loaded from backend or local cache
    let availableSpeakers = [
      { id: "0047FB356CE65652", name: "Faust", bio: "Strategic Analytical Intellect" },
      { id: "0047FB356CE62F42", name: "Vinyl Angel", bio: "Lyricism from Koi no Koe" },
      { id: "0047FB356CE60001", name: "The Manager", bio: "Visionary & Commander" },
      { id: "0047FB356CE60002", name: "Marcus Aurelius", bio: "Stoic Emperor & Philosopher" }
    ];

    let availableQuotes = {
      "0047FB356CE62F42": {
        id: "0047FB356CE62F42",
        index: 1,
        main_content: "Static hum, thrum—needle drops,\nSpinning echo, time just stops.",
        context: "Lyricism from 'Koi no Koe' by Vinyl Angel.",
        date: "2026-09-30",
        speaker_name: "Vinyl Angel"
      },
      "0047FB356CE65652": {
        id: "0047FB356CE65652",
        index: 2,
        main_content: "The universe is built on a plan, the profound symmetry of which is somehow present in every inner corner of human thought.",
        context: "Reflections on cybernetics and distributed consciousness.",
        date: "2026-09-30",
        speaker_name: "Faust"
      }
    };

    let availableTags = ["cybernetics", "symmetry", "entropy", "sovereignty", "lyricism", "memory", "music", "morning-ritual", "stoic"];

    // 16-Char Hex ID Generator
    function generateHexId() {
      const now = Date.now();
      const rand = Math.floor(Math.random() * 0xFFFF);
      return (now.toString(16) + rand.toString(16)).toUpperCase().padStart(16, '0').slice(0, 16);
    }

    // UI Updates
    function updateField(field, value) {
      activeQuote[field] = value;
      if (!activeQuote.id && activeQuote.main_content.trim()) {
        activeQuote.id = generateHexId();
      }
      renderLiveJSON();
    }

    function updateBacklink(val) {
      activeQuote.backlink = val.trim() ? [val.trim()] : [];
      renderLiveJSON();
    }

    function renderLiveJSON() {
      const pre = document.getElementById('live-json-pre');
      pre.textContent = JSON.stringify(activeQuote, null, 2);
      document.getElementById('live-index-badge').textContent = `IDX: ${activeQuote.index}`;
    }

    function fireToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2400);
    }

    // ==============================================================================
    // 2. FLEXIBLE DATE SUGGESTOR
    // ==============================================================================
    function handleDateInput(val) {
      activeQuote.date = val.trim();
      renderLiveJSON();

      const dropdown = document.getElementById('date-dropdown');
      const list = document.getElementById('date-options-list');
      const q = val.trim().toLowerCase();

      const currentYear = new Date().getFullYear();
      let suggestions = [];

      if (!q) {
        suggestions = [
          `${currentYear}`,
          `${currentYear}-10`,
          `${currentYear}-10-02`,
          `2020~${currentYear}`,
          `2020`
        ];
      } else {
        // Generate contextual suggestions
        if (/^\d{1,4}$/.test(q)) {
          suggestions.push(q);
          suggestions.push(`${q}-01`);
          suggestions.push(`${q}-05`);
          suggestions.push(`${q}~${currentYear}`);
        } else if (/^\d{4}-/.test(q)) {
          suggestions.push(q);
          suggestions.push(`${q}-01`);
          suggestions.push(`${q}-15`);
        } else {
          suggestions.push(q);
        }
      }

      list.innerHTML = suggestions.slice(0, 5).map(s => `
        <div class="dropdown-opt-row" onclick="selectDate('${s}')">
          <span style="font-weight:600; font-family:'JetBrains Mono'; color:var(--accent);">📅 ${s}</span>
        </div>
      `).join('');

      dropdown.classList.add('open');
    }

    function selectDate(val) {
      document.getElementById('input-date').value = val;
      activeQuote.date = val;
      document.getElementById('date-dropdown').classList.remove('open');
      renderLiveJSON();
    }

    // ==============================================================================
    // 3. SPEAKER MULTI-SELECT
    // ==============================================================================
    function renderSpeakerChips() {
      const container = document.getElementById('speaker-chips');
      container.innerHTML = activeQuote.source_speaker.map(sid => {
        const found = availableSpeakers.find(s => s.id === sid);
        const name = found ? found.name : sid;
        return `
          <span class="tag-chip">
            <span>👤 ${name}</span>
            <span class="tag-chip-remove" onclick="event.stopPropagation(); removeSpeaker('${sid}')">✕</span>
          </span>
        `;
      }).join('');
    }

    function filterSpeakerDropdown(q) {
      const dropdown = document.getElementById('speaker-dropdown');
      const list = document.getElementById('speaker-options-list');
      const createRow = document.getElementById('speaker-create-row');
      const query = (q || "").trim().toLowerCase();

      dropdown.classList.add('open');

      const matches = availableSpeakers.filter(s => s.name.toLowerCase().includes(query));

      list.innerHTML = matches.map(s => {
        const isSelected = activeQuote.source_speaker.includes(s.id);
        return `
          <div class="dropdown-opt-row ${isSelected ? 'selected' : ''}" onclick="toggleSpeaker('${s.id}')">
            <div class="opt-label-group">
              <span class="opt-title">${s.name} ${isSelected ? '✓' : ''}</span>
              ${s.bio ? `<span class="opt-context">${s.bio}</span>` : ''}
            </div>
            <button class="opt-delete-btn" title="Delete from speaker pool" onclick="event.stopPropagation(); deleteSpeakerPool('${s.id}')">✕</button>
          </div>
        `;
      }).join('');

      if (query && !availableSpeakers.some(s => s.name.toLowerCase() === query)) {
        createRow.style.display = 'flex';
        document.getElementById('speaker-create-query').textContent = q.trim();
      } else {
        createRow.style.display = 'none';
      }
    }

    function toggleSpeaker(id) {
      if (activeQuote.source_speaker.includes(id)) {
        activeQuote.source_speaker = activeQuote.source_speaker.filter(s => s !== id);
      } else {
        activeQuote.source_speaker.push(id);
      }
      renderSpeakerChips();
      renderLiveJSON();
      document.getElementById('speaker-input').value = "";
      document.getElementById('speaker-dropdown').classList.remove('open');
    }

    function removeSpeaker(id) {
      activeQuote.source_speaker = activeQuote.source_speaker.filter(s => s !== id);
      renderSpeakerChips();
      renderLiveJSON();
    }

    function createSpeakerOption() {
      const input = document.getElementById('speaker-input');
      const name = input.value.trim();
      if (!name) return;

      const newId = generateHexId();
      const newSpk = { id: newId, name: name, bio: "" };
      availableSpeakers.push(newSpk);
      activeQuote.source_speaker.push(newId);

      // Async post to local server if live
      fetch('/api/speaker', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newSpk)
      }).catch(() => {});

      input.value = "";
      renderSpeakerChips();
      renderLiveJSON();
      document.getElementById('speaker-dropdown').classList.remove('open');
      fireToast("Created Speaker: " + name);
    }

    function handleSpeakerKey(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        createSpeakerOption();
      } else if (e.key === 'Backspace' && e.target.value === '') {
        if (activeQuote.source_speaker.length > 0) {
          activeQuote.source_speaker.pop();
          renderSpeakerChips();
          renderLiveJSON();
        }
      }
    }

    function deleteSpeakerPool(id) {
      availableSpeakers = availableSpeakers.filter(s => s.id !== id);
      activeQuote.source_speaker = activeQuote.source_speaker.filter(s => s !== id);
      renderSpeakerChips();
      filterSpeakerDropdown(document.getElementById('speaker-input').value);
      renderLiveJSON();
      fireToast("Deleted speaker from pool");
    }

    // ==============================================================================
    // 4. RESPONSE QUOTES BROWSER (PREFERENCE)
    // ==============================================================================
    function renderPrefChips() {
      const container = document.getElementById('pref-chips');
      container.innerHTML = activeQuote.preference.map(qid => {
        const q = availableQuotes[qid];
        const snippet = q ? q.main_content.split('\n')[0].substring(0, 36) + '...' : qid.substring(0, 8);
        return `
          <span class="tag-chip" title="${q ? q.main_content : qid}">
            <span>💬 ${snippet}</span>
            <span class="tag-chip-remove" onclick="event.stopPropagation(); removePref('${qid}')">✕</span>
          </span>
        `;
      }).join('');
    }

    function filterPrefDropdown(q) {
      const dropdown = document.getElementById('pref-dropdown');
      const list = document.getElementById('pref-options-list');
      const query = (q || "").trim().toLowerCase();

      dropdown.classList.add('open');

      const matches = Object.values(availableQuotes).filter(quote => {
        return quote.main_content.toLowerCase().includes(query) ||
               (quote.context && quote.context.toLowerCase().includes(query)) ||
               (quote.speaker_name && quote.speaker_name.toLowerCase().includes(query));
      });

      if (matches.length === 0) {
        list.innerHTML = '<div style="color:var(--text-muted); font-size:0.85rem; padding:0.5rem;">No matching quotes found.</div>';
        return;
      }

      list.innerHTML = matches.map(quote => {
        const isSelected = activeQuote.preference.includes(quote.id);
        const firstLine = quote.main_content.split('\n')[0];
        return `
          <div class="dropdown-opt-row ${isSelected ? 'selected' : ''}" onclick="togglePref('${quote.id}')">
            <div class="opt-label-group">
              <span class="opt-title">“${firstLine}” ${isSelected ? '✓' : ''}</span>
              <span class="opt-context">${quote.speaker_name || 'Author'} · ${quote.date} · ${quote.context || ''}</span>
            </div>
            <span style="font-family:'JetBrains Mono'; font-size:0.7rem; color:var(--text-dim);">#${quote.id.substring(0,8)}</span>
          </div>
        `;
      }).join('');
    }

    function togglePref(id) {
      if (activeQuote.preference.includes(id)) {
        activeQuote.preference = activeQuote.preference.filter(q => q !== id);
      } else {
        activeQuote.preference.push(id);
      }
      renderPrefChips();
      renderLiveJSON();
      document.getElementById('pref-input').value = "";
      document.getElementById('pref-dropdown').classList.remove('open');
    }

    function removePref(id) {
      activeQuote.preference = activeQuote.preference.filter(q => q !== id);
      renderPrefChips();
      renderLiveJSON();
    }

    // ==============================================================================
    // 5. MULTIPLE-CHOICE TAG POOL
    // ==============================================================================
    function renderTagBoard() {
      const board = document.getElementById('tag-board');
      board.innerHTML = availableTags.map(tag => {
        const isActive = activeQuote.tags.includes(tag);
        return `
          <div class="tag-choice-pill ${isActive ? 'active' : ''}" onclick="toggleTagChoice('${tag}')">
            <span># ${tag}</span>
            <span class="tag-choice-delete" title="Delete from tag pool" onclick="event.stopPropagation(); deleteTagChoice('${tag}')">✕</span>
          </div>
        `;
      }).join('');

      document.getElementById('active-tag-count').textContent = `${activeQuote.tags.length} selected`;
    }

    function toggleTagChoice(tag) {
      if (activeQuote.tags.includes(tag)) {
        activeQuote.tags = activeQuote.tags.filter(t => t !== tag);
      } else {
        activeQuote.tags.push(tag);
      }
      renderTagBoard();
      renderLiveJSON();
    }

    function addNewTagFromInput() {
      const input = document.getElementById('input-new-tag');
      const val = input.value.replace(/#/g, '').trim().toLowerCase();
      if (!val) return;

      if (!availableTags.includes(val)) {
        availableTags.push(val);
      }
      if (!activeQuote.tags.includes(val)) {
        activeQuote.tags.push(val);
      }

      input.value = "";
      renderTagBoard();
      renderLiveJSON();
      fireToast("Added tag: " + val);
    }

    function handleNewTagKey(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        addNewTagFromInput();
      }
    }

    function deleteTagChoice(tag) {
      availableTags = availableTags.filter(t => t !== tag);
      activeQuote.tags = activeQuote.tags.filter(t => t !== tag);
      renderTagBoard();
      renderLiveJSON();
      fireToast("Deleted tag from pool: " + tag);
    }

    // ==============================================================================
    // SAVE & EXPORT PIPELINE
    // ==============================================================================
    async function saveQuote() {
      if (!activeQuote.main_content.trim()) {
        alert("Please provide the main quote content before saving.");
        return;
      }

      if (!activeQuote.id) activeQuote.id = generateHexId();
      if (!activeQuote.date) activeQuote.date = new Date().toISOString().split('T')[0];

      // Send to local server
      try {
        const res = await fetch('/api/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(activeQuote)
        });

        if (res.ok) {
          const data = await res.json();
          fireToast(`Saved Quote #${data.index} to SQLite & Projections!`);
          // Increment index for next quote
          activeQuote.index = data.index + 1;
          activeQuote.id = "";
          activeQuote.main_content = "";
          activeQuote.context = "";
          activeQuote.preference = [];
          document.getElementById('input-main-content').value = "";
          document.getElementById('input-context').value = "";
          renderPrefChips();
          renderLiveJSON();
          fetchBackendData();
          return;
        }
      } catch (err) {
        console.warn("Local server offline, copying to clipboard as fallback:", err);
      }

      // Offline fallback: download JSON and notify
      exportJSON();
      fireToast("Saved locally (Server offline). Downloaded JSON.");
    }

    function clearForm() {
      activeQuote = {
        id: "",
        index: activeQuote.index,
        main_content: "",
        context: "",
        date: "",
        source_speaker: [],
        preference: [],
        backlink: [],
        tags: [],
        sentiment: ""
      };
      document.getElementById('input-main-content').value = "";
      document.getElementById('input-context').value = "";
      document.getElementById('input-date').value = "";
      document.getElementById('input-backlink').value = "";
      document.getElementById('input-sentiment').value = "";
      renderSpeakerChips();
      renderPrefChips();
      renderTagBoard();
      renderLiveJSON();
    }

    function exportJSON() {
      if (!activeQuote.id) activeQuote.id = generateHexId();
      const str = JSON.stringify(activeQuote, null, 2);
      const blob = new Blob([str], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `prescript-${activeQuote.id}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function copyJSON() {
      navigator.clipboard.writeText(JSON.stringify(activeQuote, null, 2)).then(() => {
        fireToast("Copied JSON state to clipboard!");
      });
    }

    function toggleTheme() {
      const html = document.documentElement;
      const cur = html.getAttribute('data-theme') || 'dark';
      const nxt = cur === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', nxt);
      localStorage.setItem('prescripts-theme', nxt);
    }

    function focusInput(id) {
      document.getElementById(id).focus();
    }

    // Load initial taxonomy & quotes from local server
    async function fetchBackendData() {
      try {
        const taxRes = await fetch('/api/taxonomy');
        if (taxRes.ok) {
          const tax = await taxRes.json();
          if (tax.speakers && tax.speakers.length > 0) availableSpeakers = tax.speakers;
          if (tax.tags && tax.tags.length > 0) availableTags = tax.tags;
        }

        const qRes = await fetch('/api/quotes');
        if (qRes.ok) {
          const quotes = await qRes.json();
          if (Object.keys(quotes).length > 0) availableQuotes = quotes;
        }

        const idxRes = await fetch('/api/next_index');
        if (idxRes.ok) {
          const data = await idxRes.json();
          activeQuote.index = data.next_index;
        }
      } catch (e) {
        console.log("Using cached/embedded taxonomy pools.");
      }

      renderSpeakerChips();
      renderPrefChips();
      renderTagBoard();
      renderLiveJSON();
    }

    // Global click listener to close dropdowns
    document.addEventListener('click', function(e) {
      if (!e.target.closest('#date-dropdown') && !e.target.closest('#input-date')) {
        document.getElementById('date-dropdown').classList.remove('open');
      }
      if (!e.target.closest('#speaker-dropdown') && !e.target.closest('#speaker-box')) {
        document.getElementById('speaker-dropdown').classList.remove('open');
      }
      if (!e.target.closest('#pref-dropdown') && !e.target.closest('#pref-box')) {
        document.getElementById('pref-dropdown').classList.remove('open');
      }
    });

    // Boot
    window.addEventListener('DOMContentLoaded', () => {
      const savedTheme = localStorage.getItem('prescripts-theme');
      if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);
      fetchBackendData();
    });
  </script>
</body>
</html>
