"""
Entropy Rose: Consolidated SQLite Persistence & FTS5 Search Engine.
Adheres strictly to the Faust SQLite Persistence Protocol:
- Pure 2-Table Schema: 'quotes' and 'speakers' (zero dead columns, no created_at, no redundant tables)
- 16-character hex identifiers: <4 HEX PREFIX><12 HEX UNIX MILLISECONDS>
- WAL mode, NORMAL synchronous, 5000ms busy timeout, foreign_keys = ON
- Write transactions via BEGIN IMMEDIATE
- Idempotent migrations tracking via _schema_migrations
- Automatic O(1) JSON projection compilation on write
"""

import sqlite3
import json
import os
from typing import Dict, Any, List, Optional

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_DB_PATH = os.path.join(BASE_DIR, "data", "rose_quotes.db")
DEFAULT_JSONL_PATH = os.path.join(BASE_DIR, "data", "quotes.jsonl")


def get_connection(db_path: str = DEFAULT_DB_PATH) -> sqlite3.Connection:
    """Creates a connection configured with mandatory WAL and concurrency pragmas."""
    os.makedirs(os.path.dirname(os.path.abspath(db_path)), exist_ok=True)
    conn = sqlite3.connect(db_path, timeout=5.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode = WAL;")
    conn.execute("PRAGMA synchronous = NORMAL;")
    conn.execute("PRAGMA busy_timeout = 5000;")
    conn.execute("PRAGMA foreign_keys = ON;")
    return conn


def init_db(db_path: str = DEFAULT_DB_PATH) -> None:
    """Initializes tables and forward migrations idempotently."""
    conn = get_connection(db_path)
    with conn:
        conn.execute("BEGIN IMMEDIATE;")

        # Migrations tracking table
        conn.execute("""
            CREATE TABLE IF NOT EXISTS _schema_migrations (
                version INTEGER PRIMARY KEY,
                applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                description TEXT NOT NULL
            );
        """)

        # Migration 4: Consolidated Pure 2-Table Schema
        cur = conn.execute("SELECT version FROM _schema_migrations WHERE version = 4;")
        if not cur.fetchone():
            # 1. Drop old legacy backlinks table if present
            conn.execute("DROP TABLE IF EXISTS backlinks;")

            # 2. Ensure clean speakers table (id, name, bio — no created_at)
            conn.execute("""
                CREATE TABLE IF NOT EXISTS speakers (
                    id TEXT PRIMARY KEY,
                    name TEXT NOT NULL UNIQUE,
                    bio TEXT
                );
            """)
            conn.execute("CREATE INDEX IF NOT EXISTS idx_speakers_name ON speakers(name);")

            # 3. Create or migrate clean quotes table
            # Check existing columns in quotes
            tables = [r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table';").fetchall()]
            if "quotes" in tables:
                conn.execute("""
                    CREATE TABLE IF NOT EXISTS quotes_clean (
                        id TEXT PRIMARY KEY,
                        idx INTEGER UNIQUE NOT NULL,
                        main_content TEXT NOT NULL,
                        context TEXT,
                        date TEXT NOT NULL,
                        speaker_ids TEXT,
                        preference TEXT,
                        backlinks TEXT,
                        tags TEXT,
                        sentiment TEXT
                    );
                """)
                # Migrate existing data safely
                cols = [r["name"] for r in conn.execute("PRAGMA table_info(quotes);").fetchall()]
                spk_col = "speaker_ids_json" if "speaker_ids_json" in cols else "speaker_name"
                pref_col = "preference_json" if "preference_json" in cols else "'[]'"
                back_col = "backlinks_json" if "backlinks_json" in cols else "'[]'"
                tags_col = "tags_json" if "tags_json" in cols else "'[]'"
                sent_col = "sentiment" if "sentiment" in cols else "''"

                conn.execute(f"""
                    INSERT OR REPLACE INTO quotes_clean (id, idx, main_content, context, date, speaker_ids, preference, backlinks, tags, sentiment)
                    SELECT id, idx, main_content, context, date, {spk_col}, {pref_col}, {back_col}, {tags_col}, {sent_col}
                    FROM quotes;
                """)
                conn.execute("DROP TABLE quotes;")
                conn.execute("ALTER TABLE quotes_clean RENAME TO quotes;")
            else:
                conn.execute("""
                    CREATE TABLE IF NOT EXISTS quotes (
                        id TEXT PRIMARY KEY,
                        idx INTEGER UNIQUE NOT NULL,
                        main_content TEXT NOT NULL,
                        context TEXT,
                        date TEXT NOT NULL,
                        speaker_ids TEXT,
                        preference TEXT,
                        backlinks TEXT,
                        tags TEXT,
                        sentiment TEXT
                    );
                """)

            conn.execute("CREATE INDEX IF NOT EXISTS idx_quotes_idx ON quotes(idx);")
            conn.execute("CREATE INDEX IF NOT EXISTS idx_quotes_date ON quotes(date);")

            # 4. Clean FTS5 Full-Text Search Table matching content='quotes'
            conn.execute("DROP TABLE IF EXISTS quotes_fts;")
            conn.execute("""
                CREATE VIRTUAL TABLE IF NOT EXISTS quotes_fts USING fts5(
                    id UNINDEXED,
                    main_content,
                    context,
                    tags,
                    content='quotes',
                    content_rowid='rowid'
                );
            """)

            # Clean Triggers
            conn.execute("""
                CREATE TRIGGER IF NOT EXISTS quotes_ai AFTER INSERT ON quotes BEGIN
                    INSERT INTO quotes_fts(rowid, id, main_content, context, tags)
                    VALUES (new.rowid, new.id, new.main_content, new.context, new.tags);
                END;
            """)
            conn.execute("""
                CREATE TRIGGER IF NOT EXISTS quotes_ad AFTER DELETE ON quotes BEGIN
                    INSERT INTO quotes_fts(quotes_fts, rowid, id, main_content, context, tags)
                    VALUES('delete', old.rowid, old.id, old.main_content, old.context, old.tags);
                END;
            """)
            conn.execute("""
                CREATE TRIGGER IF NOT EXISTS quotes_au AFTER UPDATE ON quotes BEGIN
                    INSERT INTO quotes_fts(quotes_fts, rowid, id, main_content, context, tags)
                    VALUES('delete', old.rowid, old.id, old.main_content, old.context, old.tags);
                    INSERT INTO quotes_fts(rowid, id, main_content, context, tags)
                    VALUES (new.rowid, new.id, new.main_content, new.context, new.tags);
                END;
            """)

            # Populate FTS5 with any existing records
            conn.execute("""
                INSERT INTO quotes_fts(rowid, id, main_content, context, tags)
                SELECT rowid, id, main_content, context, tags FROM quotes;
            """)

            conn.execute("INSERT INTO _schema_migrations (version, description) VALUES (4, 'Consolidated Pure 2-Table Schema (quotes & speakers) with no dead columns');")

    conn.close()


