          // Chaos completely resolved into Content!
          isDrawing = false;
          stopGapChimeScheduler();
          if (led) led.classList.remove('drawing');

          // Render clean final HTML with proper prefixes, suffixes, quotation marks, and line justification classes
          container.innerHTML = `
            <div class="ep-content ${alignClass}">
              ${parsed.map(pl => `<div class="ep-text-line ${pl.align}">${pl.prefix}${pl.text}${pl.suffix}</div>`).join('')}
            </div>
          `;

          const hTitle = document.getElementById('ep-header-left-title');
          if (hTitle && lastFinalHeaderTitleHTML) {
            hTitle.innerHTML = lastFinalHeaderTitleHTML;
          }

          // Final decree seal: play complete_sound.wav once when text is fully displayed!
          playSoundEffect('complete');
          return;
        }

        typingTimer = requestAnimationFrame(entropyStep);
      }

      entropyStep();
    }

    function skipAnimation() {
      if (!isDrawing) return;
      stopDrawingAnimation();
      stopGapChimeScheduler();

      const headerTitleEl = document.getElementById('ep-header-left-title');
      if (headerTitleEl && lastFinalHeaderTitleHTML) {
        headerTitleEl.innerHTML = lastFinalHeaderTitleHTML;
      }

      const container = document.getElementById('ep-viewport');
      if (container && lastRenderedPageData) {
        container.innerHTML = `
          <div class="ep-content ${lastRenderedAlignClass}">
            ${lastRenderedPageData.lines.map(line => {
              const htmlStr = (typeof line === 'object' && line !== null) ? line.html : line;
              const alignCls = (typeof line === 'object' && line !== null) ? (line.align || 'line-left') : 'line-left';
              return `<div class="ep-text-line ${alignCls}">${htmlStr}</div>`;
            }).join('')}
          </div>
        `;
      }
      playSoundEffect('complete');
    }

    // ==============================================================================
    // 3. INITIALIZATION & DATA FETCHING
    // ==============================================================================
    async function init() {
      applyPreset('19', false);

      try {
        const [taxRes, qRes] = await Promise.all([
          fetch(`${API_BASE}/api/taxonomy`).then(r => r.json()).catch(() => null),
          fetch(`${API_BASE}/api/quotes/list`).then(r => r.json()).catch(() => null)
        ]);

        if (taxRes && qRes && qRes.length > 0) {
          availableSpecifics = taxRes.specifics || [];
          availableThemes = taxRes.themes || [];
          quotesList = qRes;
          document.getElementById('connection-status').innerHTML = '● LIVE API SYNCED';
          document.getElementById('connection-status').style.color = '#38bdf8';
        } else {
          useFallbackData();
        }
      } catch (err) {
        console.warn("Using offline fallback data:", err);
        useFallbackData();
      }

      populateSelect();

      // Default to Quote #6 (or first) with static silent load on startup
      const target = quotesList.find(q => (q.idx === 6 || q.index === 6)) || quotesList[0];
      if (target) {
        loadSelectedQuote(target.id, false);
      }
    }

    function useFallbackData() {
      quotesList = FALLBACK_QUOTES;
      document.getElementById('connection-status').innerHTML = '● STANDALONE CACHE';
      document.getElementById('connection-status').style.color = '#f59e0b';
    }

    function populateSelect() {
      const select = document.getElementById('quote-select');
      select.innerHTML = quotesList.map(q => {
        const snippet = (q.main_content || "").split('\n')[0].substring(0, 32);
        const idx = q.idx ?? q.index ?? '?';
        return `<option value="${q.id}">#${idx} — "${snippet}..."</option>`;
      }).join('');
    }

    function loadSelectedQuote(qid, shouldAnimate = true) {
      activeQuote = quotesList.find(q => q.id === qid) || quotesList[0];
      if (!activeQuote) return;

      currentPage = 1;
      document.getElementById('quote-select').value = activeQuote.id;
      renderActivePrescript(shouldAnimate);
    }

    function drawNewPrescript() {
      if (quotesList.length === 0) return;
      const rnd = quotesList[Math.floor(Math.random() * quotesList.length)];
      loadSelectedQuote(rnd.id, true);
    }

    function navQuote(step) {
      if (quotesList.length === 0) return;
      const curIdx = quotesList.findIndex(q => q.id === (activeQuote ? activeQuote.id : ''));
      let nextIdx = (curIdx + step + quotesList.length) % quotesList.length;
      loadSelectedQuote(quotesList[nextIdx].id, true);
    }

    function pickRandomQuote() {
      drawNewPrescript();
    }

    function reRollColors() {
      reRollSeed = Math.floor(Math.random() * 1000);
      if (userHasInteracted) playBeeperChirp('click');
      renderActivePrescript(false);
    }

    function toggleContext() {
      showContext = !showContext;
      currentPage = 1;
      const btn = document.getElementById('btn-toggle-context');
      btn.textContent = `Context: ${showContext ? 'ON' : 'OFF'}`;
      btn.classList.toggle('active', showContext);
      if (userHasInteracted) playBeeperChirp('click');
      renderActivePrescript(false);
    }

    function setTheme(tName) {
      currentTheme = tName;
      ['obsidian', 'eink', 'amber', 'matrix'].forEach(t => {
        const b = document.getElementById(`btn-theme-` + t);
        if (b) b.classList.toggle('active', t === tName);
      });
      const sc = document.getElementById('epaper-screen');
      if (sc) sc.className = `epaper-screen theme-${tName}`;
      if (userHasInteracted) playBeeperChirp('click');
    }

    // ==============================================================================
    // 4. SCREEN PRESET & RATIO APPLICATION
    // ==============================================================================
    function applyPreset(key, playSound = true) {
      currentPresetKey = key;
      const p = HARDWARE_PRESETS[key] || HARDWARE_PRESETS['19'];

      document.querySelectorAll('.ratio-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById(`rb-${key}`);
      if (activeBtn) activeBtn.classList.add('active');

      document.getElementById('active-screen-spec').textContent = `${p.name} · ${p.w}×${p.h} px · Ratio ${p.ratio}`;
      document.getElementById('bezel-dim-label').textContent = `${p.w} × ${p.h} NATIVE (4-LINE MATRIX)`;

      const screen = document.getElementById('epaper-screen');
      const scaleMultiplier = isNative1x ? 1.0 : p.scale;

      const targetW = Math.round(p.w * scaleMultiplier);
      const targetH = Math.round(p.h * scaleMultiplier);

      screen.style.width = `${targetW}px`;
      screen.style.height = `${targetH}px`;
      screen.style.aspectRatio = `${p.w} / ${p.h}`;

      currentPage = 1;
      renderActivePrescript(false);
      if (playSound && userHasInteracted) playBeeperChirp('click');
    }

    function toggleNativeScale() {
      isNative1x = !isNative1x;
      const btn = document.getElementById('btn-scale');
      btn.textContent = isNative1x ? 'Scale: 1:1 Native' : 'Scale: Studio 2x';
      btn.classList.toggle('active', isNative1x);
      applyPreset(currentPresetKey, true);
    }

    function setFontFamily(key) {
      if (!FONT_PRESETS[key]) return;
      currentFontKey = key;
      const f = FONT_PRESETS[key];
      document.querySelectorAll('[id^="btn-font-"]').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById(`btn-font-${key}`);
      if (activeBtn) activeBtn.classList.add('active');

      document.documentElement.style.setProperty('--screen-font', f.css);
      document.documentElement.style.setProperty('--screen-font-size', f.size);

      currentPage = 1;
      if (userHasInteracted) playBeeperChirp('click');
      renderActivePrescript(false);
    }

    // ==============================================================================
    // 5. VIEWPORT 4-LINE DISCRETE PAGINATION ENGINE (ZERO SCROLLBAR // 4 LINES MAX)
    // ==============================================================================
    let currentPage = 1;
    let totalPages = 1;
    let wheelDebounceTimer = null;

    function getCharsPerLine(key) {
      const p = HARDWARE_PRESETS[key] || HARDWARE_PRESETS['19'];
      const f = FONT_PRESETS[currentFontKey] || FONT_PRESETS['jetbrains'];
      // Target width minus 28px padding divided by font character ratio
      return Math.max(16, Math.floor((p.w - 28) / (f.charRatio || 7.9)));
    }

    function wrapTextToLines(text, maxChars) {
      const paragraphs = (text || "").split('\n');
      const lines = [];

      for (const para of paragraphs) {
        if (!para.trim()) {
          lines.push('');
          continue;
        }
        const words = para.trim().split(/\s+/);
        let curLine = '';
        for (const w of words) {
          if (!curLine) {
            curLine = w;
          } else if ((curLine + ' ' + w).length <= maxChars) {
            curLine += ' ' + w;
          } else {
            lines.push(curLine);
            curLine = w;
          }
        }
        if (curLine) {
          lines.push(curLine);
        }
      }
      return lines;
    }

    // Splits quote & context into discrete pages of AT MOST 4 LINES each with strict line budgeting
    function buildPrescriptPages(bundle, maxChars, accentColor) {
      const content = (bundle.content || "").trim();
      const pages = [];
      const MAX_LINES = 4;

      if (!content) return [{ type: 'quote', lines: [''], hasNext: false }];

      // Tokenize by paragraphs first to honor explicit line breaks (\n)
      const paragraphs = content.split('\n');
      const tokens = [];
      for (let i = 0; i < paragraphs.length; i++) {
        const pText = paragraphs[i].trim();
        if (pText) {
          const words = pText.split(/\s+/);
          for (const w of words) tokens.push(w);
        }
        if (i < paragraphs.length - 1) {
          tokens.push('\n');
        }
      }

      let tokenIdx = 0;
      let pageNum = 0;

      while (tokenIdx < tokens.length) {
        pageNum++;
        const isFirstPage = (pageNum === 1);
        const pageLines = [];

        for (let lineNum = 1; lineNum <= MAX_LINES && tokenIdx < tokens.length; lineNum++) {
          const isLine4 = (lineNum === MAX_LINES);

          // Budget characters for this line so "..." never overflows
          let lineBudget = maxChars;
          if (isFirstPage && lineNum === 1) {
            lineBudget = maxChars - 1; // reserve space for “
          }
          if (isLine4) {
            lineBudget = maxChars - 4; // reserve space for ... so it stays on line 4
          }

          let curLine = '';
          while (tokenIdx < tokens.length) {
            const nextTok = tokens[tokenIdx];
            if (nextTok === '\n') {
              tokenIdx++;
              break;
            }
            if (!curLine) {
              curLine = nextTok;
              tokenIdx++;
            } else if ((curLine + ' ' + nextTok).length <= lineBudget) {
              curLine += ' ' + nextTok;
              tokenIdx++;
            } else {
              break;
            }
          }

          pageLines.push(curLine);
        }

        // Lookahead to check if real words remain
        let lookAheadIdx = tokenIdx;
        while (lookAheadIdx < tokens.length && tokens[lookAheadIdx] === '\n') {
          lookAheadIdx++;
        }
        const hasMoreQuote = (lookAheadIdx < tokens.length);

        // Decorate lines:
        if (isFirstPage && pageLines.length > 0) {
          pageLines[0] = `<span class="ep-qmark ep-qmark-open" style="color:${accentColor};">“</span>${pageLines[0]}`;
        }

        const lastLineIdx = pageLines.length - 1;
        if (hasMoreQuote) {
          // Quote continues: append "..." directly to line 4 (never wraps)
          pageLines[lastLineIdx] = `${pageLines[lastLineIdx]}<span class="ep-ellipsis-cue" style="color:${accentColor};">...</span>`;
        } else {
          // Quote completes on this page: append closing quotation mark
          pageLines[lastLineIdx] = `${pageLines[lastLineIdx]}<span class="ep-qmark ep-qmark-close" style="color:${accentColor};">”</span>`;
        }

        // Format line objects with category-driven alignment (writing => justified, music/poem => left)
        const catNorm = (bundle.category || '').toLowerCase().trim();
        const isWriting = catNorm === 'writing' || catNorm === 'bài viết' || catNorm === 'baiviet';

        const lineObjs = pageLines.map((contentStr, lIdx) => {
          const isQuoteTerminalLine = (!hasMoreQuote && lIdx === pageLines.length - 1);
          // If category is writing, all full lines are justified!
          // The final line of the quote (if ragged) is left-aligned.
          const align = (isWriting && !isQuoteTerminalLine && contentStr.includes(' ')) ? 'line-justify' : 'line-left';
          return {
            html: contentStr,
            align: align
          };
        });

        pages.push({
          type: 'quote',
          lines: lineObjs,
          hasNext: hasMoreQuote
        });
      }

      // Handle optional context if enabled (also capped at 4 lines max)
      if (showContext && bundle.context && bundle.context.trim()) {
        const ctxWords = bundle.context.trim().split(/\s+/);
        let cIdx = 0;
        let isFirstCtx = true;

        while (cIdx < ctxWords.length) {
          const cLines = [];
          for (let l = 1; l <= MAX_LINES && cIdx < ctxWords.length; l++) {
            const isL4 = (l === MAX_LINES);
            const lBudget = isL4 ? maxChars - 4 : maxChars;
            let cLine = (isFirstCtx && l === 1) ? '[Note] ' : '';
            if (isFirstCtx && l === 1) isFirstCtx = false;

            while (cIdx < ctxWords.length) {
              const cw = ctxWords[cIdx];
              if (!cLine) {
                cLine = cw;
                cIdx++;
              } else if ((cLine + ' ' + cw).length <= lBudget) {
                cLine += ' ' + cw;
                cIdx++;
              } else {
                break;
              }
            }
            cLines.push(cLine);
          }

          const hasMoreCtx = (cIdx < ctxWords.length);
          if (hasMoreCtx && cLines.length > 0) {
            cLines[cLines.length - 1] = `${cLines[cLines.length - 1]}<span class="ep-ellipsis-cue" style="color:${accentColor};">...</span>`;
          }

          const ctxLineObjs = cLines.map(cStr => ({ html: cStr, align: 'line-left' }));

          pages.push({
            type: 'context',
            lines: ctxLineObjs,
            hasNext: hasMoreCtx
          });
        }
      }

      return pages.length > 0 ? pages : [{ type: 'quote', lines: [''], hasNext: false }];
    }

    function updateTelemetryControls() {
      const prevBtn = document.getElementById('btn-page-prev');
      const nextBtn = document.getElementById('btn-page-next');

      if (prevBtn) prevBtn.style.opacity = (currentPage <= 1) ? '0.4' : '1';
      if (nextBtn) nextBtn.style.opacity = (currentPage >= totalPages) ? '0.4' : '1';
    }

    function changePage(direction) {
      const target = currentPage + direction;
      if (target >= 1 && target <= totalPages) {
        currentPage = target;
        playSoundEffect('complete');
        renderActivePrescript(false);
      }
    }

    function goToPage(pageNum) {
      if (pageNum === 999) pageNum = totalPages;
      if (pageNum >= 1 && pageNum <= totalPages) {
        currentPage = pageNum;
        playSoundEffect('complete');
        renderActivePrescript(false);
      }
    }

    function toggleAutoScroll() {
      const btn = document.getElementById('btn-autoscroll');
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
        btn.textContent = 'Auto-Page: OFF';
        btn.classList.remove('active');
      } else {
        btn.textContent = 'Auto-Page: ON';
        btn.classList.add('active');
        autoScrollInterval = setInterval(() => {
          if (currentPage < totalPages) {
            changePage(1);
          } else {
            currentPage = 1;
            playBeeperChirp('click');
            renderActivePrescript();
          }
        }, 4200);
      }
    }

    // ==============================================================================
    // 6. METADATA NORMALIZATION & COLOR GENERATOR
    // ==============================================================================
    function generateTagColorStyle(tagName, tagIndex) {
      let hash = 0;
      for (let i = 0; i < tagName.length; i++) {
        hash = ((hash << 5) - hash) + tagName.charCodeAt(i);
        hash |= 0;
      }
      const goldenAngle = 137.508;
      const hue = Math.abs(Math.floor((hash * goldenAngle + tagIndex * 89 + reRollSeed) % 360));

      const textColor   = `hsl(${hue}, 85%, 72%)`;
      const borderColor = `hsla(${hue}, 70%, 40%, 0.45)`;
      const bgColor     = `hsla(${hue}, 65%, 8%, 0.9)`;
      return `background: ${bgColor} !important; border-color: ${borderColor} !important; color: ${textColor} !important;`;
    }

    function resolveBundle(q) {
      if (!q) return null;

      const content = q.main_content || "";
      const context = q.context || "";
      const specific = availableSpecifics.find(s => s.id === q.specific_id);
      const specificName = q.specificName || (specific ? specific.name : "—");
      const containerName = q.containerName || (specific && specific.container ? specific.container.name : (specific ? (specific.container_name || "—") : "—"));

      let effectiveDate = (q.date || q.effectiveDate || "").trim();
      if (!effectiveDate && specific && specific.date) {
        effectiveDate = specific.date.trim();
      }

      let hashtagThemes = q.hashtagThemes || [];
      if (hashtagThemes.length === 0 && q.theme_ids) {
        hashtagThemes = (q.theme_ids || []).map(tid => {
          const th = availableThemes.find(t => t.id === tid);
          return th ? `#${th.name}` : `#${tid}`;
        });
      }
      if (hashtagThemes.length === 0) hashtagThemes = ["#Wisdom"];

      const rawCategory = q.category || (specific ? specific.category : "") || "";

      return {
        idx: q.idx ?? q.index ?? 1,
        content,
        context,
        category: rawCategory,
        specificName,
        containerName,
        effectiveDate: effectiveDate || "—",
        hashtagThemes
      };
    }

    // ==============================================================================
    // 7. RENDER COMPONENT
    // ==============================================================================
    function renderActivePrescript(shouldAnimate = false) {
      const b = resolveBundle(activeQuote);
      if (!b) return;

      document.getElementById('raw-payload-json').textContent = JSON.stringify(b, null, 2);
      const screen = document.getElementById('epaper-screen');

      // Alignment: writing => justified; music/poem => left
      const catLower = (b.category || "").toLowerCase().trim();
      const isWriting = catLower === "writing" || catLower === "bài viết" || catLower === "baiviet";
      const alignClass = isWriting ? "content-justify" : "content-left";

      // Quotation Mark & Container Accent (Synchronized)
      const quoteSeed = (typeof b.idx === 'number' ? b.idx : (parseInt(String(b.idx).replace(/\D/g, ''), 10) || 1)) + reRollSeed;
      const accentIndex = Math.abs(quoteSeed % ACCENT_POOL.length);
      const activeAccent = ACCENT_POOL[accentIndex];
      const sharedAccentColor = activeAccent.hex;

      // Calculate dynamic character width & compile 4-line pages
      const maxChars = getCharsPerLine(currentPresetKey);
      const prescriptPages = buildPrescriptPages(b, maxChars, sharedAccentColor);
      totalPages = prescriptPages.length;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const activePage = prescriptPages[currentPage - 1];

      // Format Content Lines (Strictly at most 4 lines with category-driven alignment)
      let contentHTML = '';
      if (activePage.type === 'context') {
        contentHTML = `
          <div class="ep-context-box">
            ${activePage.lines.map(line => `<div class="ep-text-line ${line.align || 'line-left'}">${line.html || line}</div>`).join('')}
          </div>
        `;
      } else {
        contentHTML = `
          <div class="ep-content ${alignClass}">
            ${activePage.lines.map(line => `<div class="ep-text-line ${line.align || 'line-left'}">${line.html || line}</div>`).join('')}
          </div>
        `;
      }

      // Header Components (Clean single-line with ellipsis on long titles)
      const headerTitleHTML = `<span class="ep-header-left" id="ep-header-left-title"><strong class="ep-idx-num">#${b.idx}</strong><span class="ep-sep">~</span><span class="ep-specific-title">${b.specificName}</span></span>`;
      lastFinalHeaderTitleHTML = `<strong class="ep-idx-num">#${b.idx}</strong><span class="ep-sep">~</span><span class="ep-specific-title">${b.specificName}</span>`;
      const headerDateHTML = `<span class="ep-header-right"><span style="color:#555;">Date:</span><span class="ep-date-val">${b.effectiveDate}</span></span>`;

      // Tags Blocks
      const tagsBlocks = b.hashtagThemes.map((t, idx) => {
        const tagStyle = generateTagColorStyle(t, idx);
        return `<span class="ep-tag-block" style="${tagStyle}">${t}</span>`;
      }).join('');

      // Container Name (Clean origin without page counters)
      const containerHTML = `<span class="ep-container-name" style="color:${sharedAccentColor};">${b.containerName}</span>`;

      lastRenderedPageData = activePage;
      lastRenderedAlignClass = alignClass;

      // Render Screen with EXACT 4-LINE BODY (ZERO EXTRA BANNERS // ZERO SCROLLBAR)
      screen.innerHTML = `
        <!-- ZONE 1: FIXED HARDWARE HEADER (Truncates specific with ellipsis) -->
        <div class="ep-status-bar">
          ${headerTitleHTML}
          ${headerDateHTML}
        </div>

        <!-- ZONE 2 & 3: 4-LINE HARDWARE FRAMEBUFFER -->
        <div class="ep-viewport" id="ep-viewport" onclick="skipAnimation()" title="Click to skip animation">
          ${contentHTML}
        </div>

        <!-- ZONE 4: FIXED HARDWARE FOOTER -->
        <div class="ep-footer">
          <div class="ep-tags">${tagsBlocks}</div>
          <div class="ep-attribution">${containerHTML}</div>
        </div>
      `;

      if (shouldAnimate && animationEnabled && activePage.type === 'quote') {
        runPrescriptTypewriter(activePage, alignClass);
      } else {
        stopDrawingAnimation();
      }

      // Attach debounced wheel listener for discrete page flipping
      const vp = document.getElementById('ep-viewport');
      if (vp) {
        vp.onwheel = (e) => {
          e.preventDefault();
          if (wheelDebounceTimer) return;
          wheelDebounceTimer = setTimeout(() => { wheelDebounceTimer = null; }, 180);
          if (e.deltaY > 15) changePage(1);
          else if (e.deltaY < -15) changePage(-1);
        };
      }
      updateTelemetryControls();
    }

    // Keyboard Shortcuts (Arrow keys & Space for tactile discrete page turns)
    window.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
      if (isDrawing) {
        skipAnimation();
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          return;
        }
      }
      if (e.key === 'ArrowUp' || e.key === 'PageUp') { changePage(-1); e.preventDefault(); }
      if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') { changePage(1); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { navQuote(-1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { navQuote(1); e.preventDefault(); }
      if (e.key === 'Home') { goToPage(1); e.preventDefault(); }
      if (e.key === 'End') { goToPage(999); e.preventDefault(); }
    });

    window.addEventListener('DOMContentLoaded', init);
  </script>
