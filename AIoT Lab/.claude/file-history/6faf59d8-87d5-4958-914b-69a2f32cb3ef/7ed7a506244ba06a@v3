    // Web Audio Synthesizer (Zero-Asset 8-bit Pager Chirp)
    let audioCtx = null;
    function playBeeperChirp(type = 'chirp') {
      if (!soundEnabled) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        const now = audioCtx.currentTime;
        if (type === 'chirp') {
          osc.type = 'square';
          osc.frequency.setValueAtTime(1760, now); // A6
          osc.frequency.setValueAtTime(2637, now + 0.04); // E7
          gain.gain.setValueAtTime(0.04, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
          osc.start(now);
          osc.stop(now + 0.1);
        } else if (type === 'click') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(987, now);
          gain.gain.setValueAtTime(0.03, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);
          osc.start(now);
          osc.stop(now + 0.03);
        }
      } catch (e) {
        // AudioContext silent fallback
      }
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('btn-sound');
      btn.textContent = soundEnabled ? '🔔 Sound: ON' : '🔕 Sound: OFF';
      btn.classList.toggle('active', soundEnabled);
      if (soundEnabled) playBeeperChirp('chirp');
    }

    // ==============================================================================
    // 3. INITIALIZATION & DATA FETCHING
    // ==============================================================================
    async function init() {
      applyPreset('19');

      try {
        const [taxRes, qRes] = await Promise.all([
          fetch(`${API_BASE}/api/taxonomy`).then(r => r.json()).catch(() => null),
          fetch(`${API_BASE}/api/quotes/list`).then(r => r.json()).catch(() => null)
        ]);

        if (taxRes && qRes && qRes.length > 0) {
          availableSpecifics = taxRes.specifics || [];
          availableThemes = taxRes.themes || [];
          quotesList = qRes;
          document.getElementById('connection-status').innerHTML = '● LIVE API SYNCED';
          document.getElementById('connection-status').style.color = '#38bdf8';
        } else {
          useFallbackData();
        }
      } catch (err) {
        console.warn("Using offline fallback data:", err);
        useFallbackData();
      }

      populateSelect();

      // Default to Quote #6 (or first)
      const target = quotesList.find(q => (q.idx === 6 || q.index === 6)) || quotesList[0];
      if (target) {
        loadSelectedQuote(target.id);
      }
    }

    function useFallbackData() {
      quotesList = FALLBACK_QUOTES;
      document.getElementById('connection-status').innerHTML = '● STANDALONE CACHE';
      document.getElementById('connection-status').style.color = '#f59e0b';
    }

    function populateSelect() {
      const select = document.getElementById('quote-select');
      select.innerHTML = quotesList.map(q => {
        const snippet = (q.main_content || "").split('\n')[0].substring(0, 32);
        const idx = q.idx ?? q.index ?? '?';
        return `<option value="${q.id}">#${idx} — "${snippet}..."</option>`;
      }).join('');
    }

    function loadSelectedQuote(qid) {
      activeQuote = quotesList.find(q => q.id === qid) || quotesList[0];
      if (!activeQuote) return;

      currentPage = 1;
      document.getElementById('quote-select').value = activeQuote.id;
      playBeeperChirp('chirp');
      renderActivePrescript();
    }

    function navQuote(step) {
      if (quotesList.length === 0) return;
      const curIdx = quotesList.findIndex(q => q.id === (activeQuote ? activeQuote.id : ''));
      let nextIdx = (curIdx + step + quotesList.length) % quotesList.length;
      loadSelectedQuote(quotesList[nextIdx].id);
    }

    function pickRandomQuote() {
      if (quotesList.length === 0) return;
      const rnd = quotesList[Math.floor(Math.random() * quotesList.length)];
      loadSelectedQuote(rnd.id);
    }

    function reRollColors() {
      reRollSeed = Math.floor(Math.random() * 1000);
      playBeeperChirp('click');
      renderActivePrescript();
    }

    function toggleContext() {
      showContext = !showContext;
      currentPage = 1;
      const btn = document.getElementById('btn-toggle-context');
      btn.textContent = `Context: ${showContext ? 'ON' : 'OFF'}`;
      btn.classList.toggle('active', showContext);
      playBeeperChirp('click');
      renderActivePrescript();
    }

    function setTheme(tName) {
      currentTheme = tName;
      ['obsidian', 'eink', 'amber', 'matrix'].forEach(t => {
        const b = document.getElementById(`btn-theme-` + t);
        if (b) b.classList.toggle('active', t === tName);
      });
      const sc = document.getElementById('epaper-screen');
      if (sc) sc.className = `epaper-screen theme-${tName}`;
      playBeeperChirp('click');
    }

    // ==============================================================================
    // 4. SCREEN PRESET & RATIO APPLICATION
    // ==============================================================================
    function applyPreset(key) {
      currentPresetKey = key;
      const p = HARDWARE_PRESETS[key] || HARDWARE_PRESETS['19'];

      document.querySelectorAll('.ratio-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById(`rb-${key}`);
      if (activeBtn) activeBtn.classList.add('active');

      document.getElementById('active-screen-spec').textContent = `${p.name} · ${p.w}×${p.h} px · Ratio ${p.ratio}`;
      document.getElementById('bezel-dim-label').textContent = `${p.w} × ${p.h} NATIVE`;

      const screen = document.getElementById('epaper-screen');
      const scaleMultiplier = isNative1x ? 1.0 : p.scale;

      const targetW = Math.round(p.w * scaleMultiplier);
      const targetH = Math.round(p.h * scaleMultiplier);

      screen.style.width = `${targetW}px`;
      screen.style.height = `${targetH}px`;
      screen.style.aspectRatio = `${p.w} / ${p.h}`;

      currentPage = 1;
      setTimeout(updatePaginationState, 40);
      playBeeperChirp('click');
    }

    function toggleNativeScale() {
      isNative1x = !isNative1x;
      const btn = document.getElementById('btn-scale');
      btn.textContent = isNative1x ? 'Scale: 1:1 Native' : 'Scale: Studio 2x';
      btn.classList.toggle('active', isNative1x);
      applyPreset(currentPresetKey);
    }

    // ==============================================================================
    // 5. VIEWPORT DISCRETE PAGINATION ENGINE (ZERO SCROLLBAR // PAGE FLIP)
    // ==============================================================================
    let currentPage = 1;
    let totalPages = 1;
    let wheelDebounceTimer = null;

    function updatePaginationState() {
      const vp = document.getElementById('ep-viewport');
      const moreTop = document.getElementById('ep-more-top');
      const moreBottom = document.getElementById('ep-more-bottom');
      const pageLabel = document.getElementById('page-pos-label');
      const pageTag = document.getElementById('ep-page-tag');
      const prevBtn = document.getElementById('btn-page-prev');
      const nextBtn = document.getElementById('btn-page-next');

      if (!vp) return;

      const clientH = vp.clientHeight || 1;
      const scrollH = vp.scrollHeight || 1;
      totalPages = Math.max(1, Math.ceil(scrollH / clientH));

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // Discrete page jump (No smooth scrolling drift)
      vp.scrollTop = (currentPage - 1) * clientH;

      // Top indicator (shown if preceding text exists)
      if (moreTop) {
        moreTop.style.display = (currentPage > 1) ? 'flex' : 'none';
      }

      // Bottom indicator ("..." cue signaling quote has not ended yet)
      if (moreBottom) {
        if (currentPage < totalPages) {
          moreBottom.style.display = 'flex';
          if (pageTag) pageTag.textContent = `[PAGE ${currentPage}/${totalPages} ▼]`;
        } else {
          moreBottom.style.display = 'none';
        }
      }

      // Telemetry pill
      if (pageLabel) {
        if (totalPages > 1) {
          pageLabel.textContent = `Page ${currentPage} of ${totalPages} ···`;
        } else {
          pageLabel.textContent = `Page 1 of 1 (Complete)`;
        }
      }

      if (prevBtn) prevBtn.style.opacity = (currentPage <= 1) ? '0.4' : '1';
      if (nextBtn) nextBtn.style.opacity = (currentPage >= totalPages) ? '0.4' : '1';
    }

    function changePage(direction) {
      const target = currentPage + direction;
      if (target >= 1 && target <= totalPages) {
        currentPage = target;
        playBeeperChirp('click');
        updatePaginationState();
      }
    }

    function goToPage(pageNum) {
      if (pageNum === 999) pageNum = totalPages;
      if (pageNum >= 1 && pageNum <= totalPages) {
        currentPage = pageNum;
        playBeeperChirp('click');
        updatePaginationState();
      }
    }

    function toggleAutoScroll() {
      const btn = document.getElementById('btn-autoscroll');
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
        btn.textContent = 'Auto-Page: OFF';
        btn.classList.remove('active');
      } else {
        btn.textContent = 'Auto-Page: ON';
        btn.classList.add('active');
        autoScrollInterval = setInterval(() => {
          if (currentPage < totalPages) {
            changePage(1);
          } else {
            currentPage = 1;
            playBeeperChirp('click');
            updatePaginationState();
          }
        }, 4200);
      }
    }

    // ==============================================================================
    // 6. METADATA NORMALIZATION & COLOR GENERATOR
    // ==============================================================================
    function generateTagColorStyle(tagName, tagIndex) {
      let hash = 0;
      for (let i = 0; i < tagName.length; i++) {
        hash = ((hash << 5) - hash) + tagName.charCodeAt(i);
        hash |= 0;
      }
      const goldenAngle = 137.508;
      const hue = Math.abs(Math.floor((hash * goldenAngle + tagIndex * 89 + reRollSeed) % 360));

      const textColor   = `hsl(${hue}, 85%, 72%)`;
      const borderColor = `hsla(${hue}, 70%, 40%, 0.45)`;
      const bgColor     = `hsla(${hue}, 65%, 8%, 0.9)`;
      return `background: ${bgColor} !important; border-color: ${borderColor} !important; color: ${textColor} !important;`;
    }

    function resolveBundle(q) {
      if (!q) return null;

      const content = q.main_content || "";
      const context = q.context || "";
      const specific = availableSpecifics.find(s => s.id === q.specific_id);
      const specificName = q.specificName || (specific ? specific.name : "—");
      const containerName = q.containerName || (specific && specific.container ? specific.container.name : (specific ? (specific.container_name || "—") : "—"));

      let effectiveDate = (q.date || q.effectiveDate || "").trim();
      if (!effectiveDate && specific && specific.date) {
        effectiveDate = specific.date.trim();
      }

      let hashtagThemes = q.hashtagThemes || [];
      if (hashtagThemes.length === 0 && q.theme_ids) {
        hashtagThemes = (q.theme_ids || []).map(tid => {
          const th = availableThemes.find(t => t.id === tid);
          return th ? `#${th.name}` : `#${tid}`;
        });
      }
      if (hashtagThemes.length === 0) hashtagThemes = ["#Wisdom"];

      const rawCategory = q.category || (specific ? specific.category : "") || "";

      return {
        idx: q.idx ?? q.index ?? 1,
        content,
        context,
        category: rawCategory,
        specificName,
        containerName,
        effectiveDate: effectiveDate || "—",
        hashtagThemes
      };
    }

    // ==============================================================================
    // 7. RENDER COMPONENT
    // ==============================================================================
    function renderActivePrescript() {
      const b = resolveBundle(activeQuote);
      if (!b) return;

      document.getElementById('raw-payload-json').textContent = JSON.stringify(b, null, 2);
      const screen = document.getElementById('epaper-screen');

      // Alignment: writing => justified; music/poem => left
      const catLower = (b.category || "").toLowerCase().trim();
      const isWriting = catLower === "writing" || catLower === "bài viết" || catLower === "baiviet";
      const alignClass = isWriting ? "content-justify" : "content-left";

      // Quotation Mark & Container Accent (Synchronized)
      const quoteSeed = (typeof b.idx === 'number' ? b.idx : (parseInt(String(b.idx).replace(/\D/g, ''), 10) || 1)) + reRollSeed;
      const accentIndex = Math.abs(quoteSeed % ACCENT_POOL.length);
      const activeAccent = ACCENT_POOL[accentIndex];
      const sharedAccentColor = activeAccent.hex;

      // Format Content with quotes
      const formattedContent = `<span class="ep-qmark ep-qmark-open" style="color:${sharedAccentColor};">“</span><em>${b.content.replace(/\n/g, '<br>')}</em><span class="ep-qmark ep-qmark-close" style="color:${sharedAccentColor};">”</span>`;

      // Header Components
      const headerTitleHTML = `<span class="ep-header-left"><strong class="ep-idx-num">#${b.idx}</strong><span class="ep-sep">~</span><span class="ep-specific-title">${b.specificName}</span></span>`;
      const headerDateHTML = `<span class="ep-header-right"><span style="color:#555;">Date:</span><span class="ep-date-val">${b.effectiveDate}</span></span>`;

      // Tags Blocks
      const tagsBlocks = b.hashtagThemes.map((t, idx) => {
        const tagStyle = generateTagColorStyle(t, idx);
        return `<span class="ep-tag-block" style="${tagStyle}">${t}</span>`;
      }).join('');

      // Container Name
      const containerHTML = `<span class="ep-container-name" style="color:${sharedAccentColor};">${b.containerName}</span>`;

      // Render Screen with FIXED HEADER + DISCRETE PAGINATED VIEWPORT + FIXED FOOTER
      screen.innerHTML = `
        <!-- ZONE 1: FIXED HARDWARE HEADER (Truncates specific with ellipsis) -->
        <div class="ep-status-bar">
          ${headerTitleHTML}
          ${headerDateHTML}
        </div>

        <!-- TOP CONTINUATION CUE (Shown if page > 1) -->
        <div class="ep-more-cue-top" id="ep-more-top" onclick="changePage(-1)">
          <span>▲ ··· PREV PAGE</span>
        </div>

        <!-- ZONE 2 & 3: DISCRETE PAGINATED VIEWPORT (ZERO SCROLLBAR) -->
        <div class="ep-viewport" id="ep-viewport">
          <div class="ep-content ${alignClass}">
            ${formattedContent}
          </div>

          ${(showContext && b.context) ? `
            <div class="ep-context">
              ${b.context}
            </div>
          ` : ''}
        </div>

        <!-- BOTTOM CONTINUATION CUE (Signals quote has not yet ended) -->
        <div class="ep-more-cue-bottom" id="ep-more-bottom" onclick="changePage(1)">
          <span style="font-size:1.1em; letter-spacing:0.2em; font-weight:900;">···</span>
          <span id="ep-page-tag" style="opacity:0.85;">[PAGE 1/2 ▼]</span>
        </div>

        <!-- ZONE 4: FIXED HARDWARE FOOTER -->
        <div class="ep-footer">
          <div class="ep-tags">${tagsBlocks}</div>
          <div class="ep-attribution">${containerHTML}</div>
        </div>
      `;

      // Attach debounced wheel listener for discrete page flipping
      const vp = document.getElementById('ep-viewport');
      if (vp) {
        vp.onwheel = (e) => {
          e.preventDefault();
          if (wheelDebounceTimer) return;
          wheelDebounceTimer = setTimeout(() => { wheelDebounceTimer = null; }, 180);
          if (e.deltaY > 15) changePage(1);
          else if (e.deltaY < -15) changePage(-1);
        };
      }
      setTimeout(updatePaginationState, 40);
    }

    // Keyboard Shortcuts (Arrow keys & Space for tactile discrete page turns)
    window.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
      if (e.key === 'ArrowUp' || e.key === 'PageUp') { changePage(-1); e.preventDefault(); }
      if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') { changePage(1); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { navQuote(-1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { navQuote(1); e.preventDefault(); }
      if (e.key === 'Home') { goToPage(1); e.preventDefault(); }
      if (e.key === 'End') { goToPage(999); e.preventDefault(); }
    });

    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
