TUNNEL_FILE = PROJECT_ROOT / "colab_tunnel_url.txt"
OVERRIDE_TUNNEL_URL: Optional[str] = None


def get_active_tunnel_url() -> Optional[str]:
    """Retrieve active tunnel URL from file or manual override."""
    global OVERRIDE_TUNNEL_URL
    if OVERRIDE_TUNNEL_URL:
        return OVERRIDE_TUNNEL_URL
    if TUNNEL_FILE.exists():
        url = TUNNEL_FILE.read_text(encoding="utf-8").strip()
        if url.startswith("http"):
            return url
    return None


@app.get("/api/v1/gpu/status")
async def get_gpu_status():
    """Check health and connectivity of remote Colab GPU compute node."""
    url = get_active_tunnel_url()
    if not url:
        return {
            "connected": False,
            "tunnel_url": None,
            "message": "Tunnel URL not found. Start the GPU worker in Colab to connect."
        }

    try:
        async with httpx.AsyncClient(timeout=4.0) as client:
            resp = await client.get(f"{url}/health")
            if resp.status_code == 200:
                data = resp.json()
                return {
                    "connected": True,
                    "tunnel_url": url,
                    "device": data.get("device", "unknown"),
                    "gpu_name": data.get("gpu_name", "GPU"),
                    "cuda_available": data.get("cuda_available", True),
                    "model_loaded": data.get("model_loaded", True),
                    "job_status": data.get("job_status", "idle")
                }
            return {
                "connected": False,
                "tunnel_url": url,
                "message": f"Colab returned status {resp.status_code}"
            }
    except Exception as e:
        return {
            "connected": False,
            "tunnel_url": url,
            "message": f"Cannot reach Colab GPU worker: {type(e).__name__}"
        }


@app.post("/api/v1/gpu/set-tunnel")
async def set_tunnel(req: SetTunnelRequest):
    """Manually set or update the Colab tunnel URL."""
    global OVERRIDE_TUNNEL_URL
    url = req.tunnel_url.strip()
    if not url.startswith("http"):
        raise HTTPException(status_code=400, detail="Tunnel URL must start with http:// or https://")

    OVERRIDE_TUNNEL_URL = url
    try:
        TUNNEL_FILE.write_text(url, encoding="utf-8")
    except Exception:
        pass
    return {"status": "ok", "tunnel_url": url}


@app.post("/api/v1/gpu/crop-folder")
async def trigger_gpu_crop_folder(req: FolderCropRequest):
    """Trigger remote anime face cropping on Colab GPU."""
    url = get_active_tunnel_url()
    if not url:
        raise HTTPException(status_code=503, detail="Colab GPU worker not connected. Start notebook cell first.")

    try:
        async with httpx.AsyncClient(timeout=30.0) as client:
            resp = await client.post(
                f"{url}/process-folder",
                json={
                    "folder_url": req.folder_url,
                    "zoom_factor": req.zoom_factor,
                    "score_thresh": req.score_thresh
                }
            )
            return resp.json()
    except httpx.HTTPStatusError as e:
        raise HTTPException(status_code=e.response.status_code, detail=e.response.text)
    except Exception as e:
        raise HTTPException(status_code=502, detail=f"Failed to communicate with Colab: {e}")


@app.get("/api/v1/gpu/job-status")
async def get_gpu_job_status():
    """Poll active cropping job telemetry from Colab GPU."""
    url = get_active_tunnel_url()
    if not url:
        return {"status": "disconnected"}

    try:
        async with httpx.AsyncClient(timeout=5.0) as client:
            resp = await client.get(f"{url}/job-status")
            return resp.json()
    except Exception:
        return {"status": "unreachable"}


@app.get("/api/v1/gpu/download-result")
async def download_gpu_result():
    """Proxy download of finished avatar zip archive from Colab GPU."""
    url = get_active_tunnel_url()
    if not url:
        raise HTTPException(status_code=503, detail="Colab GPU worker not connected")

    client = httpx.AsyncClient(timeout=120.0)
    try:
        req = client.build_request("GET", f"{url}/download-result")
        r = await client.send(req, stream=True)
        if r.status_code != 200:
            await client.aclose()
            raise HTTPException(status_code=r.status_code, detail="No result file available on Colab")

        async def file_stream():
            try:
                async for chunk in r.aiter_bytes():
                    yield chunk
            finally:
                await client.aclose()

        return StreamingResponse(
            file_stream(),
            media_type="application/zip",
            headers={"Content-Disposition": 'attachment; filename="avatars_hoan_thanh.zip"'}
        )
    except Exception as e:
        await client.aclose()
        raise HTTPException(status_code=502, detail=f"Download failed: {e}")


