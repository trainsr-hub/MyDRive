@app.post("/api/v1/gpu/crop-folder")
async def trigger_gpu_crop_folder(req: FolderCropRequest, bg_tasks: BackgroundTasks):
    """Trigger local GPU anime face cropping on Local Disk D:."""
    active_job = get_job_state()
    if active_job["status"] in ("downloading", "processing", "packaging"):
        raise HTTPException(status_code=409, detail="A crop job is already in progress on local GPU")

    bg_tasks.add_task(
        run_avatar_crop_pipeline,
        folder_source=req.folder_url,
        zoom_factor=req.zoom_factor,
        score_thresh=req.score_thresh
    )
    return {
        "status": "started",
        "message": "Avatar cropping pipeline started on local NVIDIA GPU (GTX 1650)"
    }


