@app.get("/api/v1/gallery/items")
async def get_gallery_items():
    """List all cropped avatars grouped by character folder."""
    if not OUTPUT_DIR.exists():
        return {"items": [], "folders": [], "total": 0}

    valid_exts = ('.png', '.jpg', '.jpeg', '.webp')
    items = []
    folders = set()

    for root, dirs, files in os.walk(OUTPUT_DIR):
        rel = os.path.relpath(root, OUTPUT_DIR)
        folder_name = "Default" if rel == "." else rel.replace("\\", "/")
        if folder_name != "Default":
            folders.add(folder_name)

        for f in files:
            if f.lower().endswith(valid_exts):
                subpath = f if rel == "." else f"{rel}/{f}".replace("\\", "/")
                items.append({
                    "filename": f,
                    "folder": folder_name,
                    "subpath": subpath,
                    "url": f"/api/v1/gallery/image/{subpath}"
                })

    return {
        "items": sorted(items, key=lambda x: (x["folder"], x["filename"])),
        "folders": sorted(list(folders)),
        "total": len(items)
    }


@app.get("/api/v1/gallery/image/{subpath:path}")
async def get_gallery_image(subpath: str):
    """Serve a single cropped avatar image directly to the browser."""
    target = OUTPUT_DIR / subpath
    if not target.exists():
        raise HTTPException(status_code=404, detail="Image not found")
    return FileResponse(str(target))


@app.post("/api/v1/gallery/open-folder")
async def open_in_explorer():
    """Open the local output folder in Windows File Explorer on Disk D:."""
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    import subprocess
    subprocess.Popen(f'explorer.exe "{OUTPUT_DIR}"')
    return {"status": "ok", "path": str(OUTPUT_DIR)}


