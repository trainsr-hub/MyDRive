# =============================================================================

@app.get("/api/v1/status", response_model=StatusResponse)
async def get_status():
    """Check connection status to Colab."""
    is_valid, _ = verify_configuration()

    if not is_valid:
        return StatusResponse(
            connected=False,
            notebook_id=settings.COLAB_NOTEBOOK_ID,
        )

    if not colab_client._initialized:
        colab_client.initialize()

    return StatusResponse(
        connected=colab_client._initialized,
        notebook_id=colab_client.notebook_id,
        service_account_email=colab_client.get_service_account_email(),
    )


@app.post("/api/v1/execute", response_model=ExecuteResponse)
async def execute_code(request: ExecuteRequest):
    """
    Execute Python code in the Colab notebook.

    This endpoint receives code from the UI and executes it.
    """
    start_time = time.time()

    if not colab_client._initialized:
        if not colab_client.initialize():
            raise HTTPException(
                status_code=503,
                detail="Colab client not initialized. Configure credentials and restart."
            )

    try:
        success, output = await colab_client.execute(
            request.code,
            timeout=request.timeout_seconds
        )

        execution_time_ms = int((time.time() - start_time) * 1000)

        return ExecuteResponse(
            success=success,
            output=output,
            execution_time_ms=execution_time_ms,
            error=None if success else output
        )

    except Exception as e:
        execution_time_ms = int((time.time() - start_time) * 1000)
        return ExecuteResponse(
            success=False,
            output="",
            execution_time_ms=execution_time_ms,
            error=f"{type(e).__name__}: {e}"
        )


