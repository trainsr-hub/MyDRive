TUNNEL_FILE = PROJECT_ROOT / "colab_tunnel_url.txt"
OVERRIDE_TUNNEL_URL: Optional[str] = None


def get_active_tunnel_url() -> Optional[str]:
    """Retrieve active tunnel URL from file or manual override."""
    global OVERRIDE_TUNNEL_URL
    if OVERRIDE_TUNNEL_URL:
        return OVERRIDE_TUNNEL_URL
    if TUNNEL_FILE.exists():
        url = TUNNEL_FILE.read_text(encoding="utf-8").strip()
        if url.startswith("http"):
            return url
    return None


