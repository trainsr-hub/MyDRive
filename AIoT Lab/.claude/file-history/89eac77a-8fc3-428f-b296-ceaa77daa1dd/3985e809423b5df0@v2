class FolderCropRequest(BaseModel):
    folder_url: str = Field(..., description="Public Google Drive folder URL")
    zoom_factor: float = Field(default=1.6, ge=1.0, le=3.0)
    score_thresh: float = Field(default=0.5, ge=0.1, le=0.95)

def run_folder_pipeline(folder_url: str, zoom_factor: float, score_thresh: float):
    global current_job
    input_dir = TEMP_DIR / "input_images"
    output_dir = TEMP_DIR / "output_avatars"
    zip_path = TEMP_DIR / "avatars_result.zip"

    try:
        current_job.update({
            "status": "downloading",
            "total": 0,
            "processed": 0,
            "current_file": "Downloading from Drive...",
            "result_zip": None,
            "error": None
        })

        # Clear prior runs
        if input_dir.exists(): shutil.rmtree(input_dir)
        if output_dir.exists(): shutil.rmtree(output_dir)
        if zip_path.exists(): zip_path.unlink()

        input_dir.mkdir(parents=True, exist_ok=True)
        output_dir.mkdir(parents=True, exist_ok=True)

        # Download via gdown
        import subprocess
        cmd = f'gdown --folder "{folder_url}" -O "{input_dir}"'
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if res.returncode != 0:
            current_job["status"] = "error"
            current_job["error"] = f"Download failed: {res.stderr[:300]}"
            return

        current_job["status"] = "processing"

        valid_exts = ('.jpg', '.jpeg', '.png', '.webp', '.bmp')
        files_to_process = []
        for root, dirs, files in os.walk(input_dir):
            rel = os.path.relpath(root, input_dir)
            if rel == ".":
                continue
            for f in files:
                if f.lower().endswith(valid_exts):
                    files_to_process.append((os.path.join(root, f), rel, f))

        current_job["total"] = len(files_to_process)
        total_cropped = 0

        for full_path, rel_folder, file_name in files_to_process:
            current_job["current_file"] = f"[{rel_folder}] {file_name}"
            img = cv2.imread(full_path)
            if img is None:
                continue

            crops = crop_anime_faces(img, zoom_factor=zoom_factor, min_score=score_thresh)
            if crops:
                save_dir = output_dir / rel_folder
                save_dir.mkdir(parents=True, exist_ok=True)

                base_name, ext = os.path.splitext(file_name)
                for idx, c in enumerate(crops):
                    suffix = f"_avatar_{idx}{ext}" if len(crops) > 1 else f"_avatar{ext}"
                    save_path = save_dir / f"{base_name}{suffix}"
                    cv2.imwrite(str(save_path), c["image"])
                    total_cropped += 1

            current_job["processed"] += 1

        # Package into ZIP
        current_job["status"] = "packaging"
        current_job["current_file"] = "Creating zip archive..."
        shutil.make_archive(str(TEMP_DIR / "avatars_result"), 'zip', str(output_dir))

        current_job.update({
            "status": "completed",
            "total_avatars": total_cropped,
            "result_zip": str(zip_path),
            "current_file": f"Done! Processed {total_cropped} avatars."
        })

    except Exception as e:
        current_job["status"] = "error"
        current_job["error"] = str(e)

@app.post("/process-folder")
async def process_folder(req: FolderCropRequest, bg_tasks: BackgroundTasks):
    if current_job["status"] in ("downloading", "processing", "packaging"):
        raise HTTPException(status_code=409, detail="A job is already in progress")

    bg_tasks.add_task(run_folder_pipeline, req.folder_url, req.zoom_factor, req.score_thresh)
    return {"status": "started", "message": "Folder processing pipeline started on Colab GPU"}

@app.get("/job-status")
async def get_job_status():
