@app.get("/download-result")
async def download_result():
    zip_path = TEMP_DIR / "avatars_result.zip"
    if not zip_path.exists():
        raise HTTPException(status_code=404, detail="No result zip file available")
    return FileResponse(str(zip_path), filename="avatars_hoan_thanh.zip", media_type="application/zip")

# =============================================================================
# Cloudflare Tunnel Auto-Publisher
# =============================================================================
def start_tunnel_and_publish():
    print("[*] Launching Cloudflare Tunnel on port 8000...")
    import subprocess
    import re

    # Install cloudflared if missing
    if not shutil.which("cloudflared"):
        print("[*] Installing cloudflared binary...")
        subprocess.run("wget -q -nc https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb && dpkg -i cloudflared-linux-amd64.deb", shell=True)

    proc = subprocess.Popen(
        ["cloudflared", "tunnel", "--url", "http://localhost:8000"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )

    tunnel_url = None
    for line in proc.stdout:
        match = re.search(r'(https://[a-zA-Z0-9-]+\.trycloudflare\.com)', line)
        if match:
            tunnel_url = match.group(1)
            print(f"\n=======================================================")
            print(f"[*] LIVE COLAB GPU TUNNEL: {tunnel_url}")
            print(f"=======================================================\n")
            break

    if tunnel_url:
        try:
            DRIVE_PROJECT_DIR.mkdir(parents=True, exist_ok=True)
            URL_FILE.write_text(tunnel_url.strip())
            STATUS_FILE.write_text(json.dumps({
                "url": tunnel_url,
                "gpu": gpu_name,
                "timestamp": time.time()
            }))
            print(f"[OK] Tunnel URL automatically synced to Google Drive: {URL_FILE}")
        except Exception as e:
            print(f"[!] Warning: Could not write tunnel to Drive: {e}")

if __name__ == "__main__":
    import uvicorn
    # Start tunnel in background thread
    t = threading.Thread(target=start_tunnel_and_publish, daemon=True)
    t.start()
    # Run API server
    uvicorn.run(app, host="0.0.0.0", port=8000)
