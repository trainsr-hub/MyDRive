<script>
// API Configuration
const API_BASE = window.location.protocol === 'file:'
  ? 'http://127.0.0.1:8000/api/v1'
  : window.location.origin + '/api/v1';

// State management
const state = {
  connected: false,
  notebookId: '',
  serviceAccount: null,
  executing: false
};

// Load saved configuration
function loadConfig() {
  try {
    const saved = localStorage.getItem('colab_config');
    if (saved) {
      const config = JSON.parse(saved);
      if (config.notebookId) {
        document.getElementById('notebookId').value = config.notebookId;
        state.notebookId = config.notebookId;
      }
      if (config.serviceAccount) {
        document.getElementById('serviceAccount').value = config.serviceAccount;
      }
    }
  } catch (e) {
    console.warn('Could not load saved config:', e);
  }
}

// Save configuration
function saveConfig() {
  try {
    const config = {
      notebookId: document.getElementById('notebookId').value,
      serviceAccount: document.getElementById('serviceAccount').value
    };
    localStorage.setItem('colab_config', JSON.stringify(config));
  } catch (e) {
    console.warn('Could not save config:', e);
  }
}

// Update UI connection state
function updateConnectionState(connected, message) {
  state.connected = connected;
  const statusDot = document.getElementById('statusDot');
  const statusText = document.getElementById('statusText');
  const warning = document.getElementById('connectionWarning');
  const runBtn = document.getElementById('runBtn');

  if (connected) {
    statusDot.classList.add('connected');
    statusText.textContent = message || 'Connected';
    warning.style.display = 'none';
    runBtn.disabled = false;
  } else {
    statusDot.classList.remove('connected');
    statusText.textContent = message || 'Not Connected';
    warning.style.display = 'block';
    runBtn.disabled = true;
  }
}

// Connect to Colab
function connect() {
  const notebookId = document.getElementById('notebookId').value.trim();
  const serviceAccountText = document.getElementById('serviceAccount').value.trim();

  if (!notebookId) {
    addOutput('❌ Please enter a Notebook ID', 'error');
    return;
  }

  if (!serviceAccountText) {
    addOutput('⚠️ No service account provided. Using demo mode.', 'error');
    updateConnectionState(true, `Demo Mode: ${notebookId.substring(0, 8)}...`);
    saveConfig();
    return;
  }

  try {
    const serviceAccount = JSON.parse(serviceAccountText);
    state.serviceAccount = serviceAccount;
    state.notebookId = notebookId;

    updateConnectionState(true, `Connected: ${notebookId.substring(0, 8)}...`);
    addOutput(`✅ Connected to notebook: ${notebookId}`, 'success');
    addOutput(`📧 Service account: ${serviceAccount.client_email || 'N/A'}`, 'success');
    saveConfig();
  } catch (e) {
    addOutput(`❌ Invalid JSON: ${e.message}`, 'error');
  }
}

// Clear authentication
function clearAuth() {
  document.getElementById('serviceAccount').value = '';
  document.getElementById('notebookId').value = '1iYIe9pNcGO3nFYX2BOVtrLCJoF37PzP6';
  updateConnectionState(false);
  try {
    localStorage.removeItem('colab_config');
  } catch (e) {}
  addOutput('🔒 Authentication cleared', 'success');
}

// Execute code
async function executeCode() {
  if (!state.connected || state.executing) return;

  const code = document.getElementById('codeInput').value.trim();
  if (!code) {
    addOutput('❌ Please enter code to execute', 'error');
    return;
  }

  state.executing = true;
  const runBtn = document.getElementById('runBtn');
  const runIcon = document.getElementById('runIcon');
  const runText = document.getElementById('runText');

  runBtn.disabled = true;
  runIcon.innerHTML = '<span class="spinner"></span>';
  runText.textContent = 'Executing...';

  addOutput(`\n▶️ Executing code...`, 'success');
  addOutput(`\`\`\`python\n${code}\n\`\`\``);

  try {
    const response = await fetch(`${API_BASE}/execute`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        code,
        timeout_seconds: 60
      })
    });

    const result = await response.json();

    if (result.success) {
      addOutput(`\n${result.output}`, 'success');
    } else {
      addOutput(`\n❌ Error: ${result.error}`, 'error');
    }
    addOutput(`\n⏱️ Execution time: ${result.execution_time_ms}ms`, 'success');

  } catch (error) {
    addOutput(`\n❌ Network error: ${error.message}`, 'error');
  }

  state.executing = false;
  runBtn.disabled = false;
  runIcon.textContent = '▶️';
  runText.textContent = 'Run Code';
}

// Check backend connection status
async function checkBackendStatus() {
  try {
    const response = await fetch(`${API_BASE}/status`);
    const status = await response.json();

    if (status.connected) {
      updateConnectionState(true, `Backend: ${status.notebook_id.substring(0, 8)}...`);
      return true;
    } else {
      updateConnectionState(false, 'Backend not configured');
      return false;
    }
  } catch (error) {
    updateConnectionState(false, 'Backend offline');
    return false;
  }
}

// Initialize - check backend status on load
async function initialize() {
  loadConfig();

  // Try to connect to backend
  const backendConnected = await checkBackendStatus();

  // If we have saved config but backend not connected, show saved state
  if (!backendConnected && state.notebookId) {
    updateConnectionState(true, `Local config: ${state.notebookId.substring(0, 8)}...`);
  }
}

// Add output line
function addOutput(text, type = '') {
  const panel = document.getElementById('outputPanel');
  const line = document.createElement('div');
  line.className = 'output-line ' + type;
  line.textContent = text;
  panel.appendChild(line);
  panel.scrollTop = panel.scrollHeight;
}

// Clear output
function clearOutput() {
  document.getElementById('outputPanel').innerHTML = '';
}

// Notebook item selection
document.querySelectorAll('.notebook-item').forEach(item => {
  item.addEventListener('click', () => {
    document.querySelectorAll('.notebook-item').forEach(i => i.classList.remove('active'));
    item.classList.add('active');
    document.getElementById('notebookId').value = item.dataset.id;
  });
});

// Initialize
initialize();
</script>