      </div>

      <div class="card" style="margin-top: 1rem;">
        <div class="card-header">Authentication</div>
        <div class="form-group">
          <label for="notebookId">Notebook ID</label>
          <input type="text" id="notebookId" value="1iYIe9pNcGO3nFYX2BOVtrLCJoF37PzP6">
        </div>
        <div class="form-group">
          <label for="serviceAccount">Service Account JSON</label>
          <textarea id="serviceAccount" rows="6" placeholder='{"type": "service_account", "project_id": "...", ...}'></textarea>
