  <div class="layout">
    <!-- Sidebar: Connection & Settings -->
    <aside>
      <div class="card">
        <div class="card-header">Notebook Selection</div>
        <div class="notebook-list">
          <div class="notebook-item active" data-id="1iYIe9pNcGO3nFYX2BOVtrLCJoF37PzP6">
            <div class="notebook-name">AI Tools Notebook</div>
            <div class="notebook-id">1iYIe9pNcGO3nFYX2BOVtrLCJoF37PzP6</div>
          </div>
