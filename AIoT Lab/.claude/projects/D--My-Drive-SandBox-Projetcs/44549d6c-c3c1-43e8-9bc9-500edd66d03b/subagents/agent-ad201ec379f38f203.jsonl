ed,\n    rotation: rand(0, Math.PI * 2),\n    rotSpeed: rand(-0.06, 0.06),\n    size:     rand(5, 18),\n    opacity:  1,\n    sides:    Math.random() < 0.5 ? 4 : 6,\n    life:     1,          // 0→1, fades to 0\n    decay:    rand(0.004, 0.009),\n    burst:    true,\n  };\n}\n\nfunction initShards() {\n  shards.length = 0;\n  for (let i = 0; i < SHARD_COUNT; i++) shards.push(makeShard(false));\n}\n\n// ── Draw a regular polygon ──────────────────────────────────\nfunction drawPoly(x, y, r, sides, rot) {\n  ctx.beginPath();\n  for (let i = 0; i < sides; i++) {\n    const a = rot + (i / sides) * Math.PI * 2;\n    const px = x + Math.cos(a) * r;\n    const py = y + Math.sin(a) * r;\n    i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);\n  }\n  ctx.closePath();\n}\n\n// ── Shockwave ring state ────────────────────────────────────\nlet shockwave = null;   // { x, y, r, maxR, life }\n\n// ── Resize ─────────────────────────────────────────────────\nfunction resize() {\n  W = canvas.width  = window.innerWidth;\n  H = canvas.height = window.innerHeight;\n}\n\n// ── Click handler ───────────────────────────────────────────\ncanvas.addEventListener('click', e => {\n  const cx = e.clientX, cy = e.clientY;\n\n  // Shockwave ring\n  shockwave = { x: cx, y: cy, r: 0, maxR: 260, life: 1 };\n\n  // Impulse nearby shards\n  shards.forEach(s => {\n    const dx = s.x - cx, dy = s.y - cy;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n    if (dist > 200 || dist < 0.1) return;\n    const force = (1 - dist / 200) * 8;\n    s.vx += (dx / dist) * force;\n    s.vy += (dy / dist) * force - 2;   // upward bias\n    s.rotSpeed += rand(-0.08, 0.08);\n  });\n\n  // Crystal burst shards from click origin\n  const COUNT = 20;\n  for (let i = 0; i < COUNT; i++) {\n    const angle = (i / COUNT) * Math.PI * 2 + rand(-0.15, 0.15);\n    bursts.push(makeBurstShard(cx, cy, angle));\n  }\n  // A few extra random-angle ones for richness\n  for (let i = 0; i < 8; i++) {\n    bursts.push(makeBurstShard(cx, cy, rand(0, Math.PI * 2)));\n  }\n});\n\n// ── Main loop ───────────────────────────────────────────────\nconst GRAVITY = 0.012;\n\nfunction tick() {\n  // Soft clear — trail effect\n  ctx.fillStyle = 'rgba(4, 8, 15, 0.22)';\n  ctx.fillRect(0, 0, W, H);\n\n  // ── Shockwave ────────────────────────────────────────────\n  if (shockwave) {\n    shockwave.r   += 12;\n    shockwave.life = Math.max(0, shockwave.life - 0.025);\n    const sw = shockwave;\n    if (sw.life > 0) {\n      ctx.beginPath();\n      ctx.arc(sw.x, sw.y, sw.r, 0, Math.PI * 2);\n      ctx.strokeStyle = `rgba(160, 210, 255, ${sw.life * 0.5})`;\n      ctx.lineWidth = 1.5;\n      ctx.stroke();\n      // Inner ring\n      ctx.beginPath();\n      ctx.arc(sw.x, sw.y, sw.r * 0.65, 0, Math.PI * 2);\n      ctx.strokeStyle = `rgba(200, 230, 255, ${sw.life * 0.2})`;\n      ctx.lineWidth = 0.8;\n      ctx.stroke();\n    } else {\n      shockwave = null;\n    }\n  }\n\n  // ── Burst shards ─────────────────────────────────────────\n  for (let i = bursts.length - 1; i >= 0; i--) {\n    const b = bursts[i];\n    b.x  += b.vx;\n    b.y  += b.vy;\n    b.vy += GRAVITY * 1.5;\n    b.vx *= 0.988;\n    b.vy *= 0.988;\n    b.rotation += b.rotSpeed;\n    b.life     -= b.decay;\n\n    if (b.life <= 0) { bursts.splice(i, 1); continue; }\n\n    const alpha = b.life;\n    ctx.save();\n    ctx.globalAlpha = alpha;\n    drawPoly(b.x, b.y, b.size, b.sides, b.rotation);\n\n    // Bright icy fill\n    const grad = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.size);\n    grad.addColorStop(0,   `rgba(240, 248, 255, ${alpha})`);\n    grad.addColorStop(0.5, `rgba(160, 210, 255, ${alpha * 0.7})`);\n    grad.addColorStop(1,   `rgba(80, 160, 255, 0)`);\n    ctx.fillStyle = grad;\n    ctx.fill();\n\n    ctx.strokeStyle = `rgba(200, 230, 255, ${alpha * 0.9})`;\n    ctx.lineWidth   = 1;\n    ctx.stroke();\n    ctx.restore();\n  }\n\n  // ── Idle shards ───────────────────────────────────────────\n  shards.forEach(s => {\n    // Physics\n    s.vy       += GRAVITY;\n    s.vx       *= 0.999;\n    s.vy        = Math.min(s.vy, 4);          // terminal velocity\n    s.x        += s.vx;\n    s.y        += s.vy;\n    s.rotation += s.rotSpeed;\n\n    // Drift vx back toward calm (gentle restoration)\n    s.vx       += (rand(-0.0015, 0.0015));\n    s.rotSpeed += (0 - s.rotSpeed) * 0.002;  // decay spin back to idle rate\n\n    // Wrap vertically\n    if (s.y - s.size > H) {\n      Object.assign(s, makeShard(true));\n    }\n    // Wrap horizontally\n    if (s.x < -s.size * 2) s.x = W + s.size;\n    if (s.x >  W + s.size * 2) s.x = -s.size;\n\n    // Draw\n    ctx.save();\n    ctx.globalAlpha = s.opacity;\n    drawPoly(s.x, s.y, s.size, s.sides, s.rotation);\n\n    // Subtle fill\n    const fg = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.size);\n    fg.addColorStop(0,   'rgba(180, 220, 255, 0.4)');\n    fg.addColorStop(1,   'rgba(60,  120, 200, 0)');\n    ctx.fillStyle = fg;\n    ctx.fill();\n\n    // Crystal edge highlight\n    ctx.strokeStyle = `rgba(180, 220, 255, 0.55)`;\n    ctx.lineWidth   = 0.8;\n    ctx.stroke();\n\n    // Inner refraction line — draw a smaller polygon offset slightly\n    ctx.globalAlpha = s.opacity * 0.25;\n    drawPoly(s.x + 1.5, s.y - 1.5, s.size * 0.55, s.sides, s.rotation + 0.2);\n    ctx.strokeStyle = 'rgba(220, 240, 255, 0.8)';\n    ctx.lineWidth   = 0.5;\n    ctx.stroke();\n\n    ctx.restore();\n  });\n\n  requestAnimationFrame(tick);\n}\n\n// ── Init ───────────────────────────────────────────────────\nwindow.addEventListener('resize', () => { resize(); initShards(); });\nresize();\ninitShards();\ntick();\n</script>\n</body>\n</html>\n"}},"apiBlockIndex":0,"requestRef":"2f102c9c-5fb0-40a8-bf99-f804c9352b1b","requestedModel":"Faust-ST","attributionAgent":"fork","type":"assistant","uuid":"8af25565-5a6e-498d-a026-97261457b449","timestamp":"2026-10-18T04:21:06.236Z","effort":"high","perTurnEffort":null,"sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"D